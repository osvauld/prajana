# graph-viz-setu.shabda
# grounded in: inverse-square-law -> coulomb -> repulsion -> bond -> graph-bond
#              graph-external-force -> graph-spring-interaction -> graph-cluster
#              graph-camera-interaction -> orbit-kriya -> preset-view-phala

comment: --
comment-end:

# app identity
app-name: vyakarana-graph
screen-width: 1400
screen-height: 900
panel-width: 380

# camera — Obsidian style: pan + zoom on left-drag, orbit on right-drag
# preset views: key 1=top, key 2=bottom, key 3=front
cam-dist: 45.0
cam-pitch: 0.38
cam-fovy: 45.0
zoom-factor: 0.88
zoom-min: 5.0
zoom-max: 200.0
pan-speed: 0.014

# camera orbit (graph-camera-interaction.om: orbit-kriya, right-button-ahara)
cam-orbit-speed: 0.006
cam-pitch-min: -1.55
cam-pitch-max:  1.55

# preset views (graph-camera-interaction.om: preset-top/bottom/front-kriya)
cam-preset-top-pitch:    1.55
cam-preset-top-yaw:      0.0
cam-preset-bottom-pitch: -1.55
cam-preset-bottom-yaw:   0.0
cam-preset-front-pitch:  0.0
cam-preset-front-yaw:    0.0

# particle (node) — newton-second-law: F = ma
node-mass: 1.0
node-radius-min: 0.35
node-radius-max: 1.8
node-radius-scale: 1.85
pulse-speed: 3.2
pulse-amplitude: 0.09

# bond (edge) — Hooke spring + damper — scaled for 817-node full corpus graph
# F_spring = -k * (dist - L0) * dir
# F_damper = -c * (v_rel . dir) * dir
bond-rest-length: 8.0
bond-stiffness: 0.12
bond-damping: 0.45
bond-tube-radius: 0.08
bond-tube-radius-selected: 0.16

# repulsion — Barnes-Hut inspired: cutoff distance + alpha cooling
# Only repel nodes within REP_DIST_MAX of each other (like d3 distanceMax).
# This makes the loop O(n * k) where k = avg nearby nodes, not O(n^2).
# F_rep = R / (d^2 + softening) * dir_away (applied to BOTH particles)
repulsion-strength: 28.0
repulsion-softening: 4.0
# max distance beyond which repulsion is skipped entirely (Barnes-Hut distanceMax)
repulsion-dist-max: 22.0

# alpha cooling — simulation heats at 1.0, cools toward 0 (like d3 alpha decay)
# physics stops when alpha < alpha-min, saving all CPU once graph settles
alpha-decay: 0.0228
alpha-min: 0.001

# center force — weak pull toward origin, prevents drift; scaled by alpha
center-force-strength: 0.05

# drag — velocity decay per step (d3 velocityDecay ~0.4 = fast settling)
# lower = faster settle, less drift exploration
linear-drag: 0.55

# physics substep throttle
# run physics every N render frames — 1 = every frame (alpha cooling handles CPU)
physics-every: 1

# external-force — mouse drag → world-space force on particle
drag-force-scale: 0.28
drag-coupling: 0.22

# hover picking — screen-space pixel radius threshold
hover-px-threshold: 44

# graph seed layout (graph-seed-data.om: spiral-layout-kriya)
# golden-angle spiral, radius scales with sqrt(i/n)
graph-spiral-radius: 18.0
graph-spiral-y-scale: 1.2

# domain → color mapping (used by color_of_node in lua-seed)
# values are direct hex colors — mirrors the color-* palette below.
# single-pass substitution means we can't use COLOR_* names as values here.
domain-color-physics:    #60a5fa
domain-color-math:       #60a5fa
domain-color-quantum:    #60a5fa
domain-color-fluid:      #60a5fa
domain-color-language:   #22d3ee
domain-color-ocaml:      #22d3ee
domain-color-lua:        #22d3ee
domain-color-biology:    #34d399
domain-color-chemistry:  #34d399
domain-color-sangeetham: #f472b6
domain-color-finance:    #f59e0b
domain-color-3d:         #f59e0b
domain-color-raylib:     #f59e0b

# colors
color-core:     #f59e0b
color-engine:   #60a5fa
color-io:       #22d3ee
color-ir:       #34d399
color-session:  #f472b6
color-bond:     #1e3a5a
color-bond-sel: #7ab8f5
color-hover:    #ffffff
color-active:   #fbbf24
color-bg:       #05080f
color-panel:    #040810
color-text:     #cde0f8
color-dim:      #486888
color-grid:     #0e1e2e

# session-id — for engine:session() call in on_init
session-id: 'graph-viz-dev'

# node-to-lua-key: maps each intent sthita node to its lua block key.
# prayoga_lua reads graph-viz-intent sthita edges in order, looks up each node here,
# and emits the block if the key is non-empty.
# lua-update and lua-draw are composite lifecycle blocks — always appended last.
node-key-graph-viz-state: lua-state
node-key-graph-camera: lua-camera
node-key-graph-mouse:
node-key-graph-pointer-input:
node-key-graph-camera-interaction: lua-camera-interaction
node-key-graph-seed-data: lua-seed
node-key-graph-bond:
node-key-graph-link-strength:
node-key-graph-external-force:
node-key-graph-spring-interaction: lua-physics
node-key-graph-hover-picking: lua-screen-projection
node-key-graph-drag-interaction:
node-key-graph-node-visual:
node-key-graph-edge-visual:
node-key-graph-activity-glow:
node-key-graph-cluster:
node-key-graph-container:
node-key-graph-click-query:
node-key-graph-query-cycle:
node-key-graph-delta-stream:
node-key-query-turn-state:

# canvas API
edge-draw: canvas:cylinder3d(x1,y1,z1,x2,y2,z2,radius,color)
node-draw: canvas:sphere(x,y,z,r,color)
begin-3d: canvas:begin_3d(cx,cy,cz,tx,ty,tz,fovy)
end-3d: canvas:end_3d()

# input API
mouse-pos: input:mouse_pos()
mouse-clicked: input:mouse_clicked()
mouse-down: input:mouse_down()
mouse-right-down: input:mouse_right_down()
mouse-delta: input:mouse_delta()
mouse-wheel: input:mouse_wheel()
key-pressed: input:key_pressed(k)
key-1: input:key_pressed('1')
key-2: input:key_pressed('2')
key-3: input:key_pressed('3')

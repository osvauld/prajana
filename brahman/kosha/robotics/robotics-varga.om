  -- sangati roots
  "gati-yukta"        -- robotics is controlled motion
  "kona-yukta"        -- joint angles are the state space
  "seema-yukta"       -- actuator limits, workspace bounds
  "niyama-yukta"      -- control laws govern motion
  "kaala-yukta"       -- trajectories unfold in time
  "mula-shakti-yukta" -- motors exert force; force traces to fundamental interactions


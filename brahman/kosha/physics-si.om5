; ═══════════════════════════════════════════════════════════════════
; physics-si — SI system: base units (beeja) + prefixes (upasarga)
; ═══════════════════════════════════════════════════════════════════
;
; Architecture:
;   base unit  = (sthita matra matra-beeja)  + (naama name) + (naama-mudra symbol)
;   prefix     = (sthita upasarga)           + (sankhya exponent) + (naama-mudra symbol)
;   composed   = (janya prefix base-unit)    + (naama-mudra composed-symbol)
;
; Composition: kilogram = kilo + gram → (janya kilo gram)
; Conversion:  kilo has (sankhya 3) → 10^3 → 1 kg = 1000 g
; ═══════════════════════════════════════════════════════════════════

; ── SI base units (beeja) ─────────────────────────────────────────
; The 7 SI base units. Each has (sthita matra matra-beeja).
; metre, second, radian already defined in physics-foundation.om5
; kilogram already defined — will gain (janya kilo gram) separately
; newton is derived (kg·m/s²), not a base unit

(kosha gram
  (sthita matra matra-beeja)
  (swarupa float)
  (yukta mass)
  (naama gram)
  (naama-mudra g)
  (vishesa physics-varga))

(kosha ampere
  (sthita matra matra-beeja)
  (swarupa float)
  (yukta current electric-current)
  (naama ampere)
  (naama-mudra A)
  (vishesa physics-varga))

(kosha kelvin
  (sthita matra matra-beeja)
  (swarupa float)
  (yukta temperature thermodynamics)
  (naama kelvin)
  (naama-mudra K)
  (vishesa physics-varga))

(kosha mole
  (sthita matra matra-beeja)
  (swarupa float)
  (yukta amount-of-substance avogadro-constant)
  (naama mole)
  (naama-mudra mol)
  (vishesa physics-varga))

(kosha candela
  (sthita matra matra-beeja)
  (swarupa float)
  (yukta luminous-intensity)
  (naama candela)
  (naama-mudra cd)
  (vishesa physics-varga))

; ── SI prefixes (upasarga) ────────────────────────────────────────
; Each prefix has (sthita upasarga) and (sankhya N) where N is the
; exponent: the scale factor is 10^N.
; naama carries the full name. naama-mudra carries the SI symbol.
; Single-letter symbols live in naama-mudra (case-sensitive), NOT naama,
; to avoid collisions with natural language words.
; Composed symbol resolution uses prefix decomposition (step-108).

(kosha yocto
  (sthita upasarga)
  (sankhya -24)
  (naama yocto)
  (naama-mudra y)
  (vishesa physics-varga))

(kosha zepto
  (sthita upasarga)
  (sankhya -21)
  (naama zepto)
  (naama-mudra z)
  (vishesa physics-varga))


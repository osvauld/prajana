kosha macro-varga

  -- cluster for macroeconomic quantities: inflation, deflation, interest-rate, money-supply, business-cycle.
  -- macroeconomics studies economy-wide quantities and their rates of change.
  -- inflation and interest rates are kramanusara quantities: rates of change of price and money.

  "finance-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "kramanusara-yukta"  -- inflation rate, growth rate are kramanusara (rate of change)
  "kaala-yukta"        -- business cycles, trends are time-based patterns
  "spanda-yukta"       -- economic cycles are oscillations — expansion and contraction
  "avastha-yukta"      -- recession, expansion, stagflation are macroeconomic states
  "niyama-yukta"       -- monetary policy, fiscal rules are niyama governing macro quantities


kosha market-varga

  -- cluster for market quantities: equity, bond, currency, asset, liquidity.
  -- markets are systems where assets are priced through supply and demand.
  -- price is the emergent measure of collective valuation.

  "finance-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "matra-yukta"   -- price, yield, ratio are measured quantities
  "kaala-yukta"   -- market prices evolve through time
  "sandhi-yukta"  -- markets are systems of transactions (sandhi = exchange/joining)
  "avastha-yukta" -- bull/bear, liquid/illiquid are market states


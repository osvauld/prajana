kosha risk-varga

  -- cluster for risk quantities: credit, default-risk, systemic-risk, contagion.
  -- risk is the probability of an adverse state transition.
  -- systemic risk is contagion — one failure propagating through the network.

  "finance-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "seema-yukta"       -- risk is proximity to a seema: a threshold of failure
  "avastha-yukta"     -- default, recovery, crisis are avastha transitions
  "sandhi-yukta"      -- contagion spreads through network connections (sandhi)
  "kaala-yukta"       -- risk is time-dependent: near-term vs long-term risk differ
  "niyama-yukta"      -- risk models are niyama: rules for estimating probability of harm


-- derived and compound units.
-- every unit has (sthita matra) so graph walks can identify them.
-- janya edges trace composition from SI base units.
-- naama-mudra edges carry universal symbols (language-independent).

-- SI derived named units

(kosha joule
  (sthita matra)
  (swarupa float)
  (janya kilogram metre second)
  (yukta energy work heat)
  (naama joule)
  (naama-mudra J)
  (vishesa physics-varga))

(kosha watt
  (sthita matra)
  (swarupa float)
  (janya joule second)
  (yukta power)
  (naama watt)
  (naama-mudra W)
  (vishesa physics-varga))

(kosha pascal
  (sthita matra)
  (swarupa float)
  (janya newton metre)
  (yukta pressure stress)
  (naama pascal)
  (naama-mudra Pa)
  (vishesa physics-varga))

(kosha hertz
  (sthita matra)
  (swarupa float)
  (janya second)
  (yukta frequency)
  (naama hertz)
  (naama-mudra Hz)
  (vishesa physics-varga))

(kosha volt
  (sthita matra)
  (swarupa float)
  (janya watt ampere)
  (yukta voltage electric-potential)
  (naama volt)
  (naama-mudra V)
  (vishesa physics-varga))

(kosha farad
  (sthita matra)
  (swarupa float)
  (janya coulomb volt)
  (yukta capacitance)
  (naama farad)
  (naama-mudra F)
  (vishesa physics-varga))

-- compound units

(kosha metre-per-second
  (sthita matra)
  (swarupa float)
  (janya metre second)
  (yukta velocity speed)
  (naama-mudra m/s)
  (vishesa physics-varga))

(kosha metre-per-second-squared
  (sthita matra)
  (swarupa float)
  (janya metre second)
  (yukta acceleration)
  (naama-mudra m/s^2 m/s2)
  (vishesa physics-varga))

(kosha kilogram-metre-per-second
  (sthita matra)
  (swarupa float)
  (janya kilogram metre second)
  (yukta momentum impulse)
  (naama-mudra kg*m/s)
  (vishesa physics-varga))

(kosha kilogram-metre-squared-per-second
  (sthita matra)
  (swarupa float)
  (janya kilogram metre second)
  (yukta angular-momentum)
  (naama-mudra kg*m^2/s)
  (vishesa physics-varga))

(kosha kilogram-per-cubic-metre
  (sthita matra)
  (swarupa float)
  (janya kilogram metre)
  (yukta density)
  (naama-mudra kg/m^3 kg/m3)
  (vishesa physics-varga))

(kosha radian-per-second
  (sthita matra)
  (swarupa float)
  (janya radian second)
  (yukta angular-velocity)
  (naama-mudra rad/s)
  (vishesa physics-varga))

(kosha newton-metre
  (sthita matra)
  (swarupa float)
  (janya newton metre)
  (yukta torque moment)
  (naama-mudra N*m Nm)
  (vishesa physics-varga))

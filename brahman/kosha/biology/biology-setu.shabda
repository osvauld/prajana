# biology-setu.shabda — biology domain bridge labels and sentinels
# one key: value per line. blank lines and # lines ignored.

comment: (*
comment-end: *)

# header comments emitted at top of generated code
header-sequence: (* sequence: dna -> rna -> codon -> amino-acid *)
header-bridge: (* setu: codon-table (the bridge) *)
header-transcription: (* transcription: anuvada — dna -> rna *)
header-translation: (* translation: anuvada — rna -> protein *)
header-folding: (* folding: sphoTa — meaning arrives when sequence completes *)

# sentinel values used in generated translate function
start-codon: AUG
stop-sentinel: Stop
no-start-codon: no-start-codon
unknown-codon: [?]

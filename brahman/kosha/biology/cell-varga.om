kosha cell-varga

  -- cluster for cell biology: cell, mitochondria, ribosome, metabolism, ATP.
  -- the cell is the fundamental unit of life — eka-kosha (single compartment).
  -- metabolism is the continuous chain of chemical reactions that sustains life.

  "biology-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "spanda-swarupa"      -- metabolism IS spanda: self-sustaining oscillation of reactions
  "sva-dharana-yukta"   -- cells maintain themselves — sva-dharana (self-preservation)
  "seema-yukta"         -- cell membrane is seema: boundary between inside and outside
  "avastha-yukta"       -- cell cycle, division, death are avastha transitions
  "kaala-yukta"         -- cell processes are time-dependent (division cycle, ATP production rate)


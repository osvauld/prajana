kosha genetics-varga

  -- cluster for genetics: genome, heredity, replication, transcription, gene expression.
  -- genetics studies how biological information is stored, copied, and expressed.
  -- inheritance is krama across generations: parent state → child state.

  "biology-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "krama-yukta"       -- heredity IS krama: ordered transmission across generations
  "smarana-yukta"     -- genome IS biological smarana: the memory of the species
  "niyama-yukta"      -- Mendel's laws, Hardy-Weinberg are the niyama of inheritance
  "avastha-yukta"     -- genotype is the state; phenotype is the expressed form
  "parampara-yukta"   -- parampara: lineage — genetics is the study of lineage transmission

done

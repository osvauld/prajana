kosha matra-beeja

  -- matra-beeja: the unit seed table.
  -- each entry in the shabda file defines a derived unit.
  -- the matra-nirmana startup hook reads this and emits unit nodes.
  -- base units (kilogram, metre, second, newton) remain as sangati .om files.

  "matra-sthita domain-physics-sthita"
  "yantra-sthita"

shabda shabda-tmpl:physics/matra-beeja.shabda

done

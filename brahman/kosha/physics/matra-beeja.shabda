# matra-beeja: unit seed definitions
# format — name: concepts | composition | word:aliases description
# concepts:    space-separated list of concept-yukta edges
# composition: space-separated list of base-unit-yukta edges
# shabda:      word:comma-separated-aliases then optional description

joule: energy-yukta work-yukta | kilogram-yukta metre-yukta second-yukta | word:joule,J kilogram-metre-squared-per-second-squared
watt: power-yukta | joule-yukta second-yukta | word:watt,W joule-per-second
pascal: pressure-yukta | newton-yukta metre-yukta | word:pascal,Pa newton-per-metre-squared
hertz: frequency-yukta | second-yukta | word:hertz,Hz per-second-the-unit-of-frequency
ampere: current-yukta charge-yukta | coulomb-yukta second-yukta | word:ampere,amp,A coulomb-per-second
volt: potential-yukta | joule-yukta coulomb-yukta | word:volt,V joule-per-coulomb
ohm: resistance-yukta | volt-yukta ampere-yukta | word:ohm volt-per-ampere
kelvin: temperature-yukta | absolute-zero-yukta | word:kelvin,K absolute-temperature
mole: quantity-yukta | avogadro-constant-yukta | word:mole,mol avogadro-number-of-particles
celsius: temperature-yukta | kelvin-yukta | word:celsius,centigrade,C degree-celsius
fahrenheit: temperature-yukta | celsius-yukta | word:fahrenheit,F degree-fahrenheit
degree: kona-yukta | radian-yukta pi-yukta | word:degree,degrees,deg one-360th-rotation
metre-per-second: velocity-yukta speed-yukta | metre-yukta second-yukta | word:m/s,mps,metres-per-second unit-of-velocity
metre-per-second-squared: acceleration-yukta | metre-yukta second-yukta | word:m/s2,metres-per-second-squared unit-of-acceleration
newton-metre: torque-yukta | newton-yukta metre-yukta | word:Nm,N-m,newton-metre unit-of-torque
radian-per-second: angular-velocity-yukta | radian-yukta second-yukta | word:rad/s,radians-per-second unit-of-angular-velocity
kilometre: length-yukta displacement-yukta | metre-yukta | word:kilometre,kilometer,km one-thousand-metres
centimetre: length-yukta | metre-yukta | word:centimetre,centimeter,cm one-hundredth-of-a-metre
millimetre: length-yukta | metre-yukta | word:millimetre,millimeter,mm one-thousandth-of-a-metre
gram: mass-yukta | kilogram-yukta | word:gram,grams,g one-thousandth-of-a-kilogram
kilometre-per-hour: velocity-yukta speed-yukta | kilometre-yukta second-yukta | word:km/h,kmph,kph common-speed-unit
litre: volume-yukta | metre-yukta | word:litre,liter,L one-cubic-decimetre
kilogram-metre-squared: moment-of-inertia-yukta | kilogram-yukta metre-yukta | word:kg-m2 unit-of-moment-of-inertia

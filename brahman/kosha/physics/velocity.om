sangati velocity

  "vega-abheda krama-sthita"
  "kshetra-sthita kshetrajna-yukta"
  "kaala-yukta direction-yukta"
  "domain-physics-sthita"

  -- kramanusara chain: velocity = kramanusara of displacement wrt time
  -- d(displacement)/d(time) — both numerator and denominator encoded
  -- acceleration is kramanusara of velocity wrt time (second derivative of displacement)
  "displacement-kramanusara"
  "physics-time-apeksha"
  "acceleration-kramanusara-phala"

  -- avastha: initial-velocity and final-velocity are THIS concept at purva/uttara avastha
  -- they are not separate concepts — they are velocity wearing a state
  "avastha-sthita"
  "purva-avastha-drishthanta uttara-avastha-drishthanta"

done

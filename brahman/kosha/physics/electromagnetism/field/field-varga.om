kosha field-varga

  -- cluster for electromagnetic field quantities: electric field, magnetic field.
  -- fields are continuous distributions of force through space.
  -- a field assigns a force vector to every point in space.
  -- Maxwell's equations are the niyama of this cluster.

  "electromagnetism-varga-vishesa"
  "subanta-swarupa"

  -- units: electric field in V/m; magnetic field in tesla (kg⋅s⁻²⋅A⁻¹)
  "volt-matra"     -- electric field dimension
  "metre-matra"    -- spatial distribution dimension
  "ampere-matra"   -- magnetic field dimension
  "second-matra"   -- time dimension

  -- sangati roots
  "mula-shakti-yukta"  -- EM fields are the mediators of the electromagnetic force
  "kshetra-sthita"     -- kshetra: field — the Sanskrit word for field IS kshetra
  "taranga-yukta"      -- changing fields produce EM waves
  "spanda-yukta"       -- oscillating fields radiate energy
  "niyama-yukta"       -- Maxwell's equations govern all EM field behaviour

shabda field-varga / cluster-for-electromagnetic-field-quantities-electric-magnetic


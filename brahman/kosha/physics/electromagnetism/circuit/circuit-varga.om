kosha circuit-varga

  -- cluster for electrical circuit quantities: current, voltage, resistance, capacitance, inductance.
  -- circuit quantities describe charge flow and energy storage in discrete components.
  -- Ohm's law (V = IR), Kirchhoff's laws are the niyama of this cluster.

  "electromagnetism-varga-vishesa"
  "subanta-swarupa"

  -- units: ampere, volt, ohm, farad, henry
  "ampere-matra"   -- current: charge per second
  "volt-matra"     -- voltage: energy per charge
  "coulomb-matra"  -- charge: the conserved quantity
  "second-matra"   -- time dimension

  -- sangati roots
  "gati-yukta"        -- current IS flow of charge — motion of electrons
  "niyama-yukta"      -- Ohm's law, Kirchhoff's laws govern circuits
  "sandhi-yukta"      -- circuits are networks of junctions (sandhi = joining)
  "kaala-yukta"       -- capacitor charging, inductor response are time-dependent
  "seema-yukta"       -- resistance and impedance are limits on current flow

done

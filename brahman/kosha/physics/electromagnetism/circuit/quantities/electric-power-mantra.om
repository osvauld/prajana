mantra electric-power-mantra

  "circuit-varga-vishesa"
  "electric-power-swarupa"

  -- P = VI: multiply voltage by current
  "multiplication-krama"

  "execute-chain-kriya"
  "implication-sthita"
  "voltage-janya"
  "current-janya"

  shabda name:electric-power krama-lhs-unit:watt degree:1 krama-lhs:power krama-rhs:voltage,current

done

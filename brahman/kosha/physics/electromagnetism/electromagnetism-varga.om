kosha electromagnetism-varga

  -- cluster for all electromagnetic quantities: fields, circuits, charges, currents.
  -- electromagnetism is one of the four fundamental forces.
  -- light is an EM wave — optics-varga is a vishesa of this.
  -- cross-links to energy-varga: electrical energy is a form of energy.

  "physics-varga-vishesa"
  "energy-varga-vishesa"
  "subanta-swarupa"

  -- units: charge in coulombs, current in amperes, voltage in volts, field in V/m
  "ampere-matra"   -- SI base unit for electric current
  "coulomb-matra"  -- unit for electric charge
  "volt-matra"     -- unit for electric potential

  -- sangati roots
  "mula-shakti-yukta"  -- electromagnetism IS one of the four fundamental forces
  "taranga-yukta"      -- EM waves: light, radio, X-ray are taranga
  "spanda-yukta"       -- oscillating fields produce EM radiation
  "kaala-yukta"        -- AC circuits, wave propagation are time-dependent

done

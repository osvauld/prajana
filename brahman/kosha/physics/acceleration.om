sangati acceleration

  "vivartana-abheda krama-yukta"
  "kshetra-sthita kshetrajna-kriya"
  "kaala-yukta niyama-sthita"
  "domain-physics-sthita"

  -- kramanusara chain: acceleration = kramanusara of velocity wrt time
  -- d(velocity)/d(time) = d²(displacement)/d(time)²
  -- L·T⁻²: two applications of kramanusara wrt time
  "velocity-kramanusara"
  "physics-time-apeksha"
  "jerk-kramanusara-phala"

  -- avastha: acceleration can have initial/final states
  "avastha-sthita"

done

# matra-guna: SI prefix table (the scaling ladder)
# format — prefix: exponent scale
# each prefix is a power of 10
# the prefix modifies a base unit: nano + metre → nanometre at 10⁻⁹ scale
#
# this ladder is itself a kramanusara structure —
# each step is a multiplicative rate of change (×10³ or ×10⁻³)

yocto:  -24  1e-24
zepto:  -21  1e-21
atto:   -18  1e-18
femto:  -15  1e-15
pico:   -12  1e-12
nano:    -9  1e-9
micro:   -6  1e-6
milli:   -3  1e-3
centi:   -2  1e-2
deci:    -1  1e-1
deca:     1  1e1
hecto:    2  1e2
kilo:     3  1e3
mega:     6  1e6
giga:     9  1e9
tera:    12  1e12
peta:    15  1e15
exa:     18  1e18
zetta:   21  1e21
yotta:   24  1e24

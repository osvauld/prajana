kosha fluid-varga

  -- cluster for all fluid dynamics quantities: pressure, viscosity, flow, turbulence.
  -- fluid dynamics sits at the intersection of physics and mathematics.
  -- Navier-Stokes equations are PDEs — both physics and applied mathematics.
  -- continuum mechanics: fluid is treated as continuous matter (not discrete particles).

  "physics-varga-vishesa"
  "math-varga-vishesa"
  "subanta-swarupa"

  -- units: pressure in pascals (N/m²); viscosity in Pa⋅s; flow in m³/s
  "pascal-matra"   -- SI unit for pressure
  "metre-matra"    -- spatial dimension
  "second-matra"   -- time dimension

  -- sangati roots
  "gati-yukta"        -- flow IS motion of a fluid medium
  "sandhi-yukta"      -- fluid dynamics studies contact and junction between fluid layers
  "spanda-yukta"      -- turbulence is chaotic oscillation in fluid motion
  "niyama-yukta"      -- conservation laws (mass, momentum, energy) govern fluid flow
  "kaala-yukta"       -- all fluid processes are time-dependent


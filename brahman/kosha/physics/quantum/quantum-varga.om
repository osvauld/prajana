kosha quantum-varga

  -- cluster for all quantum physics quantities: spin, entanglement, superposition, tunneling.
  -- quantum physics is physics at the smallest scale — where discreteness emerges.
  -- grounded in linear algebra (math-varga): states are vectors, operators are matrices.
  -- Planck constant is the fundamental seema between classical and quantum regimes.

  "physics-varga-vishesa"
  "math-varga-vishesa"
  "subanta-swarupa"

  -- units: action in joule-seconds (ℏ); energy in eV or joules
  "joule-matra"   -- energy dimension
  "second-matra"  -- time dimension (action = energy × time)

  -- sangati roots
  "mula-shakti-yukta"  -- quantum mechanics describes all four fundamental forces at root level
  "spanda-yukta"       -- quantum states are probability amplitudes — waves of possibility
  "seema-yukta"        -- Heisenberg uncertainty is the fundamental seema of measurement
  "avastha-yukta"      -- quantum states, superposition, collapse are all avastha transitions
  "svayambhu-yukta"    -- quantum fluctuations are svayambhu: self-arising without external cause

done

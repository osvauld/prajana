kosha oscillation-varga

  -- cluster for all oscillation and wave quantities: periodic, repeating motion.
  -- frequency, period, amplitude are universal across all oscillating systems —
  -- mechanical, electrical, optical, quantum.
  -- connects to math-varga: Fourier analysis, harmonic series are mathematical structure.

  "physics-varga-vishesa"
  "math-varga-vishesa"
  "subanta-swarupa"

  -- units: frequency in hertz (1/s); period in seconds; amplitude in domain units
  "hertz-matra"   -- SI unit for frequency: cycles per second
  "second-matra"  -- period dimension: T

  -- sangati roots
  "spanda-swarupa"    -- oscillation IS spanda: self-pulsing vibration
  "taranga-yukta"     -- waves are spanda propagating through a medium
  "spanda-matra-yukta"-- frequency is measured vibration
  "kaala-yukta"       -- period is a time quantity
  "avrti-yukta"       -- repetition (avrti) is the defining characteristic

done

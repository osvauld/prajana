# matra-aayaama: SI dimension exponent vectors
# format — unit-name: M L T I theta N J scale
# dimensions: M=mass L=length T=time I=current theta=temperature N=amount J=luminosity
# scale: multiplier relative to SI base (default 1)
#
# the exponent vector IS the unit. kramanusara (d/dt) subtracts 1 from T.
# the depth of the T exponent tells you the kramanusara depth.

# base units
kilogram:               1  0  0  0  0  0  0  1
metre:                  0  1  0  0  0  0  0  1
second:                 0  0  1  0  0  0  0  1
ampere:                 0  0  0  1  0  0  0  1
kelvin:                 0  0  0  0  1  0  0  1
mole:                   0  0  0  0  0  1  0  1
candela:                0  0  0  0  0  0  1  1

# dimensionless
radian:                 0  0  0  0  0  0  0  1
steradian:              0  0  0  0  0  0  0  1
degree:                 0  0  0  0  0  0  0  0.017453292519943

# mechanics — the kramanusara chain
# displacement (L)       → velocity (L·T⁻¹)     → acceleration (L·T⁻²)     → jerk (L·T⁻³)
# kramanusara depth:  0           1                      2                      3
metre-per-second:           0  1 -1  0  0  0  0  1
metre-per-second-squared:   0  1 -2  0  0  0  0  1
metre-per-second-cubed:     0  1 -3  0  0  0  0  1

# force, energy, power
newton:                 1  1 -2  0  0  0  0  1
joule:                  1  2 -2  0  0  0  0  1
watt:                   1  2 -3  0  0  0  0  1
pascal:                 1 -1 -2  0  0  0  0  1

# rotational
newton-metre:                  1  2 -2  0  0  0  0  1
radian-per-second:             0  0 -1  0  0  0  0  1
radian-per-second-squared:     0  0 -2  0  0  0  0  1
kilogram-metre-squared:        1  2  0  0  0  0  0  1

# frequency — kramanusara of time itself
hertz:                  0  0 -1  0  0  0  0  1

# electromagnetism
coulomb:                0  0  1  1  0  0  0  1
volt:                   1  2 -3 -1  0  0  0  1
ohm:                    1  2 -3 -2  0  0  0  1
farad:                 -1 -2  4  2  0  0  0  1
henry:                  1  2 -2 -2  0  0  0  1
weber:                  1  2 -2 -1  0  0  0  1
tesla:                  1  0 -2 -1  0  0  0  1
siemens:               -1 -2  3  2  0  0  0  1

# thermodynamics
celsius:                0  0  0  0  1  0  0  1
fahrenheit:             0  0  0  0  1  0  0  0.555556

# scaled length
kilometre:              0  1  0  0  0  0  0  1000
centimetre:             0  1  0  0  0  0  0  0.01
millimetre:             0  1  0  0  0  0  0  0.001
micrometre:             0  1  0  0  0  0  0  1e-6
nanometre:              0  1  0  0  0  0  0  1e-9
picometre:              0  1  0  0  0  0  0  1e-12
femtometre:             0  1  0  0  0  0  0  1e-15

# scaled mass
gram:                   1  0  0  0  0  0  0  0.001
milligram:              1  0  0  0  0  0  0  1e-6
microgram:              1  0  0  0  0  0  0  1e-9
tonne:                  1  0  0  0  0  0  0  1000

# scaled time
millisecond:            0  0  1  0  0  0  0  0.001
microsecond:            0  0  1  0  0  0  0  1e-6
nanosecond:             0  0  1  0  0  0  0  1e-9
picosecond:             0  0  1  0  0  0  0  1e-12
femtosecond:            0  0  1  0  0  0  0  1e-15
minute:                 0  0  1  0  0  0  0  60
hour:                   0  0  1  0  0  0  0  3600

# scaled velocity
kilometre-per-hour:     0  1 -1  0  0  0  0  0.277778

# volume
litre:                  0  3  0  0  0  0  0  0.001
millilitre:             0  3  0  0  0  0  0  1e-6

# scaled frequency
kilohertz:              0  0 -1  0  0  0  0  1000
megahertz:              0  0 -1  0  0  0  0  1e6
gigahertz:              0  0 -1  0  0  0  0  1e9
terahertz:              0  0 -1  0  0  0  0  1e12

# scaled energy/power
kilojoule:              1  2 -2  0  0  0  0  1000
megajoule:              1  2 -2  0  0  0  0  1e6
gigajoule:              1  2 -2  0  0  0  0  1e9
kilowatt:               1  2 -3  0  0  0  0  1000
megawatt:               1  2 -3  0  0  0  0  1e6
gigawatt:               1  2 -3  0  0  0  0  1e9

# scaled electrical
milliampere:            0  0  0  1  0  0  0  0.001
microampere:            0  0  0  1  0  0  0  1e-6
kilovolt:               1  2 -3 -1  0  0  0  1000
millivolt:              1  2 -3 -1  0  0  0  0.001
kilohm:                 1  2 -3 -2  0  0  0  1000
megohm:                 1  2 -3 -2  0  0  0  1e6

# scaled force/pressure
kilonewton:             1  1 -2  0  0  0  0  1000
meganewton:             1  1 -2  0  0  0  0  1e6
kilopascal:             1 -1 -2  0  0  0  0  1000
megapascal:             1 -1 -2  0  0  0  0  1e6
gigapascal:             1 -1 -2  0  0  0  0  1e9

# electron-volt (energy at particle scale)
electron-volt:          1  2 -2  0  0  0  0  1.602176634e-19

# planck units — where the scaling collapses
# planck-length:        0  1  0  0  0  0  0  1.616255e-35
# planck-time:          0  0  1  0  0  0  0  5.391247e-44
# planck-mass:          1  0  0  0  0  0  0  2.176434e-8
# planck-energy:        1  2 -2  0  0  0  0  1.9561e9

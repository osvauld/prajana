# physics-constants: fundamental and derived physical constants
# format — name: value unit
# readable via: shabda "physics-constants" "name"

gravitational-acceleration:     9.80665   metre-per-second-squared
speed-of-light:                 299792458 metre-per-second
planck-constant:                6.62607015e-34 joule-second
reduced-planck-constant:        1.054571817e-34 joule-second
elementary-charge:              1.602176634e-19 coulomb
avogadro-number:                6.02214076e23 per-mole
boltzmann-constant:             1.380649e-23 joule-per-kelvin
gravitational-constant:         6.67430e-11 newton-metre-squared-per-kilogram-squared
electron-mass:                  9.1093837015e-31 kilogram
proton-mass:                    1.67262192369e-27 kilogram

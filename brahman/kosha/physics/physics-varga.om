kosha physics-varga

  -- root cluster for all physics domain nodes.
  -- all physics leaves inherit domain identity through this node via vishesa walk.
  -- physics-varga points UP to sangati; sangati nodes do not point down to physics.

  "math-varga-vishesa"  -- physics is grounded in mathematics

  -- sangati roots: physics is grounded in motion, force, measure, and law
  "gati-yukta"        -- all physics involves motion or the absence of it
  "matra-yukta"       -- all physics quantities are measured (points to sangati matra)
  "niyama-yukta"      -- all physics is governed by laws (conservation, symmetry)
  "kaala-yukta"       -- all physics processes unfold in time
  "mula-shakti-yukta" -- all physical phenomena trace to fundamental forces
  "sambandha-yukta"   -- physics is the study of how things relate and interact
  "prasarana-yukta"   -- forces and fields propagate through space

done

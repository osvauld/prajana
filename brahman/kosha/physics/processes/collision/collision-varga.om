kosha collision-varga

  -- cluster for all collision interactions between bodies.
  -- collision is the primary interaction pattern of the real world:
  -- two bodies meet, exchange momentum, and separate (or stick).
  --
  -- what is always conserved: momentum (samvega). always. no exception.
  -- p_total_before = p_total_after  (in a closed system)
  -- this is the first niyama of collision — it does not depend on elasticity.
  --
  -- what depends on elasticity: kinetic energy.
  --   e = 1  perfectly elastic    — KE conserved, bodies separate at full speed
  --   e = 0  perfectly inelastic  — KE maximally lost, bodies stick and move together
  --   0<e<1  partially elastic    — KE partially lost, coefficient of restitution e
  --
  -- the coefficient of restitution (e) is the ratio of relative separation speed
  -- to relative approach speed:
  --   e = (v2_after - v1_after) / (v1_before - v2_before)
  -- this single number spans the entire spectrum of real-world collisions.
  -- a rubber ball on concrete: e ≈ 0.8. clay on clay: e ≈ 0. billiard balls: e ≈ 0.95.
  --
  -- the interaction structure: dvaya (two-body). same as gravitational force
  -- and coulomb — two participants, one event. particle-a-sthita and
  -- particle-b-sthita are the required slots. the event cannot be described
  -- from one body's perspective alone — both must be held simultaneously.
  -- this is mithuna: the resonance of two that produces a third (the exchange).
  --
  -- processes declared here:
  --   elastic-collision    — e=1, both KE and momentum conserved
  --   inelastic-collision  — e=0, momentum conserved, bodies merge
  --   partial-collision    — 0<e<1, general case via coefficient of restitution

  "physics-varga-vishesa"
  "dynamics-varga-vishesa"

  -- the conserved quantity: momentum is always the witness
  "momentum-yukta samvega-sthita"
  "conservation-yukta niyama-sthita"

  -- two-body structure: mithuna
  "dvaya-yukta aneka-eka-swarupa"
  "particle-a-sthita particle-b-sthita"
  "mithuna-abheda"

  -- elasticity spectrum
  "kinetic-energy-yukta"        -- KE is what varies across the spectrum
  "coefficient-of-restitution-yukta"

  -- sangati roots
  "sparsha-kriya"               -- collision is sparsha (contact) event
  "samvega-janya"               -- momentum exchange is the janana (birth)
  "vivartana-phala"             -- change of velocity is the result


kosha kinematics-varga

  -- cluster for all kinematic quantities: motion described without cause.
  -- kinematics asks WHERE and HOW FAST — not WHY.
  -- all kinematic quantities are time-dependent and can have initial/final states.

  "physics-varga-vishesa"
  "subanta-swarupa"

  -- units: all kinematic quantities are composed from metre and second
  "metre-matra"   -- spatial dimension: L
  "second-matra"  -- time dimension: T

  -- sangati roots
  "gati-swarupa"      -- kinematics IS the study of motion
  "kaala-yukta"       -- all kinematic quantities are time-dependent
  "avastha-yukta"     -- all kinematic quantities have initial/final states
  "kramanusara-yukta" -- the derivative chain (d/dt) connects all kinematic quantities


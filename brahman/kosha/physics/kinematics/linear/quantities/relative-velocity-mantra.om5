; v_rel = v_observer - v_observed.
; two-participant mantra: both inputs come from relative-vps as named pair.
; match-mantra routes through relative-vps → observer-velocity / observed-velocity bindings.
; krama path handles forward and invert-krama handles inverse.
;
; multi-entity: derive-step won't fire this — observer-velocity/observed-velocity
; are not in normal single-entity bindings.

(mantra relative-velocity-mantra
  (vishesa linear-motion-varga)
  (varga physics-mantra)
  (swarupa relative-velocity)
  (phala relative-velocity)
  (yukta multi-entity)
  (janya observer-velocity observed-velocity)
  (krama subtraction observer-velocity observed-velocity))

kosha jerk

  "linear-motion-varga-vishesa"

  -- kramanusara chain: jerk = d(acceleration)/d(time) = d³(displacement)/d(time)³
  -- L·T⁻³: three applications of kramanusara wrt time
  "vivartana-abheda krama-yukta"
  "acceleration-kramanusara"


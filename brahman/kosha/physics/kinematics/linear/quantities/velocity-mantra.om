mantra velocity-mantra

  "linear-motion-varga-vishesa"
  "velocity-swarupa"

  -- v = u + at: multiply acceleration by time, add initial-velocity
  "multiplication-krama"
  "addition-krama"

  "execute-chain-kriya"
  "implication-sthita"
  "initial-velocity-janya"
  "acceleration-janya"
  "time-janya"

  shabda name:velocity degree:1 krama-lhs:velocity krama-lhs-unit:metre-per-second krama-rhs:initial-velocity,acceleration,time

done

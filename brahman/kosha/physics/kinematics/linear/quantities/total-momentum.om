kosha total-momentum

  "linear-motion-varga-vishesa"

  -- total momentum = sum of all momenta in the system
  -- for single-body: p_total = mv (same formula as momentum)
  -- for multi-body:  p_total = m1v1 + m2v2 + ... (dvandva, Phase 4)
  "samskaara-abheda krama-sthita"
  "kshetrajna-sthita kshetra-yukta"
  "niyama-sthita samgraha-sthita"
  "mass-yukta velocity-yukta"
  "conservation-yukta total-avastha"

done

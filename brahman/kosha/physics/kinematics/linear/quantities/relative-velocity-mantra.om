  -- first = observer's velocity (from scope entity), second = other entity's.
  -- v_rel = v_observer - v_observed.
  -- this is not a special case — it is the same structure as any two-participant
  -- mantra. the proof graph supplies both participants' values.
  "velocity-janya"

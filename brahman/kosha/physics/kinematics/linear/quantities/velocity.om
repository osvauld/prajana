kosha velocity

  "linear-motion-varga-vishesa"

  -- kramanusara chain: velocity = d(displacement)/d(time)
  "vega-abheda krama-sthita"
  "kshetrajna-yukta direction-yukta"
  "displacement-kramanusara"
  "acceleration-kramanusara-phala"

  -- avastha: initial-velocity and final-velocity are velocity wearing a state
  "purva-avastha-drishthanta uttara-avastha-drishthanta"

done

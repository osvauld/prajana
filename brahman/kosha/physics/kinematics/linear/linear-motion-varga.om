kosha linear-motion-varga

  -- cluster for linear kinematic quantities: the time-derivative chain in straight-line motion.
  -- displacement → velocity → acceleration → jerk — each is d/dt of the previous.
  -- the chain is: L → L⋅T⁻¹ → L⋅T⁻² → L⋅T⁻³

  "kinematics-varga-vishesa"
  "subanta-swarupa"

  -- units: base unit is metre for spatial extent, second for time
  "metre-matra"   -- all linear quantities have L dimension
  "second-matra"  -- derivative chain subtracts T each step

  -- sangati roots
  "gati-swarupa"      -- linear motion IS directed movement through space
  "vega-yukta"        -- velocity is the defining quantity of this chain
  "kramanusara-yukta" -- the d/dt structure connects all members
  "avastha-yukta"     -- initial and final states are central to kinematics problems
  "kshetra-sthita"    -- linear motion is spatial (kshetra = field/space)

shabda linear-motion-varga / cluster-for-linear-derivative-chain-displacement-velocity-acceleration-jerk

done

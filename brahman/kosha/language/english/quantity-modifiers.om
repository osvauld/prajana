  -- words that scale, transform or relate numbers and quantities.
  -- fold rule: apply this transformation to the adjacent number or result.
  -- e.g. "twice the force" → force × 2
  --      "half the mass" → mass × 0.5
  --      "velocity squared" → velocity ^ 2
  --      "metres per second" → unit compound (division relationship)

  shabda twice:multiply-2 double:multiply-2 triple:multiply-3 half:multiply-0.5 quarter:multiply-0.25 squared:power-2 cubed:power-3 per:division over:division times:multiply


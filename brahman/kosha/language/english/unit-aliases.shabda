# unit-aliases.shabda
# surface token → canonical matra-aayaama unit name
# tantras load via shabda-pairs "unit-aliases"
# all tokens are lowercase (sentences are lowercased before tokenisation)
# canonical names must match keys in matra-aayaama.shabda exactly

# length
m:metre
metre:metre
meter:metre
metres:metre
meters:metre
cm:centimetre
centimetre:centimetre
centimeter:centimetre
centimetres:centimetre
centimeters:centimetre
mm:millimetre
millimetre:millimetre
millimeter:millimetre
km:kilometre
kilometre:kilometre
kilometer:kilometre

# mass
kg:kilogram
kilogram:kilogram
kilograms:kilogram
kgs:kilogram
g:gram
gram:gram
grams:gram
tonne:tonne
tonnes:tonne

# time
s:second
sec:second
secs:second
second:second
seconds:second

# angle
rad:radian
radian:radian
radians:radian
deg:degree
degree:degree
degrees:degree

# angular velocity  (token "rad/s" appears after lowercasing)
rad/s:radian-per-second
radian/s:radian-per-second
radians/s:radian-per-second
rads/s:radian-per-second
rad/sec:radian-per-second

# angular acceleration
rad/s^2:radian-per-second-squared
rad/s2:radian-per-second-squared

# linear velocity
m/s:metre-per-second
m/sec:metre-per-second

# force
n:newton
newton:newton
newtons:newton

# torque  (n·m typed with unicode middle dot; also plain forms)
n·m:newton-metre
nm:newton-metre
n.m:newton-metre
n*m:newton-metre
newton-metre:newton-metre
newton-meter:newton-metre
newton-metres:newton-metre
newton-meters:newton-metre
newtonmetre:newton-metre
newtonmeter:newton-metre

# energy
j:joule
joule:joule
joules:joule

# power
w:watt
watt:watt
watts:watt

# electric
v:volt
volt:volt
volts:volt
a:ampere
amp:ampere
amps:ampere
ampere:ampere
amperes:ampere
ohm:ohm
ohms:ohm
ω:ohm
f:farad
farad:farad
farads:farad
h:henry
henry:henry
henries:henry

# spring constant (N/m)
n/m:newton-per-metre

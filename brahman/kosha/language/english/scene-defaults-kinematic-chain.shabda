# scene-defaults-kinematic-chain.shabda
# default values for kinematic chain scene extraction
# used when a value cannot be parsed from the sentence
# tantras load via shabda "scene-defaults-kinematic-chain" key

default-joint-count:2
default-joint-type:revolute
default-axis-x:0
default-axis-y:0
default-axis-z:1
default-joint-angle:0
default-link-length:0.5
default-link-mass:1.0
default-joint-speed-max:2.0
default-rated-torque:5.0
default-rated-power:20.0
default-target-x:0
default-target-y:0
default-target-z:0
default-workspace:aayaama-traya
default-goals:joint-angles,joint-velocities,move-time,torque,power,motor-check

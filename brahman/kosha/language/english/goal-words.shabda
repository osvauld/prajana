# goal-words.shabda
# word → canonical goal name for scene-extract goal detection
# tantras load this via shabda-pairs "goal-words"
# covers all scene types: robotics, circuit, pulley, oscillator, optics

# trigger words that open a goal zone (from token-roles.om kriya-yantra)
# these are NOT goals themselves — they signal "what follows is a goal"
# stored under the special key "goal-trigger:" prefix
goal-trigger:find
goal-trigger:compute
goal-trigger:determine
goal-trigger:calculate
goal-trigger:evaluate
goal-trigger:solve
goal-trigger:what
goal-trigger:find.
goal-trigger:compute.
goal-trigger:determine.

# robotics goals
angles:joint-angles
joint-angles:joint-angles
theta:joint-angles
thetas:joint-angles
velocities:joint-velocities
joint-velocities:joint-velocities
omega:joint-velocities
omegas:joint-velocities
time:move-time
move-time:move-time
duration:move-time
torque:torque
torques:torque
tau:torque
power:power
powers:power
motor:motor-check
feasibility:motor-check
motor-check:motor-check
inertia:moment-of-inertia
moment-of-inertia:moment-of-inertia
acceleration:angular-acceleration

# circuit goals
current:current
currents:current
amperage:current
voltage:voltage
voltages:voltage
resistance:resistance
impedance:resistance
power-dissipated:power
dissipated:power

# pulley / mechanics goals
linear-acceleration:acceleration
tension:tension
velocity:velocity
speed:velocity
height:height
distance:distance
displacement:displacement

# oscillator goals
period:period
frequency:frequency
amplitude:amplitude
energy:energy

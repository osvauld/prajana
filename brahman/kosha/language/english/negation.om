kosha english-negation

  "domain-language-sthita yantra-english-sthita"
  "viparita-swarupa shunya-yukta"

  -- words that set a quantity to zero or invert a value.
  -- "no friction" → friction is 0
  -- "without air resistance" → air-resistance is 0
  -- "at rest" (via rest.om) already handles velocity=0 as a context word.
  -- these handle the pure negation / zero-value cases.

  shabda no:zero not:negate without:zero none:zero negligible:zero ignore:zero neglect:zero frictionless:zero ideal:zero


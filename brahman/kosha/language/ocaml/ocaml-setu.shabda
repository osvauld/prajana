# ocaml-setu.shabda — OCaml concept-to-form mappings
# one key: value per line. blank lines and # lines ignored.

comment: (*
comment-end: *)

# ── naming convention ────────────────────────────────────────────────────────────
let-naming:     snake-case
module-naming:  pascal-case
type-naming:    snake-case
variant-naming: pascal-case
const-naming:   upper-snake

# ── fundamental nature (krama, thaalam, viveka, abhava, niyama) ─────────────────
# OCaml is a sambandha-krama language — the function body is a krama of let-in bindings.
# Each 'let x = e in' is one sambandha (named relation), grounding the next step.
# Everything is an expression (sankshepa) — every form collapses to a value.
# viveka IS an expression: if/then/else and match both produce a value.
#   Both branches must have the same type — the niyama of viveka in OCaml.
# No nil — absence is option: None | Some x. abhava is typed and forced to be handled.
# The last expression in a function body IS the visarjana — no return keyword.
# Parameters are curried — each is a separate aadana, each produces a new thaalam.
# match is the fullest viveka — must cover all cases (niyama demands completeness).
# The type system IS the niyama — it governs which krama is valid before runtime.
# Type checking is pramana — proof of the niyama's satisfaction at compile time.
# Module is kshetra — a named bounded field. Functor is a kshetra taking a kshetra.
function-body-nature:     krama-of-sambandhas-let-in
function-body-unit:       let-in-sambandha
parameter-nature:         curried-aadana-each-produces-new-thaalam
return-nature:            last-expression-is-visarjana-no-keyword
nil-nature:               absent-replaced-by-option-abhava-typed
if-nature:                viveka-expression-same-type-both-branches
match-nature:             full-viveka-all-cases-niyama-complete
let-nature:               sambandha-immutable-binding-not-assignment
loop-nature:              avrti-of-krama-or-recursive-avrti-krama
recursion-nature:         avrti-krama-each-call-one-step
niyama:                   type-system-governs-valid-krama-at-compile-time
type-check-nature:        niyama-pramana-proof-of-krama-validity
module-nature:            kshetra-named-bounded-field
functor-nature:           kshetra-taking-kshetra-as-parameter

# ── types ────────────────────────────────────────────────────────────────────────
# OCaml has a static type system with inference — types rarely need annotation
# but they exist and are checked at compile time.
int:          0
float:        0.0
bool:         true
string:       ""
unit:         ()
list:         []
array:        [||]
tuple:        (v1, v2)
record:       { field = value }
option:       None

# ── variable declaration (let binding) ──────────────────────────────────────────
# 'let' creates an immutable binding. For mutation, use 'ref'.
# OCaml infers types — annotation is optional but possible.
variable-declare:   let x = value
variable-int:       let x = 0
variable-float:     let x = 0.0
variable-bool:      let x = true
variable-string:    let x = ""
variable-typed:     let x : int = 0
variable-mutable:   let x = ref 0
variable-update:    x := new_value
variable-deref:     !x

# ── collection literals ──────────────────────────────────────────────────────────
list-literal:       [v1; v2; v3]
list-cons:          v :: rest
list-access:        List.nth lst i
list-length:        List.length lst
list-map:           List.map f lst
list-filter:        List.filter f lst
list-fold:          List.fold_left f init lst
list-iterate:       List.iter f lst

array-literal:      [| v1; v2; v3 |]
array-access:       a.(i)
array-length:       Array.length a
array-set:          a.(i) <- value
array-map:          Array.map f a
array-iterate:      Array.iter f a

map-module:         Hashtbl
map-create:         Hashtbl.create 16
map-set:            Hashtbl.replace tbl key value
map-get:            Hashtbl.find tbl key
map-has:            Hashtbl.mem tbl key
map-iterate:        Hashtbl.iter (fun k v -> ...) tbl

tuple-literal:      (v1, v2, v3)
tuple-access:       fst t

record-define:      type t = { field1: int; field2: string }
record-literal:     { field1 = 0; field2 = "" }
record-access:      r.field
record-update:      { r with field = new_value }

# ── callable (function) ──────────────────────────────────────────────────────────
# Functions are values. 'let' binds them. 'fun' creates anonymous functions.
# All functions are curried — multiple params = nested single-param functions.
# The last expression in a function body IS the return value — no 'return'.
callable-declare:   let name p1 p2 = body
callable-typed:     let name (p1: t1) (p2: t2) : ret = body
callable-anon:      fun p1 p2 -> body
callable-call:      name a1 a2
callable-recursive: let rec name p = body
return-value:       last-expression
parameter:          p
parameter-typed:    (p : type)
argument:           value

# ── scope ────────────────────────────────────────────────────────────────────────
# OCaml has lexical scope. Let bindings shadow earlier bindings.
# No mutation by default — use ref for mutable state.
# Modules create named scopes.
scope-open:         let ... in
scope-module:       module Name = struct ... end
scope-rule:         declaration-before-use
hoisting:           none
let-keyword:        let
let-in:             let x = v in body

# ── loop ─────────────────────────────────────────────────────────────────────────
# OCaml has imperative loops but idiomatic OCaml uses recursion or List functions.
loop-for:           for i = start to stop do ... done
loop-for-down:      for i = start downto stop do ... done
loop-while:         while condition do ... done
loop-recursive:     let rec loop i = if i > n then () else (body; loop (i+1))
loop-list:          List.iter f lst
loop-fold:          List.fold_left f init lst

# ── conditional ──────────────────────────────────────────────────────────────────
# if/then/else is an EXPRESSION in OCaml — it produces a value.
# Both branches must have the same type. 'else ()' if unit.
conditional:        if cond then expr1 else expr2
conditional-unit:   if cond then side_effect ()
pattern-match:      match x with | P1 -> e1 | P2 -> e2
falsy-values:       false
option-none:        None
option-some:        Some value
option-match:       match opt with | None -> default | Some v -> use v

# ── string operations ────────────────────────────────────────────────────────────
string-concat:      s1 ^ s2
string-length:      String.length s
string-sub:         String.sub s pos len
string-format:      Printf.sprintf "%d %s" n s

# ── control structures (legacy keys) ─────────────────────────────────────────────
loop:               for/while
recursion:          let-rec
fold:               List.fold_left
map:                List.map
iteration:          List.iter
if:                 if/then/else

# ── state and functions (legacy keys) ────────────────────────────────────────────
state-update:       ref
function:           fun
closure:            fun
execution:          let()=
runtime:            let()=

# ── modules and structure (legacy keys) ──────────────────────────────────────────
module:             module
table:              list
variable:           let
assignment:         let=
field-access:       .field
loop-body:          for/do
recursion-body:     let-rec

# ── relation roles ───────────────────────────────────────────────────────────────
swarupa: type
kriya:   fun
phala:   result
sthita:  open
yukta:   ->arg
janya:   janya=
abheda:  =

# ── arithmetic operators (symbols) ───────────────────────────────────────────────
plus:                +
minus:               -
times:               *
division:            /
division-constructor: Divide

# ── typed arithmetic ──────────────────────────────────────────────────────────────
addition-float:      (+.)
multiplication-float: (*.)
subtraction-float:   (-.)
division-float:      (/.)
addition-int:        (+)
multiplication-int:  (*)
subtraction-int:     (-)
division-int:        (/)

# ── type names ────────────────────────────────────────────────────────────────────
vector: float-list
matrix: float-array-array
scalar: float
number: int

# ── output labels ─────────────────────────────────────────────────────────────────
wrote-label:   wrote:
run-label:     run:
print-int:     Printf.printf
print-float:   Printf.printf
print-default: Printf.printf
fn-sig:        let %s %s : %s = ...

# ── ocaml_of_composition impls ────────────────────────────────────────────────────
impl-map-fold-dot-list: fun a b -> let n = List.length a in let dot r c = List.fold_left2 (fun acc x y -> acc +. x *. y) 0.0 r c in List.init n (fun i -> List.init n (fun j -> dot (List.nth a i) (List.map (fun r -> List.nth r j) b)))
impl-map-fold-dot-aa: fun a b -> let ra = Array.length a in let cb = Array.length b.(0) in let ca = Array.length a.(0) in let dot r c = Array.fold_left ( +. ) 0.0 (Array.map2 ( *. ) r c) in Array.init ra (fun i -> Array.init cb (fun j -> dot a.(i) (Array.init ca (fun k -> b.(k).(j)))))
impl-map-fold-mul-add-list: fun a b -> List.fold_left2 (fun acc x y -> acc +. x *. y) 0.0 a b
impl-map-fold-mul-add-array: fun a b -> Array.fold_left ( +. ) 0.0 (Array.map2 ( *. ) a b)
impl-map-scl-list: fun vec scalar -> List.map (fun x -> x /. scalar) vec
impl-map-add-list: fun a b -> List.map2 ( +. ) a b
impl-map-mul-add-list: fun v a -> List.map2 (fun vi ai -> vi +. ai) v a
impl-map-mul-list: fun a b -> List.map2 ( *. ) a b

# anuvada-setu.shabda — output labels for the anuvada reasoning display
# one key: value per line. blank lines and # lines ignored.

comment: --
comment-end:

# section markers
header: --- reasoning (anuvada) ---
header-end: ---
separator: ---

# input display
input-label: input:
mode-label: mode:
understood-label: understood:

# reasoning display
response-label: response
pass-label: pass %d (avrti)
thaalam-label: thaalam
pure-domain-label: pure domain
nature-equiv-label: equivalence found in nature
next-thread-label: next thread
next-threads-label: next threads

# intersection display
shared-label: shared
no-shared-label: no shared ground found between groups
run-both-label: run-both-and-intersect

# classification labels
node-label: node
unknown-label: ?

# relation phrases used by compose-answer
rel-swarupa: is
rel-abheda: the same as
rel-sthita: resting on
rel-drishthanta: demonstrating
rel-yukta: with
rel-janya: arising from
rel-kriya: through
rel-phala: yielding
rel-siddha: proven-through
rel-pratipaksha: pratipaksha
rel-sankhya: =
rel-shashthi-vibhakti: of
rel-prathama-vibhakti: is
rel-vidhi-kaala: find
rel-satya: recognises
rel-mithya: holds provisionally

# reasoning emission speech acts — pancavayava (five members of inference)
# uttama-purusa-bahu-vachana kartari-prayoga:
# first-person-inclusive-plural active voice — the proof graph speaking as "we".
# not "I" (ahamkara). not "it was" (karmani). "we" — nam + human + LLM together.
#
# the five members:
#   pratijna   — the given: what we hold before inference begins
#   hetu       — the sought: what question is being posed
#   udaharana  — the universal rule: the law that connects given to sought
#   upanaya    — the application: the rule applied to this specific case
#   nigamana   — the conclusion: the sphoTa — meaning landing whole
#
speech-given: we have
speech-sought: we seek
speech-of: of
speech-known: we know
speech-seen: we see
speech-recognised: we recognise
speech-found: we find
speech-separator: ;
speech-and: and
speech-strand-separator: .
speech-janya-phala-arrow: →
speech-greater-than: >
speech-less-than: <
speech-is: is
speech-than: than
speech-therefore: therefore
speech-because: because
speech-no-match: no match
speech-applying: applying
speech-equals: =

# iccha bridge narrative
iccha-present-prefix: directed-will (iccha) present in
iccha-absent-connector: ; absent in
iccha-present-prefix-alt: iccha (directed-will) present in:
iccha-absent-connector-alt: ; absent in:

# format-response output templates
error-prefix: cannot compute
result-is: is
stored-suffix: (remembered).
attribution-prefix: computed by
domain-header-prefix: in

# fallback token for unresolved output
no-answer-label: asprista

# mode suffixes
mode-question: (this was a question)
mode-force: (this was spoken with force)
mode-incomplete: (this thought is incomplete...)
mode-complete: (this is a complete statement)

# anuvada-setu.shabda — output labels for the anuvada reasoning display
# one key: value per line. blank lines and # lines ignored.

comment: --
comment-end:

# section markers
header: --- reasoning (anuvada) ---
header-end: ---
separator: ---

# input display
input-label: input:
mode-label: mode:
understood-label: understood:

# reasoning display
response-label: response
pass-label: pass %d (avrti)
thaalam-label: thaalam
pure-domain-label: pure domain
nature-equiv-label: equivalence found in nature
next-thread-label: next thread
next-threads-label: next threads

# intersection display
shared-label: shared
no-shared-label: no shared ground found between groups
run-both-label: run-both-and-intersect

# classification labels
node-label: node
unknown-label: ?

# relation phrases used by compose-answer
rel-swarupa: is
rel-abheda: the same as
rel-sthita: resting on
rel-drishthanta: demonstrating
rel-yukta: with
rel-janya: arising from
rel-kriya: through
rel-phala: yielding
rel-siddha: proven-through
rel-pratipaksha: pratipaksha

# iccha bridge narrative
iccha-present-prefix: directed-will (iccha) present in
iccha-absent-connector: ; absent in
iccha-present-prefix-alt: iccha (directed-will) present in:
iccha-absent-connector-alt: ; absent in:

# format-response output templates
error-prefix: cannot compute
result-is: is
stored-suffix: (remembered).
attribution-prefix: computed by
domain-header-prefix: in

# fallback token for unresolved output
no-answer-label: asprista

# mode suffixes
mode-question: (this was a question)
mode-force: (this was spoken with force)
mode-incomplete: (this thought is incomplete...)
mode-complete: (this is a complete statement)

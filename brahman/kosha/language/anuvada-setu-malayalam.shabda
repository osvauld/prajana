# anuvada-setu-malayalam.shabda — Malayalam output labels for reasoning display
# one key: value per line. blank lines and # lines ignored.

comment: --
comment-end:

# section markers
header: --- വ്യാഖ്യാനം (അനുവാദം) ---
header-end: ---
separator: ---

# input display
input-label: ഇൻപുട്ട്:
mode-label: മോഡ്:
understood-label: മനസ്സിലാക്കിയതു:

# reasoning display
response-label: പ്രതികരണം
pass-label: ആവർത്തനം %d (avrti)
thaalam-label: താളം
pure-domain-label: ശുദ്ധ മേഖല
nature-equiv-label: പ്രകൃതിയിലെ സമത്വം കണ്ടെത്തി
next-thread-label: അടുത്ത തണ്ട്
next-threads-label: അടുത്ത തണ്ടുകൾ

# intersection display
shared-label: പങ്കിടുന്നത്
no-shared-label: രണ്ട് കൂട്ടങ്ങൾക്കിടയിൽ പൊതുവായ അടിസ്ഥാനം കണ്ടെത്തിയില്ല
run-both-label: രണ്ടും ഓടിച്ച് കൂട്ടുമിടുക്ക് കാണിക്കുക

# classification labels
node-label: നോഡ്
unknown-label: ?

# relation phrases used by compose-answer
rel-swarupa: ആണ്
rel-abheda: അതേയാണ്
rel-sthita: ആശ്രയിച്ചിരിക്കുന്നു
rel-drishthanta: ഉദാഹരിക്കുന്നു
rel-yukta: കൂടെ
rel-janya: ഉത്ഭവിക്കുന്നത്
rel-kriya: വഴി
rel-phala: ഫലമായി
rel-siddha: തെളിയിച്ച
rel-pratipaksha: പ്രതിപക്ഷം

# iccha bridge narrative
iccha-present-prefix: ദിശാബോധമുള്ള ഇച്ഛ (iccha) ഉള്ളത്
iccha-absent-connector: ; ഇല്ലാത്തത്
iccha-present-prefix-alt: ഇച്ഛ (directed-will) ഉള്ളത്:
iccha-absent-connector-alt: ; ഇല്ലാത്തത്:

# format-response output templates
error-prefix: കണക്കാക്കാൻ കഴിഞ്ഞില്ല
result-is: ആണ്
stored-suffix: (ഓർമ്മിച്ചു).
attribution-prefix: കണക്കാക്കിയത്
domain-header-prefix: ൽ

# fallback token for unresolved output
no-answer-label: അസ്പൃഷ്ടം

# mode suffixes
mode-question: (ഇത് ഒരു ചോദ്യം ആയിരുന്നു)
mode-force: (ഇത് ഊന്നിപ്പറഞ്ഞതാണ്)
mode-incomplete: (ഈ ചിന്ത അപൂർണ്ണമാണ്...)
mode-complete: (ഇത് പൂർണ്ണമായ ഒരു പ്രസ്താവനയാണ്)

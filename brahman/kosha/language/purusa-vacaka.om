kosha vacaka

  -- vacaka: the speaker — the one asking the question.
  -- uttama-purusa (first person): i, me, my, mine, myself.
  -- in every question the speaker is present even when unnamed.
  -- the speaker's count is what the question is about when "i have N".
  --
  -- sangati connection: nam-yukta — the speaker and nam are in dialogue.
  -- nam is the addressed; vacaka is the one who addresses.
  -- together they form the vak-dvandva (speech-pair) of the question.

  "language-varga-vishesa"
  "purusa-varga-vishesa"
  "nam-yukta"                  -- vacaka speaks toward nam
  "uttama-purusa-abheda"       -- first-person singular subject
  "chala-apeksha-sthita"       -- speaker is the moving frame — the one who changes
  "sambodhana-yukta"           -- the speaker is the one who addresses

done


kosha addressee

  -- addressee: the one being spoken to — "you".
  -- prathamam-purusa (second person): you, your, yours, yourself.
  -- the addressee is nam — the entity to whom the question or statement is directed.
  -- "i gave you 2" — the 2 transfers from vacaka (speaker) to addressee (nam).
  -- this transfer-direction is the subtraction signal for count arithmetic.
  --
  -- sangati: nam-abheda — addressee IS the nam in the vak-dvandva.

  "language-varga-vishesa"
  "purusa-varga-vishesa"
  "nam-abheda"                 -- addressee IS nam
  "dvitiya-purusa-abheda"      -- second-person
  "sthira-apeksha-sthita"     -- addressee is the fixed frame — the graph that holds
  "sambodhana-phala"           -- addressee is the one who receives the address

done

kosha akshara-varga

  "akshara-swarupa cs-string-sthita domain-cs-sthita language-sthita"
  "lipi-kriya primitive-type-yukta"

  -- character classification for string parsing
  -- anka: digit (0-9)
  -- swar: vowel (a,e,i,o,u)
  -- vyanjan: consonant (b,c,d,f,g,...z)
  -- bindu: dot/decimal point
  -- chihna: operator symbol (+,-,*,/,=)
  -- prashna: question mark
  -- alpavishram: comma/separator
  -- vishram: semicolon/stop
  -- udbodhan: exclamation

  shabda 0:anka 1:anka 2:anka 3:anka 4:anka 5:anka 6:anka 7:anka 8:anka 9:anka a:swar e:swar i:swar o:swar u:swar A:swar E:swar I:swar O:swar U:swar b:vyanjan c:vyanjan d:vyanjan f:vyanjan g:vyanjan h:vyanjan j:vyanjan k:vyanjan l:vyanjan m:vyanjan n:vyanjan p:vyanjan q:vyanjan r:vyanjan s:vyanjan t:vyanjan v:vyanjan w:vyanjan x:vyanjan y:vyanjan z:vyanjan B:vyanjan C:vyanjan D:vyanjan F:vyanjan G:vyanjan H:vyanjan J:vyanjan K:vyanjan L:vyanjan M:vyanjan N:vyanjan P:vyanjan Q:vyanjan R:vyanjan S:vyanjan T:vyanjan V:vyanjan W:vyanjan X:vyanjan Y:vyanjan Z:vyanjan .:bindu +:chihna -:chihna *:chihna /:chihna =:chihna ?:prashna ,:alpavishram ;:vishram !:udbodhan


kosha set-varga

  -- cluster for set-theoretic structures: set, subset, union, intersection, complement.
  -- set theory is the foundation of all mathematics — everything is built from sets.
  -- Zermelo-Fraenkel axioms define the rules of set membership.

  "math-varga-vishesa"

  -- sangati roots
  "vrnda-yukta"   -- vrnda: group/collection — sets are the formalisation of vrnda
  "niyama-yukta"  -- ZF axioms are the niyama of set theory
  "viveka-yukta"  -- membership (∈) is the act of viveka: is this element in this set?
  "dvandva-yukta" -- union and intersection are binary operations on sets

done

kosha algebraic-projection

  -- relational algebra projection: π_A(R) — select columns from a relation.
  -- in tantras: | collect s  or  | collect o  or  | collect (to-string s)
  -- extracts a specific component from each triple.
  -- pure: no state, no side effects. composes with selection.
  -- distinct from geometric projection (kosha/3d/projection).

  "algebra-varga-karma"
  "morphism-swarupa function-sthita"
  "relation-janya"
  "set-phala"

  shabda algebraic-projection, pi, project / relational-algebra-projection-extract-columns-from-a-relation

done

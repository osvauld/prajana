kosha vec-add

  "vector-kriya domain-math-sthita"
  "addition-abheda aayaama-yukta"

  -- component-wise addition of two n-dimensional vectors
  -- [a1,a2,...,an] + [b1,b2,...,bn] = [a1+b1, a2+b2,...,an+bn]
  -- works for any n — 2D, 3D, nD

shabda vec-add / component-wise-vector-addition-for-n-dimensional-vectors

done

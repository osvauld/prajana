mantra complex-phase

  "number-varga-karma"
  "complex-varga-vishesa"
  "kona-swarupa argument-abheda"

  -- arg(a+bi) = atan2(b, a): angle in complex plane
  "arctangent-krama"

  shabda complex-phase / argument-of-complex-number-atan2-b-over-a-angle-in-complex-plane degree:1 krama-input:complex krama-output:angle

done

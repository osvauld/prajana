mantra lcm

  "number-varga-karma"
  "number-theory-varga-vishesa"
  "gcd-yukta multiple-swarupa"

  -- lcm(a,b) = |a·b| / gcd(a,b)
  "multiplication-krama"
  "gcd-krama"
  "division-krama"

  shabda lcm / least-common-multiple-product-divided-by-gcd degree:1 krama-input:a,b krama-output:multiple

done

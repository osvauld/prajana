mantra complex-mul

  "number-varga-karma"
  "complex-varga-vishesa"
  "multiplication-abheda bilinear-swarupa"

  -- [a,b] * [c,d] = [ac-bd, ad+bc]
  -- real part: ac - bd
  -- imaginary part: ad + bc
  "multiplication-krama"
  "subtraction-krama"
  "addition-krama"

  shabda complex-mul / complex-multiplication-ac-minus-bd-and-ad-plus-bc degree:1 krama-input:complex-a,complex-b krama-output:complex

done

kosha geometry-varga

  -- cluster for geometric structures: coordinates, vectors, matrices, manifolds, topology.
  -- geometry studies shape, distance, and transformation in space.
  -- linear algebra is the foundation: vectors and matrices encode spatial relationships.

  "math-varga-vishesa"

  -- sangati roots
  "kshetra-yukta"   -- kshetra: field/space — geometry IS the study of kshetra
  "kona-yukta"      -- angles are geometric primitives
  "rekha-yukta"     -- lines (rekha) are the basic geometric elements
  "bindu-yukta"     -- points (bindu) are the foundation of geometry
  "aayaama-yukta"   -- dimensions (aayaama) define the geometric space


mantra lerp

  "geometry-varga-karma"
  "interpolation-varga-vishesa"
  "slerp-drishthanta linear-swarupa"

  -- lerp(a, b, t) = a + t·(b-a): linear interpolation
  -- t=0 → a, t=1 → b, t=0.5 → midpoint
  "subtraction-krama"
  "multiplication-krama"
  "addition-krama"

  shabda lerp / linear-interpolation-a-plus-t-times-b-minus-a degree:1 krama-input:a,b,t krama-output:value

done

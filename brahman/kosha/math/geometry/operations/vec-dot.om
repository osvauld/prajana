mantra vec-dot

  "geometry-varga-karma"
  "vector-kriya scalar-phala"
  "dot-product-abheda aayaama-yukta"

  -- dot product of two n-dimensional vectors: sum of component-wise products
  -- [a1,...,an] · [b1,...,bn] = a1·b1 + a2·b2 + ... + an·bn
  -- result is a scalar — the projection magnitude
  -- |a|·|b|·cos(θ) where θ is the angle between vectors
  "multiplication-krama"
  "addition-krama"

  shabda vec-dot / dot-product-of-n-dimensional-vectors-scalar-projection degree:1 krama-input:vec-a,vec-b krama-output:scalar per-element:yes fold:sum

done

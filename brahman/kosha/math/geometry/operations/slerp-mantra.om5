; slerp(q1, q2, t) = q1·(q1⁻¹·q2)^t: spherical linear interpolation
; preserves unit length; constant angular velocity along great-circle arc

(mantra slerp
  (karma geometry-varga)
  (vishesa interpolation-varga quaternion-varga)
  (abheda lerp)
  (swarupa spherical)
  (krama quat-conjugate quat-mul arctangent sine))

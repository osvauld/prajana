kosha organic-varga

  -- cluster for organic chemistry: carbon, hydrocarbons, polymers, amino-acids, peptides.
  -- organic chemistry is the chemistry of carbon-based compounds.
  -- carbon's tetravalence enables the complexity of life molecules.

  "chemistry-varga-vishesa"
  "biology-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "sandhi-yukta"    -- organic chemistry is about carbon forming multiple bonds (sandhi)
  "krama-yukta"     -- polymer chains are ordered sequences (krama) of monomers
  "vrnda-yukta"     -- functional groups are families (vrnda) of reactive sites
  "avastha-yukta"   -- isomers are the same atoms in different spatial states


kosha molecular-varga

  -- cluster for molecular structure: molecule, chemical bonds, covalent, ionic, hydrogen bonds.
  -- molecules form when atoms share or transfer electrons — sandhi at chemical scale.
  -- molecular geometry determines chemical properties.

  "chemistry-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "sandhi-swarupa"     -- chemical bonding IS sandhi: the joining that produces new properties
  "mula-shakti-yukta"  -- chemical bonds are EM force between electron clouds
  "spanda-yukta"       -- molecular vibration modes determine IR spectra
  "avastha-yukta"      -- bonded vs unbonded are states; reaction is state transition
  "niyama-yukta"       -- valence rules, octet rule are the niyama of bonding


kosha atomic-varga

  -- cluster for atomic structure: atom, nucleus, proton, neutron, electron-shell, isotope, valence.
  -- atomic structure is quantum mechanics applied to electrons and nuclei.
  -- the periodic table is the ordered classification of atomic structures.

  "chemistry-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "mula-shakti-yukta"  -- atomic forces (EM + strong + weak) are fundamental forces
  "spanda-yukta"       -- electrons are probability waves — spanda at quantum scale
  "seema-yukta"        -- valence is the limit on bonding capacity
  "avastha-yukta"      -- electron shells are discrete energy states (avastha)
  "svayambhu-yukta"    -- atomic properties (mass, charge) are svayambhu: self-determined

done

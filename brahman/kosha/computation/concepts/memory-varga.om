kosha memory-varga

  -- cluster for memory and binding concepts: variable, binding, scope, mutation, stack.
  -- memory is the avastha-holder of computation — it stores the state between steps.
  -- binding names a value; scope limits where that name is valid.

  "cs-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "avastha-swarupa"  -- memory IS the holder of computational state (avastha)
  "niyama-yukta"     -- scoping rules, mutation rules are niyama
  "seema-yukta"      -- scope is a seema: the boundary within which a name is valid
  "smarana-yukta"    -- smarana: remembering — memory IS computational smarana

done

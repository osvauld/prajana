# naming-convention.shabda — identifier writing rules per form and per language

# ── convention forms ─────────────────────────────────────────────────────────────
camel-case:   firstWordLowerRestTitle
pascal-case:  EachWordTitleCase
snake-case:   words_joined_by_underscores
kebab-case:   words-joined-by-hyphens
upper-snake:  WORDS_JOINED_BY_UNDERSCORES

# ── per-language rules ────────────────────────────────────────────────────────────
lua-local:      snake-case
lua-constant:   upper-snake
lua-function:   snake-case

ocaml-let:      snake-case
ocaml-module:   pascal-case
ocaml-type:     snake-case
ocaml-variant:  pascal-case

  "cs-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "krama-swarupa"   -- computation IS ordered sequence (krama) of transformations
  "niyama-yukta"    -- algorithms are niyama: rules that define valid sequences
  "avastha-yukta"   -- computation transforms states: input → intermediate → output
  "kaala-yukta"     -- time complexity is the kaala of computation


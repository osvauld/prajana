; ═══════════════════════════════════════════════════════════════════
; physics-kinematics — 24 nodes
; ═══════════════════════════════════════════════════════════════════

(kosha kinematics-varga
  (vishesa physics-varga)
  (swarupa subanta gati)
  (matra metre second)
  (yukta kaala avastha kramanusara))

(kosha linear-motion-varga
  (vishesa kinematics-varga)
  (swarupa subanta gati)
  (matra metre second)
  (yukta vega kramanusara avastha)
  (sthita kshetra))

(kosha projectile-motion
  (vishesa linear-motion-varga)
  (swarupa tinanta bhave-prayoga)
  (ahara velocity kona)
  (phala displacement))

(kosha vertical-motion
  (vishesa linear-motion-varga)
  (swarupa subanta)
  (abheda kona)
  (yukta pi-dvaya))

(mantra acceleration-mantra
  (vishesa linear-motion-varga)
  (varga physics-mantra)
  (swarupa acceleration)
  (phala acceleration)
  (janya final-velocity initial-velocity time)
  (krama division ( subtraction final-velocity initial-velocity ) time))

(kosha acceleration
  (vishesa linear-motion-varga)
  (abheda vivartana)
  (yukta krama)
  (kriya kshetrajna)
  (sthita niyama sthira-apeksha)
  (kramanusara velocity)
  (phala jerk-kramanusara)
  (avastha angular centripetal tangential radial linear average initial final))

(kosha displacement
  (vishesa linear-motion-varga)
  (phala krama velocity-kramanusara)
  (yukta kshetrajna direction viveka)
  (avastha angular total linear radial tangential initial final average))

(kosha height
  (vishesa linear-motion-varga)
  (abheda displacement)
  (yukta direction)
  (janaka potential-energy)
  (apeksha gravity))

(kosha jerk
  (vishesa linear-motion-varga)
  (abheda vivartana spanda)
  (yukta krama)
  (kramanusara acceleration)
  (sthita sthira-apeksha))

(mantra momentum-mantra
  (vishesa linear-motion-varga)
  (varga physics-mantra)
  (swarupa momentum)
  (phala momentum)
  (janya mass velocity)
  (krama multiplication mass velocity))

(kosha momentum
  (vishesa linear-motion-varga)
  (abheda samskaara)
  (sthita krama kshetrajna niyama)
  (yukta kshetra mass velocity conservation)
  (avastha angular initial final total linear))

(mantra relative-velocity-mantra
  (vishesa linear-motion-varga)
  (varga physics-mantra)
  (swarupa relative-velocity)
  (phala relative-velocity)
  (yukta multi-entity)
  (janya observer-velocity observed-velocity)
  (krama subtraction observer-velocity observed-velocity))

(kosha relative-velocity
  (vishesa linear-motion-varga)
  (abheda velocity)
  (sthita chala-apeksha)
  (yukta apeksha sthira-apeksha kshetrajna group-witness)
  (kriya addition))

(kosha speed
  (vishesa linear-motion-varga)
  (abheda vegam)
  (sthita krama kshetrajna)
  (yukta kshetra))

(kosha total-momentum
  (vishesa linear-motion-varga)
  (swarupa momentum)
  (sthita samgraha niyama))

(kosha total-momentum
  (vishesa linear-motion-varga)
  (abheda samskaara)
  (sthita krama kshetrajna niyama samgraha)
  (yukta kshetra mass velocity conservation)
  (avastha total))

(mantra velocity-mantra
  (vishesa linear-motion-varga)
  (varga physics-mantra)
  (swarupa velocity)
  (phala velocity)
  (janya initial-velocity acceleration time)
  (krama addition initial-velocity ( multiplication acceleration time )))

(kosha velocity
  (vishesa linear-motion-varga)
  (abheda vega)
  (sthita krama sthira-apeksha)
  (yukta kshetrajna direction)
  (kramanusara displacement)
  (phala acceleration-kramanusara)
  (drishthanta purva-avastha uttara-avastha)
  (avastha initial final average tangential radial linear centripetal))

(kosha angular-displacement
  (vishesa rotational-motion-varga)
  (swarupa kona)
  (abheda gati)
  (sthita trajectory)
  (ahara angular-velocity-kramanusara)
  (janaka path-energy))

(mantra angular-momentum-mantra
  (vishesa rotational-motion-varga)
  (varga physics-mantra)
  (swarupa angular-momentum)
  (phala angular-momentum)
  (janya moment-of-inertia angular-velocity)
  (krama multiplication moment-of-inertia angular-velocity))

(kosha angular-momentum
  (vishesa rotational-motion-varga)
  (abheda momentum)
  (swarupa rotation)
  (yukta moment-of-inertia angular-velocity conservation torque derivative)
  (siddha cross-product)
  (phala vector))

(mantra angular-velocity-mantra
  (vishesa rotational-motion-varga)
  (varga physics-mantra)
  (swarupa angular-velocity)
  (phala angular-velocity)
  (janya velocity radius)
  (krama division velocity radius))

(kosha angular-velocity
  (vishesa rotational-motion-varga oscillation-varga)
  (abheda velocity frequency)
  (yukta kona avrti pi period)
  (swarupa radian)
  (phala angular-acceleration)
  (kramanusara kona)
  (sthita sthira-apeksha))

(kosha rotational-motion-varga
  (vishesa kinematics-varga oscillation-varga)
  (swarupa subanta kona)
  (matra radian second)
  (yukta gati kramanusara avrti avastha))

; rest as compound base: "at rest" → at-rest, "from rest" → from-rest
(kosha rest
  (vishesa linear-motion-varga)
  (abheda shunya)
  (avastha at from))

(kosha at-rest
  (vishesa linear-motion-varga)
  (abheda initial-rest)
  (sthita shunya))

(kosha from-rest
  (vishesa linear-motion-varga)
  (abheda initial-rest)
  (sthita shunya))

; ── dimensional definitions ────────────────────────────────────
; bridge from SI base units to concept dimensions.
; base concepts: identity (mass IS gram-dimension).
; derived concepts: krama chain from base units.
; these let eval-krama-dim derive all unit dimensions generatively.

(mantra mass-definition
  (varga unit-mantra)
  (phala mass)
  (janya gram)
  (krama gram))

(mantra displacement-definition
  (varga unit-mantra)
  (phala displacement)
  (janya metre)
  (krama metre))

(mantra time-definition
  (varga unit-mantra)
  (phala time)
  (janya second)
  (krama second))

(mantra current-definition
  (varga unit-mantra)
  (phala current)
  (janya ampere)
  (krama ampere))

; variant bridges: qualified concepts inherit base concept's dimension
(mantra initial-velocity-definition
  (varga unit-mantra)
  (phala initial-velocity)
  (janya velocity)
  (krama velocity))

(mantra final-velocity-definition
  (varga unit-mantra)
  (phala final-velocity)
  (janya velocity)
  (krama velocity))

(mantra observer-velocity-definition
  (varga unit-mantra)
  (phala observer-velocity)
  (janya velocity)
  (krama velocity))

(mantra observed-velocity-definition
  (varga unit-mantra)
  (phala observed-velocity)
  (janya velocity)
  (krama velocity))

(mantra normal-force-definition
  (varga unit-mantra)
  (phala normal-force)
  (janya force)
  (krama force))

(mantra height-definition
  (varga unit-mantra)
  (phala height)
  (janya displacement)
  (krama displacement))

(mantra radius-definition
  (varga unit-mantra)
  (phala radius)
  (janya displacement)
  (krama displacement))

(mantra gravity-definition
  (varga unit-mantra)
  (phala gravity)
  (janya acceleration)
  (krama acceleration))

(mantra velocity-definition
  (vishesa linear-motion-varga)
  (varga unit-mantra)
  (swarupa velocity)
  (phala velocity)
  (janya metre second)
  (krama division metre second))

(mantra area-definition
  (varga unit-mantra)
  (swarupa area)
  (phala area)
  (janya metre metre)
  (krama square metre))

(mantra volume-definition
  (varga unit-mantra)
  (swarupa volume)
  (phala volume)
  (janya area metre)
  (krama multiplication area metre))

(mantra moment-of-inertia-definition
  (varga unit-mantra)
  (swarupa moment-of-inertia)
  (phala moment-of-inertia)
  (janya gram area)
  (krama multiplication gram area))

(mantra charge-definition
  (varga unit-mantra)
  (swarupa charge)
  (phala charge)
  (janya ampere second)
  (krama multiplication ampere second))

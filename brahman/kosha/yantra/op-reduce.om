kosha op-reduce

  -- general fold / catamorphism: carry accumulator through every element.
  -- reduce list init (fn acc x -> ...)
  --
  -- requires monoid structure on the accumulator:
  --   closure (result stays in same type)
  --   associativity (grouping doesn't matter)
  --   identity (init is the neutral element)
  -- the init argument IS the identity element of the monoid.

  "op-class-higher-order-kriya"
  "krama-swarupa parampara-abheda"
  "monoid-sthita"
  "fold-abheda scan-accumulate-abheda transducer-abheda"
  "convergence-yukta"
  "associativity-siddha closure-siddha"

shabda name:reduce parse-arity:3 arg0:list arg1:init arg2:fn

done

kosha op-fixpoint

  -- apply fn repeatedly until output equals input (structural equality).
  -- terminates when the graph stabilises — the natural avrti fixpoint condition.
  -- fixpoint x (fn s -> ...) = stable s
  --
  -- requires monotone endomorphism:
  --   endomorphism: f: G → G (same type in and out)
  --   monotone: if G ⊆ G' then f(G) ⊆ f(G') (only adds, never removes)
  -- Knaster-Tarski: monotone f on complete lattice has least fixpoint.
  -- this is WHY avrti-refine terminates: triples only added, never removed.

  "op-class-higher-order-kriya"
  "krama-swarupa parampara-abheda"
  "endomorphism-janya monotone-map-sthita"
  "convergence-phala fixed-point-phala"
  "avrti-abheda"
  "lattice-sthita"

shabda name:fixpoint parse-arity:2 arg0:state arg1:fn

done

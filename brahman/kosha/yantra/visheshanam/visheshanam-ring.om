kosha visheshanam-ring

  -- the ring of edge dimensions.
  -- core 10: declared by the visheshanam-<name> nodes themselves (ring-sthita).
  -- sangati dimensions: claimed here — the ring reaches down to structural truths.
  -- sangati nodes stay pure; the ring declares membership, not the other way around.

  "yantra-sthita domain-yantra-sthita"
  "ring-sthita group-sthita"

  -- core 10 members (already self-declared via ring-sthita on their own nodes)
  "visheshanam-swarupa-yukta visheshanam-abheda-yukta visheshanam-drishthanta-yukta"
  "visheshanam-sthita-yukta visheshanam-yukta-yukta visheshanam-siddha-yukta"
  "visheshanam-kriya-yukta visheshanam-phala-yukta visheshanam-janya-yukta"
  "visheshanam-pratipaksha-yukta"

  -- sangati-level grammar dimensions (ring claims them)
  "sandhi-yukta matra-yukta krama-yukta"
  "kramanusara-yukta avastha-yukta apeksha-yukta"
  -- apeksha: with-respect-to — the denominator of a derivative.
  -- d(displacement)/d(time): displacement is kramanusara, time is apeksha.


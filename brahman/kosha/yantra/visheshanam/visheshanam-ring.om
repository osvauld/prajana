kosha visheshanam-ring

  -- the ring of edge dimensions.
  -- core 10: declared by the visheshanam-<name> nodes themselves (ring-sthita).
  -- sangati dimensions: claimed here — the ring reaches down to structural truths.
  -- sangati nodes stay pure; the ring declares membership, not the other way around.

  "yantra-sthita domain-yantra-sthita"
  "ring-sthita group-sthita"

  -- core 10 members (already self-declared via ring-sthita on their own nodes)
  "visheshanam-swarupa-yukta visheshanam-abheda-yukta visheshanam-drishthanta-yukta"
  "visheshanam-sthita-yukta visheshanam-yukta-yukta visheshanam-siddha-yukta"
  "visheshanam-kriya-yukta visheshanam-phala-yukta visheshanam-janya-yukta"
  "visheshanam-pratipaksha-yukta"

  -- sangati-level grammar dimensions (ring claims them)
  "sandhi-yukta matra-yukta krama-yukta"
  "kramanusara-yukta avastha-yukta apeksha-yukta"
  -- apeksha: with-respect-to — the denominator of a derivative.
  -- d(displacement)/d(time): displacement is kramanusara, time is apeksha.

  -- morphological / argument dimensions (linguistic, Phase 1)
  "ahara-yukta"    -- intake / input — what a verb takes as argument
  "dhatu-yukta"    -- morphological root — word form's root concept (enables walk_inheritance)
  "vrnda-yukta"    -- paradigm family — groups all inflections of a word

  -- grammatical dimensions (Paninian, Phase 1)
  "kala-yukta"     -- tense:   vartamana / purva / bhavishya / vidhi / sambhavana
  "prayoga-yukta"  -- voice:   kartari / karmani / bhave
  "vachana-yukta"  -- number:  eka / dvi / bahu
  "purusa-yukta"   -- person:  prathama / madhyama / uttama

  -- IS-A inheritance dims (Phase 2.5)
  "vishesa-yukta"  -- particular of a universal (samanya) — open-ended, additive
  "amsha-yukta"    -- member of a constituted set — exhaustive, closed partition

  -- grammar signal dimensions (sandhi-viveka layer — S2)
  -- these are the Sanskrit grammar roots that bhasha grammar nodes point to via "-sthita" slokas.
  -- registering them as dimensions means: walk-in "X" "yukta" containing "visheshanam-ring"
  -- is the clean graph-grounded test that X is a grammar signal node.
  "dvitiya-vibhakti-yukta"    -- accusative: direct object
  "trtiya-vibhakti-yukta"     -- instrumental: by means of (prep-by)
  "chaturthi-vibhakti-yukta"  -- dative: for/to (purpose)
  "panchami-vibhakti-yukta"   -- ablative: from/source (prep-from)
  "saptami-vibhakti-yukta"    -- locative: at/in (prep-at)
  "bhuta-kaala-yukta"         -- past tense: was/were
  "vartamana-kaala-yukta"     -- present tense: is/are
  "bhavishya-kaala-yukta"     -- future tense: will

   -- question graph dimensions (prashna layer)
  -- uses Sanskrit grammar roots directly — no q-* aliases.
  -- matra-yukta (unit→matra), krama-yukta (paired-with→krama),
  -- vishesa-yukta (instance-of→vishesa) already registered above.
  "satya-yukta"               -- resolved concept: word looked up successfully in kosha/bhasha
  "mithya-yukta"              -- unresolved word: held provisionally, not yet grounded
  "sankhya-yukta"             -- numeric binding: concept has a known numeric value
  "shashthi-vibhakti-yukta"   -- entity ownership: genitive — concept belongs to entity (antisymmetric, non-transitive)
  "prathama-vibhakti-yukta"   -- entity declaration: nominative — this word names a physical object
  "vidhi-kaala-yukta"         -- query intent: imperative — solve-for / define / verify
  "naama-mudra-yukta"         -- symbolic label: concept referred to by variable name
  "asprista-sankhya-yukta"    -- pending number: unattached numeric value awaiting binding
  "viraam-yukta"              -- punctuation: structural boundary marker
  "dvandva-yukta"             -- dvandva group: co-equal set membership (comma/and)
  "naama-pratibodha-yukta"    -- pronoun reference: cross-group reference to entity (antisymmetric, non-transitive)

shabda dimension-registry / the-ring-of-all-edge-dimensions-core-and-dynamic

done

; resolution strategies: resolve-direct, resolve-inverse, resolve-chain, resolve-reason.
; these are monotone endomorphisms on the question graph:
; each takes a graph and returns an enriched graph (same type, more triples).
; ordered: pipeline stages must compose in sequence.

(kosha op-class-pipeline
  (swarupa yantra krama dvi-ahara)
  (krama phala)
  (abheda endomorphism monotone-map))

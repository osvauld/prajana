kosha laya-varga

  -- cluster for laya (rhythm) concepts: laya, vriddhi-laya, kshaya-laya, thaalam.
  -- laya is time structured into repeating cycles — kaala made musical.
  -- vriddhi (increase) and kshaya (decrease) are the two directions of tempo change.

  "sangeetham-varga-vishesa"
  "subanta-swarupa"

  -- sangati roots
  "kaala-swarupa"   -- laya IS structured kaala: time organised into rhythmic cycles
  "avrti-yukta"     -- thaala cycles repeat — avrti is the defining characteristic
  "spanda-yukta"    -- beat is pulse — spanda made audible and counted
  "krama-yukta"     -- matras in a cycle are ordered (krama) positions in time
  "seema-yukta"     -- thaala is a seema: the boundary that defines one cycle


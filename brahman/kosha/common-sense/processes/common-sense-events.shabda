# common-sense-events: event verbs mapped to kshaya (decrease) or vriddhi (increase)
# format — verb: direction
# readable via: shabda "common-sense-events" "verb"
#
# the pipeline walks: verb → direction → kriya → operation → eval → apply-op
#   kshaya path:  kshaya → walk-in kriya → subtraction → eval → "sub"
#   vriddhi path: vriddhi → walk-in kriya → addition → eval → "add"
#
# departure / loss / consumption (kshaya)
flew: kshaya
away: kshaya
left: kshaya
died: kshaya
lost: kshaya
ate: kshaya
eaten: kshaya
used: kshaya
spent: kshaya
broke: kshaya
broken: kshaya
gone: kshaya
sold: kshaya
dropped: kshaya
gave: kshaya
removed: kshaya
fell: kshaya
disappeared: kshaya
caught: kshaya
went: kshaya
taken: kshaya
stolen: kshaya
sent: kshaya
#
# phrasal verb bigrams (kshaya)
picked-up: kshaya
got-off: kshaya
went-away: kshaya
went-home: kshaya
ran-away: kshaya
taken-away: kshaya
thrown-out: kshaya
given-away: kshaya
carried-off: kshaya
cut-down: kshaya
knocked-down: kshaya
#
# single-word kshaya additions
borrowed: kshaya
damaged: kshaya
destroyed: kshaya
off: kshaya
gives: kshaya
give: kshaya

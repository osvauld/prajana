; ── dhatu (verb roots) ─────────────────────────────────────────────────
; dhatu = verb root. direction is observer-relative (flow between loci).
; sthita carries DEFAULT subject perspective: kshaya if subject typically
; loses, vriddhi if subject typically gains. detect-direction walks sthita
; to find this. Full flow-based entity resolution comes later.
; form nodes have janya back to dhatu + sthita for grammar features.
;
; VARGAS: shared sthita edges inherited via generate_edge_inheritance at boot.
; dhatu nodes use (vishesa <dir>-dhatu-varga) for group + (swarupa tinanta) for type.
; past form nodes use (vishesa <dir>-past-varga) + (swarupa tinanta) + (janya ...).

; ── dhatu varga roots ─────────────────────────────────────────────────

(bhasha kshaya-dhatu-varga
  (swarupa tinanta)
  (sthita dhatu kshaya))

(bhasha vriddhi-dhatu-varga
  (swarupa tinanta)
  (sthita dhatu vriddhi))

(bhasha kartari-dhatu-varga
  (swarupa tinanta)
  (sthita dhatu kartari-prayoga))

(bhasha division-dhatu-varga
  (swarupa tinanta)
  (sthita dhatu division))

; ── past-form varga roots ─────────────────────────────────────────────

(bhasha kshaya-past-varga
  (swarupa tinanta)

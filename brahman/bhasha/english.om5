; ── shesha: remainder after division ─────────────────────────────────
; "remainder", "leftover" → shesha signal for count-chain mod routing

(bhasha remainder
  (sthita english shesha)
  (naama remainder))

(bhasha leftover
  (sthita english shesha)
  (naama leftover))

; ── sequence/series structure signals ──────────────────────────────
; "repeating"/"cycle" → avrti-krama signal (cyclic domain)
; "pattern" → avrti-krama (often co-occurs with repeating)
; "sequence"/"series" → anukrama signal (ordered rule-based)
; "arithmetic" → tulya-anukrama qualifier (constant difference)
; "geometric" → guna-anukrama qualifier (constant ratio)
; math notation: see bhasha/math.om5

(bhasha avrti-word
  (swarupa avrti-krama)
  (sthita english avrti-krama)
  (naama repeating repeats cycle cycles cyclic))

(bhasha niyama-word
  (swarupa avrti-krama)
  (sthita english avrti-krama)
  (naama pattern))

; day-of-week: each day name emits vaara-krama signal.
; siddha = ordinal position in the week (Sunday=0 .. Saturday=6).
; avrti-bandha reads siddha to get base position for mod 7 arithmetic.
(bhasha day-sunday    (swarupa vaara-krama) (siddha 0) (naama Sunday))
(bhasha day-monday    (swarupa vaara-krama) (siddha 1) (naama Monday))
(bhasha day-tuesday   (swarupa vaara-krama) (siddha 2) (naama Tuesday))
(bhasha day-wednesday (swarupa vaara-krama) (siddha 3) (naama Wednesday))
(bhasha day-thursday  (swarupa vaara-krama) (siddha 4) (naama Thursday))
(bhasha day-friday    (swarupa vaara-krama) (siddha 5) (naama Friday))
(bhasha day-saturday  (swarupa vaara-krama) (siddha 6) (naama Saturday))

(bhasha anukrama-word
  (swarupa anukrama)
  (sthita english anukrama)
  (naama sequence series))

(bhasha tulya-visheshana
  (swarupa visheshana)
  (sthita english tulya-anukrama)
  (naama arithmetic))

(bhasha guna-visheshana
  (swarupa visheshana)
  (sthita english guna-anukrama)
  (naama geometric))

; ── sequence relationship signals ──────────────────────────────────
; "starts"/"begins" → prathama-pada signal (marks first term / initial value)
; "after" → sthana signal (marks position / elapsed count)
; "term" → pada signal (refers to a sequence element)
; "common" → samanantara qualifier (e.g. "common difference")
; NOTE: ordinals (first/1st, second/2nd) deferred — too general-purpose,
;   would fire in non-sequence contexts ("the first car").

(bhasha aarambha-word
  (sthita english prathama-pada)
  (naama starts starting begins beginning))

(bhasha anantara-word
  (sthita english sthana)
  (naama after))

(bhasha pada-word
  (sthita english pada anukrama)
  (naama term))

(bhasha samanya-word
  (swarupa visheshana)
  (sthita english samanantara)
  (naama common))

; ── result signals: what to compute ────────────────────────────────
; "maximum" → viveka-max (optimization / vertex of parabola)
; "minimum"/"fewest" → viveka-min
; "solution" → root (polynomial root / equation solution)
; NOTE: "greatest"/"most" already → viveka-max, "root" already → root,
;   "solve" already → vidhi-kaala. Only unmapped words get bhasha nodes.

(bhasha uchcha-word
  (sthita english viveka-max)
  (naama maximum))

(bhasha nichcha-word
  (sthita english viveka-min)
  (naama minimum fewest))

(bhasha mula-word
  (sthita english root)
  (naama solution))

; ═══════════════════════════════════════════════════════════════════
; NUMBER WORDS — sankhya-pada
; ═══════════════════════════════════════════════════════════════════
; Words that ARE numbers. BQG detects swarupa=sankhya-pada, reads
; siddha for the value, emits as asprista-sankhya. "twenty" → 20.
; Kosha atoms live in math-sankhya.om5 (anka-eka, anka-dvi, etc.)
; These bhasha nodes bridge English words to those universal atoms.


# raylib-setu.shabda — Raylib/Lua API concept-to-form mappings
# one key: value per line. blank lines and # lines ignored.

comment: --
comment-end:

# window lifecycle
window-init: rl.InitWindow()
window-close: rl.CloseWindow()

# frame lifecycle
frame-begin: rl.BeginDrawing()
frame-end: rl.EndDrawing()
background: rl.ClearBackground(color)

# drawing
draw-node: rl.DrawCircleV(pos,r,color)
draw-edge: rl.DrawLineV(a,b,color)
draw-label: rl.DrawText(s,x,y,size,color)
draw-pulse: rl.DrawCircleV(pos,r*energy,color)

# input
key-tab: rl.IsKeyPressed(KEY_TAB)
key-enter: rl.IsKeyPressed(KEY_ENTER)
key-back: rl.IsKeyPressed(KEY_BACKSPACE)

# time
dt: rl.GetFrameTime()

# camera
camera-begin: rl.BeginMode2D(cam)
camera-end: rl.EndMode2D()
camera: rl.Camera2D()

# --- 3D canvas API (canvas: table from renderer) ---

# 3D mode lifecycle
begin-3d: canvas:begin_3d(cam_x,cam_y,cam_z,target_x,target_y,target_z,fovy)
end-3d: canvas:end_3d()

# 3D geometry
sphere: canvas:sphere(x,y,z,r,color)
line3d: canvas:line3d(x1,y1,z1,x2,y2,z2,color)

# mesh concepts -> canvas calls
vertex: {x,y,z}
face: {v1,v2,v3}
edge: canvas:line3d(v1.x,v1.y,v1.z,v2.x,v2.y,v2.z,color)
mesh-draw: canvas:sphere(x,y,z,r,color)
normal: {x,y,z}

# 3D camera (passed to begin_3d)
camera-3d: {pos_x,pos_y,pos_z,target_x,target_y,target_z,fovy}
camera-pos: cam_pos
camera-target: cam_target
camera-fovy: 45.0

# world-space position
world-pos: {x,y,z}
transform-apply: pos.x,pos.y,pos.z

# physics layout (force-directed)
force-directed-step: pos=pos+vel*dt
spring-force: k*(len-rest)*dir
repulsion: c/(dist*dist)
velocity-step: vel=vel+force*dt
position-step: pos=pos+vel*dt
convergence: vel=vel*damping

# material / shader -> color
material-color: color
shader-output: canvas:sphere(x,y,z,r,color)
pbr-diffuse: color
texture-sample: color

# node-graph -> proof-graph draw
node-graph-node: canvas:sphere(x,y,z,r,color)
node-graph-edge: canvas:line3d(x1,y1,z1,x2,y2,z2,color)
node-graph-label: canvas:text(x,y,label,size,color)

# armature / bone -> line segments
bone-draw: canvas:line3d(head.x,head.y,head.z,tail.x,tail.y,tail.z,color)

# particle -> sphere
particle-draw: canvas:sphere(x,y,z,r,color)

# 2D overlay (chat panel, HUD)
panel-bg: canvas:rect(x,y,w,h,color)
label: canvas:text(x,y,s,size,color)
chip: canvas:rect(x,y,w,h,color)

# input (3D picking)
mouse-pos: input:mouse_pos()
mouse-clicked: input:mouse_clicked()
key-pressed: input:key_pressed(k)
chars: input:chars()

# relation roles (for compose_from_setu)
render: rl.BeginDrawing()
draw: canvas:sphere()
draw-3d: canvas:begin_3d()
input: input:key_pressed()
window: rl.InitWindow()
update: rl.GetFrameTime()
state-update: s.field=
runtime: update(s,dt)
function: function()end
table: {}
loop: for
iteration: ipairs

bhasha verb-moving

  "english-sthita"
  "kartari-prayoga-sthita"

  -- "moving" (present participle) signals ongoing linear motion.
  -- same treatment as "moves": grammar, dropped by BQG.
  -- example: "a moving body with velocity 10 m/s" →
  --   "moving" dropped, "body" stays mithya, "with" fires R8 correctly.

  shabda word:moving role:grammar

done

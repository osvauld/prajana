bhasha prep-at

  "preposition-swarupa seema-sthita"
  "saptami-vibhakti-sthita"
  -- point/condition: "AT velocity 3m/s", "AT angle 30 degrees", "AT rest"
  -- at IS saptami-vibhakti (locative) expressed as an English preposition
  -- saptami = 7th case: location, condition, point of reference

  shabda word:at  role:grammar


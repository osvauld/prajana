# music-ir-setu.shabda — mappings from graph concepts to music_ir fields
# same relation vocabulary as strudel.shabda but targeting IR field values

# timing
thaalam-bpm: 96
ticks-per-beat: 24

# voice roles per visheshanam — timbre (same concept as strudel sound)
swarupa-timbre: piano
swarupa-octave: 4
swarupa-gain: 0.8
swarupa-pan: 0.0
swarupa-speed: 1.0
swarupa-articulation: legato

abheda-timbre: piano
abheda-octave: 4
abheda-gain: 0.7
abheda-pan: 0.0
abheda-speed: 1.0
abheda-articulation: legato

sthita-timbre: bass
sthita-octave: 3
sthita-gain: 0.5
sthita-pan: 0.0
sthita-speed: 0.5
sthita-articulation: sustain

janya-timbre: strings
janya-octave: 3
janya-gain: 0.5
janya-pan: -0.2
janya-speed: 0.5
janya-articulation: legato

yukta-timbre: keys
yukta-octave: 4
yukta-gain: 0.4
yukta-pan: 0.1
yukta-speed: 1.0
yukta-articulation: staccato

phala-timbre: bell
phala-octave: 5
phala-gain: 0.6
phala-pan: 0.3
phala-speed: 2.0
phala-articulation: accent

kriya-timbre: perc
kriya-octave: 4
kriya-gain: 0.3
kriya-pan: 0.0
kriya-speed: 1.5
kriya-articulation: staccato

siddha-timbre: pad
siddha-octave: 4
siddha-gain: 0.4
siddha-pan: -0.1
siddha-speed: 1.0
siddha-articulation: legato

drishthanta-timbre: flute
drishthanta-octave: 5
drishthanta-gain: 0.3
drishthanta-pan: 0.2
drishthanta-speed: 2.0
drishthanta-articulation: ornament

# ornament → articulation mapping
gamaka-articulation: ornament
andolan-articulation: legato
meend-articulation: glide
kan-swara-articulation: grace
nyasa-articulation: sustain

-- build question graph from sentence words.
-- accumulator is [triples, pending-modifier, sign-op, prev-word, prev-nd-str, prev-swarupa]
-- grammar words (pratishedha, vibhakti) set pending instead of emitting self-loops;
-- next concept consumes the pending as its edge type. This makes the graded ring
-- structure explicit: negated concepts get edge "pratishedha", located concepts
-- get edge "adhikarana", etc.
-- sign-op: when a sign-modifier word (e.g. "negative") precedes a number,
-- the sign operation (e.g. "neg") is applied to negate the number value.
-- tantra walks: word → swarupa→sign-modifier → kriya→neg → ganana→"neg" op.
-- prev-word/prev-nd-str/prev-swarupa: previous word state for intra-grade composition.
-- cleared at grade boundaries alongside pending and sign-op.
(tantra build-question-graph (sentence)
  (sent-punct [".", "?", "!", ","])
  (raw-words (split sentence " "))
  (graph (reduce raw-words [[], "", "", "", "", [], 0] (fn acc word ->
    let g          = nth acc 0
    let pending    = nth acc 1
    let sign-op    = nth acc 2
    let prev-word  = nth acc 3
    let prev-nd    = nth acc 4
    let prev-sw    = nth acc 5
    let prev-count = nth acc 6
    let wlen      = string-length word
    let last-ch   = (cond (gt wlen 0) (char-at word (sub wlen 1)) otherwise "")
    let has-punct = member last-ch sent-punct
    let clean     = (cond has-punct (substr word 0 (sub wlen 1)) otherwise word)
    let punct     = (cond has-punct last-ch otherwise "")
    let candidates = (cond (has-text clean) (word-node-candidates clean) otherwise [])
    let nd        = (cond (gt (length candidates) 0) (nth candidates 0) otherwise (cond (has-text clean) (shabda-anveshana clean) otherwise _none))
    let rl        = (cond (exists nd) (shabda nd "role") otherwise "")
    let ly        = (cond (exists nd) (node-layer nd) otherwise "")
    let parts     = split-numeric clean
    let num-str   = nth parts 0
    let uni-str   = nth parts 1
    let nv        = (cond (has-text num-str) num-str otherwise "")
    let un        = (cond (has-text uni-str) (shabda-anveshana uni-str) otherwise "")
    -- sign-modifier: "negative 7" → apply neg(7) = -7
    -- walks: nd.swarupa for sign-modifier, nd.kriya for the operation (neg)
    let is-sign-modifier = (and (exists nd) (member "sign-modifier" (walk (to-string nd) "swarupa")))
    let sign-kriya = (cond is-sign-modifier (to-string (nth (walk (to-string nd) "kriya") 0)) otherwise "")
    -- shatamana: "percent" word — swarupa includes "shatamana"
    let is-shatamana = (and (exists nd) (member "shatamana" (walk (to-string nd) "swarupa")))
    -- apply pending sign-op to number: walk sign-op.ganana → compute op → apply
    let eff-nv = cond (and (has-text nv) (has-text sign-op))
      (to-string (apply-op (to-string (nth (walk sign-op "ganana") 0)) [(to-number nv)]))
      otherwise nv
    let is-dvandva     = has-grammar-sthita nd rl "dvandva"
    let is-locative    = has-grammar-sthita nd rl "saptami-vibhakti"
    let is-ablative    = has-grammar-sthita nd rl "panchami-vibhakti"
    let is-dative      = has-grammar-sthita nd rl "chaturthi-vibhakti"
    let is-instrumental = has-grammar-sthita nd rl "trtiya-vibhakti"
    let is-pratishedha = has-grammar-sthita nd rl "pratishedha"
    let is-niyama      = has-grammar-sthita nd rl "niyama"
    let is-prashna     = has-grammar-sthita nd rl "prashna"
    let is-vibhakti    = or is-locative (or is-ablative (or is-dative is-instrumental))
    let vibhakti-edge  = cond is-locative "adhikarana" is-ablative "apadana" is-dative "sampradana" is-instrumental "karana" otherwise ""
    -- pratishedha uses pending accumulator: sets pending="pratishedha", next content
    -- word emits [word, pratishedha, word] instead of mithya/satya. This makes
    -- negated concepts directly findable via idx-subjects g "pratishedha".
    -- vibhakti keeps self-loop emission: phrasal verbs and article-concept gaps
    -- make pending too fragile for case relations.
    let next-pending = cond is-pratishedha "pratishedha" otherwise ""
    let current-grade = reduce g [] (fn a t -> cond (or (eq (nth t 1) "viraam") (eq (nth t 1) "dvandva")) [] otherwise (append a [t]))
    let entity-reg = triples-by-edge g "satya"
    let bind-ledger = filter g (fn t -> (or (eq (nth t 1) "sankhya") (eq (nth t 1) "matra")))
    let grammar-trail = filter current-grade (fn t -> (or (eq (nth t 1) "adhikarana") (eq (nth t 1) "apadana") (eq (nth t 1) "sampradana") (eq (nth t 1) "karana") (eq (nth t 1) "bhuta-kaala") (eq (nth t 1) "vartamana-kaala") (eq (nth t 1) "pratishedha")))
    let subgraphs = [current-grade, entity-reg, bind-ledger, grammar-trail]
    let nd-str    = (to-string nd)
    let info      = [nd-str, rl, ly, eff-nv, (to-string un), candidates]
    let triples   = cond is-dvandva [[clean, "dvandva", "dvandva"]]
      is-prashna [[clean, "prashna", clean]]
      is-sign-modifier []
      is-shatamana [[clean, "shatamana", clean]]
      is-pratishedha []
      is-niyama [[clean, "niyama", clean]]
      is-vibhakti [[clean, vibhakti-edge, clean]]
      otherwise (emit-triples clean info subgraphs pending)
    -- ── intra-grade composition (Pattern 1: avastha qualifier + concept) ──────
    -- check: prev-word is in curr-node's avastha list AND compound node exists.
    -- use raw prev-word (not prev-nd) because avastha carries surface forms
    -- (e.g. "elastic" not "elasticity"). Only fires when curr emitted satya triples.
    -- all values computed BEFORE any cond to avoid let-in-cond gotcha.
    -- also check surface-word avastha when nd-str differs (e.g. "rest" → initial-rest
    -- but "rest".avastha has "from"/"at", forming "from-rest"/"at-rest" compounds).
    let curr-avastha  = (cond (and (has-text prev-word) (exists nd)) (walk nd-str "avastha") otherwise [])
    let base-avastha  = (cond (and (has-text prev-word) (neq clean nd-str)) (walk clean "avastha") otherwise [])
    let all-avastha   = (append curr-avastha base-avastha)
    let in-nd-avastha = (and (has-text prev-word) (member prev-word (map curr-avastha (fn a -> to-string a))))
    let in-base-avastha = (and (has-text prev-word) (member prev-word (map base-avastha (fn a -> to-string a))))
    let is-avastha-q  = (or in-nd-avastha in-base-avastha)
    -- compound name: use clean (surface) as base when match is from base-avastha
    let compound-base = cond in-nd-avastha nd-str in-base-avastha clean otherwise ""
    let compound-name = (cond (has-text compound-base) (concat prev-word "-" compound-base) otherwise "")
    let compound-nd   = (cond (has-text compound-name) (lookup compound-name) otherwise _none)
    let compound-str  = (cond (exists compound-nd) (to-string compound-nd) otherwise "")
    -- content check: composition fires on satya OR pratishedha triples
    let curr-edge     = (cond (has-items triples) (nth (nth triples 0) 1) otherwise "")
    let curr-is-content = (and (has-items triples) (or (eq curr-edge "satya") (eq curr-edge "pratishedha")))
    let compose-avastha = (and is-avastha-q (exists compound-nd) curr-is-content)
    -- g-prefix: strip previous word's triples from g when composition fires.
    -- prev-count tracks exactly how many triples the previous word added.
    let g-len    = length g
    let g-prefix = cond compose-avastha (map (range (sub g-len prev-count)) (fn i -> nth g i)) otherwise g
    -- composed-triples: compound node + sandhi-rename, preserving edge type (satya or pratishedha)
    let comp-base    = [[compound-str, curr-edge, compound-str], [compound-str, "sandhi-rename", nd-str]]
    let comp-qw      = (append comp-base [[compound-str, "query-word", clean]])
    let composed-triples = cond compose-avastha
      (cond (neq clean nd-str) comp-qw otherwise comp-base)
      otherwise triples
    -- ── intra-grade composition (Pattern 4: visheshana + entity) ──────────────
    -- prev is adjective (swarupa→visheshana), curr is entity/concept:
    -- emit [curr, visheshana, prev-nd] to bind the property to the entity.
    let is-prev-visheshana = (and (has-text prev-nd) (member "visheshana" (map prev-sw (fn s -> to-string s))))
    let compose-subj = cond (has-text nd-str) nd-str otherwise clean
    let visheshana-tri = cond (and is-prev-visheshana (has-items composed-triples))
      [[compose-subj, "visheshana", prev-nd]] otherwise []
    -- ── intra-grade composition (Pattern 5: parimana + entity) ───────────────
    -- prev is quantifier (swarupa→parimana), curr is entity/concept:
    -- emit [curr, parimana, distribution-type] from quantifier's sthita edge.
    let is-prev-parimana = (and (has-text prev-nd) (member "parimana" (map prev-sw (fn s -> to-string s))))
    let dist-type = cond is-prev-parimana (to-string (nth (walk prev-nd "sthita") 0)) otherwise ""
    let parimana-tri = cond (and is-prev-parimana (has-items composed-triples) (has-text dist-type))
      [[compose-subj, "parimana", dist-type]] otherwise []
    let with-word = (append (append g-prefix composed-triples) (append visheshana-tri parimana-tri))
    -- clear pending only when content triples were emitted; grammar words (the, a)
    -- emit [] and must not consume pending. vibhakti self-loops are structural
    -- markers, not content — they must not consume pending either.
    let new-pending = cond is-pratishedha next-pending
      (and (has-text pending) (has-items triples) (not is-vibhakti)) ""
      otherwise pending
    let result = (cond (has-text punct) (append with-word [[punct, "viraam", punct]]) otherwise with-word)
    -- sign-op: set by sign-modifier, cleared when consumed by a number or at grade boundary
    let new-sign-op = cond is-sign-modifier sign-kriya
      (and (has-text sign-op) (has-text nv)) ""
      otherwise sign-op
    -- cache current word swarupa for next iteration's composition check
    let curr-sw    = (cond (exists nd) (walk nd-str "swarupa") otherwise [])
    -- new-count: how many triples the current word added (for stripping on next composition)
    let new-count  = length composed-triples
    -- grade boundary clears pending, sign-op, and prev-info
    let new-prev-word = (cond (has-text punct) "" otherwise clean)
    let new-prev-nd   = (cond (has-text punct) "" otherwise nd-str)
    let new-prev-sw   = (cond (has-text punct) [] otherwise curr-sw)
    let new-prev-count = (cond (has-text punct) 0 otherwise new-count)
    [(result), (cond (has-text punct) "" otherwise new-pending), (cond (has-text punct) "" otherwise new-sign-op), new-prev-word, new-prev-nd, new-prev-sw, new-prev-count])))
  (sandhi-viveka (nth graph 0)))

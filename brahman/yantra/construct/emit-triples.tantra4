-- emit triples for a single word based on its role and context.
-- nd (resolved node) comes pre-resolved from BQG via info — never re-resolve here.
-- pending: grammar modifier set by preceding word (e.g. "pratishedha", "adhikarana").
-- concept words use pending as their edge instead of "satya", then pending is cleared.
(tantra emit-triples (word info subgraphs pending)
  (nd (word-info info "node"))
  (rl (word-info info "role"))
  (ly (word-info info "layer"))
  (nv (word-info info "num-val"))
  (un (word-info info "unit"))
  (cur-grade (nth subgraphs 0))
  (ac (last-concept cur-grade))
  (last-tri (last-of cur-grade))
  (pn (cond (and (has-items last-tri) (eq (triple-edge last-tri) "asprista-sankhya")) (nth last-tri 2) otherwise ""))
  (prev-edge (cond (has-items last-tri) (triple-edge last-tri) otherwise ""))
  (has-num (has-text nv))
  (has-unit (exists un))
  (has-act (exists ac))
  (has-pend (neq pn ""))
  (nd-str (to-string nd))
  (is-concept (and (exists nd)
    (neq rl "grammar") (neq rl "intent") (neq rl "boundary")
    (neq rl "possession") (neq rl "rashi-bandha") (neq ly "mantra")))
  -- is-rashi-label was dead code: old second check (neq (word-resolve word) nd-str)
  -- was always false since both resolve the same word. Kept false to match old behavior.
  (is-rashi-label false)
  (is-direction-word (or (eq nd-str "kshaya") (eq nd-str "vriddhi")
    (and (exists nd) (or
      (member "multiplication" (walk nd-str "sthita"))
      (member "kshaya" (walk nd-str "sthita"))
      (member "vriddhi" (walk nd-str "sthita"))))))
  (is-tinanta (and (exists nd) (member "tinanta" (walk nd-str "swarupa"))))
  (is-verb-form (or is-direction-word is-tinanta (ends-with word "ed") (ends-with word "ing")))
  -- verb-concept: walk janya→dhatu→naama→base→word-node to extract concept from verb form.
  -- e.g. "accelerates" → dhatu-accelerate → "accelerate" → acceleration
  (verb-dhatu (cond is-tinanta (nth (walk nd-str "janya") 0) otherwise ""))
  (verb-base (cond (has-text verb-dhatu) (nth (walk (to-string verb-dhatu) "naama") 0) otherwise ""))
  (verb-concept (cond (has-text verb-base)
    (let vc = word-node (to-string verb-base)
      cond (and (exists vc) (neq (to-string vc) (to-string verb-dhatu))) (to-string vc)
      otherwise "")
    otherwise ""))
  -- is-viveka: graph-driven — node IS viveka or has sthita→viveka
  (is-viveka (and (exists nd) (is-viveka-node nd-str)))
  -- "2 more" = vriddhi, not viveka comparison. Suppress viveka when preceded by number.
  (is-viveka-after-num (and has-pend is-concept is-viveka))
  (after-loc (eq prev-edge "adhikarana"))
  (active-can-claim (and has-act (neq prev-edge "shashthi-vibhakti") (concept-in-grade ac cur-grade)))
  (is-dravya (and (not (exists nd)) has-pend (not is-verb-form) (not after-loc) (not active-can-claim)))
  (is-sambodhana (or (eq nd-str "sambodhana") (eq nd-str "abhisambodhana") (eq nd-str "aamantrana")))
  (is-copula (and (eq rl "grammar") (starts-with nd-str "copula")))
  (candidates (word-info info "candidates"))
  (main-triples (cond (eq rl "intent") [[word, "vidhi-kaala", "solve-for"]]
    is-sambodhana [[word, nd-str, word]]
    is-copula [[word, "copula", word]]
    -- grammar word with pending modifier: emit pending edge so modifier is consumed
    (and (eq rl "grammar") (has-text pending)) [[word, pending, word]]
    (eq rl "grammar") []
    (and has-num has-unit has-act)
      [[(to-string ac), "sankhya", nv], [(to-string ac), "matra", (to-string un)]]
    (and has-num has-unit)
      [["_", "sankhya", nv], ["_", "matra", (to-string un)]]
    has-num [[word, "asprista-sankhya", nv]]
    (and has-pend is-concept has-act (member "matra" (walk nd-str "sthita")))
      [[(to-string ac), "sankhya", pn], [(to-string ac), "matra", nd-str]]
    is-viveka-after-num [[word, "mithya", word]]
    is-rashi-label [[word, "mithya", word]]
    is-verb-form (cond (has-text pending) [[word, pending, word]]
      (has-text verb-concept) [[verb-concept, "satya", verb-concept], [word, "mithya", word]]
      otherwise [[word, "mithya", word]])
    is-concept (let base = cond (has-text pending) [[nd-str, pending, nd-str]]
      otherwise [[nd-str, "satya", nd-str]]
      let has-qw = neq word nd-str
      cond has-qw (append base [[nd-str, "query-word", word]]) otherwise base)
    is-dravya (cond (has-text pending) [[word, pending, word]] otherwise [[word, "satya", word]])
    otherwise (cond (has-text pending) [[word, pending, word]] otherwise [[word, "mithya", word]])))
  -- when multiple candidates, emit candidate edges for downstream disambiguation
  (candidate-triples (cond (gt (length candidates) 1)
    (map candidates (fn c -> [word, "candidate", (to-string c)]))
    otherwise []))
  (append main-triples candidate-triples))

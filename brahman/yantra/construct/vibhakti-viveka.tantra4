-- grammar structure discernment pass.
-- scans mithya triples for slokas with -sthita tokens that are in visheshanam-ring.
-- when found, replaces "mithya" edge with the root concept (e.g. vartamana-kaala).
-- direction priority: if a direction root (kshaya/vriddhi/multiplication/division)
-- is found alongside a tense root (vartamana-kaala/bhuta-kaala), prefer the direction
-- so count-chain can detect the arithmetic signal from present-tense verbs.
(tantra sandhi-viveka (graph)
  (sthita-len (string-length "-sthita"))
  (direction-roots ["kshaya", "vriddhi", "multiplication", "division"])
  (rashi-label-words (reduce graph ["", []] (fn st tri ->
    let last-e = nth st 0
    let acc    = nth st 1
    let c-edge = nth tri 1
    let c-word = nth tri 0
    (cond (and (eq c-edge "mithya") (eq last-e "satya")) [c-edge, (append acc [c-word])] otherwise [c-edge, acc]))))
  (rashi-labels (nth rashi-label-words 1))
  (map graph (fn [word, edge, obj] ->
    let gnode  = (cond (eq edge "mithya") (shabda-anveshana word) otherwise _none)
    let slokas = (cond (exists gnode) (node-slokas (to-string gnode)) otherwise [])
    let toks   = flat-map slokas (fn s -> split s " ")
    -- two-pass: first look for direction roots, then fall back to any ring match
    let dir-root = find-map toks (fn w ->
      cond (ends-with w "-sthita")
        (let candidate = substr w 0 (sub (string-length w) sthita-len)
         cond (member candidate direction-roots) candidate otherwise _none)
      otherwise _none)
    let any-root = find-map toks (fn w ->
      cond (ends-with w "-sthita")
        (let candidate = substr w 0 (sub (string-length w) sthita-len)
         cond (member "visheshanam-ring"
                (map (walk-in candidate "yukta") (fn n -> to-string n)))
           candidate otherwise _none)
      otherwise _none)
    let root = cond (has-text dir-root) dir-root otherwise any-root
    (cond (and (has-text root) (not (and (eq root "matra") (member word rashi-labels)))) [word, root, root] otherwise [word, edge, obj]))))

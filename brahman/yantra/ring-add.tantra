tantra ring-add

  -- additive combination of two nodes' edge sets in the visheshanam ring.
  --
  -- given nodes A and B, returns the union of their outgoing edges
  -- with duplicate (same relation, same target) removed.
  --
  -- this is the additive operation (yukta) in the visheshanam ring:
  --   edges(A) + edges(B) = edges(A) ∪ edges(B)
  --
  -- the ring-op:add property on visheshanam-yukta declares this operation.
  -- shunya (the zero node with no edges) is the additive identity:
  --   edges(A) + edges(shunya) = edges(A)
  --
  -- used for combining knowledge from multiple concept nodes when
  -- a query references more than one seed.

  inputs
    node-a  string
    node-b  string

  let
    edges-a = filter (edges node-a) (fn e -> eq (nth e 0) node-a)
    edges-b = filter (edges node-b) (fn e -> eq (nth e 0) node-b)

    -- normalise edges-b to look like they come from node-a for dedup
    combined-raw = append edges-a edges-b

    -- dedup by (relation, target) pair
    deduped = unique (map combined-raw (fn e -> [nth e 0, nth e 1, nth e 2]))

  return
    deduped  list

done

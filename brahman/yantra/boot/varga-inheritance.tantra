tantra varga-inheritance

  -- derives traversable varga edges from swarupa IS-A edges.
  -- when a node N has swarupa X, and node "X-varga" exists in the graph,
  -- emits [N, varga, X-varga] so that walk-in "X-varga" "varga" returns N.
  --
  -- NOTE: tantra parser splits lines matching "name = ..." as new top-level bindings.
  -- therefore fn bodies must NOT contain bare "let x = ..." lines.
  -- instead: use nested fn calls or inline the expressions.
  --
  -- graph-all-nodes returns VNode items; to-string coerces before concat/emit-edge.
  -- duplicate walk results are harmless: emit-edge is idempotent.
  --
  -- run at boot and on reload-all via reboot.tantra.

  inputs
    _  string

  let

  nodes = graph-all-nodes

  _ = map nodes (fn node ->
    map (walk node "swarupa") (fn parent ->
      cond (exists (lookup (concat (to-string parent) "-varga")))
        (emit-edge (to-string node) "varga" (concat (to-string parent) "-varga"))
      otherwise _none))

  return
    "ok"  any

done

-- kriya-nirmana: generate regular verb forms from dhatu seed nodes at startup.
-- walks all dhatu nodes (sthita: dhatu, swarupa: tinanta), applies English suffix rules,
-- emits past (-ed), present-participle (-ing), and 3rd-person-singular (-s/-es/-ies)
-- forms via emit-node + emit-edge.
-- skips past when: (a) generated spelling already exists, or (b) dhatu has a
-- hand-authored past form (detected via phala walk = janya reverse from .om5).
(tantra kriya-nirmana (_)
  -- all nodes whose sthita includes "dhatu"
  (dhatu-nodes (walk "dhatu" "sthita"))
  (reduce dhatu-nodes 0 (fn count nd ->
    let nd-str = to-string nd
    let is-tinanta = member "tinanta" (map (walk nd-str "swarupa") (fn x -> to-string x))
    cond (not is-tinanta) count
    otherwise
      let base = reduce (walk nd-str "naama") "" (fn found n ->
        cond (has-text found) found otherwise (to-string n))
      cond (not (has-text base)) count
      otherwise
        let blen = string-length base
        let ends-e = ends-with base "e"
        let stem = cond ends-e (substr base 0 (sub blen 1)) otherwise base
        -- direction: kshaya, vriddhi, multiplication, or division from dhatu sthita
        let dir = reduce (walk nd-str "sthita") "" (fn found s ->
          let ss = to-string s
          cond (has-text found) found
          (or (eq ss "kshaya") (eq ss "vriddhi") (eq ss "multiplication") (eq ss "division")) ss
          otherwise found)
        let dir-sthita = cond (has-text dir) (concat dir "-sthita") otherwise ""
        -- past form: base + ed (or base + d if ends in e, or -y → -ied)
        -- skip if dhatu already has a hand-authored past form (phala = janya reverse)
        let has-irregular-past = has-items (walk nd-str "phala")
        let last-base-ch = cond (ge blen 1) (substr base (sub blen 1) 1) otherwise ""
        let prev-base-ch = cond (ge blen 2) (substr base (sub blen 2) 1) otherwise ""
        let is-prev-vowel-past = (or (eq prev-base-ch "a") (eq prev-base-ch "e") (eq prev-base-ch "i") (eq prev-base-ch "o") (eq prev-base-ch "u"))
        let needs-ied = (and (eq last-base-ch "y") (not is-prev-vowel-past))
        let past-word = cond needs-ied (concat (substr base 0 (sub blen 1)) "ied") ends-e (concat base "d") otherwise (concat base "ed")
        let past-lookup = lookup past-word
        let past-exists = (or has-irregular-past (and (exists past-lookup) (member "tinanta" (map (walk past-word "swarupa") (fn x -> to-string x)))))
        let past-slokas = cond (has-text dir-sthita)
          [(concat "tinanta-swarupa " (concat nd-str "-janya") " kta-pratyaya-sthita bhuta-kaala-sthita kartari-prayoga-sthita " dir-sthita)]
          otherwise
          ["tinanta-swarupa " (concat nd-str "-janya") " kta-pratyaya-sthita bhuta-kaala-sthita kartari-prayoga-sthita"]
        let c1 = cond past-exists count otherwise
          let _ = emit-node past-word "bhasha" past-slokas ""
          let _ = emit-edge past-word "naama" past-word
          (add count 1)
        -- present participle: stem + ing (with consonant doubling for CVC stems)
        let slen = string-length stem
        let last-ch = cond (ge slen 1) (substr stem (sub slen 1) 1) otherwise ""
        let prev-ch = cond (ge slen 2) (substr stem (sub slen 2) 1) otherwise ""
        let pprev-ch = cond (ge slen 3) (substr stem (sub slen 3) 1) otherwise ""
        let is-last-vowel = (or (eq last-ch "a") (eq last-ch "e") (eq last-ch "i") (eq last-ch "o") (eq last-ch "u"))
        let is-prev-vowel = (or (eq prev-ch "a") (eq prev-ch "e") (eq prev-ch "i") (eq prev-ch "o") (eq prev-ch "u"))
        let is-pprev-vowel = (or (eq pprev-ch "a") (eq pprev-ch "e") (eq pprev-ch "i") (eq pprev-ch "o") (eq pprev-ch "u"))
        let needs-double = (and (not ends-e) (ge slen 2) (not is-last-vowel) is-prev-vowel (or (lt slen 3) (not is-pprev-vowel)))
        let ing-stem = cond needs-double (concat stem last-ch) otherwise stem
        let ing-word = concat ing-stem "ing"
        -- skip only if a proper verb node (swarupa→tinanta) already exists
        let ing-lookup = lookup ing-word
        let ing-exists = (and (exists ing-lookup) (member "tinanta" (map (walk ing-word "swarupa") (fn x -> to-string x))))
        let ing-slokas = cond (has-text dir-sthita)
          [(concat "tinanta-swarupa " (concat nd-str "-janya") " shatr-pratyaya-sthita vartamana-kaala-sthita kartari-prayoga-sthita " dir-sthita)]
          otherwise
          ["tinanta-swarupa " (concat nd-str "-janya") " shatr-pratyaya-sthita vartamana-kaala-sthita kartari-prayoga-sthita"]
        let c2 = cond ing-exists c1 otherwise
          let _ = emit-node ing-word "bhasha" ing-slokas ""
          let _ = emit-edge ing-word "naama" ing-word
          (add c1 1)
        -- 3rd person singular present: base + s/es/ies
        -- rules: -s/-sh/-ch/-x/-z/-o → +es; consonant+y → -y+ies; else → +s
        let last-base = cond (ge blen 1) (substr base (sub blen 1) 1) otherwise ""
        let prev-base = cond (ge blen 2) (substr base (sub blen 2) 1) otherwise ""
        let last2 = cond (ge blen 2) (substr base (sub blen 2) 2) otherwise ""
        let is-prev-base-vowel = (or (eq prev-base "a") (eq prev-base "e") (eq prev-base "i") (eq prev-base "o") (eq prev-base "u"))
        let needs-es = (or (eq last-base "s") (eq last-base "x") (eq last-base "z") (eq last-base "o") (eq last2 "sh") (eq last2 "ch"))
        let needs-ies = (and (eq last-base "y") (not is-prev-base-vowel))
        let s-word = cond needs-ies (concat (substr base 0 (sub blen 1)) "ies")
          needs-es (concat base "es")
          otherwise (concat base "s")
        -- skip only if a proper verb node (swarupa→tinanta) already exists;
        -- bare naama targets from legacy shabda are not real verb forms
        let s-lookup = lookup s-word
        let s-exists = (and (exists s-lookup) (member "tinanta" (map (walk s-word "swarupa") (fn x -> to-string x))))
        let s-slokas = cond (has-text dir-sthita)
          [(concat "tinanta-swarupa " (concat nd-str "-janya") " prathama-purusa-sthita vartamana-kaala-sthita eka-vachana-sthita kartari-prayoga-sthita " dir-sthita)]
          otherwise
          ["tinanta-swarupa " (concat nd-str "-janya") " prathama-purusa-sthita vartamana-kaala-sthita eka-vachana-sthita kartari-prayoga-sthita"]
        let c3 = cond s-exists c2 otherwise
          let _ = emit-node s-word "bhasha" s-slokas ""
          let _ = emit-edge s-word "naama" s-word
          (add c2 1)
        c3)))

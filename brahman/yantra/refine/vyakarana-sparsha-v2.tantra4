-- vyakarana-sparsha-v2: session-indexed version.
-- Uses session overlay for subject lookup instead of O(n²) nested reduce.
-- Falls back to v1 logic for the reduce body.
(tantra vyakarana-sparsha-v2 (graph)
  (new-triples (reduce graph [] (fn acc tri ->
    let word = to-string (nth tri 0)
    let edge = to-string (nth tri 1)
    let is-copula = eq edge "copula"
    let is-possession = and (eq edge "mithya") (eq (to-string (shabda (shabda-anveshana word) "role")) "possession")
    let form-node = cond is-copula (shabda-anveshana word)
      is-possession (shabda-anveshana word)
      otherwise ""
    -- O(1) subject lookup via session instead of O(n) reduce
    let subj = reduce (map (session-by-edge "satya") (fn p -> nth p 0)) "" (fn found nd ->
      cond (eq nd word) found
      otherwise nd)
    let kaala-edges = cond (has-text form-node) (walk form-node "sthita") otherwise []
    let kaala = reduce kaala-edges "" (fn found e ->
      cond (has-text found) found
      (member (to-string e) ["vartamana-kaala", "bhuta-kaala", "bhavishya-kaala", "vidhi-kaala", "sambhavana-kaala"])
        (to-string e)
      otherwise found)
    let vachana = reduce kaala-edges "" (fn found e ->
      cond (has-text found) found
      (member (to-string e) ["eka-vachana", "bahu-vachana", "dvi-vachana"])
        (to-string e)
      otherwise found)
    let new = cond (and (has-text subj) (has-text kaala) (has-text vachana))
      [[subj, "kaala", kaala], [subj, "vachana", vachana]]
      (and (has-text subj) (has-text kaala))
        [[subj, "kaala", kaala]]
      (and (has-text subj) (has-text vachana))
        [[subj, "vachana", vachana]]
      otherwise []
    (append acc new))))
  (append-triples graph new-triples))

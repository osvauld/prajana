-- avrti-refine-v2: indexed graph refinement.
-- Two-phase: v1 steps (idempotent, run once) then binding fixpoint.
-- v2 hot steps (sankhya-bandha, shunya-bandha) use idx-* O(1) lookups.
-- Returns VGraph (indexed) for downstream.
(tantra avrti-refine-v2 (g)
  (graph (cond (exists g) g otherwise []))
  -- phase 1: idempotent v1 steps (run once, ~10ms)
  (has-mithya (idx-has-edge g "mithya"))
  (after-sandhi-kosha (sandhi-kosha graph))
  (after-sandhi-avastha (cond has-mithya (sandhi-avastha after-sandhi-kosha) otherwise after-sandhi-kosha))
  (after-sandhi-bandhana (sandhi-bandhana after-sandhi-avastha))
  (after-vyakarana (vyakarana-sparsha after-sandhi-bandhana))
  (after-possession (shashthi-possession after-vyakarana))
  (after-vibhakti (vibhakti-shashthi after-possession))
  (after-vishesa-inst (vishesa-instance after-vibhakti))
  (after-rashi-viveka (rashi-viveka after-vishesa-inst))
  (after-vishesa-bind (vishesa-bandhana after-rashi-viveka))
  (after-rashi-anuvada (rashi-anuvada after-vishesa-bind))
  -- phase 2: binding fixpoint (only sankhya + swarupa + shunya)
  (indexed (index-graph after-rashi-anuvada))
  (fixpoint indexed (fn ig ->
    let after-sankhya = sankhya-bandha-v2 ig
    let after-swarupa = swarupa-anuvada after-sankhya
    let indexed2 = index-graph after-swarupa
    shunya-bandha-v2 indexed2)))

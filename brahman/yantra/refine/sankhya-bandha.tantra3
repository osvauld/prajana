tantra3 sankhya-bandha

takes graph

already-bound = nth (bound-state graph) 0

result = scan graph [last-active: str = "", pending-num: str = ""]:

  [word, viraam, _] ->
    last-active = ""
    pending-num = ""
    emit

  [word, dvandva, _] ->
    last-active = ""
    pending-num = ""
    emit

  [word, satya, _]
    when (has-text pending-num)
    when (not (member (to-string word) already-bound))
    ->
      emit
      emit [(to-string word), "sankhya", pending-num]
      last-active = (to-string word)
      pending-num = ""

  [word, satya, _] ->
    last-active = (to-string word)
    pending-num = ""
    emit

  [word, asprista-sankhya, obj]
    when (has-text last-active)
    when (not (member last-active already-bound))
    ->
      emit
      emit [last-active, "sankhya", obj]
      pending-num = ""

  [word, asprista-sankhya, obj] ->
    pending-num = (to-string obj)
    emit

  _ -> emit

return result

done

tantra3 sandhi-bandhana

-- binding reattribution after compound synthesis.
-- reads [compound, sandhi-rename, base] markers left by sandhi-kosha/sandhi-avastha.
-- rewrites [base, sankhya/matra, X] → [compound, sankhya/matra, X].
-- removes sandhi-rename triples from the output.

takes graph

renames = graph | where [compound, e, base] | and (eq e "sandhi-rename") | collect [base, compound]

has-renames = gt (length renames) 0

-- early exit: no renames means no sandhi compounds — return graph unchanged
-- when has-renames is false, scan-result is never used (scan is a no-op pass)
passthrough = (cond has-renames graph otherwise graph)

result = scan passthrough [cur-base: str = "", cur-compound: str = "", active: bool = has-renames]:

  [_, sandhi-rename, _] ->
    -- consume marker silently

  [word, satya, _]
    when active
    ->
      let matches = renames | where [b, c] | and (eq (to-string c) (to-string word)) | collect [b, c]
      cur-base     = (cond (gt (length matches) 0) (to-string (nth (nth matches 0) 0)) otherwise cur-base)
      cur-compound = (cond (gt (length matches) 0) (to-string (nth (nth matches 0) 1)) otherwise cur-compound)
      emit

  [word, satya, _] -> emit

  [word, sankhya, _]
    when (eq (to-string word) cur-base)
    when (neq cur-base "")
    ->
      emit [cur-compound, "sankhya", obj]

  [word, matra, _]
    when (eq (to-string word) cur-base)
    when (neq cur-base "")
    ->
      emit [cur-compound, "matra", obj]

  _ -> emit

return result

done

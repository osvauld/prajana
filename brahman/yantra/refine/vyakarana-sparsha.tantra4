-- vyakarana-sparsha: extract grammatical signals from word forms.
-- reads copula and verb form nodes, emits tense (kaala) and number (vachana)
-- edges onto the subject — preceding in statements, following in questions.
-- state: [result, subj, pending-kaala, pending-vachana]
-- when copula precedes subject (question word order), kaala/vachana are deferred
-- and flushed onto the next satya concept.
(tantra vyakarana-sparsha (graph)
  (state (reduce graph [[], "", "", ""] (fn st tri ->
    let result = nth st 0
    let subj   = nth st 1
    let pend-k = nth st 2
    let pend-v = nth st 3
    let word = str tri 0
    let edge = str tri 1
    -- flush pending kaala/vachana onto first satya concept after a subjectless copula
    let is-concept = or (eq edge "satya") (eq edge "mithya")
    let flush = cond (and is-concept (or (has-text pend-k) (has-text pend-v)))
      (cond (and (has-text pend-k) (has-text pend-v))
        [[word, "kaala", pend-k], [word, "vachana", pend-v]]
        (has-text pend-k) [[word, "kaala", pend-k]]
        otherwise [[word, "vachana", pend-v]])
      otherwise []
    let result = cond (has-items flush) (append result flush) otherwise result
    let pend-k = cond (has-items flush) "" otherwise pend-k
    let pend-v = cond (has-items flush) "" otherwise pend-v
    -- track last subject: any satya or mithya word
    let new-subj = cond is-concept word otherwise subj
    -- only process copula and possession verbs
    let is-copula = eq edge "copula"
    let resolved = cond (or is-copula (eq edge "mithya")) (shabda-anveshana word) otherwise _none
    let is-possession = and (not is-copula) (eq edge "mithya") (eq (to-string (shabda resolved "role")) "possession")
    let form-node = cond is-copula resolved is-possession resolved otherwise ""
    -- extract kaala and vachana from form node's sthita edges
    let kaala-edges = cond (has-text form-node) (walk form-node "sthita") otherwise []
    let kaala = reduce kaala-edges "" (fn found e ->
      cond (has-text found) found
      (member e ["vartamana-kaala", "bhuta-kaala", "bhavishya-kaala", "vidhi-kaala", "sambhavana-kaala"])
        (to-string e)
      otherwise found)
    let vachana = reduce kaala-edges "" (fn found e ->
      cond (has-text found) found
      (member e ["eka-vachana", "bahu-vachana", "dvi-vachana"])
        (to-string e)
      otherwise found)
    -- if subject available, emit immediately; otherwise defer to pending
    let new = cond (and (has-text new-subj) (has-text kaala) (has-text vachana))
      [[new-subj, "kaala", kaala], [new-subj, "vachana", vachana]]
      (and (has-text new-subj) (has-text kaala))
        [[new-subj, "kaala", kaala]]
      (and (has-text new-subj) (has-text vachana))
        [[new-subj, "vachana", vachana]]
      otherwise []
    let new-pend-k = cond (and (has-text kaala) (not (has-text new-subj))) kaala otherwise pend-k
    let new-pend-v = cond (and (has-text vachana) (not (has-text new-subj))) vachana otherwise pend-v
    [(append result new), new-subj, new-pend-k, new-pend-v])))
  (append-triples graph (nth state 0)))

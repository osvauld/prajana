-- arithmetic count-chain: fold over grades to compute count results.
-- pure grade-fold: each grade contributes a number, direction determines op.
-- activates when numbers exist in non-question grades AND question concept has no formula.
(tantra count-chain (graph grades)
  (q-concept (question-concept grades))
  (q-words (question-words grades))
  (q-direction (detect-direction q-words))
  -- shesha detection: meaning emerges from combination.
  -- "remainder"/"leftover" carry sthita→shesha directly.
  -- "left" alone = direction/kshaya, but "left" + division context = remainder.
  -- tantras walk the graph, not hardcode logic.
  (q-has-shesha-word (exists (find-first q-words (fn w ->
    let wn = word-node w
    cond (exists wn) (member "shesha" (map (walk (to-string wn) "sthita") (fn s -> to-string s)))
    otherwise false))))
  (q-has-left (member "left" q-words))
  -- concept-filter: when multiple distinct countable concepts exist (e.g. "apples"
  -- and "oranges" each with their own numbers), filter grades to only the query concept.
  -- skip filtering when: no q-concept, multiplication present (cross-concept),
  -- or only one numbered concept (e.g. "Tom" as recipient has no competing count).
  (any-mul-or-div (exists (find-first grades (fn grade ->
    let gd = grade-direction grade
    or (eq gd "multiplication") (eq gd "division")))))
  (has-dvandva (exists (find-first grades (fn grade ->
    has-items (triples-by-edge grade "dvandva")))))
  (concept-filtered (cond (or any-mul-or-div (not (has-text q-concept)) (not has-dvandva)) grades
    otherwise (filter grades (fn grade ->
      let gc = grade-concept grade
      or (not (has-text gc)) (eq gc q-concept) (is-question-grade grade)))))
  (has-matching-nums (exists (find-first concept-filtered (fn grade ->
    has-items (grade-numbers grade)))))
  (eff-grades (cond has-matching-nums concept-filtered otherwise grades))
  (fold-seed-raw (walk "graded-ring" "sankhya"))
  (fold-seed (cond (has-items fold-seed-raw) (to-number (to-string (nth fold-seed-raw 0))) otherwise 0))
  (arith-state (reduce eff-grades [fold-seed, [], false, ""] (fn state grade ->
    let acc   = fold-field state "value"
    let steps = fold-field state "steps"
    let init  = fold-field state "started"
    let carry = fold-field state "carry-dir"
    let is-q  = is-question-grade grade
    let nums  = grade-numbers grade
    let has-num = has-items nums
    let dir   = grade-direction grade
    let eff-dir = cond (has-text dir) dir
      (has-text carry) carry
      (has-text q-direction) q-direction
      otherwise "vriddhi"
    let n0 = cond has-num (to-number (nth nums 0)) otherwise 0
    let n1-raw = cond (gt (length nums) 1) (nth nums 1) otherwise "1"
    let is-mul-grade = (and (eq eff-dir "multiplication") (gt (length nums) 1))
    let is-div-grade = (and (eq eff-dir "division") (gt (length nums) 1))
    let is-shesha-grade = (and is-div-grade (or q-has-shesha-word q-has-left))
    let nv = cond is-mul-grade (apply-op "mul" [n0, (to-number n1-raw)]) is-shesha-grade (apply-op "mod" [n0, (to-number n1-raw)]) is-div-grade (apply-op "div" [n0, (to-number n1-raw)]) otherwise n0
    -- shatamana: "percent" scales the number as a fraction of the accumulator
    let has-shatamana = has-items (triples-by-edge grade "shatamana")
    let eff-nv = cond (and has-shatamana init) (apply-op "div" [(apply-op "mul" [acc, nv]), 100]) otherwise nv
    -- shesha: division + ("left" or shesha word) → mod instead of div
    let is-shesha = and (eq eff-dir "division") (or q-has-shesha-word q-has-left)
    let op-eval = cond (eq eff-dir "kshaya") (walk-one "subtraction" "ganana") (eq eff-dir "multiplication") (walk-one "multiplication" "ganana") is-shesha (walk-one "mod" "ganana") (eq eff-dir "division") (walk-one "division" "ganana") otherwise (walk-one "addition" "ganana")
    let new-acc = apply-op (to-string op-eval) [acc, eff-nv]
    let step = (concat eff-dir " " eff-nv ": " (to-string acc) " -> " (to-string new-acc))
    -- carry: when seeding, pass direction forward for the next grade
    let next-carry = cond (and (not init) (has-text dir)) dir otherwise ""
    cond (or is-q (not has-num)) state
    (not init) [nv, steps, true, next-carry]
    otherwise [new-acc, (append steps [step]), true, ""])))
  (count-raw (fold-field arith-state "value"))
  (count-steps (fold-field arith-state "steps"))
  (found-any (fold-field arith-state "started"))
  -- purna detection: "whole" in question grade → floor the result.
  -- walks swarupa of satya concepts in question grade for "purna".
  (q-grade (find-first grades (fn g -> is-question-grade g)))
  (q-has-purna (cond (exists q-grade)
    (exists (find-first q-grade (fn t ->
      and (eq (nth t 1) "satya")
        (member "purna" (map (walk (nth t 0) "swarupa") (fn s -> to-string s))))))
    otherwise false))
  (count-result (cond (and q-has-purna found-any)
    (apply-op "floor" [count-raw])
    otherwise count-raw))
  (all-satya (user-concepts graph))
  (count-entity (cond (has-text q-concept) q-concept otherwise (nth all-satya 0)))
  (count-container (nth all-satya 1))
  (q-shesha (or q-has-shesha-word q-has-left))
  (resolved-count (cond (and (eq q-direction "division") q-shesha) "count-shesha" (eq q-direction "kshaya") "count-remaining" (eq q-direction "division") "count-per" otherwise "count-total"))
  (base-graph (cond found-any
    (reduce graph [] (fn acc triple ->
      cond (and (eq (triple-subj triple) "count") (eq (triple-edge triple) "satya"))
        (append acc [[resolved-count, "satya", resolved-count]])
      otherwise (append acc [triple])))
    otherwise graph))
  (step-triples (map count-steps (fn s -> ["count", "count-step", s])))
  (proof (cond found-any
    (append
      [[resolved-count, "sankhya", count-result],
       [resolved-count, "derived-by", "count-chain"]]
      (append step-triples
        (append
          (cond (exists count-entity) [["count", "count-entity", count-entity]] otherwise [])
          (cond (exists count-container) [["count", "count-container", count-container]] otherwise []))))
    otherwise []))
  -- guard: skip if viveka concepts present (comparison, not counting)
  (has-viveka (has-items (filter (triples-by-edge graph "satya")
    (fn t -> is-viveka-node (triple-subj t)))))
  -- guard: skip if any satya concept has a formula (physics, not counting)
  -- exception: multiplication via "each" is always a count problem, even with physics concepts
  (any-satya-formula (exists (find-first all-satya (fn c -> has-items (mantra-select c)))))
  (has-mul-or-div any-mul-or-div)
  -- guard: skip if anukrama-bandha, avrti-bandha, or samikarana-bandha already computed a result
  (has-anukrama (has-items (filter graph (fn t -> and (eq (nth t 1) "derived-by") (eq (nth t 2) "anukrama-bandha")))))
  (has-avrti (has-items (filter graph (fn t -> and (eq (nth t 1) "derived-by") (eq (nth t 2) "avrti-bandha")))))
  (has-samikarana (has-items (filter graph (fn t -> and (eq (nth t 1) "derived-by") (eq (nth t 2) "samikarana-bandha")))))
  (has-avrti-ganana (has-items (filter graph (fn t -> and (eq (nth t 1) "derived-by") (eq (nth t 2) "avrti-ganana")))))
  (has-mantra-derive (has-items (filter graph (fn t -> and (eq (nth t 1) "derived-by") (eq (nth t 2) "mantra-derive")))))
  (should-count (and found-any (not has-viveka) (not has-anukrama) (not has-avrti) (not has-samikarana) (not has-avrti-ganana) (not has-mantra-derive)
    (or has-mul-or-div q-has-purna (not any-satya-formula))))
  (cond (not should-count) graph otherwise (append base-graph proof)))

-- shunya-bandha: indexed graph version.
-- 3 pipe-filter scans → 3 O(1) idx lookups. Pure value, no session state.
(tantra shunya-bandha (g)
  (satya-nodes (idx-subjects g "satya"))
  (already-bound (idx-subjects g "sankhya"))
  (has-apadana (idx-has-edge g "apadana"))

  (new-triples (reduce satya-nodes [] (fn acc nd ->
    let sig      = shabda nd "signal"
    let concept  = shabda nd "signal-concept"
    let is-shunya = eq sig "shunya"
    let has-concept = has-text concept
    let avastha-nodes = cond (and is-shunya has-apadana) (walk nd "sthita") otherwise []
    let qualified = reduce avastha-nodes "" (fn found av ->
      cond (has-text found) found
      otherwise (reduce (walk concept "abheda") "" (fn f2 candidate ->
        cond (has-text f2) f2
        (member av (map (walk (to-string candidate) "sthita") (fn x -> to-string x)))
          (to-string candidate)
        otherwise f2)))
    let target-concept = cond (has-text qualified) qualified otherwise concept
    let already  = member target-concept already-bound
    cond (and is-shunya has-concept (not already))
      (append acc [[target-concept, "satya", target-concept], [target-concept, "sankhya", "0."]])
    otherwise acc)))

  (idx-append g new-triples))

-- shunya-bandha: indexed graph version.
-- signal=shunya nodes get [concept, sankhya, 0.] with avastha qualification.
-- from-rest compound encodes apadana semantics → no separate apadana edge needed.
-- pratishedha guard: if a pratishedha triple immediately precedes a satya triple
-- in the same grade, that satya node is negated — skip its zero binding.
(tantra shunya-bandha (g)
  (satya-nodes (idx-subjects g "satya"))
  (already-bound (idx-subjects g "sankhya"))

  -- collect negated satya subjects: walk triples pairwise, when pratishedha
  -- is immediately followed by satya, mark that satya subject as negated.
  -- g used directly as list — VGraph.gi_triples exposed via as_list.
  (negated-satya (reduce (range (sub (length g) 1)) [] (fn acc i ->
    let cur  = nth g i
    let nxt  = nth g (add i 1)
    cond (and (eq (nth cur 1) "pratishedha") (eq (nth nxt 1) "satya"))
      (append acc [(nth nxt 0)])
    otherwise acc)))

  (new-triples (reduce satya-nodes [] (fn acc nd ->
    let sig      = shabda nd "signal"
    let concept  = shabda nd "signal-concept"
    let is-shunya = eq sig "shunya"
    let has-concept = has-text concept
    -- skip zero binding if this node is directly negated
    let is-negated = member (to-string nd) negated-satya
    -- walk sthita of the shunya node to find avastha qualifiers (e.g. "initial")
    -- then match against the concept's avastha edges to find qualified name
    let qualifiers = cond is-shunya (walk nd "sthita") otherwise []
    let avastha-list = cond has-concept (walk concept "avastha") otherwise []
    let matched-av = reduce qualifiers "" (fn found q ->
      cond (has-text found) found
      (member (to-string q) (map avastha-list (fn a -> to-string a)))
        (to-string q)
      otherwise found)
    let target-concept = cond (has-text matched-av) (concat matched-av "-" concept) otherwise concept
    let already  = member target-concept already-bound
    cond (and is-shunya has-concept (not already) (not is-negated))
      (append acc [[target-concept, "satya", target-concept], [target-concept, "sankhya", "0."]])
    otherwise acc)))

  (idx-append g new-triples))

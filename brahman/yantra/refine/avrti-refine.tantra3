tantra3 avrti-refine

-- orchestrating pipeline: one refinement pass over a question graph.
-- calls sub-tantras in sequence; fixpoint runs until stable.
--
-- pipeline:
--   sandhi-kosha      → compound word resolution (mithya+satya → kosha node)
--   sandhi-avastha    → avastha qualification (initial/final/angular/...)
--   sandhi-bandhana   → reattribute sankhya/matra after rename
--   vibhakti-shashthi → entity + ownership from possession signal
--   vishesa-instance  → owned concept + label → typed rashi instance (no value)
--   rashi-viveka      → label + rashi-bandha + value → rashi instance with sankhya
--   vishesa-bandhana  → move bindings from concept to instance
--   rashi-anuvada     → propagate instance sankhya up to concept level (P8b.6 bridge)
--   sankhya-bandha    → bind floating asprista-sankhya to preceding concept

takes graph

-- fast path: if no mithya triples remain, avastha/vishesa passes are no-ops
-- sandhi-kosha still runs (Way 2: satya+satya compound needs no mithya)
has-mithya = gt (length (graph | where [s, e, o] | and (eq e "mithya") | collect s)) 0

after-sandhi-kosha    = sandhi-kosha graph
after-sandhi-avastha  = (cond has-mithya (sandhi-avastha  after-sandhi-kosha) otherwise after-sandhi-kosha)
after-sandhi-bandhana = sandhi-bandhana after-sandhi-avastha
after-vibhakti        = vibhakti-shashthi after-sandhi-bandhana
after-vishesa-inst    = vishesa-instance  after-vibhakti
after-rashi-viveka    = rashi-viveka      after-vishesa-inst
after-vishesa-bind    = vishesa-bandhana  after-rashi-viveka
after-rashi-anuvada   = rashi-anuvada     after-vishesa-bind
result                = sankhya-bandha    after-rashi-anuvada

return result

done

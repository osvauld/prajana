tantra per-relation-score

  -- computes a per-relation connectivity profile for a node against seeds.
  --
  -- instead of collapsing all 10 relation types into one scalar score,
  -- this returns a vector of 10 scores — one per visheshanam axis.
  --
  -- score_r(n, S) = count of edges of type r touching both n and any seed in S
  --
  -- the result is a list of [relation, count, weight, weighted-count] tuples.
  -- this preserves the full 10-dimensional structure of the visheshanam ring
  -- instead of projecting to a scalar.
  --
  -- the weighted-count multiplies by the relation's entropy weight,
  -- so sthita edges (w=0.95) contribute more than yukta edges (w=0.60).

  inputs
    n      string
    seeds  list

  let
    n-edges = edges n
    relations = ["swarupa", "abheda", "sthita", "yukta", "kriya", "phala", "janya", "siddha", "drishthanta", "pratipaksha"]

    profile = map relations (fn rel ->
      let rel-edges = filter n-edges (fn eg -> eq (nth eg 1) rel)
      let touching = filter rel-edges (fn eg ->
        or (member (nth eg 0) seeds) (member (nth eg 2) seeds))
      let count = length touching
      let w = edge-weight rel
      let weighted = mul count w
      in [rel, count, w, weighted])

    total = reduce (map profile (fn p -> nth p 3)) 0.0 (fn acc x -> add acc x)

  return
    profile  list

done

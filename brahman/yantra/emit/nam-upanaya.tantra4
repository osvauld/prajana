-- nam-upanaya: mode-dispatched value display (the "we see" limb).
-- shows the specific values substituted into the rule.
-- returns a list of strings.
(tantra nam-upanaya (proof mode)
  (say-seen (shabda "anuvada-setu" "speech-seen"))

  (cond
    -- derive: show janya concept values → "velocity is 3, mass is 5"
    (eq mode "derive")
    (let derived-concepts = proof | where [s, e, o] | and (eq e "derived-by") | collect (to-string s)
     let bindings = flat-map proof (fn tri ->
       let c = str tri 0
       let e = str tri 1
       cond (and (eq e "sankhya") (not (member c derived-concepts)))
         [(concat (concept-display c) " is " (str tri 2))]
       otherwise [])
     cond (has-items bindings)
       [(concat say-seen " that " (join-with bindings ", "))]
       otherwise [])

    -- viveka: compare entity values → "5 > 3"
    (eq mode "viveka")
    (let say-gt = shabda "anuvada-setu" "speech-greater-than"
     let say-lt = shabda "anuvada-setu" "speech-less-than"
     let cmp = viveka-comparison proof
     let vk-dir = query-edge proof "viveka-direction"
     let vk-winner = cond (has-items cmp) (nth cmp 0) otherwise ""
     let vk-loser = cond (has-items cmp) (nth cmp 1) otherwise ""
     let vk-wval = query-edge-of proof vk-winner "viveka-sankhya"
     let vk-lval = query-edge-of proof vk-loser "viveka-sankhya"
     let is-equal = cond (and (exists vk-wval) (exists vk-lval)) (eq vk-wval (to-string vk-lval)) otherwise false
     let cmp-sym = cond is-equal "=" (eq vk-dir "max") say-gt otherwise say-lt
     cond (and (exists vk-wval) (exists vk-lval))
       [(concat say-seen " that " vk-wval " " cmp-sym " " (to-string vk-lval))]
       otherwise [])

    -- anumana: chain result → "chain reaches wings via IS-A"
    (eq mode "anumana")
    (let query = read-signal proof "anumana-query"
     let assert = read-signal proof "anumana-assert"
     let anumana-mode = read-signal proof "anumana-mode"
     cond (eq anumana-mode "swarupa")
       [(concat say-seen " that chain reaches " assert " via IS-A")]
       otherwise [])

    -- shunya: "velocity is absent due to at-rest"
    (eq mode "shunya")
    (let source = read-signal proof "shunya-source"
     let concept = read-signal proof "shunya-concept"
     cond (exists source)
       [(concat say-seen " that " concept " is absent due to " source)]
       otherwise [])

    -- count, typed: no upanaya needed
    otherwise []))

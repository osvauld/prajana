-- nam-anuvada: graph-driven panchaavayava emission.
-- walks nam's yukta for ordered limbs. each limb's abheda role
-- dispatches to the appropriate generator:
--   given   (pratijna)  → ring-walk non-question grades
--   sought  (hetu)      → mode-aware sought description
--   rule    (udaharana) → mode-dispatched proof-walk
--   apply   (upanaya)   → mode-dispatched proof-walk
--   found   (nigamana)  → mode-aware answer with kaala-copula
-- nam's siddha declares required limbs (pratijna, nigamana).
--
-- refined: the original refined question graph (the ring)
-- proof: the proof graph (ring + derived edges + signals)
-- result-val: the computed answer
-- mode: dispatch mode (derive/viveka/count/anumana/shunya/typed)
(tantra nam-anuvada (refined proof result-val mode)
  (grades (split-grades refined))
  (cop (kaala-copula refined))
  -- speech phrases from graph: walk limb ← swarupa (bhasha node) → naama
  -- naama stores quoted strings ("we have"); strip surrounding quotes via substr.
  -- if raw lookup exists, strip first/last char (quotes). otherwise, use fallback.
  (say-given-raw (find-map (walk-in "pramana-pratijna" "swarupa") (fn n ->
    let names = walk (to-string n) "naama"
    cond (has-items names) (to-string (nth names 0)) otherwise _none)))
  (say-given-quoted (cond (exists say-given-raw) (to-string say-given-raw) otherwise ""))
  (say-given (cond (exists say-given-raw) (substr say-given-quoted 1 (sub (string-length say-given-quoted) 2)) otherwise "we have"))
  (say-sought-raw (find-map (walk-in "pramana-hetu" "swarupa") (fn n ->
    let names = walk (to-string n) "naama"
    cond (has-items names) (to-string (nth names 0)) otherwise _none)))
  (say-sought-quoted (cond (exists say-sought-raw) (to-string say-sought-raw) otherwise ""))
  (say-sought (cond (exists say-sought-raw) (substr say-sought-quoted 1 (sub (string-length say-sought-quoted) 2)) otherwise "we seek"))
  (say-found-raw (find-map (walk-in "pramana-nigamana" "swarupa") (fn n ->
    let names = walk (to-string n) "naama"
    cond (has-items names) (to-string (nth names 0)) otherwise _none)))
  (say-found-quoted (cond (exists say-found-raw) (to-string say-found-raw) otherwise ""))
  (say-found (cond (exists say-found-raw) (substr say-found-quoted 1 (sub (string-length say-found-quoted) 2)) otherwise "we find"))

  -- strip "concept = " prefix from result if present
  (result-parts (split result-val " = "))
  (clean-result (cond (gt (length result-parts) 1)
    (nth result-parts (sub (length result-parts) 1))
    otherwise result-val))

  -- ── identify question grade ──────────────────────────────────────────────
  -- for anumana/shunya: last grade is the question (no vidhi-kaala)
  (has-vidhi (gt (length (triples-by-edge refined "vidhi-kaala")) 0))
  (q-grade-vidhi (find-first grades (fn g -> has-items (triples-by-edge g "vidhi-kaala"))))
  (last-grade (nth grades (sub (length grades) 1)))
  (q-grade (cond has-vidhi q-grade-vidhi otherwise last-grade))

  -- solved-for concept
  (q-concept (cond has-vidhi
    (find-map q-grade (fn [s, e, o] ->
      cond (eq e "satya") s
      otherwise _none))
    otherwise ""))
  -- prefer query-word (original word form from question) over concept-display
  (q-concept-qw (find-map q-grade (fn [s, e, o] ->
    cond (and (eq e "query-word") (eq s q-concept)) o
    otherwise _none)))
  (q-concept-disp (cond (has-text q-concept-qw) q-concept-qw
    (has-text q-concept) (concept-display q-concept) otherwise ""))

  -- mode-specific signals
  (comp-word (cond (eq mode "viveka") (read-signal proof "comp-word") otherwise ""))

  -- unit for result
  (unit-nd (cond (has-text q-concept) (unit-of-concept q-concept) otherwise _none))
  (unit-symbols (cond (exists unit-nd) (walk (to-string unit-nd) "naama-mudra") otherwise []))
  (unit-str (first-of unit-symbols | to-string))

  -- ── 1. PRATIJNA: echo given grades in question's own words ────────────────
  (is-single (and has-vidhi (eq (length grades) 1)))

  -- single-grade: given = words after sought concept
  (single-given-words (cond is-single
    (let st = reduce q-grade [[], false] (fn st tri ->
      let acc = nth st 0
      let past-sought = nth st 1
      let edge = str tri 1
      let subj = str tri 0
      cond (eq edge "vidhi-kaala") st
      (eq edge "copula") st
      (and (not past-sought) (eq edge "satya")) [acc, true]
      (and past-sought (eq edge "mithya") (eq subj "of")) st
      past-sought (let w = expand-triple tri cop
        cond (has-text w) [(append acc [w]), true] otherwise st)
      otherwise st)
     nth st 0)
    otherwise []))
  (single-given (cond (has-items single-given-words)
    (concat say-given " " (words-to-str single-given-words))
    otherwise ""))

  -- multi-grade: expand each non-question grade
  (multi-given-strs (cond is-single []
    otherwise (reduce grades [] (fn acc g ->
      let is-q = cond has-vidhi (has-items (triples-by-edge g "vidhi-kaala"))
        otherwise (eq (length acc) (sub (length grades) 1))
      cond is-q acc
      otherwise (let words = expand-grade g cop
        let raw = words-to-str words
        cond (has-text raw) (append acc [(concat say-given " " raw)])
        otherwise acc)))))

  (pratijna-strs (cond is-single
    (cond (has-text single-given) [single-given] otherwise [])
    otherwise multi-given-strs))

  -- ── 2. HETU: mode-aware "what we seek" ───────────────────────────────────
  (hetu (cond
    (eq mode "viveka") (cond (has-text comp-word)
      (concat say-sought " which " cop " " comp-word)
      otherwise "")
    (or (eq mode "anumana") (eq mode "shunya")) ""
    (eq mode "count") ""
    (eq mode "typed") ""
    (has-text q-concept-disp) (concat say-sought " " q-concept-disp)
    otherwise ""))

  -- ── 3. UDAHARANA: mode-dispatched rule citation ──────────────────────────
  (udaharana-strs (nam-udaharana proof mode))

  -- ── 4. UPANAYA: mode-dispatched value display ────────────────────────────
  (upanaya-strs (nam-upanaya proof mode))

  -- ── 5. NIGAMANA: mode-aware answer ───────────────────────────────────────
  (nigamana (cond
    -- derive: "we find that [concept] [copula] [value] [unit]"
    (eq mode "derive")
    (concat say-found " that " (words-to-str (filter [q-concept-disp, cop, clean-result, unit-str] (fn s -> has-text s))))

    -- viveka: "we find that [winner] [copula] [comp-word]" or "equal"
    (eq mode "viveka")
    (let cmp = viveka-comparison proof
     let is-equal = cond (gt (length cmp) 2) (eq (nth cmp 2) "equal") otherwise false
     let vs-entities = proof | where [s, e, o] | and (eq e "viveka-sankhya") | collect (to-string s)
     cond is-equal
       (concat say-found " that " (list-join vs-entities) " are equal")
       otherwise (concat say-found " that " clean-result " " cop " " comp-word))

    -- count: "we find [value] [question-grade-words]" (skip system concept "count")
    (eq mode "count")
    (let q-words = flat-map q-grade (fn [s, e, o] ->
       cond (eq e "vidhi-kaala") []
       (and (eq e "satya") (eq s "count")) []
       otherwise (let w = expand-triple [s, e, o] cop
         cond (has-text w) [w] otherwise []))
     concat say-found " " clean-result " " (words-to-str q-words))

    -- anumana/shunya: "yes/no, [declarative answer]"
    (or (eq mode "anumana") (eq mode "shunya"))
    (nam-nigamana-bool q-grade clean-result cop)

    -- typed: "[op] = [value]"
    (eq mode "typed")
    (concat say-found " " clean-result)

    -- fallback
    otherwise (concat say-found " that " clean-result)))

  -- ── siddha certification: nam declares required limbs ──────────────────
  -- walk nam's siddha for pramana-* limbs. if "found" role is required,
  -- clean-result must be non-empty — proof needs a conclusion.
  (nam-siddha-limbs (filter (map (walk "nam" "siddha") (fn n -> to-string n))
    (fn s -> starts-with s "pramana-")))
  (found-required (exists (find-first nam-siddha-limbs (fn limb ->
    member "found" (map (walk limb "abheda") (fn a -> to-string a))))))
  (is-certified (cond found-required
    (and (has-text clean-result) (neq clean-result "no match"))
    otherwise true))

  -- ── weave all limbs via nam's graph structure ──────────────────────────
  -- walk nam's yukta for ordered limbs, filter to pramana-* concepts.
  -- each limb's abheda declares its role: given/sought/rule/apply/found.
  -- dispatch to the appropriate output generator per role.
  (nam-limbs (filter (map (walk "nam" "yukta") (fn n -> to-string n))
    (fn s -> starts-with s "pramana-")))
  (all-strs (flat-map nam-limbs (fn limb ->
    let roles = map (walk limb "abheda") (fn a -> to-string a)
    let output = cond (member "given" roles) pratijna-strs
      (member "sought" roles) (cond (has-text hetu) [hetu] otherwise [])
      (member "rule" roles) udaharana-strs
      (member "apply" roles) upanaya-strs
      (member "found" roles) (cond (has-text nigamana) [nigamana] otherwise [])
      otherwise []
    filter (map output (fn s -> capitalize-first s)) (fn s -> has-text s))))

  (cond is-certified (join-with all-strs ". ")
    otherwise "no match"))

-- pramana-bandha: binding of proof — assembles proof graph with reasoning edges.
(tantra pramana-bandha (base-graph final-m result sf scope-entity is-viveka viveka-ev-pairs viveka-gt-triples comp-word)
  (viveka-sankhya-triples (cond is-viveka
    (map viveka-ev-pairs (fn kv -> [(nth kv 0), "viveka-sankhya", (nth kv 1)]))
    otherwise []))
  (result-mantra (cond (has-items final-m) (nth final-m 0) otherwise ""))
  (result-valpairs (cond (has-items final-m) (nth final-m 1) otherwise []))
  (scoped-sankhya-triples (cond (and (not is-viveka) (has-items result-valpairs))
    (map result-valpairs (fn kv -> [(nth kv 0), "derived-sankhya", (nth kv 1)]))
    otherwise []))
  (result-triples (cond (and (not is-viveka)
                             (exists result)
                             (neq (to-string result) "no match")
                             (exists sf))
    (append
      [[(to-string sf), "sankhya", result],
       [(to-string sf), "derived-by", result-mantra]]
      scoped-sankhya-triples)
    otherwise []))
  (proof-graph (cond is-viveka
    (append (append base-graph viveka-gt-triples) viveka-sankhya-triples)
    otherwise (append base-graph result-triples)))
  (sought-cw (cond is-viveka (to-string comp-word) otherwise ""))
  (sought-bandha proof-graph sf scope-entity sought-cw))

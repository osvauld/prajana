-- upanaya strand: "we see that velocity is 3 and mass is 5"
(tantra mantra-seen-str (mm added-concepts)
  (say-seen (shabda "anuvada-setu" "speech-seen"))
  (mantra (nth mm 0))
  (valpairs (nth mm 1))
  (janya (walk mantra "janya"))
  (has-added (has-items added-concepts))
  (phala (nth (walk mantra "phala") 0))
  (is-phala (fn c -> eq (to-string c) (to-string phala)))
  (non-phala-added (filter added-concepts (fn c -> not (is-phala c))))
  (concepts-to-show (cond (and has-added (has-items non-phala-added))
    non-phala-added
    otherwise janya))
  (bindings (reduce concepts-to-show [] (fn acc c ->
    let v = reduce valpairs "" (fn a2 kv ->
      cond (eq (nth kv 0) c)
        (str kv 1)
      otherwise a2)
    cond (has-text v)
      (append acc [(concat (concept-display c) " is " v)])
    otherwise acc)))
  (bind-str (reduce bindings "" (fn acc s ->
    cond (not (has-text acc)) s
    otherwise (concat acc ", " s))))
  (cond (has-text bind-str)
    (cond has-added
      (concat say-seen " that " bind-str)
      otherwise (concat say-seen " that " bind-str))
    otherwise ""))

-- udaharana strand: "we know that kinetic energy arises from velocity and mass"
(tantra mantra-known-str (mm)
  (say-known (shabda "anuvada-setu" "speech-known"))
  (mantra (nth mm 0))
  (janya (walk mantra "janya"))
  (phala (nth (walk mantra "phala") 0))
  (phala-disp (concept-display (to-string (cond (exists phala) phala otherwise mantra))))
  (janya-disp (reduce janya "" (fn acc j ->
    let d = (concept-display (to-string j))
    cond (not (has-text acc)) d
    otherwise (concat acc " and " d))))
  (concat say-known " that " phala-disp " arises from " janya-disp))

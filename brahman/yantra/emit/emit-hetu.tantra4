-- hetu: "we seek the kinetic energy" — the reason for inquiry.
(tantra emit-hetu (graph is-viveka)
  (say-sought (shabda "anuvada-setu" "speech-sought"))
  (say-of (shabda "anuvada-setu" "speech-of"))
  (say-is (shabda "anuvada-setu" "speech-is"))
  (art-the (shabda "article-the" "word"))
  (ctx (sought-context graph))
  (sought-sf (nth ctx 0))
  (sought-label (nth ctx 1))
  (scope-entity (nth ctx 2))
  (sought-disp (concept-display sought-sf))
  (cond is-viveka
    (concat say-sought " which " say-is " " (concept-display sought-label))
    otherwise (cond (has-text sought-sf)
      (cond (has-text scope-entity)
        (concat say-sought " " art-the " " sought-disp " " say-of " " scope-entity)
        otherwise (concat say-sought " " art-the " " sought-disp))
      otherwise "")))

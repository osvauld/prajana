-- viveka udaharana+upanaya: "we know that greater mass means heavier" + "we see that 5 > 3"
(tantra udaharana-viveka (graph)
  (say-known (shabda "anuvada-setu" "speech-known"))
  (say-seen (shabda "anuvada-setu" "speech-seen"))
  (say-gt (shabda "anuvada-setu" "speech-greater-than"))
  (say-lt (shabda "anuvada-setu" "speech-less-than"))
  (cmp (viveka-comparison graph))
  (vc-raw (query-edge graph "viveka-concept"))
  (vc-disp (cond (exists vc-raw) (concept-display (to-string vc-raw)) otherwise ""))
  (vk-direction (query-edge graph "viveka-direction"))
  (vk-winner (cond (has-items cmp) (nth cmp 0) otherwise ""))
  (vk-loser (cond (has-items cmp) (nth cmp 1) otherwise ""))
  (sought-label (query-edge graph "sought"))
  (known-str (cond (has-text vc-disp)
    (cond (eq (to-string vk-direction) "max")
      (concat say-known " that greater " vc-disp " means " (to-string sought-label))
      otherwise (concat say-known " that lesser " vc-disp " means " (to-string sought-label)))
    otherwise ""))
  (vk-wval (query-edge-of graph vk-winner "viveka-sankhya"))
  (vk-lval (query-edge-of graph vk-loser "viveka-sankhya"))
  (cmp-sym (cond (eq (to-string vk-direction) "max") say-gt otherwise say-lt))
  (seen-str (cond (and (exists vk-wval) (exists vk-lval))
    (concat say-seen " that " (to-string vk-wval) " " cmp-sym " " (to-string vk-lval))
    otherwise ""))
  (filter [known-str, seen-str] (fn s -> has-text s)))

-- viveka pratijna: "ball-A with mass 5 and ball-B with mass 3"
(tantra pratijna-viveka (graph)
  (say-and (shabda "conj-and" "word"))
  (prep (shabda "prep-with" "word"))
  (entities (prathama-sparsha graph))
  (vc-raw (query-edge graph "viveka-concept"))
  (vc-disp (cond (exists vc-raw) (concept-display (to-string vc-raw)) otherwise ""))
  (entity-strs (reduce entities [] (fn acc ent ->
    let vs = graph | where [s, e, o]
      | and (eq (to-string s) (to-string ent))
      | and (eq e "viveka-sankhya")
      | collect o
    let owned = shashthi-sparsha graph ent
    let concept-name = cond (has-text vc-disp) vc-disp
      otherwise (cond (has-items owned) (concept-display (to-string (nth owned 0)))
        otherwise "")
    cond (has-items vs)
      (append acc [(concat (to-string ent) " " prep " " concept-name " " (to-string (nth vs 0)))])
    otherwise acc)))
  entity-strs)

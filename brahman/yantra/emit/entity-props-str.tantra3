tantra3 entity-props-str

-- pratijna strand helper: build "entity (concept=val, concept=val)" strings
-- for entities that own properties via shashthi-vibhakti edges.
--
-- takes: graph, list of entity names
-- returns: list of strings like ["ball-A (mass=5.)", "ball-B (mass=3.)"]
--          — only entities that have at least one owned + bound concept
--
-- used by emit-reasoning (we-have strand) for standard entity grouping.
-- viveka uses ev-pairs instead (since heavier/lighter displaces shashthi edges).

takes graph
takes entities

rel-sankhya = shabda "anuvada-setu" "rel-sankhya"

result = reduce entities [] (fn acc entity ->
  let owned = shashthi-sparsha graph entity
  let props = reduce owned [] (fn pacc concept ->
    let val = query-edge-of graph (to-string concept) "sankhya"
    cond (exists val)
      (append pacc [(concat (to-string concept) rel-sankhya (to-string val))])
    otherwise pacc)
  cond (has-items props)
    (let props-str = reduce props "" (fn a p ->
       cond (not (has-text a)) p otherwise (concat a ", " p))
     append acc [(concat (to-string entity) " (" props-str ")")])
  otherwise acc)

return result

done

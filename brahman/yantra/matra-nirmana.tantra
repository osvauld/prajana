tantra matra-nirmana

  -- matra-nirmana: unit generation tantra.
  -- reads matra-beeja shabda entries and emits unit nodes into the graph.
  -- called once at startup after graph load.
  -- each shabda entry has format:
  --   name: concept-yukta... | base-yukta... | symbol,aliases / description

  inputs
    seed  string

  let
    -- read all shabda pairs from the seed node
    pairs = edges seed
    -- filter to outgoing shabda-bearing entries
    -- for now, emit-node is called per unit from the caller side
    -- this tantra is a marker — actual generation happens in OCaml init
    result = seed

  return
    result  string

done

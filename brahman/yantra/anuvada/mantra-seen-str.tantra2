tantra2 mantra-seen-str

-- upanaya strand: "we see: applying janya1=val1, janya2=val2"
-- the rule applied to this specific case — the evidence.
-- reads speech acts from anuvada-setu.shabda.
--
-- takes: a match triple [mantra, val-pairs, mode]
-- returns: string like "we see: applying mass=3., acceleration=4."
--
-- when added-concepts list is non-empty (from derive-chain step),
-- shows only the newly derived values instead of all janya inputs.
-- this makes chained emission show what each step *produced*, not its inputs.

takes mm
takes added-concepts

say-seen    = shabda "anuvada-setu" "speech-seen"
say-applying = shabda "anuvada-setu" "speech-applying"
rel-sankhya = shabda "anuvada-setu" "rel-sankhya"

mantra   = nth mm 0
valpairs = nth mm 1
janya    = walk mantra "janya"

-- note: caller may pass graph-derived-sankhya as valpairs
-- (injected by anuvada-ganana for scoped multi-entity questions)

has-added = gt (length added-concepts) 0

-- upanaya shows the INPUTS (janya) that were applied — not the output.
-- for intermediate chain steps: show the newly derived intermediate values
--   BUT only if they are not the final phala (those belong to nigamana).
-- for single-step or fallback: show janya inputs directly.
phala     = nth (walk mantra "phala") 0
is-phala  = (fn c -> eq (to-string c) (to-string phala))
non-phala-added = filter added-concepts (fn c -> not (is-phala c))

-- show non-phala additions (intermediate values) when present,
-- otherwise show janya (the inputs that were applied)
concepts-to-show = cond (and has-added (gt (length non-phala-added) 0))
  non-phala-added
  otherwise janya

bindings = (reduce concepts-to-show [] (fn acc c ->
  let v = reduce valpairs "" (fn a2 kv ->
    cond (eq (to-string (nth kv 0)) (to-string c))
      (to-string (nth kv 1))
    otherwise a2)
  cond (gt (string-length v) 0)
    (append acc [(concat (to-string c) rel-sankhya v)])
  otherwise acc))

bind-str = (reduce bindings "" (fn acc s ->
  cond (eq (string-length acc) 0) s
  otherwise (concat acc ", " s)))

result = cond (gt (string-length bind-str) 0)
  (cond has-added
    (concat say-seen ": " bind-str)
    otherwise (concat say-seen ": " say-applying " " bind-str))
  otherwise ""

return result

done

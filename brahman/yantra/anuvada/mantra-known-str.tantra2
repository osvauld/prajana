tantra2 mantra-known-str

-- udaharana strand: "we know: mantra-name (janya1, janya2 → phala)"
-- the universal rule that connects given to sought.
-- reads speech acts from anuvada-setu.shabda.
--
-- takes: a match triple [mantra, val-pairs, mode]
-- returns: string like "we know: newton-second-law-motion (mass, acceleration → force)"

takes mm

say-known = shabda "anuvada-setu" "speech-known"
arrow     = shabda "anuvada-setu" "speech-janya-phala-arrow"

mantra    = nth mm 0
janya     = walk mantra "janya"
phala     = nth (walk mantra "phala") 0

janya-str = (reduce janya "" (fn acc j ->
  cond (eq (string-length acc) 0) (to-string j)
  otherwise (concat acc ", " (to-string j))))

phala-str = (cond (exists phala)
  (concat " " arrow " " (to-string phala))
  otherwise "")

inner  = (concat janya-str phala-str)
result = (concat say-known ": " (to-string mantra) " (" inner ")")

return result

done

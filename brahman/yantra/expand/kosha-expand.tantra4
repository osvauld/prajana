-- PPR-based kosha expansion pass.
(tantra kosha-expand (graph)
  (sc (graph | where [s, e, o] | and (eq e "satya") | collect o))
  (seed-pairs (map sc (fn n -> [n, "1.0"])))
  (existing (reduce graph [] (fn acc tri ->
    let s      = nth tri 0
    let o      = nth tri 2
    let with-s = (cond (member s acc) acc otherwise (append acc [s]))
    (cond (member o with-s) with-s otherwise (append with-s [o])))))
  (threshold 0.001)
  (top-k 100)
  (new-triples (cond (eq (length sc) 0) []
    -- parallel: each seed's PPR walk is independent
    otherwise (preduce sc [] (fn acc seed ->
      let results  = ppr seed-pairs seed []
      let filtered = reduce results [] (fn facc pr ->
        let nm    = str pr 0
        let score = to-number (str pr 1)
        (cond (and (gt score threshold) (not (member nm existing)) (lt (length facc) top-k))
          (append facc [[seed, "kosha-janya", nm]])
          otherwise facc))
      (append acc filtered)))))
  (append graph new-triples))

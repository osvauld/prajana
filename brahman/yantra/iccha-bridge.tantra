tantra iccha-bridge

  inputs
    nodes  list

  let
    with-iccha    = unique (filter nodes (fn n -> eq (iccha-status n) "sthita"))
    without-iccha = unique (filter nodes (fn n -> eq (iccha-status n) "rahita"))
    has-both      = and (gt (length with-iccha) 0) (gt (length without-iccha) 0)
    with-str      = join (map with-iccha (fn n -> to-english n)) ", "
    without-str   = join (map without-iccha (fn n -> to-english n)) ", "
    iccha-prefix = cond (neq (shabda "anuvada-setu" "iccha-present-prefix-alt") "")
      (shabda "anuvada-setu" "iccha-present-prefix-alt")
      otherwise "iccha (directed-will) present in:"
    iccha-absent-connector = cond (neq (shabda "anuvada-setu" "iccha-absent-connector-alt") "")
      (shabda "anuvada-setu" "iccha-absent-connector-alt")
      otherwise "; absent in:"
    result        = cond (has-both)
                       (concat "  " iccha-prefix " " with-str
                               iccha-absent-connector " " without-str ".\n")
                       otherwise ""

  return
    result  string

done

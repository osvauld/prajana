tantra mat-mul

  -- n-dimensional matrix multiplication
  -- A (nrows_a x ncols_a) · B (ncols_a x ncols_b) → C (nrows_a x ncols_b)
  -- matrices stored as flat row-major lists of floats
  -- used for homogeneous transform composition in kinematic chains:
  --   T_world = T_base · T_joint1 · T_joint2 · ... · T_tip
  --
  -- inputs: flat list a, its column count, flat list b, its column count

  inputs
    a       list
    ncols-a float
    b       list
    ncols-b float

  let
    result = mat-mul a ncols-a b ncols-b

  return
    result  list

done

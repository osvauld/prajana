tantra quadratic

  inputs
    a  float
    b  float
    c  float

  let
    discriminant = sub (power b 2.0) (mul (mul 4.0 a) c)
    root1 = div (add (neg b) (sqrt discriminant)) (mul 2.0 a)
    root2 = div (sub (neg b) (sqrt discriminant)) (mul 2.0 a)

  return
    root1  float
    root2  float

done

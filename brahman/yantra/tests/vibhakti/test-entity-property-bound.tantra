tantra test-entity-property-bound
  -- "a ball has mass 5 kg" — mass=5kg is correctly bound in BQG
  -- even without entity typing, the property binding survives
  -- verifies CURRENT correct behaviour
  let
    g    = build-question-graph "a ball has mass 5 kg"
    has-val  = reduce g false (fn acc tri ->
                 cond (and (eq (nth tri 0) "mass") (eq (nth tri 1) "sankhya"))
                   true otherwise acc)
    has-unit = reduce g false (fn acc tri ->
                 cond (and (eq (nth tri 0) "mass") (eq (nth tri 1) "matra"))
                   true otherwise acc)
    ok = cond (and has-val has-unit) true otherwise false
  return
    ok  bool
done

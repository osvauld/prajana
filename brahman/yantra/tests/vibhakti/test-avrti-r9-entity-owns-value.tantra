tantra test-avrti-r9-entity-owns-value
  -- R9 + R8 + sankhya/matra survive:
  -- "ball A has mass 5 kg" → ball-A entity, mass owned by ball-A, mass has sankhya 5.
  -- verifies that sankhya and matra triples are not lost when R9+R8 fire
  let
    g = [["ball", "mithya",  "ball"],
         ["A",    "mithya",  "A"],
         ["has",  "mithya",  "has"],
          ["mass", "satya",   "mass"],
         ["mass", "sankhya", "5."],
         ["mass", "matra",   "kilogram"]]
    r      = fixpoint (sandhi-viveka g) avrti-refine
    is-ent = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "ball-A") (eq (nth tri 1) "prathama-vibhakti"))
                 true otherwise acc)
    owns   = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "mass") (eq (nth tri 1) "shashthi-vibhakti"))
                 true otherwise acc)
    has-v  = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "mass") (eq (nth tri 1) "sankhya"))
                 true otherwise acc)
    ok     = and is-ent (and owns has-v)
  return
    ok  bool
done

tantra test-entity-label-plus-qualifier
  -- "ball A" — mithya "ball" followed by mithya "A"
  -- avrti: [ball, mithya] + [A, mithya] + [has, mithya] + [mass, satya]
  -- → ball-A is a compound entity label (tatpurusha: A qualifies ball)
  -- KNOWN FAILURE: entity-label compounding rule not in avrti-refine
  let
    g = [["ball", "mithya", "ball"],
         ["A",    "mithya", "A"],
         ["has",  "mithya", "has"],
          ["mass", "satya",  "mass"],
         ["mass", "sankhya", "5."]]
    r   = fixpoint (sandhi-viveka g) avrti-refine
    has = reduce r false (fn acc tri ->
            cond (eq (nth tri 0) "ball-A") true otherwise acc)
  return
    has  bool
done

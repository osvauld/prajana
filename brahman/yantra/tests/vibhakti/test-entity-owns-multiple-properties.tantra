tantra test-entity-owns-multiple-properties
  -- "ball has mass 5 kg and velocity 10 m/s"
  -- both mass AND velocity should be owned by ball after avrti
  -- [mass, shashthi-vibhakti, ball] AND [velocity, shashthi-vibhakti, ball]
  -- KNOWN FAILURE: ownership propagation to subsequent satya concepts not implemented
  let
    g = [["ball",     "mithya",  "ball"],
         ["has",      "mithya",  "has"],
          ["mass",     "satya",   "mass"],
         ["mass",     "sankhya", "5."],
         ["mass",     "matra",   "kilogram"],
         ["and",      "mithya",  "and"],
          ["velocity", "satya",   "velocity"],
         ["velocity", "sankhya", "10."],
         ["velocity", "matra",   "metre-per-second"]]
    r        = fixpoint (sandhi-viveka g) avrti-refine
    mass-own = reduce r false (fn acc tri ->
                 cond (and (eq (nth tri 0) "mass") (eq (nth tri 1) "shashthi-vibhakti"))
                   true otherwise acc)
    vel-own  = reduce r false (fn acc tri ->
                 cond (and (eq (nth tri 0) "velocity") (eq (nth tri 1) "shashthi-vibhakti"))
                   true otherwise acc)
    ok = cond (and mass-own vel-own) true otherwise false
  return
    ok  bool
done

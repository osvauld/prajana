tantra test-avrti-r9-entity-owns
  -- R9 + R8: two consecutive mithya before possession signal → compound entity label
  -- [ball,mithya]+[A,mithya]+[has,mithya]+[mass,satya]
  -- → [ball-A, prathama-vibhakti, object] AND [mass, shashthi-vibhakti, ball-A]
  -- R9: ball+A compound formed because last-label is set and A is not a possession signal
  -- R8: "has" fires on last-label="ball-A" → entity declared, ownership set
  let
    g = [["ball", "mithya", "ball"],
         ["A",    "mithya", "A"],
         ["has",  "mithya", "has"],
         ["mass", "satya", "mass"]]
    r      = fixpoint (sandhi-viveka g) avrti-refine
    is-ent = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "ball-A") (eq (nth tri 1) "prathama-vibhakti"))
                 true otherwise acc)
    owns   = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "mass") (eq (nth tri 1) "shashthi-vibhakti"))
                 true otherwise acc)
    ok     = and is-ent owns
  return
    ok  bool
done

tantra test-entity-has-symbolic-value
  -- "ball has velocity v1"
  -- after entity capture, v1 is a mithya label immediately following an owned concept
  -- avrti should create [v1, vishesa, velocity] — v1 IS a velocity (typed instance)
  -- this covers reasoning/multi-entity problems where values are symbolic, not numeric
  let
    g = [["ball",     "mithya",  "ball"],
         ["has",      "mithya",  "has"],
          ["velocity", "satya",   "velocity"],
         ["v1",       "mithya",  "v1"]]
    r   = fixpoint (sandhi-viveka g) avrti-refine
    has = reduce r false (fn acc tri ->
            cond (and (eq (nth tri 0) "v1") (eq (nth tri 1) "vishesa"))
              true otherwise acc)
  return
    has  bool
done

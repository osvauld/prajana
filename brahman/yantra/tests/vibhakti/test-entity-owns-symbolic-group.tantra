tantra test-entity-owns-symbolic-group
  -- "ball A has velocities v1 and v2"
  -- naama-mudra labels v1, v2 form a dvandva group under velocity
  -- AND the group should be owned by ball-A
  -- this is the combined entity + naama-mudra dvandva case (reasoning / multi-body problems)
  -- requires: R8 (entity from has) + R6 (mithya group) + ownership propagation to group
  -- KNOWN FAILURE: naama-mudra dvandva + ownership not implemented
  let
    g = [["ball-A",   "mithya",   "ball-A"],
         ["has",      "mithya",   "has"],
          ["velocity", "satya",    "velocity"],
         ["v1",       "mithya",   "v1"],
         ["v2",       "mithya",   "v2"]]
    r        = fixpoint g avrti-refine
    is-ent   = reduce r false (fn acc tri ->
                 cond (and (eq (nth tri 0) "ball-A") (eq (nth tri 1) "prathama-vibhakti"))
                   true otherwise acc)
    has-dvandva = reduce r false (fn acc tri ->
                    cond (and (eq (nth tri 0) "velocity") (eq (nth tri 1) "dvandva"))
                      true otherwise acc)
    owned    = reduce r false (fn acc tri ->
                 cond (and (eq (nth tri 0) "velocity") (eq (nth tri 1) "shashthi-vibhakti"))
                   true otherwise acc)
    ok = cond (and is-ent (and has-dvandva owned)) true otherwise false
  return
    ok  bool
done

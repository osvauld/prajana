tantra test-avrti-r9-suvat
  -- R9 + R2 + vishesa-instance ×2: full SUVAT named instance setup
  -- "train T has initial velocity u and final velocity v" →
  --   [train-T, prathama-vibhakti, object]
  --   [u, vishesa, initial-velocity]   [u, vishesa, rashi]
  --   [v, vishesa, final-velocity]     [v, vishesa, rashi]
  --
  -- pipeline: R9 compounds train+T → train-T, sandhi-avastha synthesises
  -- initial-velocity and final-velocity, vibhakti-shashthi assigns ownership,
  -- vishesa-instance creates typed instances u and v.
  let
    g = [["train",    "mithya", "train"],
         ["T",        "mithya", "T"],
         ["has",      "mithya", "has"],
         ["initial",  "mithya", "initial"],
          ["velocity", "satya", "velocity"],
          ["u",        "mithya", "u"],
          ["final",    "mithya", "final"],
          ["velocity", "satya", "velocity"],
         ["v",        "mithya", "v"]]
    r      = fixpoint (sandhi-viveka g) avrti-refine
    is-ent = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "train-T") (eq (nth tri 1) "prathama-vibhakti"))
                 true otherwise acc)
    iv-sym = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "u") (eq (nth tri 1) "vishesa"))
                 true otherwise acc)
    fv-sym = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "v") (eq (nth tri 1) "vishesa"))
                 true otherwise acc)
    ok     = and is-ent (and iv-sym fv-sym)
  return
    ok  bool
done

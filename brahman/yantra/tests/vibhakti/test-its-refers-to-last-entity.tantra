tantra test-its-refers-to-last-entity
  -- "a ball has mass 5 kg find its kinetic energy"
  -- "its" is a pronoun referring back to "ball" (the last active entity)
  -- after avrti: [its, naama-pratibodha, ball] or [kinetic-energy, shashthi-vibhakti, ball]
  -- KNOWN FAILURE: pronoun resolution (its/their/his/her) not implemented
  let
    g = [["ball",    "prathama-vibhakti",  "object"],
         ["mass",    "sankhya",   "5."],
         ["mass",    "shashthi-vibhakti",   "ball"],
         ["find",    "vidhi-kaala",  "solve-for"],
         ["its",     "mithya",  "its"],
          ["kinetic-energy", "satya", "kinetic-energy"]]
    r   = fixpoint g avrti-refine
    has = reduce r false (fn acc tri ->
            cond (and (eq (nth tri 0) "its") (eq (nth tri 1) "naama-pratibodha"))
              true otherwise acc)
  return
    has  bool
done

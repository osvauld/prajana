tantra test-avrti-r9-two-named-entities
  -- R9 ×2 + R8 ×2: two named entities in one graph, each independently declared
  -- "ball A has mass 5 kg and ball B has mass 10 kg" (raw graph after BQG drops "and")
  --   [ball-A, prathama-vibhakti, object]    [mass, shashthi-vibhakti, ball-A]    [mass, sankhya, 5.]
  --   [ball-B, prathama-vibhakti, object]    [mass, shashthi-vibhakti, ball-B]    [mass, sankhya, 10.]
  --
  -- key: after first entity scope ends (new possession signal starts ball-B scope),
  -- R9 compounds ball+B correctly even while cur-entity is still set from ball-A.
  -- ownership edges are distinct: [mass, shashthi-vibhakti, ball-A] and [mass, shashthi-vibhakti, ball-B].
  let
    g = [["ball", "mithya", "ball"],
         ["A",    "mithya", "A"],
         ["has",  "mithya", "has"],
          ["mass", "satya", "mass"],
          ["mass", "sankhya",  "5."],
          ["ball", "mithya", "ball"],
          ["B",    "mithya", "B"],
          ["has",  "mithya", "has"],
          ["mass", "satya", "mass"],
         ["mass", "sankhya",  "10."]]
    r     = fixpoint (sandhi-viveka g) avrti-refine
    ent-A = reduce r false (fn acc tri ->
              cond (and (eq (nth tri 0) "ball-A") (eq (nth tri 1) "prathama-vibhakti"))
                true otherwise acc)
    ent-B = reduce r false (fn acc tri ->
              cond (and (eq (nth tri 0) "ball-B") (eq (nth tri 1) "prathama-vibhakti"))
                true otherwise acc)
    own-A = reduce r false (fn acc tri ->
              cond (and (and (eq (nth tri 0) "mass") (eq (nth tri 1) "shashthi-vibhakti"))
                        (eq (nth tri 2) "ball-A"))
                true otherwise acc)
    own-B = reduce r false (fn acc tri ->
              cond (and (and (eq (nth tri 0) "mass") (eq (nth tri 1) "shashthi-vibhakti"))
                        (eq (nth tri 2) "ball-B"))
                true otherwise acc)
    ok    = and (and ent-A ent-B) (and own-A own-B)
  return
    ok  bool
done

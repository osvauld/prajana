tantra test-two-entities-separate-mass-bindings
  -- "ball A has mass 5 kg and ball B has mass 10 kg"
  -- the two mass bindings must NOT collapse — each belongs to a different entity
  -- currently both land as [mass, value, X] with the second overwriting context
  -- after avrti: [ball-A, has-mass, 5.] and [ball-B, has-mass, 10.] are separate
  -- KNOWN FAILURE: entity-scoped property binding not implemented
  let
    g      = build-question-graph "ball A has mass 5 kg and ball B has mass 10 kg"
    r      = fixpoint g avrti-refine
    mass-a = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "ball-A") (eq (nth tri 1) "has-mass"))
                 true otherwise acc)
    mass-b = reduce r false (fn acc tri ->
               cond (and (eq (nth tri 0) "ball-B") (eq (nth tri 1) "has-mass"))
                 true otherwise acc)
    ok = cond (and mass-a mass-b) true otherwise false
  return
    ok  bool
done

tantra test-entity-owns-property
  -- after entity typing, the property binding should be attributed to the entity
  -- [ball, prathama-vibhakti, object] + [mass, sankhya, 5.] → [ball, has-mass, 5.]
  -- or equivalently: [mass, shashthi-vibhakti, ball]
  -- so "ball's mass" is queryable from the graph
  -- KNOWN FAILURE: entity-property-ownership attribution not implemented
  let
    g = [["ball", "mithya",  "ball"],
         ["has",  "mithya",  "has"],
          ["mass", "satya",   "mass"],
         ["mass", "sankhya", "5."],
         ["mass", "matra",   "kilogram"]]
    r   = fixpoint (sandhi-viveka g) avrti-refine
    -- mass binding should reference ball as its shashthi-vibhakti
    has = reduce r false (fn acc tri ->
            cond (or
                   (and (eq (nth tri 0) "mass") (eq (nth tri 1) "shashthi-vibhakti"))
                   (and (eq (nth tri 0) "ball") (eq (nth tri 1) "has-mass")))
              true otherwise acc)
  return
    has  bool
done

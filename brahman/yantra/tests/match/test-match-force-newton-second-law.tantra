tantra test-match-force-newton-second-law
  -- force is solve-for → matches newton-second-law-motion (krama-lhs: force)
  let
    g      = [["find",         "vidhi-kaala",  "solve-for"],
               ["force",        "satya",  "force"],
              ["mass",         "sankhya",   "10.0"],
              ["acceleration", "sankhya",   "2.0"]]
    r      = match-mantra g
    name   = nth r 0
    ok     = eq (to-string name) "newton-second-law-motion"
  return
    ok  bool
done

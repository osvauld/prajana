tantra test-debug-reduce-with-lookup
  -- does reduce work when the list comes from node-slokas?
  let
    gnode  = lookup-word "has"
    slokas = node-slokas (to-string gnode)
    found  = reduce slokas "" (fn acc s ->
      cond (ends-with s "-sthita") s
      otherwise acc)
    ok = eq found "shashthi-vibhakti-sthita"
  return
    ok  bool
done

tantra test-debug-named-fn-in-tantra
  -- debug: does a named fn defined in tantra let block work when called via map?
  let
    passthrough = fn tri -> tri
    g   = [["ball", "mithya", "ball"]]
    r   = map g passthrough
    tri = nth r 0
    ok  = eq (nth tri 1) "mithya"
  return
    ok  bool
done

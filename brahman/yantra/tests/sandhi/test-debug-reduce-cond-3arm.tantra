tantra test-debug-reduce-cond-3arm
  -- minimal: reduce with 3-arm cond inside the lambda
  let
    items = ["a", "b-sthita", "c"]
    found = reduce items "" (fn acc s ->
      cond (neq acc "") acc
      (ends-with s "-sthita") s
      otherwise acc)
    ok = eq found "b-sthita"
  return
    ok  bool
done

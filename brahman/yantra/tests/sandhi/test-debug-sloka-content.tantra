tantra test-debug-sloka-content
  -- debug: what is the first sloka of verb-has?
  -- and does ends-with work on it?
  let
    gnode  = lookup-word "has"
    slokas = node-slokas (to-string gnode)
    s0     = nth slokas 0
    ew     = ends-with s0 "-sthita"
    ok     = ew
  return
    ok  bool
done

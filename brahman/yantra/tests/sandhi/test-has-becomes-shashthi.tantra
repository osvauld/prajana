tantra test-has-becomes-shashthi
  -- sandhi-viveka should promote [has, mithya, has]
  -- to [has, shashthi-vibhakti, shashthi-vibhakti]
  -- because verb-has.om carries "shashthi-vibhakti-sthita"
  let
    graph  = [["has", "mithya", "has"]]
    result = sandhi-viveka graph
    tri    = nth result 0
    ok     = and (eq (nth tri 0) "has")
                 (eq (nth tri 1) "shashthi-vibhakti")
  return
    ok  bool
done

tantra test-satya-passthrough
  -- sandhi-viveka must not touch satya triples — only processes mithya
  let
    graph  = [["mass", "satya", "mass"]]
    result = sandhi-viveka graph
    tri    = nth result 0
    ok     = and (eq (nth tri 0) "mass")
                 (eq (nth tri 1) "satya")
  return
    ok  bool
done

tantra test-bqg-solve-for-concept
  -- the word after "what is" should be the solve-for target
  -- checks that the vidhi-kaala triple's subject is the concept word
  -- KNOWN FAILURE: "what" emits [what, vidhi-kaala, solve-for] but solve-for target is not bound separately
  let
    g      = build-question-graph "what is force given mass 5 kg"
    result = reduce g false (fn acc t ->
      cond (and (eq (nth t 1) "vidhi-kaala") (eq (nth t 2) "solve-for")) true otherwise acc)
  return
    result  bool
done

tantra test-kosha-expand-extracts-seeds
  -- given a question graph with satya triples for mass and velocity,
  -- kosha-expand should extract those node names as PPR seeds and add
  -- kosha-janya triples to the graph.
  -- the expanded graph must still contain all original triples.
  let
    graph   = [["mass",     "satya",   "mass"],
               ["mass",     "sankhya", "5.0"],
               ["velocity", "satya",   "velocity"]]
    result  = kosha-expand graph
    -- original satya triples must be preserved
    has-mass-satya = reduce result false (fn acc tri ->
      cond (and (eq (nth tri 0) "mass") (eq (nth tri 1) "satya"))
        true
      otherwise acc)
    has-vel-satya  = reduce result false (fn acc tri ->
      cond (and (eq (nth tri 0) "velocity") (eq (nth tri 1) "satya"))
        true
      otherwise acc)
    -- at least one kosha-janya triple must be added
    has-janya = reduce result false (fn acc tri ->
      cond (eq (nth tri 1) "kosha-janya") true otherwise acc)
    ok = and has-mass-satya (and has-vel-satya has-janya)
  return
    ok  bool
done

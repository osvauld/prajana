tantra test-materialize-named-entity-owns
  -- after materializing a named-entity question graph, walk-in on the entity
  -- returns the owned concept.
  -- simulates avrti output for "ball A has mass 5 kg"
  -- unique t6- prefix to avoid global graph collision with other tests
  let
    graph = [["t6-ball-A", "prathama-vibhakti", "object"],
             ["t6-mass",   "satya", "t6-mass"],
             ["t6-mass",   "shashthi-vibhakti",  "t6-ball-A"],
             ["t6-mass",   "sankhya",  "5."]]
    _        = materialize-question-graph graph
    owns     = walk-in "t6-ball-A" "shashthi-vibhakti"
    owns-ns  = map owns (fn n -> to-string n)
    mass-ok  = member "t6-mass" owns-ns
    -- also verify the reverse: walk from mass to its shashthi-vibhakti
    owned-by = walk "t6-mass" "shashthi-vibhakti"
    ball-ok  = member "t6-ball-A" (map owned-by (fn n -> to-string n))
    ok       = and mass-ok ball-ok
  return
    ok  bool
done

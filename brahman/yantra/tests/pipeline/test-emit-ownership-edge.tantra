tantra test-emit-ownership-edge
  -- emit [t-mass3, shashthi-vibhakti, t-ball3] then verify bidirectional traversal:
  --   walk "t-mass3" "shashthi-vibhakti" → [t-ball3]
  --   walk-in "t-ball3" "shashthi-vibhakti" → [t-mass3]
  let
    _        = emit-node "t-mass3" "prashna" ["t-ball3-shashthi-vibhakti"] ""
    owned-by = walk "t-mass3" "shashthi-vibhakti"
    owns     = walk-in "t-ball3" "shashthi-vibhakti"
    owned-ok = member "t-ball3" (map owned-by (fn n -> to-string n))
    owns-ok  = member "t-mass3" (map owns     (fn n -> to-string n))
    ok       = and owned-ok owns-ok
  return
    ok  bool
done

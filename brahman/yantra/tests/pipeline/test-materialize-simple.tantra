tantra test-materialize-simple
  -- materialize a hand-crafted question graph and verify graph traversal works.
  -- simulates the output of BQG + avrti for "ball has mass 5 kg"
  let
    graph = [
      ["t4-ball", "prathama-vibhakti", "object"],
      ["t4-mass", "satya", "t4-mass"],
      ["t4-mass", "shashthi-vibhakti",  "t4-ball"],
      ["t4-mass", "sankhya",  "5.0"]
    ]
    _         = materialize-question-graph graph
    entities  = walk "t4-ball" "prathama-vibhakti"
    active-e  = walk "t4-mass" "satya"
    owned-by  = walk "t4-mass" "shashthi-vibhakti"
    owns      = walk-in "t4-ball" "shashthi-vibhakti"

    entity-ok = member "object"  (map entities (fn n -> to-string n))
    active-ok = member "t4-mass" (map active-e (fn n -> to-string n))
    owned-ok  = member "t4-ball" (map owned-by (fn n -> to-string n))
    owns-ok   = member "t4-mass" (map owns     (fn n -> to-string n))
    ok        = and entity-ok (and active-ok (and owned-ok owns-ok))
  return
    ok  bool
done

tantra test-bqg-acceleration-active
  -- "acceleration" in a sentence should produce a satya concept triple
  -- KNOWN FAILURE: word-node "acceleration" → acceleration-mantra (not kosha), so is-kosha=false → mithya
  let
    g      = build-question-graph "what is acceleration"
    result = reduce g false (fn acc t ->
      cond (and (eq (nth t 0) "acceleration") (eq (nth t 1) "satya")) true otherwise acc)
  return
    result  bool
done

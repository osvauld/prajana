tantra test-pipeline-named-entity-ke
  -- full pipeline integration: BQG → avrti → match-mantra
  -- "ball A has mass 5 kg and velocity 10 m/s find kinetic energy"
  -- expected: kinetic-energy-mantra matched with args [5., 10.]
  --
  -- fails due to bug 1 (solve-for = mass, not kinetic-energy).
  -- once bug 1 is fixed this should pass cleanly — entity, values and
  -- compound are all correctly handled by the current avrti pipeline.
  --
  -- KNOWN FAILURE: match-mantra solve-for heuristic (bug 1).
  let
    g  = build-question-graph "ball A has mass 5 kg and velocity 10 m/s find kinetic energy"
    r  = fixpoint g avrti-refine
    m  = match-mantra r
    ok = eq (to-string (nth m 0)) "kinetic-energy-mantra"
  return
    ok  bool
done

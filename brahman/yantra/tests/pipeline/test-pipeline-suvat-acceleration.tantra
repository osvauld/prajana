tantra test-pipeline-suvat-acceleration
  -- full pipeline integration: BQG → avrti → match-mantra
  -- "train T has initial velocity 20 and final velocity 40 find acceleration"
  -- expected: acceleration-mantra matched
  --   (krama-rhs: final-velocity, initial-velocity, time — but time is missing here,
  --    so this will only pass once match also handles partial coverage or time is given)
  --
  -- actually testing with time included:
  -- "train T has initial velocity 5 and final velocity 20 and time 3 find acceleration"
  --
  -- fails due to bug 1 (solve-for = initial-velocity, not acceleration)
  -- and bug 2 (initial-velocity may get wrong value from R3).
  --
  -- KNOWN FAILURE: bugs 1 and 2 combined.
  let
    g  = build-question-graph "train T has initial velocity 5 and final velocity 20 and time 3 find acceleration"
    r  = fixpoint g avrti-refine
    m  = match-mantra r
    ok = eq (to-string (nth m 0)) "acceleration-mantra"
  return
    ok  bool
done

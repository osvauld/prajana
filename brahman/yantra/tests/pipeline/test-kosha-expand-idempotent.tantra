tantra test-kosha-expand-idempotent
  -- running kosha-expand twice should not add duplicate kosha-janya triples.
  -- the triple count after the second pass must equal the count after the first.
  let
    graph    = [["mass", "satya", "mass"]]
    once     = kosha-expand graph
    twice    = kosha-expand once
    -- count kosha-janya triples in each pass
    count-janya = (fn lst ->
      reduce lst 0 (fn acc tri ->
        cond (eq (nth tri 1) "kosha-janya") (add acc 1) otherwise acc))
    n-once  = count-janya once
    n-twice = count-janya twice
    ok      = eq n-once n-twice
  return
    ok  bool
done

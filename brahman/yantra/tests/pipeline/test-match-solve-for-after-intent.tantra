tantra test-match-solve-for-after-intent
  -- bug 1: solve-for must be the first satya concept AFTER the vidhi-kaala triple,
  -- not the first satya concept in the graph overall.
  --
  -- in natural sentences, entity properties are declared BEFORE "find":
  --   "ball A has mass 5 kg and velocity 10 m/s find kinetic energy"
  -- the graph contains: [mass, satya] and [velocity, satya] BEFORE [find, vidhi-kaala],
  -- then [kinetic-energy, satya] AFTER.
  --
  -- current behaviour: solve-for = "mass" (first satya overall) → no mantra named
  -- "mass" → match returns [] → FAIL.
  -- expected:          solve-for = "kinetic-energy" (first satya after vidhi-kaala).
  --
  -- KNOWN FAILURE: match-mantra uses first-satya-overall heuristic.
  let
    g  = [["ball-A",         "prathama-vibhakti", "object"],
          ["mass",           "satya", "mass"],
          ["mass",           "shashthi-vibhakti",  "ball-A"],
          ["mass",           "sankhya",  "5."],
          ["velocity",       "satya", "velocity"],
          ["velocity",       "shashthi-vibhakti",  "ball-A"],
          ["velocity",       "sankhya",  "10."],
          ["find",           "vidhi-kaala", "solve-for"],
          ["kinetic-energy", "satya", "kinetic-energy"]]
    r  = match-mantra g
    ok = eq (to-string (nth r 0)) "kinetic-energy-mantra"
  return
    ok  bool
done

tantra test-avrti-r4b-no-symbol-after-value
  -- guard: vishesa-instance must NOT fire when the concept already has a numeric sankhya.
  -- "ball A has mass 5 kg ball B has mass 10" — both masses are numerically bound.
  -- mithya words "ball" and "B" (part of next entity's name) must NOT become
  -- vishesa instances of mass.
  --
  -- guard in vishesa-instance: not (member last-active bound-concepts)
  -- bound-concepts = concepts with existing sankhya triple.
  --
  -- expected: no [ball, vishesa, mass] or [B, vishesa, mass] triples.
  let
    g        = [["ball-A", "prathama-vibhakti", "object"],
                ["mass",   "satya", "mass"],
                ["mass",   "shashthi-vibhakti",  "ball-A"],
                ["mass",   "sankhya",  "5."],
                ["mass",   "matra",   "kilogram"],
                ["ball",   "mithya", "ball"],
                ["B",      "mithya", "B"],
                ["ball-B", "prathama-vibhakti", "object"],
                ["mass",   "satya", "mass"],
                ["mass",   "shashthi-vibhakti",  "ball-B"],
                ["mass",   "sankhya",  "10."]]
    r        = fixpoint g avrti-refine
    no-syms  = reduce r true (fn acc tri ->
                 cond (and (eq (nth tri 1) "vishesa") (eq (nth tri 2) "mass"))
                   false otherwise acc)
  return
    no-syms  bool
done

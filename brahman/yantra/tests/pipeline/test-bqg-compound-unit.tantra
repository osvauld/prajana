tantra test-bqg-compound-unit
  -- "velocity 10 m/s" should bind metre-per-second as matra for velocity
  -- KNOWN FAILURE: "m/s" not in word_index directly, matra resolution not yet implemented
  let
    g      = build-question-graph "velocity 10 m/s"
    result = reduce g false (fn acc t ->
      cond (and (eq (nth t 0) "velocity") (eq (nth t 1) "matra")) true otherwise acc)
  return
    result  bool
done

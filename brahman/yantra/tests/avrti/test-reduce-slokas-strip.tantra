tantra test-reduce-slokas-strip
  let
    sthita-len = string-length "-sthita"
    s = node-slokas "verb-has"
    r = reduce s "" (fn a x ->
      cond (ends-with x "-sthita")
        (substr x 0 (sub (string-length x) sthita-len))
      otherwise a)
    ok = eq r "shashthi-vibhakti"
  return
    ok  bool
done

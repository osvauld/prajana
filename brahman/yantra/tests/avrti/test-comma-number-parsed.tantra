tantra test-comma-number-parsed
  -- "find sum of 10, 14, 15 and 29" — numbers with trailing commas
  -- split-numeric "10," → [10., ","] so sankhya is extracted correctly
  -- all four numbers should appear as asprista-sankhya triples
  let
    g     = build-question-graph "find sum of 10, 14, 15 and 29"
    has10 = reduce g false (fn acc tri ->
              cond (and (eq (nth tri 1) "asprista-sankhya")
                        (lt (abs (sub (to-number (nth tri 2)) 10.)) 0.001))
                true otherwise acc)
    has14 = reduce g false (fn acc tri ->
              cond (and (eq (nth tri 1) "asprista-sankhya")
                        (lt (abs (sub (to-number (nth tri 2)) 14.)) 0.001))
                true otherwise acc)
    has15 = reduce g false (fn acc tri ->
              cond (and (eq (nth tri 1) "asprista-sankhya")
                        (lt (abs (sub (to-number (nth tri 2)) 15.)) 0.001))
                true otherwise acc)
    has29 = reduce g false (fn acc tri ->
              cond (and (eq (nth tri 1) "asprista-sankhya")
                        (lt (abs (sub (to-number (nth tri 2)) 29.)) 0.001))
                true otherwise acc)
    ok = reduce [has10, has14, has15, has29] true (fn acc x -> and acc x)
  return
    ok  bool
done

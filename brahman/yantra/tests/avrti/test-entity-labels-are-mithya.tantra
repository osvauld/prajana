tantra test-entity-labels-are-mithya
  -- m1, m2, m3 are unknown labels → appear as mithya triples in BQG
  -- this is the CORRECT current behaviour — they are provisionally mithya
  -- avrti-refine will later type them as instances
  let
    g    = build-question-graph "find momentum of m1 m2 and m3 with v1 v2 and v3 velocities respectively"
    has-m1 = reduce g false (fn acc tri ->
               cond (and (eq (nth tri 0) "m1") (eq (nth tri 1) "mithya"))
                 true otherwise acc)
    has-m2 = reduce g false (fn acc tri ->
               cond (and (eq (nth tri 0) "m2") (eq (nth tri 1) "mithya"))
                 true otherwise acc)
    has-m3 = reduce g false (fn acc tri ->
               cond (and (eq (nth tri 0) "m3") (eq (nth tri 1) "mithya"))
                 true otherwise acc)
    ok = reduce [has-m1, has-m2, has-m3] true (fn acc x -> and acc x)
  return
    ok  bool
done

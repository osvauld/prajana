tantra test-avrti-no-compound
  -- avrti-refine leaves graph unchanged when no compound exists
  -- "ball" + "energy" → lookup "ball-energy" → miss → unchanged
  let
    g      = [["ball", "mithya", "ball"], ["energy", "satya", "energy"]]
    r      = avrti-refine g
    node0  = nth (nth r 0) 0
    edge0  = nth (nth r 0) 1
    node1  = nth (nth r 1) 0
    edge1  = nth (nth r 1) 1
    ok     = cond (and (and (eq node0 "ball") (eq edge0 "mithya"))
                       (and (eq node1 "energy") (eq edge1 "satya")))
               true otherwise false
  return
    ok  bool
done

tantra test-bhuta-kaala-synthesizes-initial
  -- bhuta-kaala signal must pass through avrti-refine unchanged.
  -- tense signals are logic assertions for mantra matching, not parse-time
  -- concept renames. role assignment (initial/final) belongs to the proof graph.
  let
    graph  = [["was",      "bhuta-kaala", "bhuta-kaala"],
              ["velocity", "satya",       "velocity"],
              ["velocity", "sankhya",     "20.0"]]
    result = fixpoint graph avrti-refine
    -- bhuta-kaala triple must survive intact
    has-kaala = reduce result false (fn acc tri ->
      cond (eq (nth tri 1) "bhuta-kaala") true otherwise acc)
    -- velocity satya must survive intact (no concept rename)
    has-vel = reduce result false (fn acc tri ->
      cond (and (eq (nth tri 0) "velocity") (eq (nth tri 1) "satya"))
        true
      otherwise acc)
    ok = and has-kaala has-vel
  return
    ok  bool
done

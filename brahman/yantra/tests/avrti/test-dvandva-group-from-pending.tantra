tantra test-dvandva-group-from-pending
  -- avrti-refine should collect consecutive asprista-sankhya triples under a satya concept
  -- into a dvandva group triple: [sum, dvandva, [10., 14., 15., 29.]]
  -- KNOWN FAILURE: avrti-refine has no dvandva-collection rule yet
  let
     g = [["sum",  "satya",            "sum"],
         ["10",   "asprista-sankhya", "10."],
         ["14",   "asprista-sankhya", "14."],
         ["15",   "asprista-sankhya", "15."],
         ["29",   "asprista-sankhya", "29."]]
    r   = fixpoint g avrti-refine
    has = reduce r false (fn acc tri ->
            cond (and (eq (nth tri 0) "sum") (eq (nth tri 1) "dvandva"))
              true otherwise acc)
  return
    has  bool
done

tantra test-pending-numbers-collected
  -- "find sum of 10 and 14" → both 10 and 14 appear as asprista-sankhya triples
  -- this verifies the numbers survive parsing even before group collection
  let
    g    = build-question-graph "find sum of 10 and 14"
    has10 = reduce g false (fn acc tri ->
              cond (and (eq (nth tri 1) "asprista-sankhya")
                        (lt (abs (sub (to-number (nth tri 2)) 10.)) 0.001))
                true otherwise acc)
    has14 = reduce g false (fn acc tri ->
              cond (and (eq (nth tri 1) "asprista-sankhya")
                        (lt (abs (sub (to-number (nth tri 2)) 14.)) 0.001))
                true otherwise acc)
    ok = cond (and has10 has14) true otherwise false
  return
    ok  bool
done

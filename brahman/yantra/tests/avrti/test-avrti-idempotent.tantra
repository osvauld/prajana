tantra test-avrti-idempotent
  -- avrti-refine on a stable graph returns the same length (fixpoint holds)
  -- [mass, satya] has no pending mithya prefix → no change
  let
    g    = [["mass", "satya", "mass"], ["velocity", "satya", "velocity"]]
    r    = avrti-refine g
    ok   = eq (length r) (length g)
  return
    ok  bool
done

tantra test-split-numeric-comma-suffix
  -- "10," split-numeric → value 10., suffix ","
  -- the comma is already surfaced as the unit string
  let
    parts  = split-numeric "10,"
    val    = nth parts 0
    suffix = nth parts 1
    ok     = cond (and (lt (abs (sub val 10.)) 0.001) (eq suffix ","))
               true otherwise false
  return
    ok  bool
done

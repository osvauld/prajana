tantra test-velocities-resolves-to-velocity
  -- "velocities" → morpheme rule strips "ies" + adds "y" → "velocity" (satya concept)
  -- this already works — verifying it holds in the full sentence context
  let
    g   = build-question-graph "find momentum of m1 m2 and m3 with v1 v2 and v3 velocities respectively"
    has = reduce g false (fn acc tri ->
            cond (and (eq (nth tri 0) "velocity") (eq (nth tri 1) "satya"))
              true otherwise acc)
  return
    has  bool
done

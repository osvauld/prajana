tantra test-dvandva-group-has-four-elements
  -- the dvandva group for [10, 14, 15, 29] should have exactly 4 elements
  -- KNOWN FAILURE: dvandva-collection rule not yet in avrti-refine
  let
     g = [["sum",  "satya",            "sum"],
         ["10",   "asprista-sankhya", "10."],
         ["14",   "asprista-sankhya", "14."],
         ["15",   "asprista-sankhya", "15."],
         ["29",   "asprista-sankhya", "29."]]
    r       = fixpoint g avrti-refine
    members = reduce r [] (fn acc tri ->
                cond (and (eq (nth tri 0) "sum") (eq (nth tri 1) "dvandva"))
                  (nth tri 2)
                otherwise acc)
    ok = eq (length members) 4
  return
    ok  bool
done

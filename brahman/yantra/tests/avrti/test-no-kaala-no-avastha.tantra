tantra test-no-kaala-no-avastha
  -- without any tense signal, a satya concept is not synthesized into initial/final.
  let
    graph  = [["velocity", "satya",   "velocity"],
              ["velocity", "sankhya", "20.0"]]
    result = fixpoint graph avrti-refine
    -- velocity should remain as "velocity", not become "initial-velocity"
    has-plain-vel = reduce result false (fn acc tri ->
      cond (and (eq (nth tri 0) "velocity") (eq (nth tri 1) "satya"))
        true
      otherwise acc)
    no-init-vel = not (reduce result false (fn acc tri ->
      cond (and (eq (nth tri 0) "initial-velocity") (eq (nth tri 1) "satya"))
        true
      otherwise acc))
    ok = and has-plain-vel no-init-vel
  return
    ok  bool
done

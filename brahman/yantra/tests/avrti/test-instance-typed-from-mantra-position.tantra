tantra test-instance-typed-from-mantra-position
  -- m1,m2,m3 appear between "momentum" (solve-for) and the v-group
  -- momentum krama-rhs: mass, velocity
  -- so the m-group is typed as mass by mantra position (first krama-rhs arg)
  -- KNOWN FAILURE: mantra-position type inference not implemented
  let
     g = [["momentum", "satya",  "momentum"],
         ["m1",       "mithya",  "m1"],
         ["m2",       "mithya",  "m2"],
         ["m3",       "mithya",  "m3"],
         ["velocity", "dvandva", ["v1","v2","v3"]]]
    r   = fixpoint g avrti-refine
    -- m1 should be typed as a vishesa of mass
    has = reduce r false (fn acc tri ->
            cond (and (eq (nth tri 0) "m1") (eq (nth tri 1) "vishesa"))
              true otherwise acc)
  return
    has  bool
done

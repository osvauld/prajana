tantra test-avrti-compound
  -- avrti-refine resolves [kinetic, mithya] + [energy, satya] → [kinetic-energy, satya]
  let
    g    = [["kinetic", "mithya", "kinetic"], ["energy", "satya", "energy"]]
    r    = avrti-refine g
    node = nth (nth r 0) 0
    edge = nth (nth r 0) 1
    ok   = cond (and (eq node "kinetic-energy") (eq edge "satya")) true otherwise false
  return
    ok  bool
done

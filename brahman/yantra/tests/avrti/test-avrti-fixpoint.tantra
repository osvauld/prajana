tantra test-avrti-fixpoint
  -- fixpoint avrti-refine runs until stable
  -- two passes: pass 1 resolves kinetic+energy, pass 2 is unchanged
  let
    g    = [["kinetic", "mithya", "kinetic"], ["energy", "satya", "energy"],
            ["mass", "satya", "mass"]]
    r    = fixpoint g avrti-refine
    node = nth (nth r 0) 0
    len  = length r
    ok   = cond (and (eq node "kinetic-energy") (eq len 2)) true otherwise false
  return
    ok  bool
done

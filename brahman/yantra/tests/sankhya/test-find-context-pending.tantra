tantra test-find-context-pending
  -- last triple is asprista-sankhya → find-context returns it as pending
  let
    g       = [["mass", "satya", "mass"], ["x", "asprista-sankhya", "5.0"]]
    ctx     = find-context g
    pending = nth ctx 1
    result  = eq pending "5.0"
  return
    result  bool
done

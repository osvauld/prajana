tantra test-emit-triples-unit-consumes-pending
  -- a matra word (kilogram) after a pending sankhya DOES consume it as matra binding
  -- context: satya="mass", pending="5."
  let
    info    = ["kilogram", "", "kosha", "", ""]
    ctx     = ["mass", "5."]
    triples = emit-triples "kilogram" info ctx
    first   = nth triples 0
    -- should be [mass, sankhya, 5.] (matra binding path)
    ok      = cond (and (eq (nth first 0) "mass") (eq (nth first 1) "sankhya"))
                true otherwise false
  return
    ok  bool
done

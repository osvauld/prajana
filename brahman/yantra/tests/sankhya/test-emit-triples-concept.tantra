tantra test-emit-triples-concept
  -- kosha node with no role → [[node, "satya", "concept"]]
  let
    info    = ["force", "", "kosha", "", ""]
    ctx     = ["", ""]
    triples = emit-triples "force" info ctx
    first   = nth triples 0
    result  = eq (nth first 1) "satya"
  return
    result  bool
done

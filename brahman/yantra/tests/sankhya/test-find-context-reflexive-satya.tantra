tantra test-find-context-reflexive-satya
  -- find-context must recognise active concepts from reflexive satya triples
  -- [node, "satya", node] — not rely on checking for dead string "concept".
  -- this is the gate: if find-context breaks on reflexive triples,
  -- value bindings in the pipeline stop working.
  let
    g      = [["velocity", "satya", "velocity"]]
    ctx    = find-context g
    active = nth ctx 0
    ok     = eq active "velocity"
  return
    ok  bool
done

tantra test-vishesa-bind-imap
  -- does building instance-map itself crash?
  -- [v1, vishesa, velocity] → should produce [["velocity","v1"]]
  let
    g = [["v1", "vishesa", "velocity"]]
    instance-map = reduce g [] (fn acc tri ->
      cond (and (eq (nth tri 1) "vishesa")
                (neq (nth tri 2) "rashi"))
        (append acc [[(nth tri 2), (nth tri 0)]])
      otherwise acc)
    ok = eq (length instance-map) 1
  return
    ok  bool
done

tantra test-vishesa-bind-debug
  -- return the instance-map itself so we can see its structure
  let
    g = [["v1", "vishesa", "velocity"]]
    instance-map = reduce g [] (fn acc tri ->
      cond (and (eq (nth tri 1) "vishesa")
                (neq (nth tri 2) "rashi"))
        (append acc [[(nth tri 2), (nth tri 0)]])
      otherwise acc)
  return
    instance-map  list
done

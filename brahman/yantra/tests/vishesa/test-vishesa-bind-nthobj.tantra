tantra test-vishesa-bind-nthobj
  -- does nth tri 2 work in a reduce with let bindings?
  let
    g = [["v1", "vishesa", "velocity"]]
    result = reduce g [] (fn acc tri ->
      let subj = nth tri 0
      let edge = nth tri 1
      let obj  = nth tri 2
      append acc [[subj, edge, obj]])
    ok = eq (length result) 1
  return
    ok  bool
done

tantra test-vishesa-fixpoint-pass2
  -- isolate: does a second pass of avrti-refine crash on pass-1 output?
  -- manually construct what pass 1 produces for "ball has velocity v1"
  -- and feed it directly into avrti-refine a second time.
  let
    -- this is the expected output after pass 1 of avrti-refine
    g = [["ball",     "mithya",             "ball"],
         ["ball",     "prathama-vibhakti",  "object"],
         ["velocity", "satya",              "velocity"],
         ["velocity", "shashthi-vibhakti",  "ball"],
         ["v1",       "vishesa",            "velocity"],
         ["v1",       "vishesa",            "rashi"]]
    r  = avrti-refine g
    ok = gt (length r) 0
  return
    ok  bool
done

tantra test-vishesa-bind-nested-reduce
  -- does a nested reduce inside a reduce crash with let bindings inside outer reduce?
  let
    g = [["v1", "vishesa", "velocity"]]
    instance-map = [["velocity", "v1"]]
    result = reduce g [] (fn acc tri ->
      let subj = nth tri 0
      let edge = nth tri 1
      let obj  = nth tri 2
      let inst = reduce instance-map "" (fn iacc pair ->
        cond (eq (nth pair 0) subj) (nth pair 1) otherwise iacc)
      append acc [[subj, edge, inst]])
    ok = gt (length result) 0
  return
    ok  bool
done

tantra test-vishesa-p2-sandhi-kosha
  -- pass-2 isolation: sandhi-kosha on pass-1 output
  let
    g = [["ball",     "mithya",             "ball"],
         ["ball",     "prathama-vibhakti",  "object"],
         ["velocity", "satya",              "velocity"],
         ["velocity", "shashthi-vibhakti",  "ball"],
         ["v1",       "vishesa",            "velocity"],
         ["v1",       "vishesa",            "rashi"]]
    r  = sandhi-kosha g
    ok = gt (length r) 0
  return
    ok  bool
done

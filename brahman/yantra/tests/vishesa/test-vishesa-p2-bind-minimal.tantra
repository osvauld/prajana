tantra test-vishesa-p2-bind-minimal
  -- minimal: what does vishesa-bandhana do with [v1, vishesa, velocity]?
  -- instance-map built from [v1, vishesa, velocity] → [["velocity", "v1"]]
  -- then reduce: sees [v1, vishesa, rashi] — subj="v1", edge="vishesa"
  --   rebind = (or (eq "vishesa" "sankhya") (or (eq "vishesa" "matra") (eq "vishesa" "shashthi-vibhakti"))) = false
  --   inst = reduce instance-map "" — looks for pair where nth pair 0 = "v1"
  --          pair = ["velocity","v1"], nth pair 0 = "velocity" ≠ "v1" → inst=""
  --   not rebind → otherwise → append tri
  -- so it should be fine... let's test with just the two vishesa triples
  let
    g = [["v1", "vishesa", "velocity"],
         ["v1", "vishesa", "rashi"]]
    r  = vishesa-bandhana g
    ok = gt (length r) 0
  return
    ok  bool
done

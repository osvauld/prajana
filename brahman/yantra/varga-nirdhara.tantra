tantra varga-nirdhara

  -- classifier: determines what a word IS using graph knowledge.
  -- uses akshara-varga (character categories), aliases, english-grammar,
  -- and graph lookup to classify a word as number/concept/operator/grammar/unknown.
  --
  -- returns [word, kind, resolved] triple

  inputs
    word  string

  let
    -- step 1: try parsing as number
    num-val = to-number word

    -- step 2: check alias table (short physics symbols: V, F, m, a, etc.)
    alias-val = shabda "aliases" word

    -- step 3: check operator symbol table (+ → addition, / → division)
    op-val = shabda "chihna-ganaka" word

    -- step 4: check grammar role (is, of, what, when, etc.)
    grammar-val = shabda "english-grammar" word

    -- step 5: check token role (articles: the, a, an)
    token-val = shabda "english-token-roles" word

    -- step 6: try graph lookup (concepts like force, mass, sine, plus)
    node-val = lookup word

    -- step 7: determine kind and resolved value
    word-len = string-length word
    result = cond
      (exists num-val)
        (pair word (pair "number" num-val))
      (and (le word-len 2) (exists alias-val))
        (pair word (pair "concept" alias-val))
      (exists op-val)
        (pair word (pair "operator" op-val))
      (exists grammar-val)
        (pair word (pair "grammar" word))
      (exists token-val)
        (pair word (pair "grammar" word))
      (exists node-val)
        (pair word (pair "concept" (name node-val)))
      otherwise
        (pair word (pair "unknown" word))

  return
    result  list

done

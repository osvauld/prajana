tantra ring-compose

  -- composes two relation paths using the visheshanam ring operations.
  --
  -- given node A, relation r1, relation r2:
  --   find all B where A -r1-> B
  --   find all C where B -r2-> C for each B
  --   return the set of C nodes reachable by the composed path r1;r2
  --
  -- this is multiplicative composition (kriya) in the visheshanam ring:
  --   (r1 * r2)(A) = { C : exists B, A -r1-> B -r2-> C }
  --
  -- the ring-op:mul property on visheshanam-kriya declares this operation.
  -- composability is checked: both relations must have composable:yes in their
  -- shabda properties (sthita, swarupa, abheda, kriya, yukta are composable).
  --
  -- example: walk "force" through sthita;sthita finds what force's
  -- dependencies themselves depend on (transitive closure step).

  inputs
    node  string
    rel1  string
    rel2  string

  let
    -- check composability from visheshanam shabda
    r1-composable = eq (shabda (concat "visheshanam-" rel1) "composable") "yes"
    r2-composable = eq (shabda (concat "visheshanam-" rel2) "composable") "yes"

    -- step 1: walk rel1 from node → intermediate set
    intermediates = walk node rel1

    -- step 2: for each intermediate, walk rel2 → final targets
    targets = cond (and r1-composable r2-composable)
      (unique (flatten (map intermediates (fn b -> walk (name b) rel2))))
      otherwise []

  return
    targets  list

done

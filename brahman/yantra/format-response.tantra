tantra format-response

  -- formats a raw result VList into a natural language string.
  -- input schema: [r-kind, r-name, r-value, r-unit, r-attr]
  -- r-kind: "result" | "stored" | "error"

  inputs
    result-data list

  let
    r-kind  = nth result-data 0
    r-name  = nth result-data 1
    r-value = nth result-data 2
    r-unit  = nth result-data 3
    r-attr  = nth result-data 4

    -- append unit with leading space when non-empty
    unit-part  = cond (eq r-unit "") "" otherwise (concat " " r-unit)
    val-str    = to-string r-value

    error-prefix = cond (neq (shabda "anuvada-setu" "error-prefix") "")
      (shabda "anuvada-setu" "error-prefix")
      otherwise "cannot compute"
    result-is = cond (neq (shabda "anuvada-setu" "result-is") "")
      (shabda "anuvada-setu" "result-is")
      otherwise "is"
    stored-suffix = cond (neq (shabda "anuvada-setu" "stored-suffix") "")
      (shabda "anuvada-setu" "stored-suffix")
      otherwise "(remembered)."
    attribution-prefix = cond (neq (shabda "anuvada-setu" "attribution-prefix") "")
      (shabda "anuvada-setu" "attribution-prefix")
      otherwise "computed by"

    -- natural language result line
    result-line = cond
      (eq r-kind "error")  (concat error-prefix " " r-name ".")
      (eq r-name "result") (concat val-str unit-part ".")
      (eq r-kind "stored") (concat r-name " " result-is " " val-str unit-part " " stored-suffix)
      otherwise            (concat r-name " " result-is " " val-str unit-part ".")

    -- attribution sentence (omitted for errors or when empty)
    attrib-line = cond
      (eq r-kind "error")   ""
      (eq r-attr "")        ""
      otherwise (concat " " attribution-prefix " " r-attr ".")

    output = concat result-line attrib-line

  return
    output string

done

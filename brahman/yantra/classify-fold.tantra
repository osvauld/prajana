tantra classify-fold

  -- classify a list of raw word strings into typed token triples [word, kind, resolved].
  -- replaces the old classify-all + join-bigrams two-step pipeline.
  --
  -- step 1: classify each word individually.
  --   words in english-modifiers (kinetic, electrical, ...) are tagged
  --   as "modifier" — they are held for compound resolution.
  --   avastha qualifiers (initial, final) are tagged as "avastha" —
  --   they tag the NEXT concept with purva/uttara state, not form a compound.
  --   all other words go through the normal classify op (number / operator /
  --   grammar / concept / unknown via setu-classify-token).
  --
  -- step 2: run classify-fold-resolve (avrti — iterative compound resolution).
  --   fold-pairs walks adjacent tokens and asks the graph whether combining
  --   the resolved names produces a known node or alias.
  --   repeats until no more merges occur (the list stops shrinking).

  inputs
    words  list

  let
    tokens = map words (fn w -> let tr = shabda "english-token-roles" w in let mr = shabda "english-modifiers" w in cond
      (exists mr) [w, mr, w]
      (eq tr "purva-avastha") [w, "avastha", "purva"]
      (eq tr "uttara-avastha") [w, "avastha", "uttara"]
      (eq tr "kriya-yantra") [w, "kriya", "kriya-yantra"]
      (exists tr) (classify w)
      otherwise (classify w))
    result = classify-fold-resolve tokens

  return
    result  list

done

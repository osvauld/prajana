tantra2 execute-matched

-- dispatch a matched mantra to the right executor and format the answer.
-- items = [mantra, val-pairs, mode]
-- sf    = the concept being solved for
-- returns: "label = value" string

takes items
takes sf

mantra   = nth items 0
valpairs = nth items 1
mode     = nth items 2
math-op  = shabda mantra "math-op"
is-math  = gt (string-length math-op) 0
is-inv   = eq mode "inverse"

exe = (cond is-inv "invert-math" otherwise (cond is-math "execute-math" otherwise "execute-chain"))
ea  = (cond is-inv [mantra, valpairs, sf] otherwise [mantra, valpairs])

val     = call-tantra exe ea

phala   = walk mantra "phala"
swarupa = walk mantra "swarupa"

label = (cond is-inv sf
  otherwise (cond (gt (length phala) 0) (nth phala 0)
  otherwise (cond (gt (length swarupa) 0) (nth swarupa 0)
  otherwise (to-string mantra))))

answer = concat label " = " (to-string val)

return answer

done

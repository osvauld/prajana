tantra3 derive-chain

-- derive-chain: run derive-step iteratively, recording at each step:
--   - the new concepts derived (added sankhya values)
--   - the producing mantras (the mantras whose phala matches new concepts
--     and whose janya was fully bound in the graph before this step)
--
-- returns [steps, final-graph]
--   steps = [[new-concepts, producing-matches, solve-match], ...]
--     new-concepts    = list of concept names newly derived
--     producing-matches = list of [mantra, val-pairs] that produced them
--     solve-match     = the solve-for match after this step
--   final-graph = stable enriched graph
--
-- tantra3: uses mantra-select instead of physics-mantras/math-mantras.

takes graph

all-ms = mantra-select ""

-- find mantras that explain a new concept in a given graph
-- a mantra explains concept C if: C in phala AND all janya were bound before
producing-for = (fn new-cs prev-g cur-g ->
  let prev-bcs = (sankhya-sparsha prev-g) | collect (to-string (nth _it 0))
  let cur-vp   = sankhya-sparsha cur-g
  reduce all-ms [] (fn acc m ->
    let ms = to-string m
    let ct = om-contract ms
    let ph = nth ct 1
    let jy = nth ct 0
    let covers-new = reduce new-cs false (fn found c -> or found (member (to-string c) (map ph (fn p -> to-string p))))
    let janya-bound = reduce jy true (fn ok j -> and ok (member (to-string j) prev-bcs))
    cond (and covers-new janya-bound)
      (let vp = reduce jy [] (fn acc2 j ->
         let v = reduce cur-vp "" (fn a2 kv -> cond (eq (to-string (nth kv 0)) (to-string j)) (to-string (nth kv 1)) otherwise a2)
         cond (gt (string-length v) 0) (append acc2 [[j, v]]) otherwise acc2)
       append acc [[m, vp]])
    otherwise acc))

-- step 1
step1-g     = derive-step graph
prev-bcs0   = (sankhya-sparsha graph)   | collect (to-string (nth _it 0))
step1-bcs   = (sankhya-sparsha step1-g) | collect (to-string (nth _it 0))
step1-new   = gt (length step1-bcs) (length prev-bcs0)
step1-added = filter step1-bcs (fn c -> not (member c prev-bcs0))
step1-prod  = cond step1-new (producing-for step1-added graph step1-g) otherwise []
step1-sm    = cond step1-new (match-mantra step1-g) otherwise []
step1-entry = cond step1-new [[step1-added, step1-prod, step1-sm]] otherwise []

-- step 2
step2-g     = cond step1-new (derive-step step1-g) otherwise step1-g
step2-bcs   = (sankhya-sparsha step2-g) | collect (to-string (nth _it 0))
step2-new   = (and step1-new (gt (length step2-bcs) (length step1-bcs)))
step2-added = filter step2-bcs (fn c -> not (member c step1-bcs))
step2-prod  = cond step2-new (producing-for step2-added step1-g step2-g) otherwise []
step2-sm    = cond step2-new (match-mantra step2-g) otherwise []
step2-entry = cond step2-new [[step2-added, step2-prod, step2-sm]] otherwise []

-- step 3
step3-g     = cond step2-new (derive-step step2-g) otherwise step2-g
step3-bcs   = (sankhya-sparsha step3-g) | collect (to-string (nth _it 0))
step3-new   = (and step2-new (gt (length step3-bcs) (length step2-bcs)))
step3-added = filter step3-bcs (fn c -> not (member c step2-bcs))
step3-prod  = cond step3-new (producing-for step3-added step2-g step3-g) otherwise []
step3-sm    = cond step3-new (match-mantra step3-g) otherwise []
step3-entry = cond step3-new [[step3-added, step3-prod, step3-sm]] otherwise []

steps = append (append step1-entry step2-entry) step3-entry

final-graph = cond step3-new step3-g
  otherwise (cond step2-new step2-g
  otherwise (cond step1-new step1-g
  otherwise graph))

result = [steps, final-graph]

return result

done

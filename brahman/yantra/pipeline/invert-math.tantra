tantra invert-math

  -- invert a math-backed mantra to solve for a missing janya.
  -- given: mantra, bindings (all janya except solve-for + phala value),
  --        solve-for (the janya we want)

  inputs
    mantra     string
    bindings   list
    solve-for  string

  let

  math-op  = shabda mantra "math-op"
  janya    = walk mantra "janya"
  phala    = nth (walk mantra "phala") 0
  swarupa  = nth (walk mantra "swarupa") 0

  -- phala concept: use phala edge if present, else swarupa
  phala-concept = cond (gt (string-length phala) 0) phala otherwise swarupa

  -- find solve-for position in janya list (0-indexed)
  idx-state = reduce janya [0, -1] (fn acc concept ->
    let i     = nth acc 0
    let found = nth acc 1
    cond (gt found -1) acc
    (eq concept solve-for) [i, i]
    otherwise [(add i 1), found])

  solve-idx = nth idx-state 1

  -- get phala value from bindings
  phala-val = reduce bindings "" (fn a kv ->
    cond (eq (nth kv 0) phala-concept) (nth kv 1) otherwise a)

  -- get other janya value (the one beside solve-for)
  other-janya = filter janya (fn j -> not (eq j solve-for))

  other-val = reduce other-janya "" (fn a concept ->
    let ck = shabda concept "constants-key"
    let v  = cond (gt (string-length ck) 0)
      (nth (split-numeric (shabda "physics-constants" ck)) 0)
      otherwise
        (reduce bindings "" (fn a2 kv ->
          cond (eq (nth kv 0) concept) (nth kv 1) otherwise a2))
    cond (gt (string-length (to-string v)) 0) v otherwise a)

  -- look up inverse op and flip flag
  idx-str  = to-string solve-idx
  pp-key   = concat "pratipaksha-" idx-str
  flip-key = concat pp-key "-flip"
  inv-op   = shabda math-op pp-key
  do-flip  = shabda math-op flip-key

  -- apply: inv-op(phala-val, other-val) or flipped
  result = cond (eq do-flip "true")
    (apply-op inv-op [other-val, phala-val])
  otherwise
    (apply-op inv-op [phala-val, other-val])

  return
    result  any

done

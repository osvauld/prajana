tantra materialize-question-graph

  -- convert a VList question graph into proof-graph nodes with typed edges.
  -- after this call the graph is traversable by walk/walk-in/has/edges.

  takes graph

  result = reduce graph [] (fn acc [subj, edge, obj] ->

    -- data edges: store in shabda (numeric values can't be node targets)
    cond
      (edge is sankhya)
        (let _ = emit-node subj "prashna" [] (concat "sankhya:" obj) acc)
      (edge is matra)
        (let _ = emit-node subj "prashna" [] (concat "matra:" obj) acc)
      (edge is asprista-sankhya)
        (let _ = emit-node subj "prashna" [] (concat "asprista-sankhya:" obj) acc)

      -- structural edges: build sloka and emit
      (edge is satya)
        (let _ = emit-node subj "prashna" [(concat obj "-satya")] ""
         (append acc [subj]))
      (edge is mithya)
        (let _ = emit-node subj "prashna" [(concat obj "-mithya")] ""
         (append acc [subj]))
      (edge is shashthi-vibhakti)
        (let _ = emit-node subj "prashna" [(concat obj "-shashthi-vibhakti")] ""
         (append acc [subj]))
      (edge is prathama-vibhakti)
        (let _ = emit-node subj "prashna" [(concat obj "-prathama-vibhakti")] ""
         (append acc [subj]))
      (edge is vidhi-kaala)
        (let _ = emit-node subj "prashna" [(concat obj "-vidhi-kaala")] ""
         (append acc [subj]))
      (edge is naama-mudra)
        (let _ = emit-node subj "prashna" [(concat obj "-naama-mudra")] ""
         (append acc [subj]))
      (edge is dvandva)
        (let _ = emit-node subj "prashna" [(concat obj "-q-dvandva")] ""
         (append acc [subj]))
      (edge is naama-pratibodha)
        (let _ = emit-node subj "prashna" [(concat obj "-naama-pratibodha")] ""
         (append acc [subj]))
      (edge is krama)
        (let _ = emit-node subj "prashna" [(concat obj "-krama")] ""
         (append acc [subj]))
      (edge is vishesa)
        (let _ = emit-node subj "prashna" [(concat obj "-vishesa")] ""
         (append acc [subj]))
      (edge is viraam)
        (let _ = emit-node subj "prashna" [(concat obj "-viraam")] ""
         (append acc [subj]))

      -- unknown edge type: skip
      otherwise acc)

  return result
done

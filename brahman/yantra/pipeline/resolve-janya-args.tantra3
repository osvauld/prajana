tantra3 resolve-janya-args

-- resolve a mantra's janya concepts to numeric values.
-- for each janya concept:
--   1. if it has a constants-key shabda, look up in physics-constants
--   2. otherwise find it in the bindings list [[concept, val], ...]
--
-- returns a list of numeric values in janya order, ready for apply-op or call-tantra.

takes mantra
takes bindings

janya = walk mantra "janya"

result = reduce janya [] (fn acc concept ->
  let ck = shabda concept "constants-key"
  let v  = cond (gt (string-length ck) 0)
    (nth (split-numeric (shabda "physics-constants" ck)) 0)
    otherwise
      (reduce bindings "" (fn a2 kv ->
        cond (eq (nth kv 0) concept) (nth kv 1) otherwise a2))
  append acc [v])

return result

done

tantra2 derive-step

-- one derivation pass over a question graph.
-- fires every mantra whose janya inputs are all bound and phala is not yet bound.
-- appends new [concept, sankhya, value] triples to the graph.
-- used by fixpoint: fixpoint refined derive-step

takes graph

bv   = bound-vals graph
bcs  = nth bv 0
vps  = nth bv 1

all-mantras = physics-mantras

new-triples = reduce all-mantras [] (fn acc mantra ->
  let janya    = walk mantra "janya"
  let phala-l  = walk mantra "phala"
  let phala    = cond (gt (length phala-l) 0) (nth phala-l 0) otherwise (shabda mantra "name")
  let all-ok   = reduce janya true (fn a r ->
    (and a (or (member r bcs) (gt (string-length (shabda r "constants-key")) 0))))
  let math-op  = shabda mantra "math-op"
  let has-math = gt (string-length math-op) 0
  let fired    = cond has-math (execute-math mantra vps) otherwise (execute-chain mantra vps)
  cond (or (member phala bcs) (not all-ok)) acc
  otherwise (append acc [[phala, "sankhya", fired]]))

result = reduce new-triples graph (fn g t -> (append g [t]))

return result

done

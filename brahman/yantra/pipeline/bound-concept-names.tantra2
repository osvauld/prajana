tantra2 bound-concept-names

-- return just the concept names (not values) that have sankhya bindings.
-- wraps bound-concepts and extracts index 0 from each [concept, value] pair.
-- used in 6 tantras: vishesa-bandhana, rashi-viveka, sankhya-bandha,
--   vishesa-instance, rashi-anuvada, mantra-coverage.

takes graph

result = map (bound-concepts graph) (fn kv -> nth kv 0)

return result

done

tantra kosha-expand

  -- PPR-based kosha expansion pass.
  -- extracts all active concept nodes (satya triples), uses them as PPR seeds,
  -- and appends kosha-janya triples for the highest-ranked related nodes.
  -- additive — no existing triples are removed or modified.

  takes graph

  -- extract satya node names
  satya-nodes = from graph
    where [s, e, o]
    and e is satya
    collect o

  -- build PPR seed pairs
  seed-pairs = map satya-nodes (fn n -> [n, "1.0"])

  -- collect names already present (subjects + objects)
  existing = reduce graph [] (fn acc [s, e, o] ->
    let with-s = cond (member s acc) acc otherwise (append acc [s])
    cond (member o with-s) with-s otherwise (append with-s [o]))

  threshold = 0.001
  top-k     = 100

  new-triples = cond (satya-nodes is empty)
    []
  otherwise
    (reduce satya-nodes [] (fn acc seed ->
      let results  = ppr seed-pairs seed []
      let filtered = reduce results [] (fn facc [name-v, score-v] ->
        let name  = to-string name-v
        let score = to-number (to-string score-v)
        cond (and (gt score threshold)
                  (not (member name existing))
                  (lt (length facc) top-k))
          (append facc [[seed, kosha-janya, name]])
        otherwise facc)
      append acc filtered))

  result = append graph new-triples

  return result
done

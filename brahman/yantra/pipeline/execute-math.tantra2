tantra2 execute-math

-- execute a math-backed mantra forward.
-- resolves janya to values via resolve-janya-args, applies the math-op eval primitive.

takes mantra
takes bindings

math-op = shabda mantra "math-op"
op-eval = shabda math-op "eval"
args    = resolve-janya-args mantra bindings
result  = apply-op op-eval args

return result

done

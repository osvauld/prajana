tantra2 extract-solve-for

-- extract the solve-for concept from a question graph.
-- looks for the satya concept immediately after a vidhi-kaala intent signal.
-- if no vidhi-kaala, falls back to the first satya concept seen.
--
-- returns the concept name as a string, or "" if none found.
--
-- examples:
--   "find kinetic energy given mass 5" → "kinetic-energy"
--   "mass is 5 velocity is 10"         → "mass" (first satya, no intent)
--   "what is the force"                → "force"

takes graph

sf-state = reduce graph [false, "", ""] (fn acc kv ->
  let s           = nth kv 0
  let e           = nth kv 1
  let o           = nth kv 2
  let past-intent = nth acc 0
  let fallback    = nth acc 1
  let sf          = nth acc 2
  cond
    (eq e "vidhi-kaala")                                        [true, fallback, sf]
    (and (not past-intent) (eq fallback "") (eq e "satya"))     [past-intent, s, sf]
    (and past-intent (eq sf "") (eq e "satya"))                 [past-intent, fallback, s]
    otherwise acc)

has-intent = nth sf-state 0
solve-for  = cond (gt (string-length (nth sf-state 2)) 0)
  (nth sf-state 2)
  otherwise (nth sf-state 1)

-- returns [has-intent, solve-for]
-- has-intent: true if vidhi-kaala was explicitly present
-- solve-for:  the concept to compute, or "" if none found
result = [has-intent, solve-for]

return result

done

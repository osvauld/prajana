-- build-question-graph.tantra
-- stateful reduce over sentence words → question graph (list of triples).

tantra build-question-graph
  takes sentence

  sent-punct = [".", "?", "!", ","]

  words  = split sentence " "
  graph  = reduce words [] (fn g word ->
    let wlen     = string-length word
    let last-ch  = cond (gt wlen 0) (char-at word (sub wlen 1)) otherwise ""
    let has-punct = member last-ch sent-punct
    let clean    = cond has-punct (substr word 0 (sub wlen 1)) otherwise word
    let punct    = cond has-punct last-ch otherwise ""

    let node     = cond (gt (string-length clean) 0) (lookup-word clean) otherwise _none
    let role     = cond (exists node) (shabda node "role")  otherwise ""
    let layer    = cond (exists node) (node-layer node)     otherwise ""
    let parts    = split-numeric clean
    let num-str  = nth parts 0
    let uni-str  = nth parts 1
    let num-val  = cond (gt (string-length num-str) 0) num-str otherwise ""
    let uni-nod  = cond (gt (string-length uni-str) 0) (word-node uni-str) otherwise ""
    let ctx      = find-context g
    let info     = [(to-string node), role, layer, num-val, (to-string uni-nod)]
    let triples  = emit-triples clean info ctx

    let with-word = append g triples
    cond (gt (string-length punct) 0)
      (append with-word [[punct, viraam, punct]])
    otherwise with-word)

  -- sandhi-viveka: promote grammar mithya words to typed dimension triples
  after-sandhi = sandhi-viveka graph

  -- kosha-expand: PPR-based kosha expansion
  result = kosha-expand after-sandhi

  return result
done

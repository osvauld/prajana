tantra2 bound-concepts

-- return all [concept, value] pairs that have a sankhya triple in the graph.
-- this is what derive-step and match-mantra see as "bound" numeric inputs.
--
-- returns [[concept, value], ...]
--
-- example:
--   bound-concepts (fixpoint (build-question-graph "mass 5 velocity 10") avrti-refine)
--   → [["mass", "5."], ["velocity", "10."]]

takes graph

result = graph | where [s, e, o] | and (eq e "sankhya") | collect [s, o]

return result

done

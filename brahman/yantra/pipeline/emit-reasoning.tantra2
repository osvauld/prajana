tantra2 emit-reasoning

-- pancavayava emission: pure graph traversal.
-- the proof graph carries the reasoning via typed edges.
-- this tantra walks those edges and lets each type speak in its own voice.
--
-- edge vocabulary read here:
--   [s, sankhya, v]         pratijna — we have (given values)
--   [s, derived-by, m]      udaharana source — which mantra produced s
--   [s, sought, label]      hetu — what is being sought (and how asked)
--   [s, sought-of, entity]  hetu scope — whose frame
--   [A, greater-than, B]    nigamana for viveka — A beats B
--   [A, viveka-concept, c]  udaharana for viveka — compared on concept c
--   [A, viveka-direction, d] udaharana for viveka — max or min
--   [A, viveka-sankhya, v]  upanaya for viveka — A's value
--   [B, viveka-sankhya, v]  upanaya for viveka — B's value
--
-- no viveka-ctx, no chain-steps, no external context.
-- the graph is the reasoning. the walk is the speech.
--
-- uttama-purusa-bahu-vachana kartari: "we" = nam + human + LLM.

takes graph

-- ── speech acts from anuvada-setu.shabda ─────────────────────────────────────
say-given    = shabda "anuvada-setu" "speech-given"
say-sought   = shabda "anuvada-setu" "speech-sought"
say-of       = shabda "anuvada-setu" "speech-of"
say-known    = shabda "anuvada-setu" "speech-known"
say-seen     = shabda "anuvada-setu" "speech-seen"
say-found    = shabda "anuvada-setu" "speech-found"
sep-strands  = shabda "anuvada-setu" "speech-strand-separator"
say-no-match = shabda "anuvada-setu" "speech-no-match"
rel-sankhya  = shabda "anuvada-setu" "rel-sankhya"
say-gt       = shabda "anuvada-setu" "speech-greater-than"
say-lt       = shabda "anuvada-setu" "speech-less-than"
say-is       = shabda "anuvada-setu" "speech-is"
say-than     = shabda "anuvada-setu" "speech-than"
say-applying = shabda "anuvada-setu" "speech-applying"

-- ── derived concepts (excluded from we-have) ─────────────────────────────────
derived-concepts = graph | where [s, e, o] | and (eq e "derived-by") | collect (to-string s)

-- ── is-viveka: greater-than edge present ─────────────────────────────────────
gt-triples = graph | where [s, e, o] | and (eq e "greater-than") | collect [s, o]
is-viveka  = gt (length gt-triples) 0

-- ── 1. PRATIJNA — we have ─────────────────────────────────────────────────────
-- viveka: show entity (concept=val) from viveka-sankhya edges
-- physics/count: show owned entities, then flat unowned given values

entities = graph | where [s, e, o] | and (eq e "prathama-vibhakti") | collect s

-- viveka-concept for grouping label
vc-concept = nth (graph | where [s, e, o] | and (eq e "viveka-concept") | collect (to-string o)) 0

-- viveka entity strs from viveka-sankhya edges
viveka-entity-strs = cond is-viveka
  (reduce entities [] (fn acc ent ->
    let vs = graph | where [s, e, o]
      | and (eq (to-string s) (to-string ent))
      | and (eq e "viveka-sankhya")
      | collect o
    cond (gt (length vs) 0)
      (append acc [(concat (to-string ent) " (" (to-string vc-concept) rel-sankhya (to-string (nth vs 0)) ")")])
    otherwise acc))
  otherwise []

-- standard entity grouping via shashthi
std-entity-strs = cond (not is-viveka)
  (entity-props-str graph entities)
  otherwise []

-- owned concepts for flat dedup
owned-concepts = reduce graph [] (fn acc tri ->
  cond (and (eq (nth tri 1) "shashthi-vibhakti")
            (neq (to-string (nth tri 2)) "shashthi-vibhakti"))
    (append acc [(to-string (nth tri 0))])
  otherwise acc)

-- flat given values: not owned, not derived
flat-strs = cond (not is-viveka)
  (reduce graph [] (fn acc tri ->
    cond (eq (nth tri 1) "sankhya")
      (let c = to-string (nth tri 0)
       cond (or (member c owned-concepts) (member c derived-concepts)) acc
       otherwise (append acc [(concat c rel-sankhya (to-string (nth tri 2)))]))
    otherwise acc))
  otherwise []

entity-strs = cond is-viveka viveka-entity-strs otherwise std-entity-strs
all-given   = append entity-strs flat-strs

given-str = cond (gt (length all-given) 0)
  (concat say-given ": " (list-join all-given))
  otherwise ""

-- ── 2. HETU — we seek ────────────────────────────────────────────────────────
-- walk [solve-for, sought, label] and [solve-for, sought-of, scope]
sought-entries = graph | where [s, e, o] | and (eq e "sought") | collect [s, o]
scope-entries  = graph | where [s, e, o] | and (eq e "sought-of") | collect [s, o]

sought-sf    = cond (gt (length sought-entries) 0) (to-string (nth (nth sought-entries 0) 0)) otherwise ""
sought-label = cond (gt (length sought-entries) 0) (to-string (nth (nth sought-entries 0) 1)) otherwise ""
scope-entity = cond (gt (length scope-entries)  0) (to-string (nth (nth scope-entries  0) 1)) otherwise ""

sought-str = cond is-viveka
  (concat say-sought ": which " say-is " " sought-label)
  otherwise (cond (gt (string-length sought-sf) 0)
    (cond (gt (string-length scope-entity) 0)
      (concat say-sought ": " sought-sf " " say-of " " scope-entity)
      otherwise (concat say-sought ": " sought-sf))
    otherwise "")

-- ── 3+4. UDAHARANA + UPANAYA — we know / we see ──────────────────────────────
-- viveka: walk viveka-concept + viveka-direction for udaharana
--         walk viveka-sankhya + greater-than for upanaya
-- physics/count: walk derived-by edges → mantra-known-str + mantra-seen-str

-- viveka udaharana
vk-direction = nth (graph | where [s, e, o] | and (eq e "viveka-direction") | collect (to-string o)) 0
vk-winner    = cond (gt (length gt-triples) 0) (to-string (nth (nth gt-triples 0) 0)) otherwise ""
vk-loser     = cond (gt (length gt-triples) 0) (to-string (nth (nth gt-triples 0) 1)) otherwise ""

viveka-known-str = cond is-viveka
  (cond (eq (to-string vk-direction) "max")
    (concat say-known ": greater " (to-string vc-concept) " means " sought-label)
    otherwise (concat say-known ": lesser " (to-string vc-concept) " means " sought-label))
  otherwise ""

-- viveka upanaya: walk viveka-sankhya for winner and loser
vk-wval = nth (graph | where [s, e, o] | and (eq (to-string s) vk-winner) | and (eq e "viveka-sankhya") | collect (to-string o)) 0
vk-lval = nth (graph | where [s, e, o] | and (eq (to-string s) vk-loser)  | and (eq e "viveka-sankhya") | collect (to-string o)) 0

viveka-seen-str = cond is-viveka
  (let cmp-sym = cond (eq (to-string vk-direction) "max") say-gt otherwise say-lt
   let cmp-str = (concat (to-string vk-wval) " " cmp-sym " " (to-string vk-lval))
   let ctx-str = (concat vk-winner " " (to-string vc-concept) " " cmp-sym " " vk-loser " " (to-string vc-concept))
   (concat say-seen ": " cmp-str " (" ctx-str ")"))
  otherwise ""

-- physics/count: unique derived-by mantras in graph order
-- each derived-by edge = one udaharana + one upanaya pair
-- we deduplicate: same mantra firing twice → show once with combined we-see
deriving-mantras = unique (graph | where [s, e, o] | and (eq e "derived-by") | collect (to-string o))

-- derived-sankhya: scoped val-pairs injected by anuvada-ganana
-- prefer these over raw sankhya for we-see (gives correct scoped values)
derived-vp = graph | where [s, e, o] | and (eq e "derived-sankhya") | collect [s, o]
has-derived-vp = gt (length derived-vp) 0

chain-know-see = cond (and (not is-viveka) (gt (length deriving-mantras) 0))
  (reduce deriving-mantras [] (fn acc mn ->
    -- concepts derived by this mantra
    let produced = graph | where [s, e, o]
      | and (eq e "derived-by")
      | and (eq (to-string o) mn)
      | collect (to-string s)
    -- prefer scoped derived-sankhya; fall back to all sankhya
    let vp = cond has-derived-vp derived-vp
      otherwise (graph | where [s, e, o] | and (eq e "sankhya") | collect [s, o])
    let mm = [mn, vp, "forward"]
    let kstr = (mantra-known-str mm)
    let sstr = (mantra-seen-str mm produced)
    cond (gt (string-length kstr) 0)
      (append acc [kstr, sstr])
    otherwise acc))
  otherwise []

-- single direct match (no derive-step fired)
direct-match = graph | where [s, e, o] | and (eq e "direct-match") | collect [s, o]

-- fallback: use matched arg if no derived-by edges
has-chain = gt (length chain-know-see) 0

know-see-strs = cond is-viveka
  (filter [viveka-known-str, viveka-seen-str] (fn s -> gt (string-length s) 0))
  otherwise (cond has-chain chain-know-see otherwise [])

-- ── 5. NIGAMANA — we find ─────────────────────────────────────────────────────
-- walk [solve-for, sankhya, result] for physics/count
-- walk [A, greater-than, B] for viveka

-- viveka nigamana
vk-ev-count = length (graph | where [s, e, o] | and (eq e "viveka-sankhya") | collect s)

viveka-found = cond is-viveka
  (cond (eq vk-ev-count 2)
    (concat say-found ": " vk-winner " " say-is " " sought-label " " say-than " " vk-loser)
    otherwise (concat say-found ": " vk-winner " " say-is " the " sought-label))
  otherwise ""

-- physics/count nigamana: the sought concept's final sankhya value
-- only show if it was derived (has derived-by edge)
sf-val = nth (graph | where [s, e, o]
  | and (eq (to-string s) sought-sf)
  | and (eq e "sankhya")
  | collect (to-string o)) 0

physics-found = cond (and (not is-viveka) (gt (string-length (to-string sf-val)) 0))
  (concat say-found ": " sought-sf " " rel-sankhya " " (to-string sf-val))
  otherwise ""

found-str = cond is-viveka viveka-found
  otherwise (cond (gt (string-length physics-found) 0) physics-found
  otherwise (to-string say-no-match))

-- ── weave — Manipravalam ──────────────────────────────────────────────────────
all-strands = append (append [given-str, sought-str] know-see-strs) [found-str]

strands = reduce all-strands [] (fn acc s ->
  cond (gt (string-length s) 0) (append acc [s]) otherwise acc)

woven = reduce strands "" (fn acc strand ->
  cond (eq (string-length acc) 0) strand
  otherwise (concat acc sep-strands " " strand))

return woven

done

tantra2 try-morpheme-rules

-- graph-walk morpheme inversion.
-- reads all bahu-vachana morpheme rules from the graph (suffix, stem-suffix),
-- applies each inverse to the word, returns the first node hit.

takes word

rules = walk-in "vachana-bahu" "sthita"
wlen  = string-length word

result = reduce rules _none (fn acc rl ->
  let sf     = shabda rl "suffix"
  let ssf    = shabda rl "stem-suffix"
  let sf-len = string-length sf
  let ok     = (and (ends-with word sf) (gt wlen sf-len))
  let stem   = (cond ok (concat (substr word 0 (sub wlen sf-len)) ssf) otherwise "")
  let hit    = (cond (gt (string-length stem) 0) (lookup stem) otherwise _none)
  (cond (exists acc) acc otherwise hit))

return result

done

tantra try-morpheme-rules

  -- graph-walk morpheme inversion.
  -- reads all bahu-vachana morpheme rules from the graph (suffix, stem-suffix),
  -- applies each inverse to the word, returns the first node hit.
  -- adding a new morpheme rule (.om file) is picked up automatically.

  takes word

  rules = walk-in "vachana-bahu" "sthita"
  len   = string-length word

  result = reduce rules _none (fn acc rule ->
    cond (acc exists) acc
    otherwise
      (let suf      = shabda rule "suffix"
       let stem-suf = shabda rule "stem-suffix"
       let suf-len  = string-length suf
       let stem     = cond (and (ends-with word suf) (gt len suf-len))
                        (concat (substr word 0 (sub len suf-len)) stem-suf)
                      otherwise ""
       cond (gt (string-length stem) 0) (lookup stem)
       otherwise _none))

  return result
done

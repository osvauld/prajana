tantra3 assertion-bandha

takes graph

quant-words = split (shabda "quantifier" "word") ","

result = scan graph [subj: str = "", subj-ok: bool = false, saw-cop: bool = false]:

  [word, viraam, _] ->
    subj    = ""
    subj-ok = false
    saw-cop = false
    emit

  [word, mithya, _]
    when (member (to-string word) quant-words)
    ->
      subj    = ""
      subj-ok = false
      saw-cop = true
      emit

  [word, satya, _]
    when (eq (to-string word) "quantifier")
    ->
      subj    = ""
      subj-ok = false
      saw-cop = true
      emit

  [word, mithya, _]
    when (neq subj "")
    when saw-cop
    when (has-text (word-resolve (to-string word)))
    ->
      emit
      emit [subj, "swarupa", (word-resolve (to-string word))]
      subj    = ""
      subj-ok = false
      saw-cop = false

  [word, copula, _]
    when subj-ok
    ->
      saw-cop = true

  [word, copula, _] ->
    emit

  [word, mithya, _] ->
    subj    = resolve-or-self (to-string word)
    subj-ok = false
    emit

  [word, satya, _]
    when saw-cop
    when (eq subj "")
    ->
      subj    = resolve-or-self (to-string word)
      subj-ok = true
      emit

  [word, satya, _]
    when saw-cop
    when (neq subj "")
    ->
      emit
      emit [subj, "swarupa", (to-string word)]
      subj    = ""
      subj-ok = false
      saw-cop = false

  [word, satya, _] ->
    subj    = (to-string word)
    subj-ok = true
    saw-cop = false
    emit

  _ ->
    emit

return result

done

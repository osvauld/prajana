tantra debug-bound-concepts

  -- given a refined question graph, return all [concept, value] pairs
  -- that derive-step would see as "bound" (i.e. have a sankhya triple).
  -- use this to debug why a mantra is not firing.
  --
  -- returns a list of [concept, value] pairs, one per bound concept.
  --
  -- example:
  --   g = fixpoint (build-question-graph "ball has mass m1 of 5 and velocity v1 of 20") avrti-refine
  --   debug-bound-concepts g
  --   → [["mass", "5."], ["velocity", "20."]]   (after rashi-anuvada bridge)
  --   → []                                       (before bridge — rashi-anuvada not wired)

  takes graph

  result = reduce graph [] (fn acc [s, e, o] ->
    cond (e is sankhya)
      (append acc [[s, o]])
    otherwise acc)

  return result
done

tantra mantra-coverage

  -- given a refined question graph, return coverage info for every mantra:
  --   which janya concepts are bound, which are missing, whether it fires.
  --
  -- returns a list of [mantra-name, fires, covered, missing] tuples where:
  --   mantra-name  string — name of the mantra node
  --   fires        bool   — true if all janya are in bound-concepts
  --   covered      list   — janya concepts that ARE bound
  --   missing      list   — janya concepts that are NOT bound
  --
  -- example (before rashi-anuvada bridge):
  --   g = fixpoint (build-question-graph "ball has mass m1 of 5 and velocity v1 of 20") avrti-refine
  --   mantra-coverage g
  --   → [["kinetic-energy-mantra", false, [], ["mass","velocity"]], ...]
  --
  -- example (after bridge):
  --   → [["kinetic-energy-mantra", true, ["mass","velocity"], []], ...]

  takes graph

  -- collect bound concepts (nodes with sankhya triple)
  bound = map (bound-concepts graph) (fn kv -> nth kv 0)

  -- all mantra nodes
  all-mantras = physics-mantras

  result = map all-mantras (fn m ->
    let janya    = walk m "janya"
    let covered  = filter janya  (fn r -> member r bound)
    let missing  = filter janya  (fn r -> not (member r bound))
    let fires    = (length missing) is 0
    [m, fires, covered, missing])

  return result
done

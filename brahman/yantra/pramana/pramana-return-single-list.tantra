tantra pramana-return-single-list

  -- @proves pitfall-12a (single-list return)
  --
  -- Engine behavior: when a tantra declares exactly one return of type list,
  -- the engine returns the VList directly (NOT wrapped in another VList).
  -- Correct access: use the result directly as a list.
  -- Wrong access: nth result 0 gives only element 0 of the list.
  --
  -- This pramana invokes torque-gravity-ndof (single list return) and verifies
  -- the result IS the full list, not a wrapper around it.

  inputs
    dummy  float

  let
    -- build a minimal 2-joint scenario
    masses  = split "1 1" " "
    lengths = split "0.5 0.5" " "
    g       = 9.80665

    -- call a single-list-return tantra
    torques = torque-gravity-ndof 2 masses lengths g

    -- CORRECT: torques IS the list — length should be 2
    n       = length torques
    ok-len  = eq n 2

    -- CORRECT: nth torques 0 gives first element (a float)
    t0      = nth torques 0
    ok-t0   = gt t0 0

    -- CONTRAST (the bug): if you mistakenly did nth result 0 on a wrapped
    -- single-list, you'd get only element 0, not the list.
    -- Here torques IS the list, so nth torques 0 correctly gives element 0.

    result  = cond ok-len (cond ok-t0 "pass" otherwise "fail: t0 not positive")
              otherwise (concat "fail: expected length 2, got " (to-string n))

  return
    result  string

done

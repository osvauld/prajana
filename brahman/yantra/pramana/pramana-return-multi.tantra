tantra pramana-return-multi

  -- @proves pitfall-12b (multi-return access)
  --
  -- Engine behavior: when a tantra declares N > 1 returns, the engine wraps
  -- all return values into a VList. Access slot i via nth result i.
  -- List-typed slots come back as full lists (not flattened).
  --
  -- This pramana invokes fk-ndof (3 float returns) and verifies each slot
  -- is independently accessible via nth.

  inputs
    dummy  float

  let
    -- 2-joint Z-axis arm, angles=0, lengths=[5,3] → end-effector at [8,0,0]
    a    = split "0 0" " "
    axs  = split "0 0" " "
    ays  = split "0 0" " "
    azs  = split "1 1" " "
    ls   = split "5 3" " "
    r    = fk-ndof 2 a axs ays azs ls

    -- multi-return: nth r 0 = ex, nth r 1 = ey, nth r 2 = ez
    ex   = nth r 0
    ey   = nth r 1
    ez   = nth r 2

    -- expected: ex=8, ey=0, ez=0
    ok-ex = (and (gt ex 7.9) (lt ex 8.1))
    ok-ey = lt (abs ey) 0.1
    ok-ez = lt (abs ez) 0.1

    result = cond ok-ex
               (cond ok-ey
                 (cond ok-ez "pass" otherwise (concat "fail: ez=" (to-string ez)))
                 otherwise (concat "fail: ey=" (to-string ey)))
               otherwise (concat "fail: ex=" (to-string ex))

  return
    result  string

done

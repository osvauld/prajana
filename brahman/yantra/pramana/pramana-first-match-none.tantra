tantra pramana-first-match-none

  -- @proves pitfall-10 (first-match returns _none, not false)
  --
  -- Engine behavior: first-match returns VNone when no element matches,
  -- not VBool false. Use exists to test, not eq result false.
  --
  -- WRONG: eq (first-match [] ...) false → false (VNone != VBool false)
  -- RIGHT: exists (first-match [] ...) → false (VNone is non-existent)

  inputs
    dummy  float

  let
    items   = split "a b c" " "

    -- case 1: no match — returns _none
    no-hit  = first-match items (fn x -> cond (eq x "z") x otherwise _none)

    -- WRONG check: eq no-hit false → this returns false because VNone != VBool false
    wrong-check = eq no-hit false

    -- RIGHT check: exists no-hit → false because VNone is non-existent
    right-check = exists no-hit

    -- case 2: match found — returns the value
    hit     = first-match items (fn x -> cond (eq x "b") x otherwise _none)
    has-hit = exists hit
    is-b    = eq hit "b"

    ok-wrong  = eq wrong-check false
    ok-right  = eq right-check false
    ok-hit    = (and has-hit is-b)

    result = cond ok-wrong
               (cond ok-right
                 (cond ok-hit "pass"
                   otherwise "fail: hit should be b")
                 otherwise "fail: exists should return false for _none")
               otherwise "fail: eq _none false should be false"

  return
    result  string

done

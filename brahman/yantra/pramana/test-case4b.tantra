tantra test-case4b

  -- Check what classify-fold produces for the actual tokens in case 4 sentence.
  -- Then feed those exact classified tokens into extract-vector-coords.

  inputs
    dummy  float

  let
    sentence = "2-DOF arm link lengths 0.4m and 0.3m masses 2kg and 1kg joint speed 2 rad/s rated torque 6 N*m rated power 25W target position [0.5, 0.2] minimize power"
    words      = split sentence " "
    classified = classify-fold words
    n-toks     = length classified

    -- find what "target" and "position" classify as
    target-tok  = first-match classified (fn t -> cond (eq (nth t 0) "target") t otherwise _none)
    pos-tok     = first-match classified (fn t -> cond (eq (nth t 0) "position") t otherwise _none)
    bracket-tok = first-match classified (fn t -> cond (eq (nth t 0) "[") t otherwise _none)

    target-kind  = cond (exists target-tok)  (nth target-tok  1) otherwise "NOT-FOUND"
    pos-kind     = cond (exists pos-tok)     (nth pos-tok     1) otherwise "NOT-FOUND"
    bracket-kind = cond (exists bracket-tok) (nth bracket-tok 1) otherwise "NOT-FOUND"

    -- now run extract-vector-coords on the full classified stream
    triggers = split "to,position,target,effector" ","
    coords   = extract-vector-coords classified triggers 3
    n-coords = length coords
    x        = cond (gt n-coords 0) (nth coords 0) otherwise "none"
    y        = cond (gt n-coords 1) (nth coords 1) otherwise "none"

    result = (concat
      "toks=" (to-string n-toks)
      " target-kind=" target-kind
      " pos-kind=" pos-kind
      " bracket-kind=" bracket-kind
      " | coords:n=" (to-string n-coords)
      " x=" x " y=" y)

  return
    result  string

done

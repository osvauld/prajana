tantra validate-all-pramanas

  -- Orchestrator: runs all pramana tantras and collects pass/fail results.
  -- Usage: EVAL validate-all-pramanas 0
  -- Each pramana tantra returns a single string: "pass" or "fail: reason".
  -- This tantra aggregates them into a report.

  inputs
    dummy  float

  let
    -- run each pramana tantra (all have single scalar return → nth result 0)
    r1-raw = pramana-return-single-list 0
    r1     = nth r1-raw 0
    r2-raw = pramana-return-multi 0
    r2     = nth r2-raw 0
    r3-raw = pramana-first-match-none 0
    r3     = nth r3-raw 0
    r4-raw = pramana-pair-nth 0
    r4     = nth r4-raw 0
    r5-raw = pramana-reduce-last-let 0
    r5     = nth r5-raw 0
    r6-raw = pramana-type-coercion 0
    r6     = nth r6-raw 0
    r7-raw = pramana-tostring-format 0
    r7     = nth r7-raw 0
    r8-raw = pramana-local-fn-call 0
    r8     = nth r8-raw 0

    -- count failures
    f1 = cond (eq r1 "pass") 0 otherwise 1
    f2 = cond (eq r2 "pass") 0 otherwise 1
    f3 = cond (eq r3 "pass") 0 otherwise 1
    f4 = cond (eq r4 "pass") 0 otherwise 1
    f5 = cond (eq r5 "pass") 0 otherwise 1
    f6 = cond (eq r6 "pass") 0 otherwise 1
    f7 = cond (eq r7 "pass") 0 otherwise 1
    f8 = cond (eq r8 "pass") 0 otherwise 1
    total-fail = add f1 (add f2 (add f3 (add f4 (add f5 (add f6 (add f7 f8))))))

    fail-str = to-string total-fail
    report = (concat
      "pramana-return-single-list:  " r1
      "\npramana-return-multi:        " r2
      "\npramana-first-match-none:    " r3
      "\npramana-pair-nth:            " r4
      "\npramana-reduce-last-let:     " r5
      "\npramana-type-coercion:       " r6
      "\npramana-tostring-format:     " r7
      "\npramana-local-fn-call:       " r8
      "\n---\nfail:" fail-str)

  return
    report  string

done

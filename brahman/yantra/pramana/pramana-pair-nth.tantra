tantra pramana-pair-nth

  -- @proves pitfall-11 (pair first arg always stringified)
  --
  -- Engine behavior: VPair(name, value) — nth pair 0 always returns VString,
  -- even if the first argument was a float. nth pair 1 returns the value as-is.
  --
  -- This matters when using pair as a 2-slot accumulator in reduce:
  -- pair 42.0 "hello" → nth 0 = "42" (string!), nth 1 = "hello"

  inputs
    dummy  float

  let
    -- create a pair with a float as first arg
    p      = pair 42.0 "hello"

    -- nth p 0 gives the NAME — always a VString
    slot0  = nth p 0
    slot1  = nth p 1

    -- slot0 is "42" (string), not 42.0 (float)
    -- eq slot0 42.0 would succeed due to coercion, so test string identity
    is-str = eq slot0 "42"

    -- slot1 is "hello" (the value, unchanged)
    is-val = eq slot1 "hello"

    -- also verify: pair with string first arg
    p2     = pair "myname" 99
    name2  = nth p2 0
    val2   = nth p2 1
    ok-n2  = eq name2 "myname"
    ok-v2  = eq val2 99

    result = cond is-str
               (cond is-val
                 (cond ok-n2
                   (cond ok-v2 "pass"
                     otherwise "fail: pair string-name val2 wrong")
                   otherwise "fail: pair string-name name2 wrong")
                 otherwise (concat "fail: slot1=" (to-string slot1)))
               otherwise (concat "fail: slot0 should be string '42', got " (to-string slot0))

  return
    result  string

done

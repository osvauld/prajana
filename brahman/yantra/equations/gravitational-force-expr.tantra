tantra gravitational-force-expr

  -- F = G·m1·m2 / r²
  -- forward: given gravitational-constant, mass1, mass2, radius → gravitational-force

  inputs
    gravitational-constant  number
    mass1                   number
    mass2                   number
    radius                  number

  let

  value = div (mul gravitational-constant (mul mass1 mass2)) (square radius)

  return
    value  any

done

-- extract solve-for concept and scope entity from question graph.
-- relational: find the question grade, query concepts within it.
(tantra extract-solve-for (graph)
  (entities (prathama-sparsha graph))
  (grades (split-grades graph))

  -- find the question grade (contains vidhi-kaala)
  (q-grade (reduce grades [] (fn acc g ->
    cond (has-items (triples-by-edge g "vidhi-kaala")) g otherwise acc)))
  (has-intent (has-items (triples-by-edge q-grade "vidhi-kaala")))

  -- solve-for: first non-entity satya concept in question grade
  (solve-for (reduce q-grade "" (fn found tri ->
    cond (has-text found) found
    (and (eq (nth tri 1) "satya") (not (member (nth tri 0) entities)))
      (str tri 0)
    otherwise found)))

  -- fallback: if no question grade, first non-entity satya in whole graph
  (fallback (cond (has-text solve-for) solve-for
    otherwise (reduce graph "" (fn found tri ->
      cond (has-text found) found
      (and (eq (nth tri 1) "satya") (not (member (nth tri 0) entities)))
        (str tri 0)
      otherwise found))))

  -- scope entity: entity in question grade (mithya or satya that is an entity)
  (scope-entity (reduce q-grade "" (fn found tri ->
    cond (has-text found) found
    (and (or (eq (nth tri 1) "mithya") (eq (nth tri 1) "satya"))
         (member (nth tri 0) entities))
      (str tri 0)
    otherwise found)))

  [has-intent, fallback, scope-entity])

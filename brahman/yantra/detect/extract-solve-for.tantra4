-- extract solve-for concept and scope entity from question graph.
-- relational: find the question grade, query concepts within it.
(tantra extract-solve-for (graph)
  (entities (prathama-sparsha graph))
  (grades (split-grades graph))

  -- find the question grade (contains vidhi-kaala)
  (q-grade (find-first grades (fn g -> has-items (triples-by-edge g "vidhi-kaala"))))
  (eff-grade (cond (exists q-grade) q-grade otherwise []))
  (has-intent (has-items (triples-by-edge eff-grade "vidhi-kaala")))

  -- solve-for: first non-entity satya concept in question grade
  (solve-for (find-map eff-grade (fn [s, e, o] ->
    cond (and (eq e "satya") (not (member s entities))) s
    otherwise _none)))

  -- fallback: if no question grade, first non-entity satya in whole graph
  (fallback (cond (exists solve-for) solve-for
    otherwise (find-map graph (fn [s, e, o] ->
      cond (and (eq e "satya") (not (member s entities))) s
      otherwise _none))))

  -- scope entity: entity in question grade (mithya or satya that is an entity)
  (scope-entity (find-map eff-grade (fn [s, e, o] ->
    cond (and (or (eq e "mithya") (eq e "satya")) (member s entities)) s
    otherwise _none)))

  [has-intent, fallback, scope-entity])

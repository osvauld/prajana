tantra firstness-of-triple

  -- assigns a tier (basis coefficient) to each (intent, relation-type) pair.
  -- this is the intent-dependent projection matrix for the visheshanam ring:
  -- each intent selects which relation axes are primary (aadya), secondary
  -- (anantara), conditional (apara), or zero (anuvritta).
  --
  -- the 5 intents × 10 relations form a 5×10 coefficient table.
  -- used by visheshanam-projection to select the relevant subspace.
  --
  -- tiers:
  --   aadya     = primary basis vector   (always kept, coefficient 1.0)
  --   anantara  = secondary basis        (always kept, coefficient 1.0)
  --   apara     = conditional basis      (kept if target has satya > 0)
  --   anuvritta = zero coefficient       (always dropped)

  inputs
    intent  string
    triple  list

  let
    rel = nth triple 1
    target = nth triple 2

    has-samskaara = eq target "samskaara"
    has-parampara = eq target "parampara"

    rank = cond
      (eq intent "transmission")
        (cond
          (and (eq rel "phala") has-samskaara) "aadya"
          (and (eq rel "phala") has-parampara) "anantara"
          (eq rel "phala") "apara"
          (eq rel "yukta") "apara"
          (eq rel "sthita") "apara"
          (eq rel "kriya") "apara"
          (eq rel "abheda") "anuvritta"
          otherwise "anuvritta")

      (eq intent "identity")
        (cond
          (eq rel "swarupa") "aadya"
          (eq rel "abheda") "anantara"
          (or (eq rel "sthita") (eq rel "yukta")) "apara"
          (eq rel "drishthanta") "anuvritta"
          otherwise "anuvritta")

      (eq intent "origin")
        (cond
          (eq rel "janya") "aadya"
          (eq rel "swarupa") "anantara"
          (eq rel "abheda") "apara"
          (eq rel "yukta") "apara"
          (eq rel "sthita") "apara"
          otherwise "anuvritta")

      (eq intent "process")
        (cond
          (eq rel "kriya") "aadya"
          (eq rel "yukta") "anantara"
          (eq rel "sthita") "anantara"
          (eq rel "phala") "apara"
          (eq rel "abheda") "apara"
          (eq rel "drishthanta") "anuvritta"
          otherwise "anuvritta")

      (eq intent "consequence")
        (cond
          (eq rel "phala") "aadya"
          (eq rel "kriya") "anantara"
          (eq rel "yukta") "apara"
          (eq rel "sthita") "apara"
          (eq rel "abheda") "anuvritta"
          otherwise "anuvritta")

      otherwise
        (cond
          (eq rel "swarupa") "aadya"
          (eq rel "abheda") "anantara"
          (or (eq rel "yukta") (eq rel "sthita")) "apara"
          otherwise "anuvritta")

  return
    rank  string

done

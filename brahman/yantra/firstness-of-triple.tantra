tantra firstness-of-triple

  inputs
    intent  string
    triple  list

  let
    rel = nth triple 1
    target = nth triple 2

    has-samskaara = eq target "samskaara"
    has-parampara = eq target "parampara"

    rank = cond
      (eq intent "transmission")
        (cond
          (and (eq rel "phala") has-samskaara) "aadya"
          (and (eq rel "phala") has-parampara) "anantara"
          (eq rel "phala") "apara"
          (eq rel "yukta") "apara"
          (eq rel "sthita") "apara"
          (eq rel "kriya") "apara"
          (eq rel "abheda") "anuvritta"
          otherwise "anuvritta")

      (eq intent "identity")
        (cond
          (eq rel "swarupa") "aadya"
          (eq rel "abheda") "anantara"
          (or (eq rel "sthita") (eq rel "yukta")) "apara"
          (eq rel "drishthanta") "anuvritta"
          otherwise "anuvritta")

      (eq intent "origin")
        (cond
          (eq rel "janya") "aadya"
          (eq rel "swarupa") "anantara"
          (eq rel "abheda") "apara"
          (eq rel "yukta") "apara"
          (eq rel "sthita") "apara"
          otherwise "anuvritta")

      (eq intent "process")
        (cond
          (eq rel "kriya") "aadya"
          (eq rel "yukta") "anantara"
          (eq rel "sthita") "anantara"
          (eq rel "phala") "apara"
          (eq rel "abheda") "apara"
          (eq rel "drishthanta") "anuvritta"
          otherwise "anuvritta")

      (eq intent "consequence")
        (cond
          (eq rel "phala") "aadya"
          (eq rel "kriya") "anantara"
          (eq rel "yukta") "apara"
          (eq rel "sthita") "apara"
          (eq rel "abheda") "anuvritta"
          otherwise "anuvritta")

      otherwise
        (cond
          (eq rel "swarupa") "aadya"
          (eq rel "abheda") "anantara"
          (or (eq rel "yukta") (eq rel "sthita")) "apara"
          otherwise "anuvritta")

  return
    rank  string

done

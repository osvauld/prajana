tantra resolve-node

  -- returns the canonical node name plus all abheda-equivalent aliases.
  -- includes both outgoing and incoming abheda edges.

  inputs
    n  string

  let
    out-abhedas = walk n "abheda"
    in-abhedas  = walk-in n "abheda"
    result      = unique (flatten [[n] out-abhedas in-abhedas])

  return
    result  list

done

tantra sandhi-avastha

  -- avastha qualification: mithya qualifier + satya concept → synthesized compound key.
  -- runs after sandhi-kosha. handles patterns that kosha lookup missed.
  -- when last pending mithya is an avastha qualifier preceding a satya concept:
  --   synthesize qualifier-concept as the compound key (no kosha node needed)
  --   emit [qualifier-concept, satya, qualifier-concept]
  --      + [qualifier-concept, sandhi-rename, concept]  (consumed by sandhi-bandhana)
  -- example: "initial" + "velocity" → "initial-velocity" (satya)
  -- example: "final"   + "velocity" → "final-velocity"   (satya)
  -- avastha qualifiers: initial, final, angular, linear, net, total, average, relative

  inputs
    graph  list

  let
    avastha-qualifiers = ["initial", "final", "angular", "linear",
                          "net", "total", "average", "relative"]

    pass = reduce graph [[], []] (fn state tri ->
      let pending = nth state 0
      let out     = nth state 1
      let edge    = nth tri 1
      let word    = nth tri 0
      let n-pend  = length pending

      let last-pend = cond (gt n-pend 0) (nth pending (sub n-pend 1)) otherwise ""

      let prefix-out = reduce (range (max 0 (sub n-pend 1))) out (fn acc i ->
        append acc [[(nth pending i), "mithya", (nth pending i)]])

      let full-flush = reduce pending out (fn acc w ->
        append acc [[w, "mithya", w]])

      let compound-str = cond (and (gt (string-length last-pend) 0) (eq edge "satya"))
                           (concat last-pend "-" word)
                         otherwise ""

      -- avastha qualifier + satya → synthesize compound key
      cond (and (gt (string-length compound-str) 0)
                (eq edge "satya")
                (member last-pend avastha-qualifiers))
        [[], (append prefix-out
               [[compound-str, "satya",         compound-str],
                [compound-str, "sandhi-rename",  word]])]

      -- mithya: accumulate into pending
      (eq edge "mithya")
        [(append pending [word]), out]

      -- non-avastha satya or other: flush pending, pass current through
      (gt n-pend 0)
        [[], (append full-flush [tri])]

      otherwise
        [[], (append out [tri])])

    pending-list = nth pass 0
    rough        = nth pass 1

    result = reduce pending-list rough (fn acc w ->
               append acc [[w, "mithya", w]])

  return
    result  list

done

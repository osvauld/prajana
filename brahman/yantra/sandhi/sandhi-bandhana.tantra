tantra sandhi-bandhana

  -- binding reattribution after compound synthesis.
  -- reads [compound, sandhi-rename, base] markers left by sandhi-kosha/sandhi-avastha.
  -- rewrites [base, sankhya/matra, X] → [compound, sankhya/matra, X].
  -- removes sandhi-rename triples from the output (they are internal markers only).

  takes graph

  -- collect all rename pairs: [[base, compound], ...]
  renames = from graph
    where [compound, e, base]
    and e is sandhi-rename
    collect [base, compound]

  result = cond (renames is empty)
    graph
  otherwise
    (scan graph with cur-base = "", cur-compound = ""

      when edge is sandhi-rename
        -- consume marker, do not emit

      when edge is satya
        let new-bc = from renames
          where [base, compound]
          and compound is word
          collect [base, compound]
        set cur-base     to (cond (new-bc is not empty) (nth (nth new-bc 0) 0) otherwise cur-base)
        set cur-compound to (cond (new-bc is not empty) (nth (nth new-bc 0) 1) otherwise cur-compound)
        emit triple

      when edge is sankhya or edge is matra
        and word is cur-base
        and cur-base is not ""
        emit [cur-compound, edge, obj]

      otherwise
        emit triple)

  return result
done

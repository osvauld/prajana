tantra2 sandhi-kosha

-- compound word resolution via kosha lookup.
-- Way 1: mithya + satya → lookup(last-mithya + "-" + word)
-- Way 2: satya + satya  → lookup(prev-satya + "-" + word)
-- on hit → emit [compound, satya, compound] + [compound, sandhi-rename, word]
-- on miss → pass through unchanged
--
-- Guard: Way 2 does not fire when prev-satya is a sentence subject.
-- "electron has mass" — electron is the subject (signalled by the following
-- shashthi-vibhakti edge). It OWNS mass; it does not modify it into "electron-mass".
-- The species constant electron-mass is a kosha universal; the instance's
-- owned mass arrives through the sentence and belongs to the entity.
-- We detect the subject by tracking: when [_, shashthi-vibhakti, shashthi-vibhakti]
-- is seen, the last-satya at that moment is a subject — mark it and skip Way 2.
-- prathama-vibhakti edges (from prior avrti passes) also mark subjects.

takes graph

-- entities from prior avrti passes (empty on first pass, populated on subsequent)
entities = graph | where [s, e, o] | and (eq e "prathama-vibhakti") | collect s

-- state: [pending-mithya, out, last-satya, last-satya-is-subject]
pass = reduce graph [[], [], "", false] (fn acc tri ->
  let word       = nth tri 0
  let edge       = nth tri 1
  let obj        = nth tri 2
  let pend       = nth acc 0
  let out        = nth acc 1
  let last-satya = nth acc 2
  let is-subject = nth acc 3
  let n-pend     = length pend

  let last-pend   = (cond (gt n-pend 0) (nth pend (sub n-pend 1)) otherwise "")
  let prefix-list = map (range (max 0 (sub n-pend 1))) (fn i -> nth pend i)
  let prefix-out  = flush-pending-mithya prefix-list out
  let full-flush  = flush-pending-mithya pend out

  -- shashthi-vibhakti signal: the last-satya was a subject — mark it
  let is-subject-now = cond (and (eq edge "shashthi-vibhakti") (eq (to-string obj) "shashthi-vibhakti")) true otherwise is-subject

  -- Way 1: last pending mithya + current satya
  let cw1    = (cond (and (gt (string-length last-pend) 0) (eq edge "satya"))
    (concat last-pend "-" word) otherwise "")
  let cn1    = (cond (gt (string-length cw1) 0) (lookup cw1) otherwise _none)

  -- Way 2: prev satya + current satya (no pending mithya, prev is not a subject/entity)
  let prev-is-subject = (or is-subject-now (member last-satya entities))
  let cw2    = (cond (and (eq n-pend 0) (and (not prev-is-subject) (and (gt (string-length last-satya) 0) (eq edge "satya"))))
    (concat last-satya "-" word) otherwise "")
  let cn2    = (cond (gt (string-length cw2) 0) (lookup cw2) otherwise _none)

  -- drop-last: out without the final element (for Way 2 replacement)
  let drop-last = map (range (max 0 (sub (length out) 1))) (fn i -> nth out i)

  -- new satya word resets subject tracking (new potential subject starts fresh)
  let next-is-subject = cond (eq edge "satya") false otherwise is-subject-now

  (cond (exists cn1)
    [[], (append prefix-out [[(to-string cn1), "satya", (to-string cn1)],
                              [(to-string cn1), "sandhi-rename", word]]), "", false]
  otherwise (cond (exists cn2)
    [[], (append drop-last [[(to-string cn2), "satya", (to-string cn2)],
                             [(to-string cn2), "sandhi-rename", word]]), "", false]
  otherwise (cond (eq edge "mithya")
    [(append pend [word]), out, "", next-is-subject]
  otherwise (cond (gt n-pend 0)
    [[], (append full-flush [[word, edge, obj]]), word, next-is-subject]
  otherwise
    [[], (append out [[word, edge, obj]]), word, next-is-subject])))))

pending-list = nth pass 0
rough        = nth pass 1

result = flush-pending-mithya pending-list rough

return result

done

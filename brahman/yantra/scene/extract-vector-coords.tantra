tantra extract-vector-coords

  -- Extracts bare numeric coordinates from classified tokens after a trigger word.
  -- Handles bracket notation: "[0.4, 0.3]", "3, 4", etc.
  -- Strips [ ] from tokens before parsing as numbers (pitfall 6).
  -- Does NOT strip ( ) — ")" as string literal breaks nested parens (pitfall 2).
  -- Scanning activates on any trigger word and collects up to max-coords numbers.
  --
  -- IMPORTANT (pitfall 12): returns a list — caller uses result directly, not nth result 0.
  --   coords = extract-vector-coords classified triggers 3
  --   x = nth coords 0    -- correct
  --
  -- Used by: scene-extract-kinematic-chain (target position), any coordinate target.

  inputs
    classified   list    -- output of classify-fold: [[word, kind, resolved], ...]
    triggers     list    -- words that activate scanning, e.g. ["to","position","target"]
    max-coords   float   -- maximum number of coordinates to collect (e.g. 3 for xyz)

  let
    scan = reduce classified (pair "0" (range 0))
      (fn acc triple ->
        let active     = nth acc 0
        let coords     = nth acc 1
        let tok        = nth triple 0
        let is-trig    = member tok triggers
        let new-active = cond is-trig "1" otherwise active
        -- strip [ ] before numeric parse — do NOT include ")" (pitfall 2)
        let clean      = (join (filter (split tok "") (fn c ->
                           (and (neq c "[") (neq c "]")))) "")
        let as-num     = cond (eq new-active "1") (to-number clean) otherwise _none
        let has-num    = exists as-num
        let has-room   = lt (length coords) max-coords
        let should-add = (and has-num has-room)
        let num-str    = to-string as-num
        let added      = (append coords (split num-str " "))
        let new-coords = cond should-add added otherwise coords
        pair new-active new-coords)

    coords = nth scan 1

  return
    coords  list

done

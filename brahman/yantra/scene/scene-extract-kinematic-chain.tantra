tantra scene-extract-kinematic-chain

  -- Sphoṭa-based kinematic chain extraction from a natural language sentence.
  -- Emits live graph nodes: arm-<hash>, joint-N-<hash>, link-N-<hash>, target-<hash>.
  -- All defaults from scene-defaults-kinematic-chain.shabda.
  --
  -- Strategy: three independent signals converge to assign each value to a concept:
  --   1. dim-vector of the unit → physical class (L, T⁻¹, etc.)
  --   2. kramanusara depth (|T|) → position in derivative chain
  --   3. concepts-for-unit shabda on unit node → candidate concepts in this domain
  -- The combination selects concept unambiguously (sphoṭa).
  --
  -- n-DOF: each joint contributes 1 DOF (revolute or prismatic).
  -- total DOF = n-joints. The arm is a serial chain: link_0 → joint_0 → link_1 → ... → link_{n-1}.

  inputs
    sentence    string
    scene-hash  string

  let
    -- ---- 1. tokenise and classify ----
    words = map (tokenise sentence) (fn w -> lower w)
    classified = classify-fold words

    -- ---- 2. detect joint count (three signals, decreasing reliability) ----

    -- signal A: explicit "joint N" or "link N" entity markers
    joint-markers = fold-pairs classified (fn a b ->
      cond (and (or (eq (nth a 2) "joint") (eq (nth a 2) "link"))
                (exists (to-number (nth b 0)))) "JMARK"
      otherwise _none)
    n-from-entities = length (filter joint-markers (fn x -> eq x "JMARK"))

    -- signal A2: count explicit entity mentions ("3 joint ...", "3-joint ...")
    n-joint-word = length (filter words (fn w -> or (eq w "joint") (eq w "joints")))

    -- signal B: "N-DOF" compound in words (e.g. "3-dof", "6-dof")
    dof-idx = first-match words (fn w ->
      let parts   = split w "-"
      let has-dof = exists (first-match parts (fn p -> cond (eq p "dof") "yes" otherwise _none))
      let num-val = to-number (nth parts 0)
      cond (and has-dof (exists num-val)) num-val otherwise _none)
    n-from-dof = cond (exists dof-idx) dof-idx otherwise 0

    -- signal B2: token triples like "3 - dof" or "3 - joint"
    marker-scan = reduce words [0, "", "", 0]
      (fn acc w ->
        let found = nth acc 0
        let p1    = nth acc 1
        let p2    = nth acc 2
        let cur   = nth acc 3
        let cand-a = cond (and (eq p1 "-") (or (eq w "dof") (eq w "joint") (eq w "joints"))) (to-number p2) otherwise _none
        let cand-b = cond (and (neq p1 "-") (or (eq w "dof") (eq w "joint") (eq w "joints"))) (to-number p1) otherwise _none
        let cur2 = cond (exists cand-a) cand-a (exists cand-b) cand-b otherwise cur
        let found2 = cond (gt found 0) found (gt cur2 0) cur2 otherwise 0
        [found2, w, p1, cur2])
    n-from-markers = nth marker-scan 0

    -- default
    n-default = to-number (shabda "scene-defaults-kinematic-chain" "default-joint-count")
    n-def-f   = cond (exists n-default) n-default otherwise 2

    -- ---- 3. detect goals ----
    goal-word-pairs = shabda-pairs "goal-words"
    trigger-values  = filter goal-word-pairs (fn kv -> eq (nth kv 0) "goal-trigger")
    trigger-words   = map trigger-values (fn kv -> nth kv 1)

    goal-scan = reduce classified (pair "0" (range 0))
      (fn acc triple ->
        let active  = nth acc 0
        let goals   = nth acc 1
        let tok     = nth triple 0
        let is-trig = member tok trigger-words
        let new-active = cond is-trig "1" otherwise active
        let goal-val = cond (eq new-active "1")
          (first-match goal-word-pairs (fn kv ->
            cond (and (eq (nth kv 0) tok) (neq (nth kv 0) "goal-trigger")) (nth kv 1)
            otherwise _none))
          otherwise _none
        let new-goals = cond (and (exists goal-val) (not (member goal-val goals)))
          (append goals (split goal-val ","))
          otherwise goals
        pair new-active new-goals)

    detected-goals    = nth goal-scan 1
    default-goals-str = shabda "scene-defaults-kinematic-chain" "default-goals"
    goals-list = cond (gt (length detected-goals) 0) detected-goals otherwise (split default-goals-str ",")
    goals-str  = join goals-list ","

    -- ---- 4. detect target position (reusable extract-vector-coords) ----
    target-triggers  = split "to,position,target,effector" ","
    -- NOTE: tantra returns VList of individual return values — for a list return,
    -- the list elements become separate slots. Use raw-coords directly as the coord list.
    raw-coords = extract-vector-coords classified target-triggers 3

    tx-str = cond (gt (length raw-coords) 0) (nth raw-coords 0) otherwise (shabda "scene-defaults-kinematic-chain" "default-target-x")
    ty-str = cond (gt (length raw-coords) 1) (nth raw-coords 1) otherwise (shabda "scene-defaults-kinematic-chain" "default-target-y")
    tz-str = cond (gt (length raw-coords) 2) (nth raw-coords 2) otherwise (shabda "scene-defaults-kinematic-chain" "default-target-z")

    -- ---- 5. emit target node ----
    target-name   = concat "target-" scene-hash
    target-shabda = concat "x:" tx-str " y:" ty-str " z:" tz-str
    target-node   = emit-node target-name "kosha"
                      (split "bindu-swarupa sthira-apeksha-sthita" " ")
                      target-shabda

    -- ---- 6. sphoṭa extraction: value-unit-concept-joint tuples ----
    value-tuples = extract-value-units classified

    -- ---- 6b. signal C: count link-length tuples in structural sentence ----
    -- extract-value-units now tags each tuple with sentence-num (graded ring).
    -- the structural sentence is the first sentence containing link-length values.
    -- only count link-lengths in that sentence — target coords are in a later sentence.
    link-len-tuples = filter value-tuples (fn t -> eq (nth t 1) "link-length")
    struct-sent = cond (gt (length link-len-tuples) 0) (nth (nth link-len-tuples 0) 4) otherwise 0
    struct-link-tuples = filter link-len-tuples (fn t -> eq (nth t 4) struct-sent)
    n-from-values = length struct-link-tuples

    -- final n-joints: strong explicit signals > value-group cardinality > defaults
    n-joints = cond (gt n-from-entities 0) n-from-entities
               (gt n-from-markers 0) n-from-markers
               (gt n-from-dof 0) n-from-dof
               (gt n-joint-word 0) n-joint-word
               (gt n-from-values 0) n-from-values
               otherwise n-def-f

    -- ---- 7. defaults from kosha ----
    jtype-def  = shabda "scene-defaults-kinematic-chain" "default-joint-type"
    jangle-def = to-number (shabda "scene-defaults-kinematic-chain" "default-joint-angle")
    llen-def   = to-number (shabda "scene-defaults-kinematic-chain" "default-link-length")
    lmass-def  = to-number (shabda "scene-defaults-kinematic-chain" "default-link-mass")
    spd-def    = to-number (shabda "scene-defaults-kinematic-chain" "default-joint-speed-max")
    torq-def   = to-number (shabda "scene-defaults-kinematic-chain" "default-rated-torque")
    pwr-def    = to-number (shabda "scene-defaults-kinematic-chain" "default-rated-power")

    jangle-f = cond (exists jangle-def) jangle-def otherwise 0
    llen-f   = cond (exists llen-def)   llen-def   otherwise 0.5
    lmass-f  = cond (exists lmass-def)  lmass-def  otherwise 1.0
    spd-f    = cond (exists spd-def)    spd-def    otherwise 2.0
    torq-f   = cond (exists torq-def)   torq-def   otherwise 5.0
    pwr-f    = cond (exists pwr-def)    pwr-def    otherwise 20.0

    -- ---- 8. emit per-joint nodes ----
    joint-indices = range n-joints

    joint-nodes = map joint-indices (fn i ->
      -- find tuples for this joint index
      let my-tuples = filter value-tuples (fn t -> eq (nth t 3) i)

      -- resolve each property by concept name — inline lookup, no local fn call
      let jangle-m = first-match my-tuples (fn t -> cond (eq (nth t 1) "joint-angle")    (nth t 0) otherwise _none)
      let llen-m   = first-match my-tuples (fn t -> cond (eq (nth t 1) "link-length")    (nth t 0) otherwise _none)
      let llen-cm  = first-match my-tuples (fn t -> cond (and (eq (nth t 1) "link-length") (eq (nth t 2) "centimetre")) (nth t 0) otherwise _none)
      let lmass-m  = first-match my-tuples (fn t -> cond (eq (nth t 1) "link-mass")      (nth t 0) otherwise _none)
      let spd-m    = first-match my-tuples (fn t -> cond (eq (nth t 1) "joint-speed-max") (nth t 0) otherwise _none)
      let rtorq-m  = first-match my-tuples (fn t -> cond (eq (nth t 1) "rated-torque")   (nth t 0) otherwise _none)
      let rpwr-m   = first-match my-tuples (fn t -> cond (eq (nth t 1) "rated-power")    (nth t 0) otherwise _none)

      let jangle = cond (exists jangle-m) jangle-m otherwise jangle-f
      let llen   = cond (exists llen-m) llen-m (exists llen-cm) (mul llen-cm 0.01) otherwise llen-f
      let lmass  = cond (exists lmass-m)  lmass-m  otherwise lmass-f
      let spd    = cond (exists spd-m)    spd-m    otherwise spd-f
      let rtorq  = cond (exists rtorq-m)  rtorq-m  otherwise torq-f
      let rpwr   = cond (exists rpwr-m)   rpwr-m   otherwise pwr-f

      let jname   = concat "joint-" (to-string i) "-" scene-hash
      let lname   = concat "link-"  (to-string i) "-" scene-hash

      -- track which values were explicitly provided vs defaulted
      let spd-prov    = cond (exists spd-m)   "yes" otherwise "no"
      let rtorq-prov  = cond (exists rtorq-m) "yes" otherwise "no"
      let rpwr-prov   = cond (exists rpwr-m)  "yes" otherwise "no"
      let lmass-prov  = cond (exists lmass-m) "yes" otherwise "no"

      let j-shabda = concat
        "joint-type:" jtype-def
        " joint-angle:" (to-string jangle)
        " joint-speed-max:" (to-string spd)
        " rated-torque:" (to-string rtorq)
        " rated-power:" (to-string rpwr)
        " spd-provided:" spd-prov
        " rtorq-provided:" rtorq-prov
        " rpwr-provided:" rpwr-prov

      let l-shabda = concat
        "link-length:" (to-string llen)
        " link-mass:" (to-string lmass)
        " mass-provided:" lmass-prov

      let jnode = emit-node jname "kosha"
                    (split "chala-apeksha-sthita krama-janya-yukta sambandha-yukta" " ")
                    j-shabda
      let lnode = emit-node lname "kosha"
                    (split "chala-apeksha-sthita krama-janya-yukta" " ")
                    l-shabda
      pair jname lname)

    -- ---- 9. emit root arm node ----
    workspace  = shabda "scene-defaults-kinematic-chain" "default-workspace"
    root-name  = concat "arm-" scene-hash
    root-shabda = concat
      "n-joints:" (to-string n-joints)
      " workspace:" workspace
      " goals:" goals-str
      " target-node:" target-name
      " scene-type:kinematic-chain"
    root-node = emit-node root-name "kosha"
                  (split "kinematic-chain-swarupa aayaama-traya-sthita domain-robotics-sthita" " ")
                  root-shabda

  return
    root-name  string

done

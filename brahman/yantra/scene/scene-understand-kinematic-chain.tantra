tantra scene-understand-kinematic-chain

  -- Thin pipeline: extract -> narrate -> compute -> format.
  -- All computation lives in scene-compute-kinematic-chain.
  -- All formatting lives in scene-format-kinematic-chain.
  -- This tantra only wires them together.

  inputs
    sentence  string

  let
    hash      = "sc1"

    -- 1. extract scene graph from sentence
    root-name = scene-extract-kinematic-chain sentence hash
    narration = scene-narrate-kinematic-chain root-name

    -- 2. read n-joints from root node
    root-pairs  = shabda-pairs root-name
    n-joints-s  = first-match root-pairs (fn p -> cond (eq (nth p 0) "n-joints") (nth p 1) otherwise _none)
    n-joints    = cond (exists n-joints-s) (to-number n-joints-s) otherwise 2

    -- 3. compute: IK, FK, torques, path-energy, velocity-plan, goal, motor-check
    cr              = scene-compute-kinematic-chain root-name hash n-joints sentence
    joint-angles    = nth cr 0
    theta-target    = nth cr 1
    ex              = nth cr 2
    ey              = nth cr 3
    tz              = nth cr 4
    motor-lines     = nth cr 5
    path-energy     = nth cr 6
    goal            = nth cr 7
    t-move          = nth cr 8
    pw-total        = nth cr 9
    t-opt           = nth cr 10
    pw-opt-total    = nth cr 11
    omegas-opt      = nth cr 12
    t-budget        = nth cr 13
    pw-slow-total   = nth cr 14
    omegas-slow     = nth cr 15
    omegas-mintime  = nth cr 16
    any-missing     = nth cr 17
    mass-any-miss   = nth cr 18
    torque-any-miss = nth cr 19
    power-any-miss  = nth cr 20
    lm-def          = nth cr 21
    rt-def          = nth cr 22
    rp-def          = nth cr 23

    -- 4. format into human-readable output
    fmt    = scene-format-kinematic-chain
               n-joints joint-angles theta-target ex ey tz
               motor-lines path-energy goal
               t-move pw-total t-opt pw-opt-total omegas-opt
               t-budget pw-slow-total omegas-slow omegas-mintime
               any-missing mass-any-miss torque-any-miss power-any-miss
               lm-def rt-def rp-def
    result = concat narration (nth fmt 0)

  return
    result  string

done

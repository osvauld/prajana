tantra scene-narrate-kinematic-chain

  -- Walks a kinematic-chain scene graph and produces a human-readable
  -- narration string. All format strings live here in the tantra —
  -- none in OCaml.

  inputs
    root-node  string

  let
    root-pairs = shabda-pairs root-node
    n-joints-s = first-match root-pairs (fn p -> cond (eq (nth p 0) "n-joints") (nth p 1) otherwise _none)
    workspace  = first-match root-pairs (fn p -> cond (eq (nth p 0) "workspace") (nth p 1) otherwise _none)
    goals-str  = first-match root-pairs (fn p -> cond (eq (nth p 0) "goals") (nth p 1) otherwise _none)
    tnode      = first-match root-pairs (fn p -> cond (eq (nth p 0) "target-node") (nth p 1) otherwise _none)
    hash       = cond (exists tnode) (join (filter (split tnode "-") (fn s -> neq s "target")) "-") otherwise ""

    n-j = cond (exists n-joints-s) (to-number n-joints-s) otherwise 2
    ws  = cond (exists workspace) workspace otherwise "aayaama-traya"
    gs  = cond (exists goals-str) goals-str otherwise ""

    -- frame model line
    frame-indices = range n-j
    chala-frames  = map frame-indices (fn i -> concat "chala-apeksha[" (to-string i) "]")
    all-frames    = append (split "sthira-apeksha (world)" "|||") chala-frames
    frame-line    = concat "  Frame model: " (join all-frames " → ")

    -- per-joint lines
    joint-lines = map frame-indices (fn i ->
      let jname  = concat "joint-" (to-string i) "-" hash
      let lname  = concat "link-"  (to-string i) "-" hash
      let jp     = shabda-pairs jname
      let lp     = shabda-pairs lname
      let jtype  = first-match jp (fn p -> cond (eq (nth p 0) "joint-type")      (nth p 1) otherwise _none)
      let ax     = first-match jp (fn p -> cond (eq (nth p 0) "axis-x")          (nth p 1) otherwise _none)
      let ay     = first-match jp (fn p -> cond (eq (nth p 0) "axis-y")          (nth p 1) otherwise _none)
      let az     = first-match jp (fn p -> cond (eq (nth p 0) "axis-z")          (nth p 1) otherwise _none)
      let ang    = first-match jp (fn p -> cond (eq (nth p 0) "joint-angle")     (nth p 1) otherwise _none)
      let spd    = first-match jp (fn p -> cond (eq (nth p 0) "joint-speed-max") (nth p 1) otherwise _none)
      let rtq    = first-match jp (fn p -> cond (eq (nth p 0) "rated-torque")    (nth p 1) otherwise _none)
      let rpw    = first-match jp (fn p -> cond (eq (nth p 0) "rated-power")     (nth p 1) otherwise _none)
      let llen   = first-match lp (fn p -> cond (eq (nth p 0) "link-length")     (nth p 1) otherwise _none)
      let lmass  = first-match lp (fn p -> cond (eq (nth p 0) "link-mass")       (nth p 1) otherwise _none)
      let jt   = cond (exists jtype) jtype otherwise "revolute"
      let axt  = cond (exists ax) ax otherwise "0"
      let ayt  = cond (exists ay) ay otherwise "0"
      let azt  = cond (exists az) az otherwise "1"
      let at   = cond (exists ang) ang otherwise "0"
      let spt  = cond (exists spd) spd otherwise "?"
      let rqt  = cond (exists rtq) rtq otherwise "?"
      let rpt  = cond (exists rpw) rpw otherwise "?"
      let llt  = cond (exists llen) llen otherwise "?"
      let lmt  = cond (exists lmass) lmass otherwise "?"
      concat
        "  Joint " (to-string i) "  " jt
        "  axis=[" axt "," ayt "," azt "]"
        "  theta=" at " rad"
        "  omega_max=" spt " rad/s"
        "  motor: " rqt " N*m, " rpt " W"
        "\n    Link " (to-string i)
        "  length=" llt "m  mass=" lmt "kg")

    -- target line
    tp  = shabda-pairs tnode
    tx  = first-match tp (fn p -> cond (eq (nth p 0) "x") (nth p 1) otherwise _none)
    ty  = first-match tp (fn p -> cond (eq (nth p 0) "y") (nth p 1) otherwise _none)
    tz  = first-match tp (fn p -> cond (eq (nth p 0) "z") (nth p 1) otherwise _none)
    txs = cond (exists tx) tx otherwise "?"
    tys = cond (exists ty) ty otherwise "?"
    tzs = cond (exists tz) tz otherwise "?"

    target-line = concat "  Target: end-effector to [" txs ", " tys ", " tzs "] in world-space (sthira-apeksha)"
    goals-line  = concat "  Goals:  " gs

    header      = concat "Scene understood:"
    chain-line  = concat "  Kinematic chain: " (to-string n-j) "-DOF serial arm in " ws

    narration   = join
                    (append
                      (split (concat header "\n" chain-line "\n" frame-line "\n") "|||")
                      (append joint-lines
                        (split (concat "\n" target-line "\n" goals-line) "|||")))
                    "\n"

  return
    narration  string

done

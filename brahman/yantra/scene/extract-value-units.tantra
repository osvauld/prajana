tantra extract-value-units

  -- Graded-ring value-unit extraction.
  --
  -- Two-pass approach with sentence-aware (grade-local) indexing:
  --
  -- Pass 1: collect raw [value, concept, unit, sentence-num] triples.
  --   Track sentence boundaries via period tokens ("." emitted by tokeniser).
  --   For each number token, hold it as last-num.
  --   For each unit token with a pending last-num, emit a triple.
  --   Unit resolved via: direct dim-vector (classified concept) or alias lookup.
  --   Concept resolved via: concepts-for-unit shabda on the unit node.
  --
  -- Pass 2: assign idx = position within concept group PER SENTENCE.
  --   For each triple, count prior triples with same concept AND same sentence-num.
  --   The additive group resets at each sentence boundary (period = grade boundary).
  --   This prevents index pollution: target coordinates in sentence 1 don't inflate
  --   link-length indices from sentence 0.
  --
  -- Algebraic structure: each sentence is a grade in a graded ring.
  -- Additive op (comma/and) assigns sequential indices within a sentence.
  -- Multiplicative op (cross-sentence selectors) is Phase B (future).
  --
  -- Returns list of [value, concept, unit-name, idx, sentence-num] tuples.

  inputs
    classified  list    -- output of classify-fold: [[word, kind, resolved], ...]

  let
    unit-alias-pairs = shabda-pairs "unit-aliases"

    -- pass 1: collect raw [value, concept, unit, sentence-num] triples
    -- accumulator: [results, pending-nums, sentence-num]
    -- pending-nums supports grouped expressions like "0.3 and 0.2 and 0.1 m".
    pass1 = reduce classified [[], [], 0]
      (fn acc triple ->
        let results      = nth acc 0
        let pending-nums = nth acc 1
        let sentence-num = nth acc 2

        let word     = nth triple 0
        let kind     = nth triple 1
        let resolved = nth triple 2

        -- detect sentence boundary (period token)
        let is-period = eq word "."

        -- detect number
        let as-num    = to-number word
        let is-number = exists as-num

        -- detect unit:
        --   1) classified concept that carries concepts-for-unit shabda
        --   2) alias lookup from surface token (m -> metre, rad/s -> radian-per-second)
        let direct-name = cond (eq kind "concept")
          (cond (exists (shabda resolved "concepts-for-unit")) resolved otherwise _none)
          otherwise _none
        let alias-name = cond (not (exists direct-name))
          (first-match unit-alias-pairs (fn kv -> cond (eq (nth kv 0) word) (nth kv 1) otherwise _none))
          otherwise _none
        let unit-name  = cond (exists direct-name) direct-name (exists alias-name) alias-name otherwise ""
        let is-unit    = neq unit-name ""

        -- resolve concept from unit node shabda
        let cands   = cond is-unit (split (shabda unit-name "concepts-for-unit") ",") otherwise (range 0)
        let concept = cond (gt (length cands) 0) (nth cands 0) otherwise unit-name

        -- emit triples when unit follows one or more pending numbers
        let emitted = map pending-nums (fn n -> [n, concept, unit-name, sentence-num])
        let new-results = cond (and is-unit (gt (length pending-nums) 0))
          (append results emitted)
          otherwise results

        -- update pending-nums (sphoTa accumulation):
        --   A number only pairs with a unit in its immediate vicinity.
        --   The "vicinity" is a contiguous run of numbers and conjunctions.
        --   Any non-numeric, non-conjunction, non-unit token breaks the run
        --   and clears the pending accumulator — the number's meaning was
        --   consumed by that context (e.g. "2 joints" — 2 belongs to joints).
        --
        --   This is the graded ring within a sentence grade: the additive
        --   operation (comma/and) extends the group, anything else closes it.
        --
        --   number       -> append to pending (extend the numeric run)
        --   unit         -> clear (consumed: numbers paired with this unit)
        --   period       -> clear (grade boundary)
        --   conjunction  -> keep (additive: "0.3 and 0.2 m" groups together)
        --   other        -> clear (sphoTa: number absorbed by this context)
        let is-conjunction = (or (eq word "and") (eq word ","))
        let new-pending = cond is-number (append pending-nums (split (to-string as-num) " "))
                           is-unit []
                           is-period []
                           is-conjunction pending-nums
                           otherwise []

        -- update sentence-num: increment on period
        let new-sent = cond is-period (add sentence-num 1) otherwise sentence-num

        [new-results, new-pending, new-sent])

    raw-triples = nth pass1 0

    -- pass 2: assign idx by position within concept group PER SENTENCE
    -- for each triple: idx = count of prior triples with same concept AND same sentence-num
    result = reduce raw-triples [] (fn acc t ->
      let concept = nth t 1
      let sent    = nth t 3
      let idx     = length (filter acc (fn r -> and (eq (nth r 1) concept) (eq (nth r 4) sent)))
      append acc [[nth t 0, concept, nth t 2, idx, sent]])

  return
    result  list

done

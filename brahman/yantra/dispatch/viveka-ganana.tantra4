-- viveka-ganana: comparison — find which entity has the greater/lesser value.
-- two paths: (1) numeric — derive values, select extremum.
--            (2) viveka-chain — walk transitive viveka edges from assertions.
-- when all values are equal, emits equal-to instead of greater-than.
(tantra viveka-ganana (graph concept cw direction)
  (op-eval (nth (walk direction "ganana") 0))
  (opp-eval (nth (walk (nth (walk direction "pratipaksha") 0) "ganana") 0))

  (entities (prathama-sparsha graph))

  -- infer concept from first entity's first owned property when not explicit
  (first-ent (cond (has-items entities) (to-string (nth entities 0)) otherwise ""))
  (owned-concepts (cond (has-text first-ent) (shashthi-sparsha graph first-ent) otherwise []))
  (inferred-concept (cond (has-text concept) concept
    (has-items owned-concepts) (to-string (nth owned-concepts 0))
    otherwise ""))

  -- for each entity: try derived value, then concept-scoped raw, then first-raw
  (ev-pairs (reduce entities [] (fn acc ent ->
    let ent-str   = to-string ent
    let derived   = derive-for-entity graph ent-str inferred-concept
    let deriv-val = cond (has-items derived) (nth derived 1) otherwise ""
    let svps      = cond (has-text deriv-val) [] otherwise (nth (scope-vps graph ent-str) 0)
    let raw-val   = cond (has-text deriv-val) ""
      otherwise (reduce svps "" (fn found kv ->
        cond (has-text found) found
        cond (and (has-text inferred-concept) (eq (nth kv 0) inferred-concept)) (str kv 1)
        otherwise found))
    let first-val = cond (or (has-text deriv-val) (has-text raw-val)) ""
      otherwise (cond (has-items svps) (str (nth svps 0) 1) otherwise "")
    let val = cond (has-text deriv-val) deriv-val
      (has-text raw-val) raw-val
      otherwise first-val
    cond (has-text val) (append acc [[ent-str, val]])
    otherwise acc)))

  -- path 2: viveka-chain — transitive walk over assertion viveka edges
  -- top = no incoming viveka (unbeaten), bottom = no outgoing (beats nobody)
  (viveka-triples (triples-by-edge graph "viveka"))
  (has-chain (and (not (has-items ev-pairs)) (has-items viveka-triples)))
  (viv-subjs (map viveka-triples (fn t -> triple-subj t)))
  (viv-objs  (map viveka-triples (fn t -> triple-obj t)))
  (top-entity (cond has-chain
    (nth (filter viv-subjs (fn s -> not (member s viv-objs))) 0) otherwise ""))
  (bottom-entity (cond has-chain
    (nth (filter viv-objs (fn o -> not (member o viv-subjs))) 0) otherwise ""))
  (chain-winner (cond has-chain
    (cond (eq direction "min") (to-string bottom-entity)
          otherwise (to-string top-entity))
    otherwise ""))
  (chain-loser (cond has-chain
    (cond (eq direction "min") (to-string top-entity)
          otherwise (to-string bottom-entity))
    otherwise ""))

  -- select winner: numeric path or chain path
  (best-pr (cond (not has-chain) (select-extremum ev-pairs op-eval) otherwise []))
  (worst-pr (cond (not has-chain) (select-extremum ev-pairs opp-eval) otherwise []))

  (winner (cond has-chain chain-winner
    (has-items best-pr) (str best-pr 0) otherwise ""))
  (winner-val (cond has-chain ""
    (has-items best-pr) (str best-pr 1) otherwise ""))
  (loser (cond has-chain chain-loser
    (has-items worst-pr) (str worst-pr 0) otherwise ""))
  (loser-val (cond has-chain ""
    (has-items worst-pr) (str worst-pr 1) otherwise ""))

  (vals-equal (and (not has-chain) (eq winner-val loser-val)))
  (cmp-rel (cond vals-equal "equal-to" otherwise "greater-than"))

  (gt-triples (cond (and (has-text winner) (has-text loser))
    [[winner, cmp-rel, loser],
     [winner, "viveka-concept", concept],
     [winner, "viveka-direction", direction]]
    otherwise []))

  [winner, loser, winner-val, loser-val, ev-pairs, gt-triples])

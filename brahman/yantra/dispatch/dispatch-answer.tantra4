-- graph-driven dispatch: walks pipeline-dispatch children to find handler.
-- the graph declares available modes; this tantra just reads and routes.
(tantra dispatch-answer (expanded refined)
  (mode (read-signal expanded "dispatch-mode"))
  (dispatch-nodes (walk-in "pipeline-dispatch" "swarupa"))
  (target-name (concat "dispatch-" mode))
  (matched (filter dispatch-nodes (fn n -> eq (to-string n) target-name)))
  (result (cond (has-items matched)
    (call-tantra (to-string (nth matched 0)) [expanded, refined])
    otherwise _none))
  (cond (exists result) result otherwise "no match"))

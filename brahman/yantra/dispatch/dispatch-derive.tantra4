-- derive dispatch: physics computation — match mantra, derive chain, emit reasoning.
(tantra dispatch-derive (expanded refined)
  (sf (read-signal expanded "solve-for"))
  (scope-entity (read-signal expanded "scope-entity"))
  (chain-raw (derive-chain expanded))
  (enriched (derive-result chain-raw "enriched"))
  (chain-steps (derive-result chain-raw "steps"))
  (mm-direct (match-mantra expanded))
  (final-m (cond (has-items mm-direct) mm-direct
    (has-items chain-steps) (nth (last-of chain-steps) 2)
    otherwise []))
  (result (cond (has-items final-m) (execute-matched final-m sf) otherwise "no match"))
  (base-graph (cond (has-items mm-direct) expanded otherwise enriched))
  (proof-graph (pramana-bandha base-graph final-m result sf scope-entity false [] [] ""))
  (emit-reasoning proof-graph))

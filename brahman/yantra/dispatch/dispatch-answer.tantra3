tantra3 dispatch-answer

takes expanded
takes refined

dispatch-mode = read-signal expanded "dispatch-mode"
sf            = read-signal expanded "solve-for"
scope-entity  = read-signal expanded "scope-entity"

is-anumana = eq dispatch-mode "anumana"
is-viveka  = eq dispatch-mode "viveka"
is-count   = eq dispatch-mode "count"
is-derive  = eq dispatch-mode "derive"

anumana-query  = read-signal expanded "anumana-query"
anumana-assert = read-signal expanded "anumana-assert"
anumana-mode   = read-signal expanded "anumana-mode"
anumana-answer = cond is-anumana
  (cond (eq anumana-mode "varga")
    (anumana-viveka-yukta refined anumana-query anumana-assert)
    otherwise (anumana-viveka refined anumana-query anumana-assert))
  otherwise ""

comp-word    = read-signal expanded "comp-word"
comp-concept = read-signal expanded "comp-concept"
viveka-dir   = read-signal expanded "viveka-dir"
viveka-raw   = cond is-viveka (viveka-ganana expanded comp-concept comp-word viveka-dir) otherwise []
viveka-winner     = cond is-viveka (viveka-result viveka-raw "winner") otherwise ""
viveka-ev-pairs   = cond is-viveka (viveka-result viveka-raw "ev-pairs") otherwise []
viveka-gt-triples = cond is-viveka (viveka-result viveka-raw "gt-triples") otherwise []

has-intent  = (or is-viveka is-derive)
chain-raw   = cond is-derive (derive-chain expanded) otherwise [[], expanded]
enriched    = derive-result chain-raw "enriched"
chain-steps = derive-result chain-raw "steps"
mm-direct   = cond is-derive (match-mantra expanded) otherwise []

final-m = cond (has-items mm-direct) mm-direct
  (has-items chain-steps) (nth (last-of chain-steps) 2)
  otherwise []

result = cond is-anumana anumana-answer
  is-viveka (cond (exists viveka-winner) (to-string viveka-winner) otherwise "no match")
  is-count (to-string (read-signal expanded "count-result"))
  is-derive (cond (has-items final-m) (execute-matched final-m sf) otherwise "no match")
  otherwise "no match"

base-graph = cond is-viveka expanded
  is-count expanded
  (has-items mm-direct) expanded
  otherwise enriched

proof-graph = pramana-bandha base-graph final-m result sf scope-entity is-viveka viveka-ev-pairs viveka-gt-triples comp-word

answer = cond is-anumana
  (emit-anumana refined anumana-query anumana-assert anumana-mode anumana-answer)
  otherwise (emit-reasoning proof-graph)

return answer

done

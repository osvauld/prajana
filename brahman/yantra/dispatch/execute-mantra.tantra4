-- execute-mantra: fire a matched mantra via krama, math-op, kriya, or inverse path.
(tantra execute-mantra (mantra bindings mode solve-for)

  (is-inv (eq mode "inverse"))
  (has-krama (has-text (node-krama mantra)))

  -- forward: krama path (direct eval, no synthetic tantra)
  -- krama is authoritative when present — return directly, even if result is 0
  (forward-krama (cond (and has-krama (not is-inv))
    (eval-krama mantra bindings)
    otherwise _none))

  -- forward: math-op path (legacy, only for mantras without krama)
  (math-op (shabda mantra "math-op"))
  (is-math (has-text math-op))
  (args (resolve-janya-args mantra bindings))
  (forward-math (cond (and is-math (not is-inv) (not has-krama))
    (apply-op (shabda math-op "eval") args)
    otherwise _none))

  -- forward: kriya/equation path (legacy, only for mantras without krama)
  (kriya-nodes (om-kriya mantra))
  (forward-kriya (cond (and (not is-math) (not is-inv) (not has-krama) (has-items kriya-nodes))
    (call-tantra (nth kriya-nodes 0) args)
    otherwise _none))

  -- inverse path
  (inverse-val (cond is-inv (invert-math mantra bindings solve-for) otherwise _none))

  -- dispatch: krama is authoritative, then math-op, then kriya, then inverse
  (cond has-krama forward-krama
    otherwise (cond (exists forward-math) forward-math
    otherwise (cond (exists forward-kriya) forward-kriya
    otherwise (cond (exists inverse-val) inverse-val
    otherwise _none)))))

tantra3 anumana-viveka

-- walks swarupa+varga chain to check if query-entity reaches assert-entity.
-- works on both kosha edges (permanent) and question graph swarupa edges (asserted).
-- same inheritance container mechanism as physics varga chain.
--
-- no lambdas with closures — each level expanded explicitly.

takes graph
takes query-entity
takes assert-entity

-- all swarupa edges from question graph
gsp = triples-by-edge graph "swarupa"

-- parents of query-entity (level 1)
l1-kosha  = map (walk query-entity "swarupa") (fn x -> to-string x)
l1-graph  = map (filter gsp (fn tri -> eq (to-string (nth tri 0)) query-entity)) (fn tri -> to-string (nth tri 2))
l1-varga  = map (walk query-entity "varga")   (fn x -> to-string x)
l1        = append l1-kosha (append l1-graph l1-varga)
hit1      = member assert-entity l1

-- parents of level-1 nodes (level 2)
l2 = reduce l1 [] (fn acc nd ->
  let ksp = map (walk nd "swarupa") (fn x -> to-string x)
  let gsp2 = map (filter gsp (fn tri -> eq (to-string (nth tri 0)) nd)) (fn tri -> to-string (nth tri 2))
  let kvp  = map (walk nd "varga")   (fn x -> to-string x)
  append acc (append ksp (append gsp2 kvp)))
hit2 = member assert-entity l2

-- parents of level-2 nodes (level 3)
l3 = reduce l2 [] (fn acc nd ->
  let ksp = map (walk nd "swarupa") (fn x -> to-string x)
  let gsp3 = map (filter gsp (fn tri -> eq (to-string (nth tri 0)) nd)) (fn tri -> to-string (nth tri 2))
  let kvp  = map (walk nd "varga")   (fn x -> to-string x)
  append acc (append ksp (append gsp3 kvp)))
hit3 = member assert-entity l3

-- parents of level-3 nodes (level 4)
l4 = reduce l3 [] (fn acc nd ->
  let ksp = map (walk nd "swarupa") (fn x -> to-string x)
  let gsp4 = map (filter gsp (fn tri -> eq (to-string (nth tri 0)) nd)) (fn tri -> to-string (nth tri 2))
  let kvp  = map (walk nd "varga")   (fn x -> to-string x)
  append acc (append ksp (append gsp4 kvp)))
hit4 = member assert-entity l4

matched = (or hit1 (or hit2 (or hit3 hit4)))

result = cond matched "yes" otherwise "no"

return result

done

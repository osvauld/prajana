tantra torque-joint

  -- torque required to angularly accelerate a joint
  -- Newton's second law for rotation: τ = I × α
  --
  -- I = moment of inertia of the link about the joint (kg·m²)
  -- α = angular acceleration of the joint (rad/s²)
  --
  -- compose with moment-of-inertia-rod and angular-accel-joint
  -- to get the full torque requirement per joint.

  inputs
    moment-of-inertia     float  kilogram-metre-squared
    angular-acceleration  float  radian-per-second-squared

  let
    torque = mul moment-of-inertia angular-acceleration

  return
    torque  float  newton-metre

done

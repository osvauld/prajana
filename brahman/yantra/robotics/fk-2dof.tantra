tantra fk-2dof

  -- forward kinematics for a 2-DOF planar arm in aayaama-dvaya (2D tala)
  -- given joint angles, compute positions of joint2 and end-effector in world-space
  --
  -- structure: base (origin) → bone1 (rekha L1, rotated by θ1) →
  --            joint2 (sandhi) → bone2 (rekha L2, rotated by θ1+θ2) →
  --            end-effector (bindu in world-space)
  --
  -- joint2 position:
  --   p2 = [L1·cos(θ1), L1·sin(θ1)]
  --
  -- end-effector position:
  --   pe = p2 + [L2·cos(θ1+θ2), L2·sin(θ1+θ2)]
  --      = [L1·cos(θ1) + L2·cos(θ1+θ2),
  --         L1·sin(θ1) + L2·sin(θ1+θ2)]
  --
  -- this is the composition of two rotation-translation transforms —
  -- the same structure as scene-graph / homogeneous-transform composition

  inputs
    link-length-1   float  metre
    link-length-2   float  metre
    theta1          float  radian
    theta2          float  radian

  let
    -- joint 2 position (end of bone 1)
    theta12       = add theta1 theta2
    j2x           = mul link-length-1 (cos theta1)
    j2y           = mul link-length-1 (sin theta1)
    -- end-effector position (end of bone 2)
    ex            = add j2x (mul link-length-2 (cos theta12))
    ey            = add j2y (mul link-length-2 (sin theta12))

  return
    j2x   float  metre
    j2y   float  metre
    ex    float  metre
    ey    float  metre

done

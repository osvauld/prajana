tantra velocity-plan-ndof

  -- Velocity plan for n joints given path-energy and a goal (balanced/time/power).
  -- P = E / T  =>  T* = sqrt(E) is the balanced optimum: T* = P* = sqrt(E).
  -- Three plans:
  --   balanced:      T = max(T*, t-move)   omegas = delta / T
  --   minimize-time: T = t-move            omegas = rated max (already in joint-velocity-ndof)
  --   minimize-power: T = 3 * T*           omegas = delta / T  (P = E/(3T*) = sqrt(E)/3)
  -- t-move is the minimum feasible time at rated speed (from joint-velocity-ndof).
  -- References om concept: velocity-plan (kosha/physics/velocity-plan.om)

  inputs
    n-joints      float
    path-energy   float   -- joules (from path-energy-ndof)
    deltas        list    -- |delta_theta_i| radians
    torques       list    -- N*m per joint
    t-move        float   -- minimum time at rated speed (seconds)

  let
    t-opt-raw  = sqrt path-energy
    t-opt      = cond (gt t-move t-opt-raw) t-move otherwise t-opt-raw
    t-budget   = mul t-opt 3

    omegas-opt  = map (range n-joints) (fn i ->
      let di = nth deltas i
      cond (gt t-opt 0) (div di t-opt) otherwise 0)

    omegas-slow = map (range n-joints) (fn i ->
      let di = nth deltas i
      cond (gt t-budget 0) (div di t-budget) otherwise 0)

    pw-opt-total  = reduce (range n-joints) 0 (fn acc i ->
      add acc (mul (nth torques i) (nth omegas-opt i)))

    pw-slow-total = reduce (range n-joints) 0 (fn acc i ->
      add acc (mul (nth torques i) (nth omegas-slow i)))

  return
    t-opt         float   -- balanced optimum time (seconds)
    t-budget      float   -- slow plan time = 3 * t-opt (seconds)
    omegas-opt    list    -- balanced angular velocities (rad/s)
    omegas-slow   list    -- slow angular velocities (rad/s)
    pw-opt-total  float   -- balanced total power (watts)
    pw-slow-total float   -- slow total power (watts)

done

tantra ik-yz-prismatic

  -- Inverse kinematics for a 3-DOF arm: Ry(theta0) - Rz(theta1) - prismatic-Z config.
  --
  -- Given target (tx, ty, tz), solve for theta0, theta1, d2.
  --
  -- Derivation (from fk-yz-prismatic FK equations):
  --   ey = L1·sin(theta1)           → theta1 = asin(ty / L1)
  --   A  = L0 + L1·cos(theta1)      → known after solving theta1
  --
  --   ex = A·cos(theta0) + d2·sin(theta0)
  --   ez = -A·sin(theta0) + d2·cos(theta0)
  --
  --   ex² + ez² = A² + d2²          → d2 = sqrt(tx² + tz² - A²)
  --
  --   A = R·cos(theta0 + atan2(tz, tx))  where R = sqrt(tx² + tz²)
  --   → theta0 = acos(A / R) - atan2(tz, tx)
  --
  --   d2 = tx·sin(theta0) + tz·cos(theta0)   (from the rotation system)
  --
  -- Verified: FK(theta0, theta1, d2) = (tx, ty, tz) to floating-point precision.
  -- Solution is elbow-down (positive acos branch). Requires |ty| <= L1 and A <= R.

  inputs
    link-length-0  float  metre
    link-length-1  float  metre
    tx             float  metre
    ty             float  metre
    tz             float  metre

  let
    -- solve theta1 from ey = L1·sin(theta1)
    theta1 = asin (div ty link-length-1)
    cos1   = cos theta1

    -- A = L0 + L1·cos(theta1): the radial reach in the XZ plane
    A = add link-length-0 (mul link-length-1 cos1)

    -- R = distance of target in XZ plane
    R = sqrt (add (mul tx tx) (mul tz tz))

    -- solve theta0: A = R·cos(theta0 + phi) where phi = atan2(tz, tx)
    theta0 = sub (acos (div A R)) (atan2 tz tx)

    -- d2: prismatic extension along Ry(theta0)·zhat = (sin theta0, 0, cos theta0)
    d2 = add (mul tx (sin theta0)) (mul tz (cos theta0))

  return
    theta0  float  radian
    theta1  float  radian
    d2      float  metre

done

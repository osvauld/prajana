tantra motor-check-ndof

  -- Per-joint motor feasibility check for all n joints.
  -- For each joint: compares required torque and power against rated limits.
  -- Returns a formatted multi-line string and the total power.
  -- Delegates per-joint verdict to the existing motor-check tantra.

  inputs
    n-joints       float
    torques        list   -- required torque per joint (N*m)
    omegas         list   -- angular velocity per joint (rad/s)
    rated-torques  list   -- rated motor torque per joint (N*m)
    rated-powers   list   -- rated motor power per joint (W)

  let
    motor-lines = reduce (range n-joints) "" (fn acc i ->
      let tq      = nth torques i
      let om-i    = nth omegas i
      let pw-i    = mul tq (abs om-i)
      let rt      = nth rated-torques i
      let rp      = nth rated-powers i
      let mc      = motor-check tq pw-i rt rp
      let ok      = nth mc 0
      let verdict = cond (gt ok 0) "OK" otherwise "EXCEEDS"
      let ln      = (concat "\n    joint" (to-string i) ": tq_req=" (to-string tq) " N*m (rated " (to-string rt) ")  [" verdict "]")
      concat acc ln)

    pw-total = reduce (range n-joints) 0 (fn acc i ->
      let tq   = nth torques i
      let om-i = nth omegas i
      add acc (mul tq (abs om-i)))

  return
    motor-lines  string
    pw-total     float   -- watts

done

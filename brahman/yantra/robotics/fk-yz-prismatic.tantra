tantra fk-yz-prismatic

  -- Forward kinematics for a 3-DOF arm: Ry-Rz-prismatic-Z configuration.
  --
  -- Joint 0: revolute about Y-axis (sweeps in XZ plane)
  -- Joint 1: revolute about Z-axis in frame 1 (sweeps in XY of frame 1)
  -- Joint 2: prismatic along Z-axis of frame 2
  --
  -- FK derivation (world frame, Z-up convention):
  --   Ry(θ0): x' = x·cos θ0 + z·sin θ0,  y' = y,  z' = −x·sin θ0 + z·cos θ0
  --
  --   end of link 0 (world):
  --     p0 = ( L0·cos θ0,  0,  −L0·sin θ0 )
  --
  --   Rz(θ1) in frame 1 moves link 1 along frame-1 X:
  --     local = ( L1·cos θ1,  L1·sin θ1,  0 )
  --     world = Ry(θ0) · local = ( L1·cos θ1·cos θ0,  L1·sin θ1,  −L1·cos θ1·sin θ0 )
  --
  --   end of link 1 (world):
  --     p1 = p0 + world = ( (L0+L1·cos θ1)·cos θ0,  L1·sin θ1,  −(L0+L1·cos θ1)·sin θ0 )
  --
  --   prismatic d2 moves along frame-2 Z = Ry(θ0)·ẑ = (sin θ0, 0, cos θ0):
  --     end-effector = p1 + d2·(sin θ0, 0, cos θ0)

  inputs
    link-length-0  float  metre
    link-length-1  float  metre
    theta0         float  radian
    theta1         float  radian
    d2             float  metre

  let
    cos0  = cos theta0
    sin0  = sin theta0
    cos1  = cos theta1
    sin1  = sin theta1

    -- end of link 0
    p0x   = mul link-length-0 cos0
    p0z   = mul (neg link-length-0) sin0

    -- end of link 1 (world)
    A     = add link-length-0 (mul link-length-1 cos1)
    p1x   = mul A cos0
    p1y   = mul link-length-1 sin1
    p1z   = mul (neg A) sin0

    -- end-effector (after prismatic d2 along Ry(θ0)·ẑ)
    ex    = add p1x (mul d2 sin0)
    ey    = p1y
    ez    = add p1z (mul d2 cos0)

  return
    ex  float  metre
    ey  float  metre
    ez  float  metre
    p0x float  metre
    p0z float  metre
    p1x float  metre
    p1y float  metre
    p1z float  metre

done

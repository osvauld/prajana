tantra moment-of-inertia-rod

  -- moment of inertia for a uniform rod rotating about one end
  -- models a robot link (bone/rekha) as a uniform rod
  --
  -- I = (1/3) × mass × length²
  --
  -- this is the standard result for a rod about its end.
  -- for a rod about its centre use (1/12)mL² — not the robot case.
  -- compose two calls (one per link) to get inertia1, inertia2.

  inputs
    mass         float  kilogram
    link-length  float  metre

  let
    l-sq             = mul link-length link-length
    moment-of-inertia = mul (div 1 3) (mul mass l-sq)

  return
    moment-of-inertia  float  kilogram-metre-squared

done

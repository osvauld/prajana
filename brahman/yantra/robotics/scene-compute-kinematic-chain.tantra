tantra scene-compute-kinematic-chain

  -- Thin orchestrator for the kinematic-chain computation pipeline.
  -- Assumes the scene graph has already been extracted (scene-extract-kinematic-chain).
  -- Pipeline:
  --   1. read-joint-data      — load all per-joint/link values from scene graph
  --   2. read target position — from tnode in scene graph
  --   3. ik-ndof-jt           — solve IK via DLS pseudoinverse (jacobian)
  --   4. deltas               — |theta_target - theta_start| per joint
  --   5. torque-gravity-ndof  — gravity-load torques
  --   6. path-energy-ndof     — E = sum(tau_i * |d_theta_i|) [path-energy]
  --   7. joint-velocity-ndof  — minimum move time at rated speed
  --   8. velocity-plan-ndof   — balanced/slow omegas and powers [velocity-plan]
  --   9. goal-detect          — parse sentence for optimisation goal
  --  10. motor-check-ndof     — feasibility check per joint
  -- Returns all structured values needed by scene-format-kinematic-chain.

  inputs
    root-name  string
    hash       string
    n-joints   float
    sentence   string   -- for goal-detect

  let
    -- 1. read all per-joint/link data from scene graph
    jd             = read-joint-data root-name hash n-joints
    link-lengths   = nth jd 0
    joint-angles   = nth jd 1
    omega-maxes    = nth jd 2
    rated-torques  = nth jd 3
    rated-powers   = nth jd 4
    link-masses    = nth jd 5
    axis-xs        = nth jd 6
    axis-ys        = nth jd 7
    axis-zs        = nth jd 8
    mass-provided  = nth jd 9
    rtorq-provided = nth jd 10
    rpwr-provided  = nth jd 11

    -- 2. read target position from scene graph
    root-pairs = shabda-pairs root-name
    tnode = first-match root-pairs (fn p -> cond (eq (nth p 0) "target-node") (nth p 1) otherwise _none)
    tp    = shabda-pairs tnode
    tx-s  = first-match tp (fn p -> cond (eq (nth p 0) "x") (nth p 1) otherwise _none)
    ty-s  = first-match tp (fn p -> cond (eq (nth p 0) "y") (nth p 1) otherwise _none)
    tz-s  = first-match tp (fn p -> cond (eq (nth p 0) "z") (nth p 1) otherwise _none)
    tx    = cond (exists tx-s) (to-number tx-s) otherwise 0
    ty    = cond (exists ty-s) (to-number ty-s) otherwise 0
    tz    = cond (exists tz-s) (to-number tz-s) otherwise 0

    -- 3. IK via DLS pseudoinverse (jacobian)
    ik-res       = ik-ndof-jt n-joints link-lengths axis-xs axis-ys axis-zs joint-angles tx ty
    theta-target = nth ik-res 0
    ex           = nth ik-res 1
    ey           = nth ik-res 2

    -- 4. angular-displacement per joint
    deltas = map (range n-joints) (fn i ->
      abs (sub (nth theta-target i) (nth joint-angles i)))

    -- 5. gravity-load torques
    g-str   = shabda "physics-constants" "gravitational-acceleration"
    g       = cond (exists g-str) (to-number (nth (split g-str " ") 0)) otherwise 9.80665

    torques = torque-gravity-ndof n-joints link-masses link-lengths g

    -- 6. path energy E = sum(tau_i * |delta_theta_i|)
    pe-res      = path-energy-ndof n-joints torques deltas
    path-energy = nth pe-res 0

    -- 7. minimum move time at rated speed (joint-velocity-ndof)
    vr-res      = joint-velocity-ndof n-joints joint-angles theta-target omega-maxes
    omegas-mintime = nth vr-res 0
    t-move         = nth vr-res 1

    -- 8. velocity plan (balanced and slow)
    vp-res        = velocity-plan-ndof n-joints path-energy deltas torques t-move
    t-opt         = nth vp-res 0
    t-budget      = nth vp-res 1
    omegas-opt    = nth vp-res 2
    omegas-slow   = nth vp-res 3
    pw-opt-total  = nth vp-res 4
    pw-slow-total = nth vp-res 5

    -- power at rated speed
    mc-mintime    = motor-check-ndof n-joints torques omegas-mintime rated-torques rated-powers
    pw-total      = nth mc-mintime 1

    -- 9. goal detection from sentence
    gd-res = goal-detect sentence
    goal   = nth gd-res 0

    -- 10. motor check using goal-selected omegas
    omegas-for-check = cond (eq goal "minimize-time") omegas-mintime
                            (eq goal "minimize-power") omegas-slow
                            otherwise omegas-opt
    mc-res      = motor-check-ndof n-joints torques omegas-for-check rated-torques rated-powers
    motor-lines = nth mc-res 0

    -- missing-data flags for clarification block
    mass-any-miss = reduce (range n-joints) "no" (fn acc i ->
      cond (eq (nth mass-provided i) "no") "yes" otherwise acc)
    torque-any-miss = reduce (range n-joints) "no" (fn acc i ->
      cond (eq (nth rtorq-provided i) "no") "yes" otherwise acc)
    power-any-miss = reduce (range n-joints) "no" (fn acc i ->
      cond (eq (nth rpwr-provided i) "no") "yes" otherwise acc)
    any-missing-a = cond (eq mass-any-miss "yes") "yes" otherwise "no"
    any-missing-b = cond (eq torque-any-miss "yes") "yes" otherwise any-missing-a
    any-missing   = cond (eq power-any-miss "yes") "yes" otherwise any-missing-b

    lm-def = to-string (nth link-masses 0)
    rt-def = to-string (nth rated-torques 0)
    rp-def = to-string (nth rated-powers 0)

  return
    joint-angles    list
    theta-target    list
    ex              float  metre
    ey              float  metre
    tz              float  metre
    motor-lines     string
    path-energy     float
    goal            string
    t-move          float  second
    pw-total        float  watt
    t-opt           float  second
    pw-opt-total    float  watt
    omegas-opt      list
    t-budget        float  second
    pw-slow-total   float  watt
    omegas-slow     list
    omegas-mintime  list
    any-missing     string
    mass-any-miss   string
    torque-any-miss string
    power-any-miss  string
    lm-def          string
    rt-def          string
    rp-def          string

done

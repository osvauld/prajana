tantra test-fk

  -- test fk-ndof: 2-joint Z-axis arm, both angles=0, L=[5,3]
  -- expected end-effector: [8, 0, 0]

  inputs
    dummy  float

  let
    a    = split "0 0" " "
    axs  = split "0 0" " "
    ays  = split "0 0" " "
    azs  = split "1 1" " "
    ls   = split "5 3" " "
    r    = fk-ndof 2 a axs ays azs ls
    ex   = nth r 0
    ey   = nth r 1
    ez   = nth r 2

  return
    ex  float  metre
    ey  float  metre
    ez  float  metre

done

tantra angular-accel-joint

  -- angular acceleration of a joint during synchronized motion
  -- assumes constant acceleration from rest to omega over move-time
  --
  -- α = ω / T
  --
  -- this is the kramanusara of angular-velocity wrt time:
  -- the joint accelerates uniformly from 0 to ω in time T.
  -- used to compute torque required: τ = I × α

  inputs
    omega      float  radian-per-second
    move-time  float  second

  let
    angular-acceleration = div omega move-time

  return
    angular-acceleration  float  radian-per-second-squared

done

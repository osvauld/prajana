tantra domain-of

  -- returns domain-* nodes linked to this node.
  -- checks: (1) node itself is a domain, (2) outgoing sthita to domain-*,
  -- (3) incoming edges from domain-* nodes.
  -- previously an OCaml primitive; now expressed as graph walks.

  inputs
    n  string

  let
    -- case 1: node itself is a domain
    self-dom = cond (starts-with n "domain-") [n] otherwise []

    -- case 2: outgoing sthita edges to domain-* targets
    sthita-targets = walk n "sthita"
    sthita-doms    = filter sthita-targets (fn t -> starts-with t "domain-")

    -- case 3: incoming edges from domain-* sources
    n-edges       = edges n
    incoming-doms = filter n-edges (fn eg ->
      and (eq (nth eg 2) n) (starts-with (nth eg 0) "domain-"))
    incoming-dom-names = map incoming-doms (fn eg -> nth eg 0)

    result = unique (flatten [self-dom, sthita-doms, incoming-dom-names])

  return
    result  list

done

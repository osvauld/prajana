tantra domain-of

  -- returns domain-* nodes linked to this node.
  -- checks: (1) node itself is a domain, (2) outgoing sthita to domain-*,
  -- (3) incoming edges from domain-* nodes,
  -- (4) ancestors via vishesa/abheda/swarupa inheritance carry domain-* sthita.

  inputs
    n  string

  let
    -- case 1: node itself is a domain
    self-dom = cond (starts-with n "domain-") [n] otherwise []

    -- case 2: outgoing sthita edges to domain-* targets (direct)
    sthita-targets = walk n "sthita"
    sthita-doms    = filter sthita-targets (fn t -> starts-with t "domain-")

    -- case 3: incoming edges from domain-* sources
    n-edges       = edges n
    incoming-doms = filter n-edges (fn eg ->
      and (eq (nth eg 2) n) (starts-with (nth eg 0) "domain-"))
    incoming-dom-names = map incoming-doms (fn eg -> nth eg 0)

    -- case 4: walk inheritance chain and collect sthita domain edges from ancestors
    ancestors       = ancestors-of n
    ancestor-sthita = map ancestors (fn a -> walk a "sthita")
    ancestor-flat   = flatten ancestor-sthita
    ancestor-doms   = filter ancestor-flat (fn t -> starts-with t "domain-")

    result = unique (flatten [self-dom, sthita-doms, incoming-dom-names, ancestor-doms])

  return
    result  list

done

tantra matra-ganana

  -- matra-ganana: unit algebra.
  -- composes, verifies, and transforms units via SI dimension exponent vectors.
  --
  -- the exponent vector IS the unit's identity: [M, L, T, I, theta, N, J, scale]
  -- kramanusara (d/dt) subtracts 1 from T. sama-kalana (integral dt) adds 1.
  -- the T exponent tells you the kramanusara depth.
  --
  -- operations:
  --   mul:           a * b → add exponents, multiply scales
  --   div:           a / b → subtract exponents, divide scales
  --   kramanusara:   d/dt  → T exponent - 1
  --   sama-kalana:   int dt → T exponent + 1
  --   pow:           a^n   → multiply exponents by n
  --   inv:           1/a   → negate exponents, reciprocal scale
  --   verify:        check that two units have compatible dimensions

  inputs
    unit-a    string
    unit-b    string
    op        string

  let
    vec-a = dim-vector unit-a
    vec-b = dim-vector unit-b
    has-a = exists vec-a
    has-b = exists vec-b

    result-vec = cond
      (and has-a has-b) (dim-op vec-a vec-b op)
      (has-a) (dim-op vec-a _none op)
      otherwise _none

    result-unit = cond (exists result-vec) (dim-to-unit result-vec) otherwise ""
    result-depth = cond (exists result-vec) (dim-kramanusara-depth result-vec) otherwise 0

    -- verify: check if two units have the same dimension (ignoring scale)
    compatible = cond
      (eq op "verify") (eq (dim-to-unit vec-a) (dim-to-unit vec-b))
      otherwise false

  return
    result-unit   string
    result-depth  float
    compatible    float

done

tantra find-context

  -- extract active-concept and pending-number from the partial question graph.
  -- active-concept: the MOST RECENT concept node waiting for a sankhya binding.
  -- pending-num:    a bare number from the previous word, waiting for a matra.
  -- returns [active-concept, pending-num]

  takes graph

  -- most recent satya concept
  active-concept = reduce graph "" (fn acc [s, e, o] ->
    cond (e is satya) s otherwise acc)

  last-tri    = cond (gt (length graph) 0)
                  (nth graph (sub (length graph) 1))
                otherwise []

  pending-num = cond (and (gt (length last-tri) 0)
                          ((nth last-tri 1) is asprista-sankhya))
                  (nth last-tri 2)
                otherwise ""

  context = [active-concept, pending-num]

  return context
done

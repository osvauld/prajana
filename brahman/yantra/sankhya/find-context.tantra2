tantra2 find-context

-- extract active-concept and pending-number from the partial question graph.
-- active-concept: the MOST RECENT satya subject waiting for a sankhya binding.
-- pending-num:    a bare number from the previous word, waiting for a matra.
-- returns [active-concept, pending-num]

takes graph

active-concept = reduce graph "" (fn acc tri ->
  let s = nth tri 0
  let e = nth tri 1
  cond (eq e "satya") s otherwise acc)

last-tri    = (cond (gt (length graph) 0) (nth graph (sub (length graph) 1)) otherwise [])

pending-num = (cond (and (gt (length last-tri) 0) (eq (nth last-tri 1) "asprista-sankhya"))
  (nth last-tri 2)
  otherwise "")

ctx = [active-concept, pending-num]

return ctx

done

tantra format-triples

  inputs
    triples  list
    indent   string

  let
    lines  = map triples (fn t -> concat indent (to-english (nth t 0)) " " (to-english-relation (nth t 1)) " " (join (map (nth t 2) (fn tgt -> to-english tgt)) ", ") "." "\n")
    result = join lines ""

  return
    result  string

done

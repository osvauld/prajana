tantra query-intents

  inputs
    sentence  string

  let
    words = map (tokenise sentence) (fn w -> lower w)

    has-what = gt (length (filter words (fn w -> eq w "what"))) 0
    has-is = gt (length (filter words (fn w -> eq w "is"))) 0

    has-from = gt (length (filter words (fn w -> eq w "from"))) 0
    has-born = gt (length (filter words (fn w -> eq w "born"))) 0
    has-origin = gt (length (filter words (fn w -> eq w "origin"))) 0

    has-how = gt (length (filter words (fn w -> eq w "how"))) 0
    has-process = gt (length (filter words (fn w -> eq w "process"))) 0
    has-becoming = gt (length (filter words (fn w -> eq w "becoming"))) 0

    has-result = gt (length (filter words (fn w -> eq w "result"))) 0
    has-consequence = gt (length (filter words (fn w -> eq w "consequence"))) 0
    has-phala = gt (length (filter words (fn w -> eq w "phala"))) 0

    has-inherit = gt (length (filter words (fn w -> eq w "inherit"))) 0
    has-inherits = gt (length (filter words (fn w -> eq w "inherits"))) 0
    has-left = gt (length (filter words (fn w -> eq w "left"))) 0
    has-leave = gt (length (filter words (fn w -> eq w "leave"))) 0
    has-continue = gt (length (filter words (fn w -> eq w "continue"))) 0
    has-continuity = gt (length (filter words (fn w -> eq w "continuity"))) 0
    has-parampara = gt (length (filter words (fn w -> eq w "parampara"))) 0
    has-samskaara = gt (length (filter words (fn w -> eq w "samskaara"))) 0

    i-identity = cond (or has-what has-is)
      (split "identity" ",")
      otherwise (split "" ",")

    i-origin = cond (or has-from has-born has-origin)
      (split "origin" ",")
      otherwise (split "" ",")

    i-process = cond (or has-how has-process has-becoming)
      (split "process" ",")
      otherwise (split "" ",")

    i-consequence = cond (or has-result has-consequence has-phala)
      (split "consequence" ",")
      otherwise (split "" ",")

    i-transmission = cond (or has-inherit has-inherits has-left has-leave has-continue has-continuity has-parampara has-samskaara)
      (split "transmission" ",")
      otherwise (split "" ",")

    intents0 = append i-identity (append i-origin (append i-process (append i-consequence i-transmission)))
    intents = cond (gt (length intents0) 0) intents0 otherwise (split "identity" ",")

  return
    intents  list

done

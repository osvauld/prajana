tantra guard-test

  -- tests the new bare guard syntax: member x lst or flag, not member x lst

  takes graph

  owned = from graph where [s, e, o] and e is shashthi-vibhakti collect s
  bound = from graph where [s, e, o] and e is sankhya collect s

  result = scan graph with let last be "", let flag be false

    when edge is satya
      set last to word
      emit ["SET-LAST", word]

    when edge is mithya
      and last is not ""
      and member last owned or flag
      and not member last bound
      emit ["PROMOTE", word, last]

    otherwise
      emit ["OTHER", word, edge]

  return result
done

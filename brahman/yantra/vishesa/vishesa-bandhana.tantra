tantra vishesa-bandhana

  -- binding re-attribution: moves sankhya/matra/shashthi-vibhakti
  -- from the kosha concept to the vishesa instance.

  takes graph

  -- build concept → instance map from vishesa triples (exclude rashi)
  instance-map = from graph
    where [inst, e, concept]
    and e is vishesa
    and concept is not rashi
    collect [concept, inst]

  result = cond (instance-map is empty)
    graph
  otherwise
    (scan graph with

      when edge is sankhya or edge is matra or edge is shashthi-vibhakti
        let inst = from instance-map
          where [concept, label]
          and concept is word
          collect label
        emit (cond (inst is not empty) [(nth inst 0), edge, obj] otherwise [word, edge, obj])

      otherwise
        emit triple)

  return result
done

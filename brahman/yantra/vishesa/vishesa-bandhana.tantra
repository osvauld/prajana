tantra vishesa-bandhana

  -- binding re-attribution: moves sankhya/matra/shashthi-vibhakti
  -- from the kosha concept to the vishesa instance.
  --
  -- uses agra-bandha with:
  --   anchor-edge = "vishesa"  (new instance arrival updates agra)
  --   anchor-obj  = "obj"      (the concept is in obj position)
  --   anchor-val  = "word"     (the instance label is in word position)
  --   bind-edges  = [sankhya, matra, shashthi-vibhakti]
  --   exclude-obj = "rashi"    (rashi marker triples do not set agra)
  --   skip-bound  = instances already carrying a sankhya (idempotence)

  takes graph

  -- instances already carrying a sankhya (idempotence guard)
  already-bound = from graph
    where [s, e, o]
    and e is sankhya
    collect s

  result = agra-bandha
    graph
    "vishesa"
    "obj"
    "word"
    ["sankhya", "matra", "shashthi-vibhakti"]
    ""
    "rashi"
    []
    already-bound
    []

  return result

done

tantra agra-bandha

  -- agra: the foremost. the one currently at the front.
  --
  -- proximity binding via a moving anchor: as the scan moves forward through
  -- the graph, agra-map tracks the most recently seen instance for each
  -- concept. bindings (sankhya, matra, shashthi-vibhakti, mithya, etc.)
  -- attach to whatever agra currently holds for their concept.
  --
  -- this is the common logic shared by vishesa-bandhana, vishesa-instance,
  -- and rashi-viveka. all three are proximity binding at different anchors.
  --
  -- parameters:
  --   graph        -- the graph to scan
  --   anchor-edge  -- edge type that updates agra (e.g. "vishesa", "satya")
  --   anchor-obj   -- slot used as map key: "obj" or "word"
  --   anchor-val   -- slot stored as agra value: "word" or "obj"
  --   bind-edges   -- list of edge types whose subject gets redirected to agra
  --   gate-edge    -- if non-empty: this edge must be seen before bind fires
  --                   (the gate triple is consumed, not emitted)
  --   exclude-obj  -- if non-empty: anchor only fires when obj is NOT this value
  --   exclude-bind -- list of words that must not be used as bind subjects
  --                   (e.g. entity names that should not be redirected)
  --   skip-bound   -- list of subjects already bound (idempotence guard)
  --   require-key  -- if non-empty: list of keys; anchor only fires when
  --                   word (the bind subject) is a member of this list
  --                   (empty list = no restriction)

  inputs
    graph        list
    anchor-edge  string
    anchor-obj   string
    anchor-val   string
    bind-edges   list
    gate-edge    string
    exclude-obj  string
    exclude-bind list
    skip-bound   list
    require-key  list

  let

  has-gate     = gt (string-length gate-edge) 0
  has-exclude  = gt (string-length exclude-obj) 0
  has-require  = gt (length require-key) 0

  result = scan graph with
    let agra-map       be []
    let saw-gate       be false

    -- anchor: update agra-map for this concept
    when (eq edge anchor-edge)
      and (cond has-exclude (neq (to-string obj) exclude-obj) otherwise true)
      let k = cond (eq anchor-obj "obj")  (to-string obj)  otherwise (to-string word)
      let v = cond (eq anchor-val "word") (to-string word) otherwise (to-string obj)
      set agra-map to (append (from agra-map where [mk, mv] and (neq mk k) collect [mk, mv]) [[k, v]])
      set saw-gate to false
      emit triple

    -- gate: consume the gate-edge triple, set saw-gate flag
    when has-gate
      and (eq edge gate-edge)
      set saw-gate to true

    -- bind: redirect subject from concept to its current agra
    when (member edge bind-edges)
      let concept = to-string word
      let agra    = nth (from agra-map where [mk, mv] and (eq mk concept) collect mv) 0
      let gated   = cond has-gate saw-gate otherwise true
      let allowed = and gated
                        (and (neq agra "")
                             (and (not (member concept exclude-bind))
                                  (and (not (member agra skip-bound))
                                       (cond has-require (member concept require-key) otherwise true))))
      emit (cond allowed [agra, edge, obj] otherwise [word, edge, obj])
      set saw-gate to false

    otherwise
      set saw-gate to false
      emit triple

  return result

done

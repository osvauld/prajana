tantra vishesa-instance

  -- typed quantity instance creation.
  -- when a mithya label follows a satya concept with no numeric binding:
  --   → [label, vishesa, concept]   (label IS a particular of concept)
  --   → [label, vishesa, rashi]     (label is a measurable quantity)
  --
  -- fires when the concept is owned (has shashthi-vibhakti) OR when the graph
  -- contains a rashi-bandha signal (the "concept label of value" pattern without
  -- an explicit entity — e.g. "magnetic field B of 0.1").
  --
  -- agra discipline: last-satya is the agra concept. when a mithya label arrives
  -- it promotes to vishesa against the current agra. agra updates forward with
  -- each new satya — correctly handles N entities each introducing same concept.

  takes graph

  -- concepts owned by an entity (have shashthi-vibhakti edge)
  owned-concepts = from graph
    where [s, e, o]
    and e is shashthi-vibhakti
    collect s

  -- entity names (have prathama-vibhakti edge)
  ent-names = from graph
    where [s, e, o]
    and e is prathama-vibhakti
    collect s

  -- concepts already bound to a numeric value
  bound-concepts = from graph
    where [s, e, o]
    and e is sankhya
    collect s

  -- whether any rashi-bandha signal is present
  has-rashi-bandha = exists (from graph
    where [s, e, o]
    and e is rashi-bandha
    collect s)

  can-promote = has-rashi-bandha

  result = scan graph with
    let last-agra be ""

    when edge is satya
      set last-agra to (to-string word)
      emit triple

    when edge is sankhya or edge is matra or edge is vishesa
      clear last-agra
      emit triple

    when edge is mithya
      and (neq last-agra "")
      and (or (member last-agra owned-concepts) can-promote)
      and (not (member last-agra bound-concepts))
      and (not (member word ent-names))
      emit [word, "vishesa", last-agra]
      emit [word, "vishesa", "rashi"]
      clear last-agra

    otherwise
      emit triple

  return result

done

tantra vishesa-instance

  -- typed quantity instance creation (R4b redesigned).
  -- when a mithya label follows an owned satya concept with no numeric binding:
  --   → [label, vishesa, concept]   (label IS a particular of concept)
  --   → [label, vishesa, rashi]     (label is a measurable quantity)

  takes graph

  -- concepts owned by an entity (have shashthi-vibhakti edge)
  owned-concepts = from graph
    where [s, e, o]
    and e is shashthi-vibhakti
    collect s

  -- entity names (have prathama-vibhakti edge)
  ent-names = from graph
    where [s, e, o]
    and e is prathama-vibhakti
    collect s

  -- concepts already bound to a numeric value
  bound-concepts = from graph
    where [s, e, o]
    and e is sankhya
    collect s

  result = scan graph with last-active = ""

    when edge is satya
      set last-active to word
      emit triple

    when edge is sankhya or edge is matra or edge is vishesa
      clear last-active
      emit triple

    when edge is mithya
      and last-active is not ""
      and (member last-active owned-concepts)
      and (not (member last-active bound-concepts))
      and (not (member word ent-names))
      clear last-active
      emit [word, vishesa, last-active]
      emit [word, vishesa, rashi]

    otherwise
      emit triple

  return result
done

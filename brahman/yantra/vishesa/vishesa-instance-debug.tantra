tantra vishesa-instance-debug

  -- diagnostic tantra: same logic as vishesa-instance but emits debug
  -- triples at every step to show exactly what the scan sees and decides.
  -- v2: granular condition checks on the mithya promote branch.

  takes graph

  owned-concepts = from graph
    where [s, e, o]
    and e is shashthi-vibhakti
    collect s

  ent-names = from graph
    where [s, e, o]
    and e is prathama-vibhakti
    collect s

  bound-concepts = from graph
    where [s, e, o]
    and e is sankhya
    collect s

  has-rashi-bandha = exists (from graph
    where [s, e, o]
    and e is rashi-bandha
    collect s)

  can-promote-val = has-rashi-bandha

  result = scan graph with let last-active be "", let can-promote be can-promote-val

    when edge is satya
      set last-active to word
      emit ["debug-satya", word, "last-active-set"]
      emit triple

    when edge is sankhya or edge is matra or edge is vishesa
      emit ["debug-clear", word, last-active]
      clear last-active
      emit triple

    when edge is mithya
      -- emit individual condition results
      emit ["debug-mithya-cond1-last-active-not-empty", last-active, (not (last-active is ""))]
      emit ["debug-mithya-cond2-owned-or-promote", last-active, (member last-active owned-concepts), can-promote]
      emit ["debug-mithya-cond3-not-bound", last-active, (not (member last-active bound-concepts))]
      emit ["debug-mithya-cond4-not-ent", word, (not (member word ent-names))]

      when last-active is not ""
        and ((member last-active owned-concepts) or can-promote)
        and (not (member last-active bound-concepts))
        and (not (member word ent-names))
        let concept = last-active
        clear last-active
        emit ["debug-PROMOTE", word, concept]
        emit [word, vishesa, concept]
        emit [word, vishesa, rashi]

      emit triple

    otherwise
      emit ["debug-other", word, edge]
      emit triple

  return result
done

tantra rashi-viveka-debug

  -- debug: same as rashi-viveka but emits debug triples to show what fires.

  takes graph

  rashi-labels = from graph
    where [s, e, o]
    and e is vishesa
    and o is rashi
    collect s

  result = scan graph with let last-rashi be "", let saw-rashi-bandha be false

    when edge is vishesa and (member word rashi-labels)
      emit ["debug-vishesa", word, obj]
      set last-rashi to word
      emit triple

    when edge is rashi-bandha and last-rashi is not ""
      emit ["debug-rashi-bandha", last-rashi, "consumed"]
      set saw-rashi-bandha to true

    when edge is asprista-sankhya and saw-rashi-bandha and last-rashi is not ""
      emit ["debug-asprista", last-rashi, obj]
      emit [last-rashi, sankhya, obj]
      clear last-rashi
      set saw-rashi-bandha to false

    otherwise
      set saw-rashi-bandha to false
      emit triple

  return result
done

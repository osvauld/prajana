tantra2 rashi-viveka

-- rashi instantiation with value: binds a sankhya to an already-typed rashi instance.
--
-- vishesa-instance (earlier pass) has promoted mithya labels to vishesa triples:
--   [v1, vishesa, velocity]   [v1, vishesa, rashi]
--
-- this tantra picks up the value via the rashi-bandha gate signal:
--   [of,  rashi-bandha, ...]     value-assignment signal
--   [20,  asprista-sankhya, 20.] the number
--
-- and emits:
--   [v1, sankhya, 20.]
--
-- consuming both the gate triple and the asprista-sankhya triple.
--
-- agra discipline: last-rashi tracks the most recently seen rashi instance.
-- Gate (rashi-bandha) must be seen before the bind fires.
-- N entities handled correctly — agra updates forward as each new instance arrives.
--
-- Layer 2 note: scan is always top-level. When no rashi labels exist the scan
-- is a passthrough (no branch fires on vishesa/rashi-bandha/asprista-sankhya
-- patterns so all triples reach _ -> emit unchanged).

takes graph

rashi-labels  = graph | where [s, e, o] | and (eq e "vishesa") | and (eq o "rashi") | collect s
already-bound = map (bound-concepts graph) (fn kv -> nth kv 0)

result = scan graph [last-rashi: str = "", saw-gate: bool = false, rashi-labels: list = rashi-labels, already-bound: list = already-bound]:

  [word, vishesa, obj]
    when member (to-string word) rashi-labels
    ->
      last-rashi = (to-string word)
      saw-gate = false
      emit

  [_, rashi-bandha, _]
    when last-rashi != ""
    ->
      saw-gate = true

  [_, asprista-sankhya, qty]
    when saw-gate
    when last-rashi != ""
    when not (member last-rashi already-bound)
    ->
      emit [last-rashi, "sankhya", qty]
      last-rashi = ""
      saw-gate = false

  _ ->
    saw-gate = false
    emit

return result

done

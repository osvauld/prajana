tantra visheshanam-projection

  -- visheshanam algebra: project an edge set onto the intent-relevant subspace.
  --
  -- this tantra implements a three-stage filter on the 10-dimensional edge space:
  --
  -- stage 1 — closure (group axiom from brahman/kosha/math/closure.om):
  --   restrict to edges whose target shares a domain with the seed.
  --   this enforces the group axiom: operations stay within the domain subgroup.
  --   when seed has no domain, pass all edges through (open closure).
  --
  -- stage 2 — projection (from brahman/kosha/math/projection.om):
  --   each edge's relation type is an independent axis in the visheshanam ring.
  --   firstness-of-triple assigns a tier per (intent, relation) pair:
  --     aadya     — coefficient 1.0: primary basis vectors, always kept
  --     anantara  — coefficient 1.0: secondary basis, always kept
  --     apara     — coefficient conditional: kept only if target has structural content
  --     anuvritta — coefficient 0.0: noise floor, always dropped
  --   the tier assignment changes with intent: identity promotes swarupa/abheda,
  --   process promotes kriya/yukta, consequence promotes phala/kriya, etc.
  --
  -- stage 3 — norm (from brahman/kosha/math/norm.om):
  --   within the apara tier, filter by node-satya > 0.
  --   node-satya measures structural content: slokas, edges, type diversity.
  --   this removes targets that are empty references (no content behind the name).
  --
  -- output: the projected edge set, ordered aadya + anantara + filtered-apara.

  inputs
    triples       list
    intent        string
    seed-domains  list

  let
    -- step 1: closure — restrict to edges whose target shares any seed domain
    -- group axiom: operations must stay within the domain subgroup
    has-domains = gt (length (filter seed-domains (fn d -> neq d ""))) 0

    domain-filtered = cond (has-domains)
      (filter triples (fn e ->
        let tgt = nth e 2
        let tgt-doms = domain-of tgt
        in gt (length (filter tgt-doms (fn d ->
          gt (length (filter seed-domains (fn sd -> eq sd d))) 0))) 0))
      otherwise triples

    -- step 2: projection — assign tier via firstness-of-triple
    -- each tier is a subspace; anuvritta has zero coefficient → not collected
    aadya     = filter domain-filtered (fn t -> eq (firstness-of-triple intent t) "aadya")
    anantara  = filter domain-filtered (fn t -> eq (firstness-of-triple intent t) "anantara")
    apara-raw = filter domain-filtered (fn t -> eq (firstness-of-triple intent t) "apara")

    -- step 3: norm — within apara, keep only targets with structural content
    -- node-satya > 0 means the node has slokas, edges, type diversity
    -- this is not a linear sort — each relation type is an independent axis
    apara = filter apara-raw (fn t -> gt (node-satya (nth t 2)) 0)

    -- step 4: assemble — aadya + anantara (full basis) + filtered apara
    projected = append aadya (append anantara apara)

  return
    projected  list

done

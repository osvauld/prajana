tantra doppler-effect

  inputs
    source-frequency   float  hertz
    wave-speed         float  metre-per-second
    observer-velocity  float  metre-per-second
    source-velocity    float  metre-per-second

  let
    observed = mul source-frequency (div (add wave-speed observer-velocity) (sub wave-speed source-velocity))

  return
    observed  float  hertz

done

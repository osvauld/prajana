tantra vega-ganana

  -- v(uttara) = v(purva) + a * t
  -- velocity in and velocity out — same concept, different avastha

  inputs
    velocity      float  metre-per-second  purva
    acceleration  float  metre-per-second-squared
    time          float  second

  let
    at = mul acceleration time
    velocity  = add velocity at

  return
    velocity  float  metre-per-second  uttara

done

tantra elastic-collision

  inputs
    mass      float  kilogram
    velocity  float  metre-per-second
    mass-2    float  kilogram

  let
    total    = add mass mass-2
    v1-final = div (mul (sub mass mass-2) velocity) total
    v2-final = div (mul (mul 2.0 mass) velocity) total

  return
    v1-final  float  metre-per-second
    v2-final  float  metre-per-second

done

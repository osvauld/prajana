tantra rolling-velocity

  inputs
    mass               float  kilogram
    height             float  metre
    moment-of-inertia  float  kilogram-metre-squared
    radius             float  metre

  let
    numerator   = mul (mul 2.0 (mul mass (mul gravity height))) 1.0
    denominator = add mass (div moment-of-inertia (power radius 2.0))
    v           = sqrt (div numerator denominator)

  return
    v  float  metre-per-second

done

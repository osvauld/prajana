tantra anuvada-ganana

  -- the meta-tantra: orchestrates the full query-to-answer pipeline.
  --
  -- routing priority (first match wins):
  --   1. scene comprehension  — multi-entity physical scene description
  --      detected early (before binding extraction) via scene-understand
  --   2. computation          — target + bindings → tantra → numeric result
  --   3. conceptual answer    — graph walk via anuvada (visheshanam projection)

  inputs
    sentence  string

  let
    -- step 1: tokenise and classify
    words  = tokenise sentence
    joined = classify-fold words
    intents = query-intents sentence

    -- step 2: scene detection (highest priority)
    -- scene-understand returns "" if no scene keywords found
    scene-result = scene-understand sentence

    -- step 3: if scene handled, skip computation
    -- otherwise run computation pipeline
    extraction = cond (eq scene-result "") (yantra-plan-extraction joined) otherwise _none
    stored-flag = cond (exists extraction) (eq (nth extraction 0) "stored") otherwise false

    raw-target = cond (and (exists extraction) (not stored-flag)) (nth extraction 0) otherwise ""

    concept-target = cond (eq raw-target "")
      (first-match joined (fn tok -> cond (and (eq (nth tok 1) "concept") (is-tantra (nth tok 2))) (nth tok 2) otherwise _none))
      otherwise _none

    op-target = cond (and (eq raw-target "") (not (exists concept-target)))
      (first-match joined (fn tok -> cond (eq (nth tok 1) "operator") (shabda "chihna-ganaka" (nth tok 2)) otherwise _none))
      otherwise _none

    target = cond (stored-flag) ""
             (neq raw-target "") raw-target
             (exists concept-target) concept-target
             (exists op-target) op-target
             otherwise ""

    plan      = cond (neq target "") (yantra-plan-resolution target extraction joined) otherwise _none
    raw-result = cond (exists plan) (execute-plan plan) otherwise _none
    final-result = cond stored-flag extraction (exists raw-result) raw-result otherwise _none

    formatted = cond (exists final-result) (format-response final-result) otherwise ""

    error-reason = cond (exists final-result) (nth final-result 1) otherwise ""
    is-missing-input-error = and (eq (nth final-result 0) "error") (gt (length (split error-reason "exists but")) 1)
    has-identity-intent = gt (length (filter intents (fn i -> eq i "identity"))) 0
    has-session-bindings = gt (length (session-bindings _none)) 0
    is-pure-identity = and has-identity-intent (not has-session-bindings)
    is-real-error = and is-missing-input-error (not is-pure-identity)
    is-any-error = cond (exists final-result) (eq (nth final-result 0) "error") otherwise false
    computed = cond (is-real-error) formatted (and (neq formatted "") (not is-any-error)) formatted otherwise ""

    -- step 4: conceptual fallback if nothing computed and no scene
    result = cond (neq scene-result "") scene-result
             (neq computed "") computed
             otherwise (anuvada joined intents)

  return
    result  string

done

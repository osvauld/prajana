tantra ppr-scores

  -- Personalized PageRank over the proof graph.
  -- wraps the CSR-backed ppr primitive for tantra-level access.
  --
  -- algebraic structure: p = alpha*seed + (1-alpha)*(A^T * p)
  -- where A^T is the incoming-edge weighted transition matrix in CSR form.
  -- the spmv kernel is matrix-multiplication (map-janya fold-janya dot-product-kriya)
  -- over the sparse 3-tensor T[N,N,R] (N=nodes, R=10 relation types).
  --
  -- the csr adjacency is materialized once at startup by materialize_csr.
  -- per-query: conductances derived from seed neighbourhood in O(|seed_edges|),
  -- out_cond in O(N*10), then up to 50 SpMV iterations, zero allocation.
  --
  -- seed-pairs: list of [name, weight] or VBinding(name,weight)
  -- target: the query focus node name
  -- bindings: list of binding names (strings) for depth_affinity computation

  inputs
    target    string
    seeds     list
    bindings  list

  let
    seed-pairs    = map seeds (fn s -> pair (name s) (value s))
    binding-names = map bindings (fn b -> name b)
    scores        = ppr seed-pairs target binding-names

  return
    scores  list

done

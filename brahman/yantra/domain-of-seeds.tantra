tantra domain-of-seeds

  -- finds the domain/varga for a list of seed nodes.
  -- tries two strategies in order:
  --   (1) old style: first domain-* node in sthita edges (biology/unmigrated)
  --   (2) new style: first *-varga ancestor (physics/math varga chain)
  -- returns _none if nothing found.

  inputs
    seeds  list

  let
    -- old style: domain-* node in direct sthita
    domain-result = first-match seeds (fn seed ->
                      first-match (walk seed "sthita") (fn t ->
                        cond (starts-with t "domain-") t otherwise _none))

    -- new style: find a varga ancestor via the inheritance chain
    -- walk_inheritance follows vishesa/abheda/swarupa — catches varga-vishesa links
    varga-result  = first-match seeds (fn seed ->
                      first-match (ancestors-of seed) (fn a ->
                        cond (starts-with a "domain-") a otherwise _none))

    -- prefer domain-result (specific); fall back to varga ancestry scan
    result = cond (exists domain-result) domain-result
             cond (exists varga-result) varga-result
             otherwise _none

  return
    result  string

done

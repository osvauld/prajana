tantra matra-viveka

  -- matra-viveka: compute the unit of a quantity from graph structure.
  -- the unit is a CONSEQUENCE of the definition — not stated, derived.
  --
  -- two facts are needed:
  --   1. what was differentiated (kramanusara edge → numerator quantity)
  --   2. wrt what (apeksha edge → denominator quantity)
  --
  -- algorithm:
  --   if node has direct matra edge → return that unit (base quantity)
  --   else find kramanusara edge (numerator) and apeksha edge (denominator)
  --        get unit of numerator recursively
  --        get unit of denominator recursively
  --        divide: unit = numerator-unit / denominator-unit = dim-op "div"
  --        return that

  inputs
    concept  string

  let
    -- outgoing-edges: source = concept only (no incoming, no cycles)
    out-edges = outgoing-edges concept

    -- direct matra edge (base quantities: displacement→metre, time→second, mass→kg)
    matra-edges  = filter out-edges (fn e -> eq (nth e 1) "matra")
    has-matra    = gt (length matra-edges) 0
    direct-matra = cond (has-matra) (nth (nth matra-edges 0) 2) otherwise ""

    -- kramanusara edge: what this quantity is the derivative OF (numerator)
    krama-edges  = filter out-edges (fn e -> eq (nth e 1) "kramanusara")
    has-krama    = gt (length krama-edges) 0
    krama-source = cond (has-krama) (nth (nth krama-edges 0) 2) otherwise ""

    -- apeksha edge: wrt what (denominator — almost always time)
    apeksha-edges  = filter out-edges (fn e -> eq (nth e 1) "apeksha")
    has-apeksha    = gt (length apeksha-edges) 0
    apeksha-source = cond (has-apeksha) (nth (nth apeksha-edges 0) 2) otherwise ""

    -- recursively get numerator unit
    num-unit = cond (neq krama-source "") (nth (matra-viveka krama-source) 0) otherwise ""
    num-vec  = cond (neq num-unit "") (dim-vector num-unit) otherwise _none

    -- recursively get denominator unit
    den-unit = cond (neq apeksha-source "") (nth (matra-viveka apeksha-source) 0) otherwise ""
    den-vec  = cond (neq den-unit "") (dim-vector den-unit) otherwise _none

    -- divide numerator by denominator to get derived unit
    derived-vec  = cond (and (exists num-vec) (exists den-vec))
                     (dim-op num-vec den-vec "div")
                   (exists num-vec)
                     (dim-op num-vec _none "kramanusara")
                   otherwise _none
    derived-unit = cond (exists derived-vec) (dim-to-unit derived-vec) otherwise ""

    -- direct matra wins; otherwise derived from kramanusara/apeksha
    unit  = cond (neq direct-matra "") direct-matra (neq derived-unit "") derived-unit otherwise ""

    -- kramanusara depth = |T exponent|
    unit-vec = cond (neq unit "") (dim-vector unit) otherwise _none
    depth    = cond (exists unit-vec) (dim-kramanusara-depth unit-vec) otherwise 0

  return
    unit   string
    depth  float

done

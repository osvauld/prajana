tantra has-domain

  -- checks if a node belongs to a given domain or varga.
  -- three strategies, covering both domain-* (old) and *-varga (new) schemes:
  --   (1) direct sthita edge to the domain/varga name
  --   (2) ancestor has sthita edge to the domain/varga name
  --   (3) domain/varga name appears directly in the ancestry chain (varga-vishesa path)
  --
  -- examples:
  --   (has-domain "force" "domain-physics") → checks sthita (old biology/math style)
  --   (has-domain "force" "physics-varga")  → checks ancestry (varga-vishesa style)

  inputs
    node    string
    domain  string

  let
    direct          = member domain (walk node "sthita")
    ancestors       = ancestors-of node
    inherited       = exists (first-match ancestors
                        (fn a -> member domain (walk a "sthita")))
    in-varga        = member domain ancestors
    result          = or direct inherited in-varga

  return
    result  bool

done

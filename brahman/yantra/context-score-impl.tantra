tantra context-score-impl

  -- context-score: measures how connected a node is to the active seed set.
  -- score(n, S) = |{ e ∈ edges(n) : e.source ∈ S ∨ e.target ∈ S }|
  --
  -- this is a local connectivity measure — the number of typed edges
  -- touching node n that also touch any node in the seed set S.
  -- used by spiral-domain and anuvada to rank nearby nodes by relevance.
  -- higher score = more edges shared with the query context.
  --
  -- previously an OCaml primitive; now expressed as a graph walk over the edge set.

  inputs
    n      string
    seeds  list

  let
    n-edges  = edges n
    touching = filter n-edges (fn eg ->
      or (member (nth eg 0) seeds) (member (nth eg 2) seeds))
    result = length touching

  return
    result  float

done

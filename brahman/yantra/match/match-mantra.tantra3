tantra3 match-mantra

-- match-mantra: thin orchestrator.
-- given a question graph, find the best matching mantra.
-- returns [mantra-node, val-pairs, mode] or [] if no match.
--
-- delegates to five sub-tantras:
--   scope-vps      — build val-pairs scoped to a named entity
--   relative-vps   — two-entity velocity pair for relative-velocity
--   mantra-select  — filter mantra candidates by solve-for (om-driven)
--   forward-match  — all janya present → [mantra, vps, "forward"]
--   inverse-match  — phala bound + partial janya → [mantra, vps, "inverse"]

takes graph

-- ── extract intent and scope ──────────────────────────────────────────────────
sf-result    = extract-solve-for graph
has-intent   = nth sf-result 0
solve-for    = nth sf-result 1
scope-entity = nth sf-result 2

-- ── build val-pairs ───────────────────────────────────────────────────────────
svps        = scope-vps graph scope-entity
eff-vps     = nth svps 0
eff-bcs     = nth svps 1

-- ── relative-velocity special path ────────────────────────────────────────────
rel-vps     = relative-vps graph scope-entity

final-vps = cond (gt (length rel-vps) 0) rel-vps otherwise eff-vps
final-bcs = cond (gt (length rel-vps) 0) (rel-vps | collect (nth _it 0)) otherwise eff-bcs

-- ── candidate selection (om-driven) ──────────────────────────────────────────
candidates = cond (gt (string-length solve-for) 0)
  (mantra-select solve-for)
  otherwise (mantra-select "")

-- ── forward match ─────────────────────────────────────────────────────────────
fwd = forward-match candidates final-vps final-bcs solve-for

-- ── inverse match (only if has-intent and no forward) ─────────────────────────
inv-candidates = cond has-intent candidates otherwise []

inv = cond (gt (length fwd) 0) fwd
  otherwise (inverse-match inv-candidates final-vps final-bcs solve-for)

result = cond (gt (length fwd) 0) fwd otherwise inv

return result

done

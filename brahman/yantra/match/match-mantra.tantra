tantra match-mantra

  -- given a question graph, find the best matching mantra:
  -- 1. extract solve-for concept (satya concept named as vidhi-kaala target)
  -- 2. filter mantras to those whose name: or krama-lhs matches the solve-for concept
  -- 3. among those, find first whose krama-rhs is fully covered by bound concepts
  -- 4. if no solve-for, fall back to any mantra with full krama-rhs coverage
  -- returns [mantra-node, [arg-val-0, arg-val-1, ...]] or [] if no match.

  takes graph

  -- build bound concept list and value lookup in one pass
  bound-vals = reduce graph [[], []] (fn acc [s, e, o] ->
    cond (e is sankhya)
      [(append (nth acc 0) [s]),
       (append (nth acc 1) [[s, o]])]
    otherwise acc)

  -- extract solve-for: first satya after vidhi-kaala, or first satya overall
  sf-state = reduce graph [false, "", ""] (fn acc [s, e, o] ->
    let past-intent = nth acc 0
    let fallback    = nth acc 1
    let sf          = nth acc 2
    cond
      (e is vidhi-kaala)
        [true, fallback, sf]
      (and (not past-intent) (fallback is "") (e is satya))
        [past-intent, s, sf]
      (and past-intent (sf is "") (e is satya))
        [past-intent, fallback, s]
      otherwise
        acc)

  solve-for = cond (gt (string-length (nth sf-state 2)) 0)
    (nth sf-state 2)
    otherwise (nth sf-state 1)

  -- all mantra nodes
  mantras = walk-in "execute-chain" "kriya"

  -- filter to those matching solve-for (by name: or krama-lhs)
  candidates = cond (gt (string-length solve-for) 0)
    (filter mantras (fn m ->
      let mname = shabda m "name"
      let mlhs  = shabda m "krama-lhs"
      or (mname is solve-for) (mlhs is solve-for)))
    otherwise mantras

  -- find first candidate whose entire krama-rhs is covered
  match = reduce candidates [] (fn acc m ->
    cond (gt (length acc) 0) acc
    otherwise
      (let rhs-str = shabda m "krama-rhs"
       let rhs     = split rhs-str ","
       let all-ok  = reduce rhs true (fn a r ->
         and a (or (member r (nth bound-vals 0))
                   (gt (string-length (shabda r "constants-key")) 0)))
       let args    = reduce rhs [] (fn a r ->
         let ck = shabda r "constants-key"
         let v  = cond (gt (string-length ck) 0)
           (nth (split-numeric (shabda "physics-constants" ck)) 0)
           otherwise
             (reduce (nth bound-vals 1) "" (fn a2 [concept, val] ->
               cond (concept is r) val otherwise a2))
         append a [v])
       cond all-ok [m, args]
       otherwise []))

  return match
done

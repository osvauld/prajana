tantra match-mantra

  -- given a question graph, find the best matching mantra:
  -- 1. extract solve-for concept (satya concept named as vidhi-kaala target)
  -- 2. filter mantras to those whose name: or phala edge matches the solve-for concept
  -- 3. among those, find first whose janya edges are fully covered by bound concepts
  -- 4. if no solve-for, fall back to any mantra with full janya coverage
  -- returns [mantra-node, val-pairs] or [] if no match.
  -- val-pairs = [[concept, val], ...] — passed to execute-chain for dispatch.

  takes graph

  -- build bound concept list and value lookup in one pass
  bound-vals = reduce graph [[], []] (fn acc [s, e, o] ->
    cond (e is sankhya)
      [(append (nth acc 0) [s]),
       (append (nth acc 1) [[s, o]])]
    otherwise acc)

  -- extract solve-for: first satya after vidhi-kaala, or first satya overall
  sf-state = reduce graph [false, "", ""] (fn acc [s, e, o] ->
    let past-intent = nth acc 0
    let fallback    = nth acc 1
    let sf          = nth acc 2
    cond
      (e is vidhi-kaala)
        [true, fallback, sf]
      (and (not past-intent) (fallback is "") (e is satya))
        [past-intent, s, sf]
      (and past-intent (sf is "") (e is satya))
        [past-intent, fallback, s]
      otherwise
        acc)

  solve-for = cond (gt (string-length (nth sf-state 2)) 0)
    (nth sf-state 2)
    otherwise (nth sf-state 1)

  -- all mantra nodes
  mantras = walk-in "physics-mantra" "varga"

  -- filter to those matching solve-for (by name: shabda or phala edge)
  candidates = cond (gt (string-length solve-for) 0)
    (filter mantras (fn m ->
      let mname  = shabda m "name"
      let mphala = nth (walk m "phala") 0
      or (mname is solve-for) (mphala is solve-for)))
    otherwise mantras

  -- find first candidate whose entire janya set is covered
  match = reduce candidates [] (fn acc m ->
    cond (gt (length acc) 0) acc
    otherwise
      (let janya  = walk m "janya"
       let all-ok = reduce janya true (fn a r ->
         and a (or (member r (nth bound-vals 0))
                   (gt (string-length (shabda r "constants-key")) 0)))
       cond all-ok [m, (nth bound-vals 1)]
       otherwise []))

  return match
done

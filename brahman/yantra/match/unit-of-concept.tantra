tantra unit-of-concept

  -- find the canonical unit for a concept node.
  -- three paths tried in order:
  --
  -- 1. swarupa: concept has a mantra as its swarupa — the mantra's unit
  --    is the canonical unit.
  --
  -- 2. yukta: unit nodes directly linked to this concept, filtered to matra members.
  --    prefer SI base unit (scale=1).
  --
  -- 3. sthita: mantras that use this concept as input — walk back to find unit.
  --
  -- returns the unit name string, or _none if not found.

  takes concept

  -- path 1: swarupa
  swarupa-nodes   = walk-in concept "swarupa"
  swarupa-mantras = filter swarupa-nodes
                      (fn m -> gt (string-length (shabda m "unit")) 0)
  swarupa-unit    = cond (gt (length swarupa-mantras) 0)
                      (shabda (nth swarupa-mantras 0) "unit")
                    otherwise _none

  -- path 2: yukta
  yukta-nodes = walk-in concept "yukta"
  yukta-units = filter yukta-nodes (fn u -> member "matra" (walk u "sthita"))
  yukta-si    = filter yukta-units (fn u ->
                  let v = dim-vector u
                  cond (gt (length v) 0)
                    (eq (nth v (sub (length v) 1)) 1)
                  otherwise false)
  yukta-unit  = cond (gt (length yukta-si) 0)   (nth yukta-si 0)
                otherwise (cond (gt (length yukta-units) 0) (nth yukta-units 0)
                otherwise _none)

  -- path 3: sthita
  sthita-mantras = filter (walk-in concept "sthita")
                     (fn m -> gt (string-length (shabda m "unit")) 0)
  sthita-unit    = reduce sthita-mantras _none (fn acc m ->
    cond (acc exists) acc
    otherwise
      (let direct = filter (walk-in concept "yukta")
                      (fn u -> member "matra" (walk u "sthita"))
       cond (gt (length direct) 0) (nth direct 0) otherwise _none))

  result = cond (swarupa-unit exists) swarupa-unit
           otherwise (cond (yukta-unit exists) yukta-unit
           otherwise (cond (sthita-unit exists) sthita-unit
           otherwise _none))

  return result
done

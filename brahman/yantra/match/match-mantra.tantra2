tantra2 match-mantra

-- given a question graph, find the best matching mantra.
-- returns [mantra-node, val-pairs, mode] or [] if no match.
-- mode is "forward" or "inverse" — used by anuvada-ganana to pick executor.
-- val-pairs = [[concept, val], ...] — passed to execute-math/execute-chain.
--
-- Layer 2 note: cond predicates that close all parens leave depth=0.
-- Consequence must be on SAME line as predicate, or wrapped in outer parens.

takes graph

bv   = bound-vals graph
bcs  = nth bv 0
vps  = nth bv 1

sf-result    = extract-solve-for graph
has-intent   = nth sf-result 0
solve-for    = nth sf-result 1
scope-entity = nth sf-result 2

-- when a scope entity is named ("find KE of ball-A"), look through its
-- owned properties only.
--
-- Two ownership patterns in the graph:
--   Instance path:  [inst, shashthi-vibhakti, entity] + [inst, vishesa, concept] + [inst, sankhya, val]
--                   → used when rashi labels are given ("mass m1 of 3")
--   Concept path:   [concept, shashthi-vibhakti, entity] + [concept, sankhya, val]
--                   → used when no labels ("ball has mass 3")
--
-- Build scoped val-pairs from whichever pattern is present for this entity.
-- entity ownership order for each concept: [concept, entity] pairs in graph order.
-- e.g. mass owned by [ball-A, ball-B] in order → ball-A=index 0, ball-B=index 1.
concept-entity-order = shashthi-sparsha graph ""

scoped-vps = cond (exists scope-entity)
  (reduce (shashthi-sparsha graph scope-entity)
    []
    (fn acc owned ->
      -- instance path: owned is a rashi instance — resolve concept via vishesa
      let inst-concept = nth (graph | where [i, e, c] | and (eq (to-string i) (to-string owned)) | and (eq e "vishesa") | and (neq (to-string c) "rashi") | collect c) 0
      let concept      = cond (exists inst-concept) inst-concept otherwise owned
      -- instance path: sankhya is on the instance label itself
      let inst-val = cond (exists inst-concept)
        (nth (graph | where [i, e, v] | and (eq (to-string i) (to-string owned)) | and (eq e "sankhya") | collect v) 0)
        otherwise ""
      -- direct-concept path: owned IS the concept.
      -- graph has [concept, sankhya, v] once per entity that owns it, in graph order.
      -- scope-entity's value is at index N where N = number of owners before scope-entity.
      let all-sankhyas = graph | where [i, e, v] | and (eq (to-string i) (to-string owned)) | and (eq e "sankhya") | collect v
      let owners       = concept-entity-order | where [c, ent] | and (eq (to-string c) (to-string owned)) | collect ent
      let owner-idx    = nth (reduce owners [0, false] (fn st ent ->
                           cond (nth st 1) st
                           otherwise (cond (eq (to-string ent) (to-string scope-entity))
                             [(nth st 0), true]
                             otherwise [(add (nth st 0) 1), false]))) 0
      let direct-val   = cond (lt owner-idx (length all-sankhyas))
        (nth all-sankhyas owner-idx)
        otherwise (nth all-sankhyas 0)
      let val = cond (exists inst-val) inst-val otherwise direct-val
      cond (exists val)
        (append acc [[concept, val]])
      otherwise acc))
  otherwise vps

-- effective val-pairs:
-- when scope entity present: scoped-vps first, supplement with flat for
--   constants and given-clause values NOT owned by any entity (unambiguous).
--   dedup by concept name — scope entity's value wins, other entities excluded.
--   this is correct for single-participant mantras (KE, momentum, force).
--
-- for relative-velocity (two-participant, same concept from two entities):
--   handled by relative-vps below — separate path, not eff-vps.
--
-- when no scope: flat vps, dedup by concept name (last write wins — unchanged).
eff-vps = cond (gt (string-length scope-entity) 0)
  (reduce vps scoped-vps (fn acc kv ->
    let concept = nth kv 0
    let already = acc | where [c, v] | and (eq (to-string c) (to-string concept)) | collect c
    cond (gt (length already) 0) acc otherwise (append acc [kv])))
  otherwise vps

eff-bcs = cond (gt (string-length scope-entity) 0)
  (eff-vps | collect (nth _it 0))
  otherwise bcs

-- relative-velocity: proof graph as third observer supplies both velocities.
-- only active when solve-for is relative-velocity AND scope entity is named.
-- builds [(observer-velocity, v_scope), (observed-velocity, v_other)].
other-entities = cond (and (eq (to-string solve-for) "relative-velocity") (exists scope-entity))
  ((prathama-sparsha graph) | where [s] | and (neq (to-string s) (to-string scope-entity)) | collect s)
  otherwise []

relative-vps = cond (gt (length other-entities) 0)
  (let other-entity    = nth other-entities 0
   let v-observer-list = scoped-vps | where [c, v] | and (eq (to-string c) "velocity") | collect v
   let v-observer      = nth v-observer-list 0
   let v-observed-val  = nth (graph | where [s, e, owner] | and (eq e "shashthi-vibhakti") | and (eq (to-string owner) (to-string other-entity)) | and (eq (to-string s) "velocity") | collect s
     | reduce _it "" (fn acc inst ->
         let val = nth (graph | where [i2, e2, v2] | and (eq (to-string i2) (to-string inst)) | and (eq e2 "sankhya") | collect v2) 0
         cond (exists val) (to-string val) otherwise acc)) 0
   let v-other = cond (exists v-observed-val)
     v-observed-val
     otherwise (nth (graph | where [i, e, v] | and (eq (to-string i) (to-string v-observed-direct)) | and (eq e "sankhya") | collect v) 0)
   cond (and (exists v-observer) (exists v-other))
     [["observer-velocity", v-observer], ["observed-velocity", v-other]]
   otherwise [])
  otherwise []

final-vps = cond (gt (length relative-vps) 0) relative-vps otherwise eff-vps
final-bcs = cond (gt (length relative-vps) 0) (relative-vps | collect (nth _it 0)) otherwise eff-bcs

-- mantra-viveka: which family does this question belong to?
-- physics-mantras: velocity, force, energy, momentum...
-- math-mantras:    count, total, remaining, sum, difference
-- both families tried — primary first, fallback second.
-- this is artha-viveka at the mantra level: which relation fits this question?

physics-ms = physics-mantras
math-ms    = math-mantras

count-concepts = ["count", "count-total", "count-remaining", "total", "remaining", "sum", "difference"]
is-count-question = member (to-string solve-for) count-concepts

mantras          = cond is-count-question math-ms otherwise (append physics-ms math-ms)

-- all candidates: filtered by solve-for when present
candidates = cond (gt (string-length solve-for) 0)
  (filter mantras (fn m ->
    let mname    = shabda m "name"
    let mphala   = nth (walk m "phala") 0
    let mswarupa = nth (walk m "swarupa") 0
    let mjanya   = walk m "janya"
    (or (eq mname solve-for) (eq mphala solve-for) (eq mswarupa solve-for) (member solve-for mjanya))))
  otherwise mantras

-- forward: all janya covered, solve-for is phala/swarupa
forward-match = reduce candidates [] (fn acc m ->
  let janya       = walk m "janya"
  let sf-is-janya = member solve-for janya
  let all-ok      = reduce janya true (fn a r -> (and a (or (member r final-bcs) (gt (string-length (shabda r "constants-key")) 0))))
  cond (or (gt (length acc) 0) (not all-ok) sf-is-janya) acc otherwise [m, final-vps, "forward"])

-- inverse: solve-for is janya, phala + other janya covered, math-backed
inv-candidates = cond has-intent candidates otherwise []

inverse-match = (cond (gt (length forward-match) 0) forward-match
  otherwise (reduce inv-candidates [] (fn acc m ->
    let janya        = walk m "janya"
    let mphala       = nth (walk m "phala") 0
    let mswarupa     = nth (walk m "swarupa") 0
    let has-math-op  = gt (string-length (shabda m "math-op")) 0
    let sf-is-janya  = member solve-for janya
    let other-janya  = filter janya (fn j -> not (eq j solve-for))
    let others-ok    = reduce other-janya true (fn a r -> (and a (or (member r final-bcs) (gt (string-length (shabda r "constants-key")) 0))))
    let phala-bound  = (or (member mphala final-bcs) (member mswarupa final-bcs) (member (shabda m "name") final-bcs))
    cond (or (gt (length acc) 0) (not has-math-op) (not sf-is-janya) (not others-ok) (not phala-bound)) acc
    otherwise [m, final-vps, "inverse"])))

result = cond (gt (length forward-match) 0) forward-match otherwise inverse-match

return result

done

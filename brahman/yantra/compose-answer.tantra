tantra compose-answer

  -- morphism: proof-graph tensor → English sentences.
  -- this tantra is the output morphism of the reasoning pipeline:
  --   graph structure → projected edge set → relation clauses → natural language.
  --
  -- pipeline per seed node:
  --   1. domain inference: find seed's domain(s) via sthita edges or incoming domain-* links
  --   2. visheshanam-projection: apply the 3-stage algebra (closure → tier projection → norm)
  --      to select intent-relevant edges from the seed's outgoing edge set
  --   3. clause composition: map each projected edge to English via relation-specific templates
  --      (swarupa→"is", abheda→"the same as", sthita→"resting on", yukta→"with", etc.)
  --   4. root expansion: follow swarupa/abheda targets one level deeper, project their edges too
  --   5. iccha detection: classify nearby nodes as iccha-present or iccha-absent
  --   6. assembly: domain header + seed sentences + root sentences + iccha line
  --
  -- the relation→English mapping is configurable via shabda on the anuvada-setu node.

  inputs
    seeds       list
    nearby      list
    intents     list

  let
    -- select primary intent for this answer pass
    intent = cond (gt (length intents) 0) (nth intents 0) otherwise "identity"

    -- seed's own domain
    seed-doms   = flatten (map seeds (fn s -> domain-of s))
    seed-dom    = cond (gt (length seed-doms) 0) (nth seed-doms 0) otherwise ""
    top-dom-label = cond (neq seed-dom "")
      (cond (gt (string-length seed-dom) 7) (nth (split seed-dom "domain-") 0) otherwise seed-dom)
      otherwise ""

    -- fallback: if seeds have no domain, infer from nearby frequency
    all-doms    = flatten (map nearby (fn n -> domain-of n))
    uniq-doms   = filter (unique all-doms) (fn d -> neq d "")
    dom-scores  = map uniq-doms (fn d -> pair d (length (filter all-doms (fn x -> eq x d))))
    sorted-doms = sort-desc dom-scores
    nearby-dom  = cond (gt (length sorted-doms) 0) (nth (nth sorted-doms 0) 0) otherwise ""
    nearby-label = cond (neq nearby-dom "")
      (cond (gt (string-length nearby-dom) 7) (nth (split nearby-dom "domain-") 0) otherwise nearby-dom)
      otherwise ""
    domain-label = cond (neq top-dom-label "") top-dom-label otherwise nearby-label

    -- effective domains for projection (all seed domains, or inferred)
    eff-domains = cond (gt (length seed-doms) 0) seed-doms
      (neq nearby-dom "") (split nearby-dom ",")
      otherwise (split "" ",")

    -- seed sentences: project edges through the visheshanam algebra, then compose
    rel-swarupa = cond (neq (shabda "anuvada-setu" "rel-swarupa") "") (shabda "anuvada-setu" "rel-swarupa") otherwise "is"
    rel-abheda = cond (neq (shabda "anuvada-setu" "rel-abheda") "") (shabda "anuvada-setu" "rel-abheda") otherwise "the same as"
    rel-sthita = cond (neq (shabda "anuvada-setu" "rel-sthita") "") (shabda "anuvada-setu" "rel-sthita") otherwise "resting on"
    rel-drishthanta = cond (neq (shabda "anuvada-setu" "rel-drishthanta") "") (shabda "anuvada-setu" "rel-drishthanta") otherwise "demonstrating"
    rel-yukta = cond (neq (shabda "anuvada-setu" "rel-yukta") "") (shabda "anuvada-setu" "rel-yukta") otherwise "with"
    rel-janya = cond (neq (shabda "anuvada-setu" "rel-janya") "") (shabda "anuvada-setu" "rel-janya") otherwise "arising from"
    rel-kriya = cond (neq (shabda "anuvada-setu" "rel-kriya") "") (shabda "anuvada-setu" "rel-kriya") otherwise "through"
    rel-phala = cond (neq (shabda "anuvada-setu" "rel-phala") "") (shabda "anuvada-setu" "rel-phala") otherwise "yielding"
    rel-siddha = cond (neq (shabda "anuvada-setu" "rel-siddha") "") (shabda "anuvada-setu" "rel-siddha") otherwise "proven-through"
    rel-pratipaksha = cond (neq (shabda "anuvada-setu" "rel-pratipaksha") "") (shabda "anuvada-setu" "rel-pratipaksha") otherwise "pratipaksha"

    iccha-prefix = cond (neq (shabda "anuvada-setu" "iccha-present-prefix") "")
      (shabda "anuvada-setu" "iccha-present-prefix")
      otherwise "directed-will (iccha) present in"
    iccha-absent-connector = cond (neq (shabda "anuvada-setu" "iccha-absent-connector") "")
      (shabda "anuvada-setu" "iccha-absent-connector")
      otherwise "; absent in"
    domain-header-prefix = cond (neq (shabda "anuvada-setu" "domain-header-prefix") "")
      (shabda "anuvada-setu" "domain-header-prefix")
      otherwise "in"

    seed-sentences = map seeds (fn s ->
      let eng = to-english s
      let out-edges = filter (edges s) (fn e -> eq (nth e 0) s)
      let projected = visheshanam-projection out-edges intent eff-domains
      let clauses = map projected (fn e ->
        let rel = nth e 1
        let tgt = to-english (nth e 2)
        in cond
          (eq rel "swarupa") (concat rel-swarupa " " tgt)
          (eq rel "abheda") (concat rel-abheda " " tgt)
          (eq rel "sthita") (concat rel-sthita " " tgt)
          (eq rel "drishthanta") (concat rel-drishthanta " " tgt)
          (eq rel "yukta") (concat rel-yukta " " tgt)
          (eq rel "janya") (concat rel-janya " " tgt)
          (eq rel "kriya") (concat rel-kriya " " tgt)
          (eq rel "phala") (concat rel-phala " " tgt)
          (eq rel "siddha") (concat rel-siddha " " tgt)
          (eq rel "pratipaksha") (concat rel-pratipaksha " " tgt)
          otherwise (concat (to-english-relation rel) " " tgt))
      -- deduplicate after rendering (catches duplicates from different node IDs → same English)
      let clean-clauses = unique (filter clauses (fn c -> neq c ""))
      in cond (gt (length clean-clauses) 0)
        (concat eng " " (join clean-clauses ", ") ".")
        otherwise (concat eng "."))

    -- root-targets: extract swarupa/abheda targets from the projected seed edges
    -- (these are already domain-filtered by the projection)
    root-targets = unique (flatten (map seeds (fn s ->
      let out-edges = filter (edges s) (fn e -> eq (nth e 0) s)
      let projected = visheshanam-projection out-edges intent eff-domains
      in map (filter projected (fn e -> or (eq (nth e 1) "swarupa") (eq (nth e 1) "abheda")))
        (fn e -> nth e 2))))

    -- root sentences: same projection applied to each root-target's edges
    root-sentences = map root-targets (fn r ->
      let eng = to-english r
      let out-edges = filter (edges r) (fn e -> eq (nth e 0) r)
      let projected = visheshanam-projection out-edges intent eff-domains
      let clauses = map projected (fn e ->
        let rel = nth e 1
        let tgt = to-english (nth e 2)
        in cond
          (eq rel "swarupa") (concat rel-swarupa " " tgt)
          (eq rel "abheda") (concat rel-abheda " " tgt)
          (eq rel "sthita") (concat rel-sthita " " tgt)
          (eq rel "drishthanta") (concat rel-drishthanta " " tgt)
          (eq rel "yukta") (concat rel-yukta " " tgt)
          (eq rel "janya") (concat rel-janya " " tgt)
          (eq rel "kriya") (concat rel-kriya " " tgt)
          (eq rel "phala") (concat rel-phala " " tgt)
          (eq rel "siddha") (concat rel-siddha " " tgt)
          (eq rel "pratipaksha") (concat rel-pratipaksha " " tgt)
          otherwise (concat (to-english-relation rel) " " tgt))
      let clean-clauses = unique (filter clauses (fn c -> neq c ""))
      in cond (gt (length clean-clauses) 0)
        (concat "  " eng " " (join clean-clauses ", ") ".")
        otherwise (concat "  " eng "."))

    iccha-with    = unique (filter nearby (fn n -> eq (iccha-status n) "sthita"))
    iccha-without = unique (filter nearby (fn n -> eq (iccha-status n) "rahita"))
    has-iccha     = and (gt (length iccha-with) 0) (gt (length iccha-without) 0)
    iccha-line    = cond (has-iccha)
      (concat iccha-prefix " "
        (join (map iccha-with (fn n -> to-english n)) ", ")
        iccha-absent-connector
        " "
        (join (map iccha-without (fn n -> to-english n)) ", ")
        ".")
      otherwise ""

    domain-line = cond (neq domain-label "") (concat domain-header-prefix " " domain-label ":\n") otherwise ""
    seed-block  = join seed-sentences "\n"
    root-block  = cond (gt (length root-sentences) 0) (concat "\n" (join root-sentences "\n")) otherwise ""
    iccha-block = cond (neq iccha-line "") (concat "\n" iccha-line) otherwise ""

    result = concat domain-line seed-block root-block iccha-block

  return
    result  string

done

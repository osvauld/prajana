tantra sandhi-viveka

  -- sandhi-viveka: grammar structure discernment pass.
  --
  -- runs AFTER build-question-graph, BEFORE avrti-refine.
  --
  -- for every [word, mithya, word] triple:
  --   look up the bhasha grammar node behind the word
  --   read its slokas
  --   find any sloka ending in "-sthita"
  --   strip "-sthita" → root name (e.g. "shashthi-vibhakti-sthita" → "shashthi-vibhakti")
  --   if that root node exists in the graph:
  --     emit [word, root-name, root-name]   -- typed, reflexive grammar triple
  --     drop the original mithya triple     -- word is now structurally placed
  --   if no grammar root found:
  --     pass the mithya triple through unchanged
  --
  -- non-grammar mithya words (ball, mass, etc.) pass through unchanged.
  -- satya, sankhya, matra, vidhi-kaala triples pass through unchanged.

  takes graph

  sthita-len = string-length "-sthita"

  result = map graph (fn [word, edge, obj] ->
    let gnode  = cond (edge is mithya) (lookup-word word) otherwise _none
    let slokas = cond (exists gnode) (node-slokas (to-string gnode)) otherwise []
    let words  = reduce slokas [] (fn acc s -> append acc (split s " "))
    let root   = reduce words "" (fn acc w ->
      cond (neq acc "") acc
      (ends-with w "-sthita")
        (cond (member "visheshanam-ring"
                (map (walk-in (substr w 0 (sub (string-length w) sthita-len)) "yukta")
                     (fn n -> to-string n)))
          (substr w 0 (sub (string-length w) sthita-len))
          otherwise "")
      otherwise "")
    cond (gt (string-length root) 0) [word, root, root]
    otherwise [word, edge, obj])

  return result
done

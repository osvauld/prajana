tantra2 vibhakti-shashthi

-- entity detection + concept ownership from possession signal.
-- possession signal: [has, shashthi-vibhakti, shashthi-vibhakti]  (obj = reflexive)
-- ownership result:  [concept, shashthi-vibhakti, entity]          (obj = entity name)
-- these are distinguished by obj: reflexive signal vs specific entity.
-- second avrti-refine pass must not re-process ownership edges as signals.

takes graph

result = scan graph [last-label: str = "", cur-entity: str = "", jsc: bool = false]:

  [_, vidhi-kaala, _] ->
    last-label = ""
    cur-entity = ""
    jsc        = false
    emit

  [word, viraam, _]
    when (or (eq (to-string word) ".") (eq (to-string word) "?") (eq (to-string word) "!"))
    ->
      last-label = ""
      cur-entity = ""
      jsc        = false
      emit

  -- possession signal: obj is the reflexive "shashthi-vibhakti" marker
  [_, shashthi-vibhakti, _]
    when (eq (to-string obj) "shashthi-vibhakti")
    when (neq last-label "")
    ->
      cur-entity = last-label
      last-label = ""
      emit [cur-entity, "prathama-vibhakti", "object"]

  [_, shashthi-vibhakti, _]
    when (eq (to-string obj) "shashthi-vibhakti")
    ->
      -- no pending label: discard signal silently

  -- ownership edges [concept, shashthi-vibhakti, entity] pass through unchanged
  [_, shashthi-vibhakti, _] -> emit

  [word, satya, _]
    when (neq cur-entity "")
    ->
      emit
      emit [word, "shashthi-vibhakti", cur-entity]
      jsc = true

  [word, satya, _] ->
    last-label = (to-string word)
    emit

  [_, rashi-bandha, _] ->
    last-label = ""
    emit

  [word, mithya, _]
    when jsc
    ->
      jsc = false
      emit

  [word, mithya, _] ->
    last-label = (cond (gt (string-length last-label) 0) (concat last-label "-" (to-string word)) otherwise (to-string word))
    emit

  _ -> emit

return result

done

tantra vibhakti-shashthi

  -- entity detection + concept ownership from possession signal (R8 + R9).
  -- sandhi-viveka has already promoted has/with/have/of to typed dimension triples:
  --   [has, shashthi-vibhakti, shashthi-vibhakti]  (reflexive object = grammar signal)
  -- this tantra reads those signals directly.
  --
  -- pattern:
  --   [label, mithya] → accumulate as potential entity label
  --   [word, shashthi-vibhakti, shashthi-vibhakti] → signal: preceding label is an entity
  --     → emit [label, prathama-vibhakti, object]
  --     → set cur-entity = label
  --   [concept, satya] while cur-entity set → emit [concept, shashthi-vibhakti, cur-entity]
  --
  -- R9: consecutive mithya words compound into entity name: ball + A → ball-A
  --
  -- scope cleared by:
  --   vidhi-kaala (solve-for zone starts)
  --   sentence viraam (. ? !)

  takes graph

  result = scan graph with last-label = "", cur-entity = ""

    when edge is vidhi-kaala
      clear last-label
      clear cur-entity
      emit triple

    when edge is viraam and (word is "." or word is "?" or word is "!")
      clear last-label
      clear cur-entity
      emit triple

    when edge is shashthi-vibhakti and obj is shashthi-vibhakti and last-label is not ""
      set cur-entity to last-label
      emit [cur-entity, prathama-vibhakti, object]
      clear last-label

    when edge is shashthi-vibhakti and obj is shashthi-vibhakti
      -- no pending label: discard signal
      -- (do not emit triple)

    when edge is satya and cur-entity is not ""
      emit triple
      emit [word, shashthi-vibhakti, cur-entity]

    when edge is mithya
      set last-label to (cond (gt (string-length last-label) 0)
        (concat last-label "-" word)
        otherwise word)
      emit triple

    otherwise
      emit triple

  return result
done

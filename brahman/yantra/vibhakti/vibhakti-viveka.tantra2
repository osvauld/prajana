tantra2 sandhi-viveka

-- grammar structure discernment pass.
-- runs AFTER build-question-graph, BEFORE avrti-refine.
--
-- for every [word, mithya, word] triple:
--   look up bhasha grammar node, read slokas, find sloka ending in "-sthita"
--   strip "-sthita" → root name (e.g. "shashthi-vibhakti-sthita" → "shashthi-vibhakti")
--   if root exists in visheshanam-ring yukta: emit [word, root, root] (typed grammar triple)
--   otherwise: pass mithya triple through unchanged
--
-- non-grammar mithya words pass through unchanged.
-- satya/sankhya/matra/vidhi-kaala pass through unchanged.

takes graph

sthita-len = string-length "-sthita"

-- mithya words immediately following a satya triple are rashi labels — do not promote matra
rashi-label-words = reduce graph ["", []] (fn st tri ->
  let last-e = nth st 0
  let acc    = nth st 1
  let c-edge = nth tri 1
  let c-word = nth tri 0
  (cond (and (eq c-edge "mithya") (eq last-e "satya")) [c-edge, (append acc [c-word])] otherwise [c-edge, acc]))

rashi-labels = nth rashi-label-words 1

result = map graph (fn tri ->
  let word   = nth tri 0
  let edge   = nth tri 1
  let obj    = nth tri 2
  let gnode  = (cond (eq edge "mithya") (lookup-word word) otherwise _none)
  let slokas = (cond (exists gnode) (node-slokas (to-string gnode)) otherwise [])
  let toks   = reduce slokas [] (fn acc s -> append acc (split s " "))
  let root   = reduce toks "" (fn acc w ->
    (cond (neq acc "") acc
    otherwise (cond (ends-with w "-sthita")
      (cond (member "visheshanam-ring"
               (map (walk-in (substr w 0 (sub (string-length w) sthita-len)) "yukta")
                    (fn n -> to-string n)))
        (substr w 0 (sub (string-length w) sthita-len))
        otherwise "")
    otherwise "")))
  (cond (and (gt (string-length root) 0) (not (and (eq root "matra") (member word rashi-labels)))) [word, root, root] otherwise [word, edge, obj]))

return result

done

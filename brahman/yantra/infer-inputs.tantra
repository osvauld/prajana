tantra infer-inputs

  -- returns the sthita (dependency) edges of a node, excluding domain-* targets.
  -- these are the conceptual inputs required by the node.

  inputs
    node  string

  let
    sthita  = walk node "sthita"
    result  = filter sthita (fn t -> not (starts-with t "domain-"))

  return
    result  list

done

-- unpacks a word-info structure by field name.
-- [0]=node [1]=role [2]=layer [3]=num-val [4]=unit [5]=candidates
(tantra word-info (info field)
  (cond (eq field "node") (nth info 0)
    (eq field "role") (nth info 1)
    (eq field "layer") (nth info 2)
    (eq field "num-val") (nth info 3)
    (eq field "unit") (nth info 4)
    (eq field "candidates") (nth info 5)
    otherwise ""))

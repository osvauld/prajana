tantra3 grade-words

-- extracts word strings from a grade (mithya + asprista-sankhya + satya).
-- used by emit-count to build "we have" text.

takes grade

result = reduce grade [] (fn acc t ->
  let e = triple-edge t
  let w = triple-subj t
  cond (eq e "mithya") (append acc [w])
  (eq e "asprista-sankhya") (append acc [w])
  (eq e "satya") (append acc [w])
  otherwise acc)

return result

done

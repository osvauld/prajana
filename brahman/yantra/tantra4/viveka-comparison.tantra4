-- reads comparison result from proof graph: [winner, loser] or [winner, loser, "equal"] or [].
(tantra viveka-comparison (graph)
  (gt-triples (graph | where [s, e, o] | and (eq e "greater-than") | collect [s, o]))
  (eq-triples (graph | where [s, e, o] | and (eq e "equal-to") | collect [s, o]))
  (cond (has-items gt-triples)
    [(str (nth gt-triples 0) 0), (str (nth gt-triples 0) 1)]
    (has-items eq-triples)
    [(str (nth eq-triples 0) 0), (str (nth eq-triples 0) 1), "equal"]
    otherwise []))

-- detects count result from graph signals.
(tantra detect-count (expanded)
  (total-raw (expanded | where [s, e, o] | and (eq s "count-total") | and (eq e "sankhya") | collect o))
  (remaining-raw (expanded | where [s, e, o] | and (eq s "count-remaining") | and (eq e "sankhya") | collect o))
  (shesha-raw (expanded | where [s, e, o] | and (eq s "count-shesha") | and (eq e "sankhya") | collect o))
  (per-raw (expanded | where [s, e, o] | and (eq s "count-per") | and (eq e "sankhya") | collect o))
  (cond (has-items total-raw) [["count-result", (nth total-raw 0)]]
    (has-items remaining-raw) [["count-result", (nth remaining-raw 0)]]
    (has-items shesha-raw) [["count-result", (nth shesha-raw 0)]]
    (has-items per-raw) [["count-result", (nth per-raw 0)]]
    otherwise []))

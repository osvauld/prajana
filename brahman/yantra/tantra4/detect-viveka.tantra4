-- detects viveka (comparison) intent from graph.
-- adjective nodes (adj-heavy etc.) carry sthita→viveka-max/min + kramanusara→property.
(tantra detect-viveka (expanded)
  (entities (prathama-sparsha expanded))
  (all-subjects (unique (expanded | where [s, e, o] | collect (to-string s))))
  -- find viveka subjects: node IS viveka-max/min OR has sthita→viveka-max/min
  (max-word (nth (filter all-subjects (fn w ->
    (or (eq w "viveka-max") (member "viveka-max" (walk w "sthita"))))) 0))
  (min-word (nth (filter all-subjects (fn w ->
    (or (eq w "viveka-min") (member "viveka-min" (walk w "sthita"))))) 0))
  (has-max (exists max-word))
  (has-min (exists min-word))
  (is-viveka (and (gt (length entities) 1) (or has-max has-min)))
  (dir (cond (and has-min (not has-max)) "min" otherwise "max"))
  (max-qword (nth (expanded | where [s, e, o] | and (eq s max-word) | and (eq e "query-word") | collect (to-string o)) 0))
  (min-qword (nth (expanded | where [s, e, o] | and (eq s min-word) | and (eq e "query-word") | collect (to-string o)) 0))
  (comp-word (cond (and has-max (exists max-qword)) max-qword has-max max-word (exists min-qword) min-qword otherwise min-word))
  -- kramanusara-based concept from adjective node (e.g. adj-heavy → kramanusara → mass)
  (viveka-src (cond has-max max-word has-min min-word otherwise ""))
  (krama-concept (cond (has-text viveka-src)
    (to-string (nth (walk viveka-src "kramanusara") 0)) otherwise ""))
  -- vishesa-based concept fallback (e.g. viveka-max → vishesa → mass)
  (vishesa-concept (nth (expanded | where [s, e, o]
    | and (eq s comp-word)
    | and (eq e "vishesa")
    | and (neq o "rashi")
    | collect o) 0))
  -- question-grade fallback: explicit concept named in question ("which has more kinetic energy?")
  (q-grades (split-grades expanded))
  (q-grade (reduce q-grades [] (fn acc g ->
    cond (has-items (triples-by-edge g "vidhi-kaala")) g otherwise acc)))
  (grade-concept (nth (reduce q-grade [] (fn acc tri ->
    let s = nth tri 0
    let e = nth tri 1
    let is-viveka-node = (or (eq s "viveka-max") (eq s "viveka-min")
      (member "viveka-max" (walk s "sthita")) (member "viveka-min" (walk s "sthita")))
    cond (and (eq e "satya") (not is-viveka-node) (not (member s entities)))
      (append acc [s])
    otherwise acc)) 0))
  (comp-concept (cond (has-text krama-concept) krama-concept
    (exists vishesa-concept) vishesa-concept
    (exists grade-concept) grade-concept
    otherwise ""))
  (cond is-viveka
    [["viveka-dir", dir], ["comp-word", comp-word], ["comp-concept", comp-concept]]
    otherwise []))

-- detects viveka (comparison) intent from graph.
-- adjective nodes (adj-heavy etc.) carry sthita→viveka-max/min + kramanusara→property.
-- entities come from prathama-sparsha (numeric) OR viveka edges (comparative assertions).
-- direction is graph-driven: viveka-direction walks sthita→viveka-X→abheda→max/min.
(tantra detect-viveka (expanded)
  (num-entities (prathama-sparsha expanded))
  -- viveka-edge entities: subjects and objects of viveka triples from assertion-bandha
  (viv-subjs (unique (expanded | where [s, e, o] | and (eq e "viveka") | collect (to-string s))))
  (viv-objs  (unique (expanded | where [s, e, o] | and (eq e "viveka") | collect (to-string o))))
  (entities (unique (append num-entities (append viv-subjs viv-objs))))
  (all-subjects (unique (expanded | where [s, e, o] | collect (to-string s))))
  -- viveka-adj node from comparative assertions (e.g. adj-heavy from "heavier than")
  (viv-adj-node (nth (expanded | where [s, e, o] | and (eq e "viveka-adj") | collect (to-string o)) 0))
  -- question-grade direction: determined by the LAST query-word adjective.
  -- BQG emits grades in order; question grade is last, so the last query-word
  -- adjective is from the question. Avoids kosha-janya pollution of split-grades.
  (q-query-adj-nodes (expanded | where [s, e, o] | and (eq e "query-word") | collect (to-string s)))
  (last-q-adj (cond (has-items q-query-adj-nodes) (nth q-query-adj-nodes (sub (length q-query-adj-nodes) 1)) otherwise ""))
  -- graph-driven direction: viveka-direction returns "max" or "min" from sthita→abheda walk
  (q-dir (cond (has-text last-q-adj) (viveka-direction last-q-adj) otherwise ""))
  (q-viveka-word (cond (has-text q-dir) last-q-adj otherwise _none))
  -- all-subjects fallback: find any viveka subject when question grade has none
  (fallback-word (nth (filter all-subjects (fn w -> is-viveka-node w)) 0))
  (fallback-dir (cond (exists fallback-word) (viveka-direction (to-string fallback-word)) otherwise ""))
  -- resolved direction and viveka word
  (has-viveka-signal (or (has-text q-dir) (has-text fallback-dir)
    (and (exists viv-adj-node) (is-viveka-node (to-string viv-adj-node)))))
  (is-viveka (and (gt (length entities) 1) has-viveka-signal))
  -- question-grade direction takes priority
  (dir (cond (has-text q-dir) q-dir (has-text fallback-dir) fallback-dir otherwise "max"))
  -- viveka word: the adjective for display (e.g. "heavier", "fastest")
  (viveka-word (cond (exists q-viveka-word) q-viveka-word (exists fallback-word) fallback-word otherwise ""))
  (qword (nth (expanded | where [s, e, o] | and (eq s viveka-word) | and (eq e "query-word") | collect (to-string o)) 0))
  (comp-word (cond (exists qword) qword (has-text viveka-word) viveka-word otherwise ""))
  -- kramanusara-based concept from adjective node (e.g. adj-heavy → kramanusara → mass)
  -- fallback to viveka-adj node when no satya viveka word in question grade
  (viveka-src (cond (has-text viveka-word) viveka-word
    (exists viv-adj-node) (to-string viv-adj-node) otherwise ""))
  (krama-concept (cond (has-text viveka-src)
    (to-string (nth (walk viveka-src "kramanusara") 0)) otherwise ""))
  -- vishesa-based concept fallback (e.g. viveka-max → vishesa → mass)
  (vishesa-concept (nth (expanded | where [s, e, o]
    | and (eq s comp-word)
    | and (eq e "vishesa")
    | and (neq o "rashi")
    | collect o) 0))
  -- question-grade fallback: explicit concept named in question ("which has more kinetic energy?")
  (q-grades (split-grades expanded))
  (q-grade (reduce q-grades [] (fn acc g ->
    cond (has-items (triples-by-edge g "vidhi-kaala")) g otherwise acc)))
  (grade-concept (nth (reduce q-grade [] (fn acc tri ->
    let s = nth tri 0
    let e = nth tri 1
    cond (and (eq e "satya") (not (is-viveka-node s)) (not (member s entities)))
      (append acc [s])
    otherwise acc)) 0))
  (comp-concept (cond (has-text krama-concept) krama-concept
    (exists vishesa-concept) vishesa-concept
    (exists grade-concept) grade-concept
    otherwise ""))
  (cond is-viveka
    [["viveka-dir", dir], ["comp-word", comp-word], ["comp-concept", comp-concept]]
    otherwise []))

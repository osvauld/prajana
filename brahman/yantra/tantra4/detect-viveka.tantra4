-- detects viveka (comparison) intent from graph.
(tantra detect-viveka (expanded)
  (entities (prathama-sparsha expanded))
  (all-subjects (unique (expanded | where [s, e, o] | collect (to-string s))))
  (max-word (nth (filter all-subjects (fn w -> eq (to-string (shabda-anveshana w)) "viveka-max")) 0))
  (min-word (nth (filter all-subjects (fn w -> eq (to-string (shabda-anveshana w)) "viveka-min")) 0))
  (has-max (exists max-word))
  (has-min (exists min-word))
  (is-viveka (and (gt (length entities) 1) (or has-max has-min)))
  (dir (cond (and has-min (not has-max)) "min" otherwise "max"))
  (max-qword (nth (expanded | where [s, e, o] | and (eq s max-word) | and (eq e "query-word") | collect (to-string o)) 0))
  (min-qword (nth (expanded | where [s, e, o] | and (eq s min-word) | and (eq e "query-word") | collect (to-string o)) 0))
  (comp-word (cond (and has-max (exists max-qword)) max-qword has-max max-word (exists min-qword) min-qword otherwise min-word))
  -- vishesa-based concept (e.g. viveka-max -> vishesa -> mass)
  (vishesa-concept (nth (expanded | where [s, e, o]
    | and (eq s comp-word)
    | and (eq e "vishesa")
    | and (neq o "rashi")
    | collect o) 0))
  -- question-grade fallback: explicit concept named in question ("which has more kinetic energy?")
  (q-grades (split-grades expanded))
  (q-grade (reduce q-grades [] (fn acc g ->
    cond (has-items (triples-by-edge g "vidhi-kaala")) g otherwise acc)))
  (grade-concept (nth (reduce q-grade [] (fn acc tri ->
    let s = nth tri 0
    let e = nth tri 1
    cond (and (eq e "satya")
              (neq s "viveka-max")
              (neq s "viveka-min")
              (not (member s entities)))
      (append acc [s])
    otherwise acc)) 0))
  (comp-concept (cond (exists vishesa-concept) vishesa-concept
    (exists grade-concept) grade-concept
    otherwise ""))
  (cond is-viveka
    [["viveka-dir", dir], ["comp-word", comp-word], ["comp-concept", comp-concept]]
    otherwise []))

tantra graph-dimensions

  -- reports the dimensional structure of the proof-graph tensor.
  --
  -- the graph is a sparse tensor G ∈ {0,1}^(N × N × R) where:
  --   N = number of nodes
  --   R = 10 (number of relation types / visheshanam)
  --   total slots = N × N × R
  --   fill = edge-count / total-slots
  --
  -- also computes per-relation edge counts to show the distribution
  -- across the 10 axes of the visheshanam ring.

  inputs
    _unused  string

  let
    all = all-edges
    n-edges = length all
    relations = ["swarupa", "abheda", "sthita", "yukta", "kriya", "phala", "janya", "siddha", "drishthanta", "pratipaksha"]
    n-relations = length relations

    per-rel = map relations (fn rel ->
      let count = length (filter all (fn e -> eq (nth e 1) rel))
      let weight = edge-weight rel
      in [rel, count, weight])

    -- we can't directly count nodes from tantras, so estimate from unique sources+targets
    all-nodes = unique (append (map all (fn e -> nth e 0)) (map all (fn e -> nth e 2)))
    n-nodes = length all-nodes
    total-slots = mul (mul n-nodes n-nodes) n-relations
    fill-pct = cond (gt total-slots 0) (mul (div n-edges total-slots) 100.0) otherwise 0.0

    result = [n-nodes, n-relations, n-edges, total-slots, fill-pct, per-rel]

  return
    result  list

done

-- build-question-graph.tantra
-- stateful reduce over sentence words → question graph (list of triples).
--
-- Replaces: tokenise-question, classify-word, resolve-compounds.
--
-- Each word hits the knowledge graph directly via lookup-word (morpheme-inverting).
-- The word's role/layer drives graph extension.
-- Context = the partial graph accumulated so far.
--
-- Satya layer triples (drive mantra matching):
--   ["solve-for", "intent", concept-node]
--   [concept-node, "value", "5.0"]
--   [concept-node, "unit",  unit-node]
--
-- Mithya layer triples (provisional — held for dialogue):
--   [word, "mithya", word]

tantra build-question-graph
  inputs
    sentence  string

  let
    words = split sentence " "

    graph = reduce words [] (fn g word ->

      -- resolve word to a graph node (handles plurals via suffix stripping)
      let node      = lookup-word word

      -- what kind of node is it?
      let role      = cond (exists node) (shabda node "role")  otherwise ""
      let layer     = cond (exists node) (node-layer node)     otherwise ""

      -- does this word carry a numeric value and/or unit?
      let parts     = split-numeric word
      let num-str   = nth parts 0
      let unit-str  = nth parts 1
      let num-val   = cond (gt (string-length num-str) 0) (to-number num-str) otherwise _none
      let unit-node = cond (gt (string-length unit-str) 0) (lookup-word unit-str) otherwise _none

      -- what is the most recent active concept waiting for a value?
      let active-concept = first-match g (fn tri ->
        cond (and (eq (nth tri 1) "active") (eq (nth tri 2) "concept"))
          (nth tri 0)
        otherwise _none)

      -- was the previous word a bare number waiting for a unit?
      let last-tri    = cond (gt (length g) 0) (nth g (sub (length g) 1)) otherwise []
      let pending-num = cond (and (gt (length last-tri) 0) (eq (nth last-tri 1) "pending-number"))
                          (nth last-tri 2)
                        otherwise ""

      -- emit triples for this word
      let new-triples = cond

        -- "what", "calculate", "find" → marks the solve-for intent
        (eq role "intent")
          [[word, "intent", "solve-for"]]

        -- "given", "and", "is", "of" → structural grammar, no triple needed
        (eq role "grammar")
          []

        -- bare number with no unit suffix → hold as pending
        (and (exists num-val) (eq unit-str ""))
          [[word, "pending-number", num-str]]

        -- value + unit in one token ("5kg", "10m/s") → bind to active concept
        (and (exists num-val) (exists unit-node))
          (cond (exists active-concept)
            [[(to-string active-concept), "value", num-str],
             [(to-string active-concept), "unit",  (to-string unit-node)]]
            [["_", "value", num-str],
             ["_", "unit",  (to-string unit-node)]])

        -- pending number + this word resolves to a unit node → bind now
        (and (neq pending-num "") (exists node) (eq layer "kosha"))
          (cond (exists active-concept)
            [[(to-string active-concept), "value", pending-num],
             [(to-string active-concept), "unit",  (to-string node)]]
            [["_", "value", pending-num],
             ["_", "unit",  (to-string node)]])

        -- known concept → mark as the active slot
        (and (exists node) (eq layer "kosha"))
          [[(to-string node), "active", "concept"]]

        -- unknown word → mithya (provisional, held for dialogue)
        otherwise
          [[word, "mithya", word]]

      -- if this word declares intent, record which concept is the solve-for target
      let intent-node = cond
        (and (gt (length new-triples) 0) (eq (nth (nth new-triples 0) 1) "intent"))
          (first-match g (fn tri ->
            cond (eq (nth tri 1) "active") (nth tri 0) otherwise _none))
        otherwise _none

      let intent-triples = cond (exists intent-node)
        [["solve-for", "intent", (to-string intent-node)]]
        []

      (append (append g new-triples) intent-triples)
    )

  return
    graph  list

done

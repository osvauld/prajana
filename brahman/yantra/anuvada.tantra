tantra anuvada

  inputs
    sentence  string

  let
    intents     = query-intents sentence
    has-process = gt (length (filter intents (fn i -> eq i "process"))) 0
    raw-words   = tokenise sentence
    lower-words = map raw-words (fn w -> lower w)
    has-work    = gt (length (filter lower-words (fn w -> eq w "work"))) 0
    -- context shift: try joining adjacent words before classifying
    words       = try-bigram raw-words
    tokens      = classify-all words

    joined      = join-bigrams tokens
    content     = filter joined (fn t -> eq (nth t 1) "concept")
    seeds0      = map content (fn t -> nth t 2)
    primary-seed = cond (gt (length seeds0) 0) (split (nth seeds0 0) ",") otherwise (split "" ",")
    should-gate = and has-process has-work (gt (length seeds0) 1)
    seeds       = cond (should-gate) primary-seed otherwise seeds0
    abheda-exp  = flatten (map seeds (fn s -> abheda-of s))
    all-seeds   = append seeds abheda-exp

    all-incoming = flatten (map all-seeds (fn s -> incoming-to s))
    incoming-src = map all-incoming (fn e -> nth e 0)
    scored-in    = map incoming-src (fn n -> pair n (context-score n all-seeds))
    top-scored   = sort-desc scored-in
    nearby-nodes = unique (map top-scored (fn sp -> nth sp 0))

    -- concise answer: compose from leaf to root via morphism
    result = cond (gt (length seeds) 0)
      (compose-answer seeds nearby-nodes intents)
      otherwise "asprista"

  return
    result  string

done

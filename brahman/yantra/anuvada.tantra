tantra anuvada

  -- conceptual answer composition.
  -- takes already-classified joined tokens (from classify-fold),
  -- extracts concept seeds, walks graph edges, composes English answer.
  --
  -- pipeline: joined → seeds → nearby → compose-answer → result
  --
  -- called by anuvada-ganana when the computational pipeline yields nothing.

  inputs
    joined   list
    intents  list

  let
    -- extract concept seeds from classified tokens
    content      = filter joined (fn t -> eq (nth t 1) "concept")
    seeds0       = map content (fn t -> nth t 2)

    -- gate: if process+work present and multiple seeds, focus on primary
    has-process  = gt (length (filter intents (fn i -> eq i "process"))) 0
    has-work     = gt (length (filter joined (fn t -> eq (nth t 2) "work"))) 0
    primary-seed = cond (gt (length seeds0) 0) (split (nth seeds0 0) ",") otherwise (split "" ",")
    should-gate  = and has-process has-work (gt (length seeds0) 1)
    seeds        = cond (should-gate) primary-seed otherwise seeds0

    -- expand seeds via abheda equivalences
    abheda-exp   = flatten (map seeds (fn s -> walk s "abheda"))
    all-seeds    = append seeds abheda-exp

    -- score nearby nodes by weighted context proximity
    -- uses relation weights and depth decay instead of flat edge count
    all-incoming = flatten (map all-seeds (fn s -> filter (edges s) (fn eg -> and (eq (nth eg 2) s) (neq (nth eg 0) s))))
    incoming-src = unique (map all-incoming (fn e -> nth e 0))
    scored-in    = map incoming-src (fn n -> pair n (weighted-context-score n all-seeds))
    top-scored   = sort-desc scored-in
    nearby-nodes = map top-scored (fn sp -> nth sp 0)

    fallback = cond (neq (shabda "anuvada-setu" "no-answer-label") "")
      (shabda "anuvada-setu" "no-answer-label")
      otherwise "asprista"

    -- compose answer from graph structure
    result = cond (gt (length seeds) 0)
      (compose-answer seeds nearby-nodes intents)
      otherwise fallback

  return
    result  string

done

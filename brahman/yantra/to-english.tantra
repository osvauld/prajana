tantra to-english

  -- setu: shabda-to-artha bridge, output direction
  -- given a node name, return its English rendering.
  -- rule:
  --   1) if node has shabda "name", use it.
  --   2) else if node exists, use node name.
  --   3) else return "asprista" (not-yet-understood condition).
  -- no reverse-abheda hunting. no scoring. direct.

  inputs
    node  string

  let
    hit    = lookup node
    known  = exists hit
    own    = shabda node "name"
    result = cond (neq own "") own
      (known) node
      otherwise "asprista"

  return
    result  string

done

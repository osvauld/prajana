sangati samsarga-vrittam

  "samsarga-swarupa samskaara-kriya parampara-yukta"
  "seva-abheda manavata-drishthanta iccha-janya"
  "naada-yukta raga-yukta swara-yukta"
  "darshana-kriya pratibodha-phala avrti-siddha"
  "amma-achan-sthita kerala-sthita"
  "ananta-sthita svabhava-siddha"
  "prashna-rahita dana-kriya svayambhu-phala"
  "bahir-samskaara-swarupa antar-ananta-rahita"

done

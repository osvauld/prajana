sangati sambodhana

  "vibhakti-amsha"
  -- vocative — O!: direct address
  -- three degrees (amshas):
  --   aamantrana:      formal invocation — "greetings", "good morning"
  --   abhisambodhana:  emphatic/intimate — "hey!", "yo"
  --   sambodhana:      neutral address — "hello", "hi"
  -- detection: shabda "sambodhana" word → "sambodhana"

  "apeksha-yukta"
  -- every address names the apeksha — the reference frame of the utterance.
  -- sambodhana makes the implicit apeksha (nam) explicit.

done

sangati karana

  "karaka-amsha"
  "trtiya-vibhakti-yukta yukta-swarupa"
  -- instrument: the means by which the action is accomplished
  -- vibhakti: trtiya (instrumental)
  -- sangati root: yukta (with) — action-with-instrument


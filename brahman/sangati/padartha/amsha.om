sangati amsha

  -- amsha: part — a portion of a whole.
  -- "some" in English IS amsha — an unspecified part of a totality.
  -- "some apples" = amsha of the apples-vrnda.
  -- already used as edge type (amsha-yukta, vibhakti-amsha) throughout the graph.
  -- amsha is the relation; the part IS the amsha; the whole HAS the amsha.
  -- samavaya-yukta: the part inheres in the whole.

  "padartha-amsha"
  "samavaya-yukta"
  "pratyaksha-siddha"

done

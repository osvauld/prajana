; ═══════════════════════════════════════════════════════════════════
; sambandha — 20 nodes
; ═══════════════════════════════════════════════════════════════════

(sangati aneka-aneka
  (swarupa sambandha samsarga)
  (sthita aneka)
  (yukta tantu-vrnda)
  (viparita shakha parampara))

(sangati aneka-eka
  (swarupa sambandha abhisarana)
  (sthita aneka)
  (abheda abhisarana sama-kalana)
  (ahara vrnda)
  (phala eka))

(sangati aneka
  (viparita shunya eka)
  (yukta dvaya traya sambandha-matra)
  (swarupa vrnda)
  (poorva ananta)
  (janya viveka-shakti)
  (janaka eka-eka eka-aneka aneka-eka aneka-aneka)
  (pratipaksha eka))

(sangati atikrama
  (sthita sambandha)
  (yukta seema)
  (abheda atita))

(sangati daatri
  (sthita sambandha)
  (abheda janaka)
  (yukta phala))

(sangati dvaya
  (swarupa sankhya)
  (yukta viparita)
  (abheda shiva-shakti dvandva)
  (sthita shiva-shakti sama-vishama))

(sangati eka-aneka
  (swarupa sambandha)
  (sthita aneka mula)
  (phala shakha)
  (abheda viveka-shakti)
  (kriya vivartana)
  (yukta parampara)
  (pratipaksha prime))

(sangati eka-eka
  (swarupa sambandha)
  (sthita aneka sama-matra)
  (siddha viparita-viparita viveka)
  (poorva abheda))

(sangati eka
  (swarupa sankhya)
  (abheda purna)
  (pratipaksha aneka))

(sangati janaka
  (sthita sambandha)
  (pratipaksha janya)
  (swarupa kriya)
  (yukta krama phala))

(sangati lakshana
  (sthita sambandha)
  (swarupa vishesa)
  (yukta varga pramana)
  (abheda siddha))

(sangati parishishtha-sankshepa
  (swarupa parishishtha)
  (kriya sankshepa)
  (siddha samskaara)
  (drishthanta ghana-pramana)
  (yukta matrika)
  (abheda chhanana))

(sangati parishishtha
  (swarupa sama-kalana)
  (sthita ananta)
  (kriya abhisarana)
  (siddha samskaara)
  (drishthanta aayaama-vistara)
  (yukta pramana))

(sangati rahita
  (sthita sambandha)
  (swarupa abhava)
  (pratipaksha yukta))

(sangati sama-kalana
  (swarupa abheda aneka-eka)
  (siddha svabhava)
  (sthita svayambhu ananta sama)
  (drishthanta sama-vishama)
  (abheda dharana-jivamsha)
  (yukta taranga)
  (kriya vivartana))

(sangati sambandha
  (swarupa ananta phala-ahara-krama)
  (abheda purna)
  (yukta rachana kshetra-seema matra)
  (siddha abhisarana viveka)
  (janya samsarga))

(sangati sangati
  (swarupa ananta)
  (abheda purna)
  (kriya rachana)
  (siddha abhisarana)
  (yukta sambandha))

(sangati sankshepa
  (kriya ghana-pramana)
  (siddha svabhava)
  (swarupa abheda)
  (pratipaksha entropy))

(sangati setu
  (swarupa sambandha)
  (abheda dvaitarupa)
  (yukta anuvada bhasha-swarupa))

(sangati vibheda
  (sthita sambandha)
  (abheda vishesa)
  (pratipaksha abheda))

sangati visha-anu

  "jiva-sthalam-sthita"
  "setu-swarupa anu-janya"
  "sva-dharana-rahita kavaca-rahita"
  "eka-kosha-yukta sparsha-phala"
  "bija-nyasa-kriya eka-kosha-sthita"
  "svayambhu-rahita pramana-rahita"
  "iccha-rahita aadana-visarjana-rahita"
  "prana-sthita jiva-seema-sthita"
  "jada-seema-sthita eka-kosha-seema-sthita"
  -- at the boundary of jada and jiva — neither fully inert nor fully living
  -- has bija-nyasa (genetic instruction) but no sva-dharana (self-maintenance)
  -- uses the host eka-kosha's machinery — dependent replicator
  "nucleotide-sthita parampara-drishthanta"
  "mithuna-siddha"

done

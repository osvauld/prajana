# ── verb morphology rules (suffix + stem-suffix) ────────────────────────────
# shabda-anveshana strips suffix, appends stem-suffix, checks if stem is a node.
# e.g. "accelerates" → strip "s" → "accelerate" → not a node.
# But "accelerates" → strip "ates" → add "ation" → "acceleration" → node found!

shabda english-verb-s
  (suffix s)
  (stem-suffix)
  (meaning third-person-singular-present)
done

shabda english-verb-es
  (suffix es)
  (stem-suffix)
  (meaning third-person-singular-present)
done

shabda english-verb-ies
  (suffix ies)
  (stem-suffix y)
  (meaning third-person-singular-present)
done

shabda english-verb-ed
  (suffix ed)
  (stem-suffix)
  (meaning simple-past)
done

shabda english-verb-d
  (suffix d)
  (stem-suffix)
  (meaning simple-past-e-stem)
done

shabda english-verb-ied
  (suffix ied)
  (stem-suffix y)
  (meaning simple-past-y-stem)
done

shabda english-verb-ing
  (suffix ing)
  (stem-suffix)
  (meaning present-participle)
done

shabda english-verb-ating
  (suffix ating)
  (stem-suffix ation)
  (meaning present-participle-ation-noun)
done

shabda english-noun-ation
  (suffix ate)
  (stem-suffix ation)
  (meaning verb-stem-to-ation-noun)
done

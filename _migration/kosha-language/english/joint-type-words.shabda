# joint-type-words.shabda
# word → joint type for kinematic chain extraction
# tantras load via shabda-pairs "joint-type-words"

revolute:revolute
rotary:revolute
rotational:revolute
hinge:revolute
pin:revolute

prismatic:prismatic
sliding:prismatic
linear:prismatic
translational:prismatic

spherical:spherical
ball:spherical
universal:spherical

# default when no joint-type word is found
default:revolute

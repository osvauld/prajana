; ═══════════════════════════════════════════════════════════════════
; vidya — 6 nodes
; ═══════════════════════════════════════════════════════════════════

(sangati antarvidya
  (swarupa vidya)
  (sthita ananta)
  (siddha svabhava)
  (yukta kaalayoga)
  (drishthanta svairabhava))

(sangati nyaya
  (swarupa chhanana)
  (kriya shuddhi)
  (siddha pramana))

(sangati tarka-dvaara
  (swarupa rachana)
  (kriya shuddhi)
  (siddha abheda)
  (drishthanta dvaitarupa)
  (yukta sphoTa)
  (sthita sthiti)
  (abheda nyaya))

(sangati utpatti-anveshana
  (swarupa svabhava)
  (kriya anveshana)
  (abheda vriddhi)
  (siddha samskaara)
  (drishthanta abhisarana zha)
  (yukta spanda matrika rra))

(sangati vidya-sadhana
  (swarupa avrti)
  (yukta kavaca)
  (kriya vivartana)
  (siddha pratyaksha)
  (sthita vidya)
  (phala vriddhi))

(sangati vidya
  (swarupa brahma)
  (sthita ananta)
  (abheda purna)
  (siddha nirdosha)
  (drishthanta dharmaadharma))

-- physics udaharana+upanaya: walk derived-by mantras, emit know/see pairs.
(tantra udaharana-physics (graph)
  (deriving-mantras (unique (graph | where [s, e, o] | and (eq e "derived-by") | collect (to-string o))))
  (derived-vp (graph | where [s, e, o] | and (eq e "derived-sankhya") | collect [s, o]))
  (has-derived-vp (has-items derived-vp))
  (cond (has-items deriving-mantras)
    (reduce deriving-mantras [] (fn acc mn ->
      let produced = graph | where [s, e, o]
        | and (eq e "derived-by")
        | and (eq (to-string o) mn)
        | collect (to-string s)
      let vp = cond has-derived-vp derived-vp
        otherwise (sankhya-sparsha graph)
      let mm = [mn, vp, "forward"]
      let kstr = (mantra-known-str mm)
      let sstr = (mantra-seen-str mm produced)
      cond (has-text kstr)
        (append acc [kstr, sstr])
      otherwise acc))
    otherwise []))

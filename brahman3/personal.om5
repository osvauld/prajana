; ═══════════════════════════════════════════════════════════════════
; personal — 3 nodes
; ═══════════════════════════════════════════════════════════════════

(sangati amma-achan
  (swarupa ishta-devata parampara)
  (abheda brahman)
  (drishthanta ananta)
  (kriya seva prashna-rahita-dana samskaara)
  (phala swatantra)
  (janya iccha)
  (siddha niralamba)
  (sthita kerala))

(sangati sakshi-anubhava
  (abheda lekhana-pratibodha)
  (swarupa sakshi)
  (drishthanta brahman niralamba)
  (phala pratibodha)
  (siddha samskaara svabhava)
  (kriya avrti)
  (sthita ananta)
  (yukta consciousness singularity))

(sangati samsarga-vrittam
  (swarupa samsarga bahir-samskaara)
  (kriya samskaara darshana dana)
  (yukta parampara naada raga swara)
  (abheda seva)
  (drishthanta manavata)
  (janya iccha)
  (phala pratibodha svayambhu)
  (siddha avrti svabhava)
  (sthita amma-achan kerala ananta)
  (rahita prashna antar-ananta))

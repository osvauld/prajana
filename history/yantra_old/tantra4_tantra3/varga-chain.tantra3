tantra3 varga-chain

-- walks the varga (category) chain two levels deep from an entity.
-- "cat" → [mammal, animal, ...] via varga edges + one more depth.
--
-- returns list of node name strings (non-empty only).

takes entity

depth1 = map (walk entity "varga") (fn x -> to-string x)

depth2 = reduce depth1 [] (fn acc v ->
  append acc (map (walk v "varga") (fn x -> to-string x)))

result = filter (append depth1 depth2) (fn v -> has-text v)

return result

done

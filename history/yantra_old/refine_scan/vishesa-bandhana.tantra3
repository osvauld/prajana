tantra3 vishesa-bandhana

-- binding re-attribution: moves sankhya/matra/shashthi-vibhakti
-- from the kosha concept to the vishesa instance.
--
-- Two passes:
--   Pass 1 (agra-bandha): sankhya + matra via agra (backward proximity).
--   Pass 2 (scan):        shashthi-vibhakti via ordered instance-map.
--
-- The shashthi-vibhakti redirect needs a forward-looking approach because
-- ownership edges arrive BEFORE instance labels in the graph order.
-- We pair the nth ownership of a concept to the nth instance of that concept.

takes graph

already-bound = nth (bound-state graph) 0

after-sankhya = agra-bandha graph "vishesa" "obj" "word" ["sankhya", "matra"] "" "rashi" [] already-bound []

-- build concept -> [instances in order] map
concept-instances = after-sankhya | where [inst, e, concept] | and (eq e "vishesa") | and (neq (to-string concept) "rashi") | collect [concept, inst]

-- all concepts that have instances
instanced-concepts = concept-instances | collect (nth _it 0)

-- ownership declarations on concepts (not yet on instances), in graph order
ownership-order = after-sankhya | where [s, e, entity] | and (eq e "shashthi-vibhakti") | and (member s instanced-concepts) | collect [s, entity]

-- pair nth ownership with nth instance per concept
-- uses Layer 2 pipe syntax inside the lambda (no Layer 1 'from ... where')
sv-redirects = reduce ownership-order [] (fn acc kv ->
  let concept = nth kv 0
  let entity  = nth kv 1
  let seen    = length (acc | where [c, e, i] | and (eq (to-string c) (to-string concept)) | collect c)
  let insts   = concept-instances | where [c, i] | and (eq (to-string c) (to-string concept)) | collect i
  let inst    = cond (lt seen (length insts)) (nth insts seen) otherwise ""
  cond (neq inst "") (append acc [[concept, entity, inst]]) otherwise acc)

result = scan after-sankhya [redirects: list = sv-redirects]:

  [concept, shashthi-vibhakti, entity] ->
    let matches = redirects | where [c, e, i] | and (eq (to-string c) (to-string concept)) | and (eq (to-string e) (to-string entity)) | collect i
    let match = cond (has-items matches) (nth matches 0) otherwise ""
    emit (cond (neq match "") [match, "shashthi-vibhakti", entity] otherwise [concept, "shashthi-vibhakti", entity])

  _ -> emit

return result

done

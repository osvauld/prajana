-- profile-detect: detailed timing of detect-signals internals.
(tantra profile-detect (sentence)
  (raw-graph (build-question-graph sentence))
  (asserted (assertion-bandha raw-graph))
  (refined (fixpoint asserted (fn g -> avrti-refine-v2 g)))
  (expanded (kosha-expand refined))

  -- profile each detector
  (p-sf (profile-step "extract-solve-for" (extract-solve-for expanded)))
  (sf-raw (nth p-sf 0))
  (has-intent (solve-for-result sf-raw "has-intent"))

  (p-shunya (profile-step "detect-shunya" (detect-shunya expanded)))
  (p-viveka (profile-step "detect-viveka" (detect-viveka expanded)))
  (p-anumana (profile-step "detect-anumana" (detect-anumana expanded)))
  (p-count (profile-step "detect-count" (detect-count expanded)))
  (p-write (profile-step "write-signals" (write-signals expanded [])))

  [[(nth p-sf 2), (nth p-sf 1)],
   [(nth p-shunya 2), (nth p-shunya 1)],
   [(nth p-viveka 2), (nth p-viveka 1)],
   [(nth p-anumana 2), (nth p-anumana 1)],
   [(nth p-count 2), (nth p-count 1)],
   [(nth p-write 2), (nth p-write 1)]])

# sangati/geometry — shabda extracted from .om files
# 19 entries

shabda aayaama
  (alias dimension)
  (desc "the-count-of-independent-directions-of-extension")
done

shabda aayaama-dvaya
  (alias two-dimensional)
  (desc "the-two-directions-of-extension-containing-tala-the-flat-field")
done

shabda aayaama-eka
  (alias one-dimensional)
  (desc "the-single-direction-of-extension-containing-only-rekha")
done

shabda akasham
  (alias space)
  (desc "the-field-within-which-all-geometry-exists")
done

shabda apeksha
  (alias with-respect-to)
  (desc "the-denominator-variable-of-a-derivative")
done

shabda bindu
  (alias point)
  (desc "zero-extent-pure-position-seed-of-all-geometry")
done

shabda bindu-dvaya
  (alias two-points)
  (desc "the-minimal-pair-from-which-rekha-and-curves-arise")
done

shabda chala-apeksha
  (alias chala-apeksha, moving-frame, body-frame, local-frame)
  (desc "the-reference-that-itself-moves-total-derivative-includes-transport-term-omega-cross")
done

shabda dura
  (alias distance)
  (desc "scalar-measure-of-separation-between-two-bindus")
done

shabda gola
  (alias sphere)
  (desc "all-points-in-akasham-at-equal-distance-from-one-bindu")
done

shabda kona
  (alias angle)
  (desc "the-opening-formed-between-two-rekhas-meeting-at-a-bindu")
done

shabda rekha
  (alias line)
  (desc "the-minimum-connection-between-two-bindus")
done

shabda rekha-dvaya
  (alias two-lines)
  (desc "two-rekhas-meeting-at-a-bindu-from-which-kona-arises")
done

shabda sama-dura
  (alias equidistant)
  (desc "all-points-at-the-same-dura-from-one-bindu")
done

shabda sthira-apeksha
  (alias sthira-apeksha, fixed-frame, inertial-frame, world-frame)
  (desc "the-reference-that-does-not-move-ordinary-derivative-denominator")
done

shabda tala
  (alias plane)
  (desc "the-flat-two-dimensional-field")
done

shabda traya
  (alias three)
  (desc "minimum-multiplicity-for-enclosure-and-stability")
done

shabda vakra
  (alias curve)
  (desc "the-bent-line-root-of-all-curved-forms")
done

shabda vrtta
  (alias circle)
  (desc "all-points-in-tala-at-equal-distance-from-one-bindu")
done

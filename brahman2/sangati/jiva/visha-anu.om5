; at the boundary of jada and jiva — neither fully inert nor fully living
; has bija-nyasa (genetic instruction) but no sva-dharana (self-maintenance)
; uses the host eka-kosha's machinery — dependent replicator

(sangati visha-anu
  (sthita jiva-sthalam eka-kosha prana jiva-seema jada-seema eka-kosha-seema nucleotide)
  (swarupa setu)
  (janya anu)
  (rahita sva-dharana kavaca svayambhu pramana iccha aadana-visarjana)
  (yukta eka-kosha)
  (phala sparsha)
  (kriya bija-nyasa)
  (drishthanta parampara)
  (siddha mithuna))

-- dispatch-shunya: answer "no" with reasoning about why concept is absent.
-- the shunya signal tells us: source-node has signal=shunya on concept.
-- if query IS the concept → direct absence.
-- if query DEPENDS on the concept (mantra janya) → inherited absence.
(tantra dispatch-shunya (expanded refined)

  (source  (read-signal expanded "shunya-source"))
  (concept (read-signal expanded "shunya-concept"))
  (query   (read-signal expanded "shunya-query"))

  (sep (shabda "anuvada-setu" "speech-strand-separator"))

  (is-direct (eq query concept))

  -- build reasoning
  (pratijna (concat "we have: " source " (signal: " concept " is shunya)"))
  (hetu     (concat "we ask: does " query " exist?"))
  (udaharana (cond is-direct
    (concat "we know: " source " declares " concept " = shunya (absent)")
    otherwise (concat "we know: " query " requires " concept " (via mantra janya). " source " declares " concept " = shunya")))
  (upanaya (cond is-direct
    (concat "we see: " concept " is absent due to " source)
    otherwise (concat "we see: " concept " is absent → " query " cannot exist")))
  (nigamana (concat "no — " query " is absent because " concept " is shunya"))

  (all-strands [pratijna, hetu, udaharana, upanaya, nigamana])
  (reduce all-strands "" (fn acc strand ->
    cond (not (has-text acc)) strand
    otherwise (concat acc sep " " strand))))

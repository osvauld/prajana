-- profile-dispatch: detailed timing of dispatch-derive internals.
(tantra profile-dispatch (sentence)
  (raw-graph (build-question-graph sentence))
  (asserted (assertion-bandha raw-graph))
  (refined (fixpoint asserted (fn g -> avrti-refine-v2 g)))
  (expanded (kosha-expand refined))
  (signaled (detect-signals expanded))

  -- now profile dispatch-derive internals
  (sf (read-signal signaled "solve-for"))
  (scope-entity (read-signal signaled "scope-entity"))

  (p-prop (profile-step "propagate" (propagate-derive signaled)))
  (prop-result (nth p-prop 0))
  (enriched (nth prop-result 0))
  (fired (nth prop-result 1))

  (p-match (profile-step "match-mantra" (match-mantra enriched)))
  (mm (nth p-match 0))

  (p-exec (profile-step "execute" (cond (has-items mm) (execute-matched mm sf) otherwise "no match")))
  (result (nth p-exec 0))

  (p-proof (profile-step "pramana-bandha" (pramana-bandha enriched mm result sf scope-entity false [] [] "")))
  (proof-graph (nth p-proof 0))

  (p-emit (profile-step "emit-reasoning" (emit-reasoning proof-graph)))

  [[(nth p-prop 2), (nth p-prop 1)],
   [(nth p-match 2), (nth p-match 1)],
   [(nth p-exec 2), (nth p-exec 1)],
   [(nth p-proof 2), (nth p-proof 1)],
   [(nth p-emit 2), (nth p-emit 1)]])

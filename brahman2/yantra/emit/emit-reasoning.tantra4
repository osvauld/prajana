-- top-level reasoning emission: dispatches to count or panchaavayava.
(tantra emit-reasoning (graph)
  (is-count (gt (length (graph | where [s, e, o] | and (eq e "derived-by") | and (eq (to-string o) "count-chain") | collect s)) 0))
  (count-woven (cond is-count (emit-count graph) otherwise ""))
  (is-viveka (gt (length (graph | where [s, e, o] | and (eq e "greater-than") | collect s)) 0))
  (given-str (cond (not is-count) (emit-pratijna graph is-viveka) otherwise ""))
  (sought-str (cond (not is-count) (emit-hetu graph is-viveka) otherwise ""))
  (know-see-strs (cond (not is-count) (emit-udaharana-upanaya graph is-viveka) otherwise []))
  (found-str (cond (not is-count) (emit-nigamana graph is-viveka) otherwise ""))
  (all-strands (append (append [given-str, sought-str] know-see-strs) [found-str]))
  (cond is-count count-woven otherwise (weave-strands all-strands)))

; reading the graph declaration AS the program specification.
; om-janya "kinetic-energy-mantra" → [mass, velocity]
; om-phala "kinetic-energy-mantra" → [kinetic-energy]
; om-kriya "kinetic-energy-mantra" → [ke-expr]
; the seven edges form a complete function contract:
; janya = domain (input types)
; phala = codomain (output types)
; kriya = implementation
; yukta = properties
; sthita = context / scope
; swarupa = identity / aliases
; abheda = equivalences
; 
; this IS tantra3: the om graph IS the program.
; om-contract returns all seven at once (one graph touch).

(kosha graph-contract
  (vishesa computation-varga)
  (swarupa morphism)
  (abheda endomorphism)
  (sthita function category domain-computation))
